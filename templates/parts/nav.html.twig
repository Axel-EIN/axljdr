{% set compact = compact|default(false) %}
{% set avec_recherche = not compact %}
{% set control_panel = null %}
{% if app.user and is_granted('ROLE_ADMIN') %}
  {% set control_panel = {variant: 'admin', icon: 'fa-tools', label: "Panneau d'Administration"} %}
{% elseif app.user and is_granted('ROLE_MJ') %}
  {% set control_panel = {variant: 'mj', icon: 'fa-scroll', label: 'Panneau du Maître'} %}
{% endif %}

{% if control_panel and not compact %}
  <div class="control-panel-bar {{ control_panel.variant }}">
    <a href="{{ path('back_office') }}">
      <i class="fas {{ control_panel.icon }}"></i>
      &nbsp;&nbsp;
      {{ control_panel.label }}
    </a>
  </div>
{% endif %}

{% set nav_sections = [
  { label: 'ACCUEIL',      route: 'news',       actives: ['news'] },
  { label: 'AVENTURE',    route: 'aventure',    actives: ['aventure', 'aventure_saison', 'aventure_episode'] },
  { label: 'PERSONNAGES', route: 'personnages', actives: ['personnages', 'personnage_profil', 'personnage_fiche', 'personnage_fiche_edit'] },
  { label: 'UNIVERS',      route: 'world',      actives: ['world', 'world_clan', 'world_archive', 'world_lieu', 'world_lore'] },
  { label: 'RÈGLES',      route: 'regles',      actives: ['regles', 'regles_rule', 'regles_library', 'regles_classe', 'regles_ecole'] },
  { label: 'CARTE',       route: 'carte',       actives: ['carte'] },
] %}
{% set route_courante = app.request.get('_route') %}
{% set section_active = nav_sections|filter(s => route_courante in s.actives)|first %}

<header class="container-fluid navigation-bar{% if compact %} compact{% endif %}">
  <div class="container">
    <nav class="navbar navbar-expand-lg">

      <a id="logo" class="navbar-brand hover-shine" href="{{ path('news') }}">
        <img  class="img-fluid" src="{{ asset(LOGO) }}" alt="Logo AXL-JDR" title="Retour à l'Accueil" />
      </a>

      <div class="nav-mobile-menu dropdown{{ compact ? '' : ' d-lg-none' }}">
        <button
          class="nav-link nav-mobile-toggle-full chevron-toggle{% if section_active %} active{% endif %}" type="button"
          data-toggle="dropdown" aria-expanded="false" aria-label="Ouvrir le menu des sections"
        >
          {{ section_active.label|default('MENU') }}
          <i class="fas fa-chevron-down"></i>
        </button>

        <div class="dropdown-menu dropdown-dark">
          {% for une_section in nav_sections %}
            <a class="dropdown-item{% if route_courante in une_section.actives %} active{% endif %}" href="{{ path(une_section.route) }}">{{ une_section.label }}</a>
          {% endfor %}
        </div>
      </div>

      {% if avec_recherche %}
        <button
          class="search-toggle d-lg-none" type="button"
          data-toggle="collapse" data-target="#search-mobile" aria-controls="search-mobile" aria-expanded="false" aria-label="Ouvrir la recherche"
        >
          <i class="fas fa-magnifying-glass"></i>
        </button>
      {% endif %}

      <div class="navbar-collapse d-lg-flex {{ compact ? 'justify-content-lg-end' : 'justify-content-lg-between' }} align-items-lg-center w-100" id="navbarNav">

        <ul class="navbar-nav d-none{{ compact ? '' : ' d-lg-flex' }}">
          {% for une_section in nav_sections %}
            <li class="nav-item">
              <a  href="{{ path(une_section.route) }}"
                  class="nav-link{% if route_courante in une_section.actives %} active{% endif %}"
              >
                {{ une_section.label }}
              </a>
            </li>
          {% endfor %}
        </ul>

        {% if avec_recherche %}
          {{ include('parts/search-bar.html.twig', {variant: 'd-none d-lg-flex ml-auto mr-4'}) }}
        {% endif %}

        {% if app.user %}
          {% set main_character = main_character() %}
          <div id="user-zone" class="connected">

            <div class="user-infos">
              <strong>{{ app.user.pseudo }}</strong>

              {% if main_character %}
                <a class="main-character" href="{{ path('personnage_profil', {id: main_character.id}) }}">
                  <img class="img-24" src="{{ asset(image_small(main_character.clan ? main_character.clan.mon|default(NA_MON) : NA_MON)) }}" alt="Mon du clan" />
                  ({{ main_character.nomComplet }})
                </a>
              {% endif %}

              <a class="{% if route_courante starts with 'mon_compte' %}active{% endif %}" href="{{ path('mon_compte') }}">
                <i class="fas fa-torii-gate couleur-primaire"></i>
                &nbsp;&nbsp;
                MON COMPTE
              </a>

              <small>
                <a href="{{ path('app_logout') }}">Se Déconnecter</a>
              </small>
            </div>

            <a class="avatar-link hover-shine" href="{{ path('mon_compte') }}">
              {{ include('parts/avatar.html.twig', {user: app.user, character: true, size: compact ? 48 : 96}) }}
            </a>

          </div>
        {% else %}
          <div id="user-zone" class="disconnected">
            {% if compact %}
              <a href="#connexion" data-toggle="modal" role="button">Se connecter</a>
            {% else %}
              <button class="btn-primary-style btn-medium" data-toggle="modal" data-target="#connexion">Se connecter</button>
              <a class="mt-1" href="{{ path('app_register') }}">Créer un compte</a>
            {% endif %}
          </div>
        {% endif %}

        {% if control_panel and compact %}
          <a class="control-panel-bar icon {{ control_panel.variant }}" href="{{ path('back_office') }}" title="{{ control_panel.label }}" aria-label="{{ control_panel.label }}">
            <i class="fas {{ control_panel.icon }}"></i>
          </a>
        {% endif %}
      </div>
    </nav>

    {% if avec_recherche %}
      <div id="search-mobile" class="search-collapse collapse d-lg-none">
        {{ include('parts/search-bar.html.twig', {variant: 'mobile'}) }}
      </div>
    {% endif %}
  </div>
</header>
