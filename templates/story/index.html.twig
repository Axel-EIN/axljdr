{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{parent()}}
    <link rel="stylesheet" href="{{asset('css/pages/campaign.css')}}" />
    <link rel="stylesheet" href="{{asset('css/components/chapter.css')}}" />
    <link rel="stylesheet" href="{{asset('css/components/episode-card.css')}}" />
{% endblock %}
{% block title %}L'Aventure Saison {{ season.numero }} {{ parent() }}{% endblock %}
{% block body %}

<section class="saison-bar container-fluid" style="background-color: {{ season.couleur }}">
    <div class="container">
        {{ include('/parts/flash-messages.html.twig') }}
        <a class="btn-quaternary-style text-white50{{ previous_season is empty ? ' invisible' : '' }}"
           {% if previous_season is not empty %}href="{{ path('story_season', {id: previous_season.id}) }}" title="Voir saison précédente"{% endif %}>
            <span class="text-small"><i class="fa-solid fa-caret-left"></i><span class="d-none d-lg-inline"> Saison Précédente</span></span>
        </a>

        <h1 class="h1-saison">
            {% if next_season is empty %}
                SAISON {{ season.numero }} en cours
            {% else %}
                SAISON {{ season.numero }} - {{ season.titre|upper }}
            {% endif %}
        </h1>

        <a class="btn-quaternary-style text-white50{{ next_season is empty ? ' invisible' : '' }}"
           {% if next_season is not empty %}href="{{ path('story_season', {id: next_season.id}) }}" title="Voir saison suivante"{% endif %}>
            <span class="text-small"><span class="d-none d-lg-inline">Saison Suivante </span><i class="fa-solid fa-caret-right"></i></span>
        </a>
    </div>
</section>

<main class="relative">

    {% set color, entity, parent, parentID, redirect = 'text-white50', 'chapter', 'season', season.id, 'story' %}
    {% for chapter in season.chapitres|reverse %}
        {{ include('/story/chapter-detail.html.twig', {lazy: not loop.first}) }}
    {% else %}

        <section class="chapter-backdrop banner" style="--chapter-color: #400000">
            <img class="chapter-backdrop-image zoomed centered" src="{{ asset(NA_169) }}" alt="" />
            <div class="container">
                <div class="header header-chapter d-flex flex-column justify-content-end" >
                    <div class="alert alert-light mx-auto alert-persist mt-3 mb-3">
                        <strong>Désolé, il n'y a pas encore de Chapitre dans cette Saison.</strong>
                    </div>
                </div>
            </div>
        </section>

    {% endfor %}

</main>

{% endblock %}
