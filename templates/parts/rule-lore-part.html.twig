{% if attribute(un_element, 'part' ~ i ~ 'titre') is defined and attribute(un_element, 'part' ~ i ~ 'titre') is not empty %}
  <div id="part{{i}}" class="part-header">
    {% if app.user and is_granted("ROLE_MJ") %}
      {% set position, size, color, un_element, redirect, fragment = 'right-snap', 'btn-icon-medium', 'text-accent', un_element, entity, 'part' ~ i %}
      {{ include('/parts/btn-icon-edit.html.twig') }}
    {% endif %}

    <h2 class="heading-cardtitle">{{i}}. {{ attribute(un_element, 'part' ~ i ~ 'titre') }}</h2>
    <hr>
  </div>
{% endif %}

{% if attribute(un_element, 'part' ~ i) is defined and attribute(un_element, 'part' ~ i) is not empty %}
  <div class="part-body">
    {% if attribute(un_element, 'part' ~ i ~ 'aside') is defined and attribute(un_element, 'part' ~ i ~ 'aside') is not empty %}
      <aside class="aside">
        <p>{{ attribute(un_element, 'part' ~ i ~ 'aside')|raw|nl2br }}</p>
      </aside>
    {% endif %}
    <div class="card-description">{{ attribute(un_element, 'part' ~ i)|raw|nl2br }}</div>
  </div>

  {{ include('/parts/divider-ornament.html.twig') }}
{% endif %}
