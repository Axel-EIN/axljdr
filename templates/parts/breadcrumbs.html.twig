<nav class="breadcrumbs">
    <span class="text-muted">
        <a href="{{ path('news') }}"><i class="fas fa-home"></i></a>
        {% for item in items %}
            &nbsp;&gt;&nbsp;
            {% if not loop.last and item.path is defined %}
                <a href="{{ item.path }}"><span class="bold">{{ item.label }}</span></a>
            {% else %}
                <span class="bold">{{ item.label }}</span>
            {% endif %}
        {% endfor %}
    </span>
</nav>
