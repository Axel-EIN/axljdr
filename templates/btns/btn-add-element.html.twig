{% set path = 'admin_' ~ entity|lower ~ '_create' %}
{% set url = '?redirect=' ~ entity|lower ~ '&' ~ options|default('') %}
{% set variant = variant|default('btn-primary-style btn-medium') %}

{% if app.user and is_granted("ROLE_MJ") %}
    <a href="{{ path(path) }}{{url}}" class="{{ variant }} {{ position is defined ? position : 'topright-corner-snap' }}" >
        <i class="fas fa-plus-square" aria-hidden="true"></i><span class="btn-add-label">&nbsp;&nbsp;Ajouter {{label_one}}</span>
    </a>
{% endif %}