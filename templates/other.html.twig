{% extends 'base.html.twig' %}
{% block title %}{{ page_title }} {{ parent() }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{asset('css/components/element.css')}}" />
  <link rel="stylesheet" href="{{asset('css/components/other.css')}}" />
{% endblock %}

{% block body %}
  <main class="container-fluid element-page other-page">
    <div class="container">

      {{ include('parts/breadcrumbs.html.twig', {items: [{label: page_title}]}) }}
      {{ include('parts/flash-messages.html.twig') }}

      <section>
        <h1 class="heading-elementdetail"><strong>{{ page_title }}</strong></h1>
        <hr class="hr-title">

        <div class="row">
          {% block cards %}
            <div class="col-12">
              <div class="card card-page">
                {% block content %}{% endblock %}
              </div>
            </div>
          {% endblock %}
        </div>
      </section>
    </div>
  </main>
{% endblock %}
