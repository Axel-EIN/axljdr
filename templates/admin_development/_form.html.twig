<div class="col-12">
    {{ form_start(form) }}
        <div class="row form-wrapper">

            <div class="col-12 col-lg-6">{{ form_row(form.personnage) }}</div>
            <div class="col-12 col-lg-6">{{ form_row(form.participation) }}</div>
            <div class="col-12">{{ form_row(form.content) }}</div>

            {{ include('/btns/btn-form.html.twig') }}
        </div>
    {{ form_end(form) }}
</div>

<script>
(function () {
    const characterSelect = document.getElementById('admin_development_personnage');
    const sceneSelect = document.getElementById('admin_development_participation');
    if (!characterSelect || !sceneSelect) return;

    const allOptions = Array.from(sceneSelect.querySelectorAll('option')).map(option => ({
        option,
        chapter: option.parentElement.tagName === 'OPTGROUP' ? option.parentElement.label : null,
    }));

    function filterOptions() {
        const selected = sceneSelect.value;
        sceneSelect.innerHTML = '';

        let currentChapter = null;
        let group = null;

        allOptions
            .filter(({ option }) => !option.value || option.dataset.character === characterSelect.value)
            .forEach(({ option, chapter }) => {
                if (chapter === null) {
                    sceneSelect.add(option);
                    currentChapter = null;
                    return;
                }

                if (chapter !== currentChapter) {
                    group = document.createElement('optgroup');
                    group.label = chapter;
                    sceneSelect.add(group);
                    currentChapter = chapter;
                }

                group.appendChild(option);
            });

        sceneSelect.value = selected;
    }

    characterSelect.addEventListener('change', filterOptions);
    filterOptions();
})();
</script>
