<div class="col-12 col-sm-6 col-md-4 col-lg-3 hover-zoom episode-card-space">

  {% if app.user and is_granted("ROLE_MJ") %}
    {% set position, redirect, entity, un_element, size = 'right-corner-16', 'aventure', 'episode', un_episode, 'small' %}
    {{ include('/parts/btn-icon-edit.html.twig') }}
  {% endif %}


  {% if app.user %}
    {% for cumul in user_personnages_cumul_episodes %}
      {% if cumul[un_episode.id] is defined %}
        {% set joue = cumul[un_episode.id] %}
        <div class="character-box">
          {% if joue.estMort == 1 %}
            <strong class="text-dead">MORT</strong>
          {% elseif joue.xp != 0 %}
            <strong class="text-your-xp">+{{ joue.xp }}&nbsp;xp</strong>
          {% endif %}
          <a href="{{ path('personnage_profil', {id: joue.id}) }}">
            <img class="character-portrait medium outlined {% if joue.estMort == 1 %}dead{% elseif joue.xp == 0 %}grayscale{% else %}hover-shine{% endif %}"
              src="{{ asset(joue.icone) }}" alt="Icone de {{ joue.prenom }}" title="{{ joue.prenom }}" />
          </a>
        </div>
      {% endif %}
    {% endfor %}
  {% endif %}

  <a class="card-inner" href="{{ path('aventure_episode', {id:un_episode.id} ) }}">
    <span class="card-number"><span class="text-big">#</span>{{ un_episode.numeroSaison }}</span>
    <div class="image-container gradient-after-down">
      <img class="card-image" src="{{ asset(un_episode.image|default(NA_SESSION)) }}" alt="Image de la session {{un_episode.titre}}" title="{{un_episode.titre}}"  />
    </div>
    <div class="text-container">
      <span class="card-title-cartouche leading-0">{{ un_episode.titre }}</span>
      <p class="card-text">{{ un_episode.resume|default('Résumé à venir...') }}</p>
    </div>
    <button class="btn-primary-style btn-medium">
      <i class="fab fa-readme" aria-hidden="true"></i>&nbsp;&nbsp;Lire le résumé
    </button>
  </a>
</div>
