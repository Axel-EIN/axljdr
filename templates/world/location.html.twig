{% extends 'element.html.twig' %}

{% block stylesheets %}
  {{parent()}}
  <link rel="stylesheet" href="{{asset('css/components/history.css')}}" />
  <link rel="stylesheet" href="{{asset('css/components/map.css')}}" />
  <link rel="stylesheet" href="{{asset('css/components/image-viewer.css')}}" />
  <link rel="stylesheet" href="{{asset('css/pages/location.css')}}" />
{% endblock %}

{% block element_content %}

  <div class="col-12">
    <div class="card card-page">

      <div class="relative">

        <h2 class="nickname-container d-none d-lg-flex">
          <img class="img-96 mr-2 filter-shadow" src="{{ asset(record.icone|default(NA_LIEU_ICO)) }}" alt="Icone de {{record.nom}}">
          <i class="align-middle">{{ record.surnom|default('') }}</i>
        </h2>

        <div class="stats d-none d-lg-flex">
          {% if record.clan is defined and record.clan is not empty %}
            <a class="d-flex justify-content-end" href="{{ path('world_clan', {id:record.clan.id} ) }}" >
              <img class="mb-2 img-64 circle-crop" src="{{ asset(image_small(record.clan.mon|default(NA_MON))) }}" alt="Mon d'une faction" title="{{record.clan.nom|default('')}}" />
            </a>
          {% endif %}
          {% if record.type is defined and record.type is not empty %}<span>Type : <strong>{{ record.type }}</strong></span>{% endif %}
          {% if record.population is defined and record.population is not empty %}
            <span>Population : <strong>{{ record.population|number_format(0, ',', '.') }} habitants</strong></span>
          {% endif %}
        </div>

        {{ include('/parts/card-top-image.html.twig', {image: record.image, na_image: NA_LIEU, alt: 'Image de ' ~ record.nom, img_class: 'crop-169', title: name, classes: 'gradient-desktop', state: element_state(record)}) }}
      </div>

      <div class="location-mobile-info d-lg-none text-center">
        {% if record.surnom is defined and record.surnom is not empty %}
          <p class="location-nickname">{{ record.surnom }}</p>
        {% endif %}

        <div class="d-inline-flex justify-content-center align-items-center text-center">
          <img class="img-96 mr-5" src="{{ asset(record.icone|default(NA_LIEU_ICO)) }}" alt="Icone de {{record.nom}}" />

          <ul class="list-decored text-left">
            {% if record.clan is defined and record.clan is not empty %}
              <li>
                <span class="label">Clan :</span>
                <a class="extrabold" href="{{ path('world_clan', {id:record.clan.id} ) }}">
                  <img class="img-24" src="{{ asset(image_small(record.clan.mon|default(NA_MON))) }}" alt="" title="Mon du clan {{record.clan.nom}}" />
                  {{ record.clan.nom }}
                </a>
              </li>
            {% endif %}
            {% if record.type is defined and record.type is not empty %}
              <li><span class="label">Type :</span> {{ record.type }}</li>
            {% endif %}
            {% if record.population is defined and record.population is not empty %}
              <li><span class="label">Habitants :</span> {{ record.population|number_format(0, ',', '.') }}</li>
            {% endif %}
          </ul>

        </div>
      </div>

      {% if record.description is defined and record.description is not empty %}
        {{ include('parts/description.html.twig', {text: record.description, variant: 'aerated'}, with_context = false) }}
      {% endif %}

      {% set placed = record.placed %}
      {% set region_visible_mobile = record.regionDesc is not empty %}
      {% set plan_visible = record.planMap is not empty or record.planDesc is not empty %}

      {% if placed or region_visible_mobile %}
        {{ include('/parts/divider-ornament.html.twig', {classes: region_visible_mobile ? 'my-3' : 'my-3 d-none d-lg-flex'}) }}

        <h2 class="heading-elementpart decorated{% if not region_visible_mobile %} d-none d-lg-block{% endif %}">Carte</h2>

        {% if placed %}
          {{ include('parts/map.html.twig', {locations, current: record, zoom: record.zoom, draggable: true, labels_on: true, territories_on: true}, with_context = false) }}
        {% endif %}

        {% if record.regionDesc is not empty %}
          {{ include('parts/description.html.twig', {text: record.regionDesc, variant: 'aerated'}, with_context = false) }}
        {% endif %}
      {% endif %}

      {% if plan_visible %}
        {{ include('/parts/divider-ornament.html.twig') }}

        <h2 class="heading-elementpart decorated">Plan</h2>

        {% if record.planMap is not empty %}
          {{ include('parts/image-viewer.html.twig', {image: record.planMap, alt: 'Plan de ' ~ record.nom}, with_context = false) }}
        {% endif %}

        {% if record.planDesc is not empty %}
          {{ include('parts/description.html.twig', {text: record.planDesc, variant: 'aerated'}, with_context = false) }}
        {% endif %}
      {% endif %}

      {% if record.description is not empty or placed or region_visible_mobile or plan_visible %}
        {{ include('/parts/divider-ornament.html.twig') }}
        {% set ornament = true %}
      {% endif %}

      {% if is_gm() %}
        {% set redirect, element, record, color, action = 'world', 'location', record, 'link-gm', 'delete' %}
        {{ include('/btns/btn-line.html.twig', {classes: ornament is defined ? '' : 'mt-5'}) }}
      {% endif %}

    </div>
  </div>

  {% if history is defined and history|length > 0 %}
    <div class="col-12">
      <div class="card card-body">
        <h2 class="heading-cardtitle">Historique des visites</h2>
        <hr>
        <div class="card-text">
          {{ include('parts/history.html.twig', {history, current_season}) }}
        </div>
      </div>
    </div>
  {% endif %}

  {{ include('/parts/picture-grid.html.twig', {
      title: 'Lieux affiliés',
      catalog: true,
      variant: 'icon',
      items: other_locations, route: 'world_location',
      type_icon: true,
      na_image: NA_LIEU_ICO,
      per_row: {desktop: 6, mobile: 2},
  }) }}

{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('scripts/map.js') }}"></script>
  <script src="{{ asset('scripts/image-viewer.js') }}"></script>
{% endblock %}
