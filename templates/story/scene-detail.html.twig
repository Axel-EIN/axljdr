<article id="scn{{ scene.numero }}" class="relative mb-3">

    <div class="bg-black relative">

        {% if scene.temps == 'Aube' or scene.temps == 'Matinée' %}
            {% set TIME_ICO = MORNING %}
        {% elseif scene.temps == 'Midi' or scene.temps == 'Après-midi' or scene.temps == 'Journée' %}
            {% set TIME_ICO = NOON %}
        {% elseif scene.temps == 'Soirée' or scene.temps == 'Crépuscule' or scene.temps == 'Tombée de la nuit' %}
            {% set TIME_ICO = EVENING %}
        {% elseif scene.temps == 'Minuit' or scene.temps == 'Nuit' %}
            {% set TIME_ICO = NIGHT %}
        {% elseif scene.temps == 'Intemporel' %}
            {% set TIME_ICO = INTEMPOREL %}
        {% endif %}

        <div class="time-location-infos-container">
            <div class="time-and-location">
                <div class="location">
                    {% if scene.lieu is not empty %}
                        <a href="{{path('world_location', {id: scene.lieu.id} ) }}" >
                            <img src="{{asset(scene.lieu.icone|default(NA_LIEU_ICO))}}" alt="icône du lieu" />
                        </a>
                    {% endif %}
                </div>
                <div class="time" >
                    <img src="{{asset(TIME_ICO|default(NA_TIME))}}" alt="icône du temps" />
                </div>
            </div>
            <div class="infos">
                {% if scene.lieu is not empty %}
                    <span>{{ scene.lieu.nom }}</span>
                {% endif %}
                {{ scene.temps|default('Temps inconnu') }}
            </div>
        </div>

        <div class="characters-line pnjs">
            {% for participation in scene.participations|filter( (participation) => participation.estPj == 0) %}

                {% if participation.personnage.icone is null and participation.personnage.genre == 'F' %}
                    {% set gender_variable_sufix ='_F' %}
                {% elseif participation.personnage.icone is null and participation.personnage.genre == 'M' %}
                    {% set gender_variable_sufix = '_M' %}
                {% endif %}

                <div class="character-portrait-box">
                    <a class="character-portrait-link" href="{{path('characters_profile',{id: participation.personnage.id})}}" >
                        {% if participation.estMort == 1 %}
                            <img class="character-icon-dead" src="{{ asset(MORT_ICO) }}" alt="est mort" />
                        {% endif %}
                        <span class="hover-tooltip character-name pnj">
                            {{participation.personnage.prenom}}
                        </span>
                        <img class="character-portrait large pnj
                            {% if participation.estMort == 1 %}effect-dead{% endif %}"
                            src="{{ asset(participation.personnage.icone|default( attribute(_context, 'NA_PERSO_PORTRAIT' ~ gender_variable_sufix|default ) ) ) }}"
                            alt="Icone personnage" />
                    </a>
                </div>
            {% endfor %}
        </div>

        <div class="characters-line pjs">
            {% for participation in scene.participations|filter( (participation) => participation.estPj == 1)|sort( (a, b) => a.xpGagne <=> b.xpGagne)|reverse %}
                
                {% if participation.personnage.icone is null and participation.personnage.genre == 'F' %}
                    {% set gender_variable_sufix ='_F' %}
                {% elseif participation.personnage.icone is null and participation.personnage.genre == 'M' %}
                    {% set gender_variable_sufix = '_M' %}
                {% endif %}

                <div class="character-portrait-box">

                    {% if participation.xpGagne != 0 and participation.estMort != 1 %}
                        <div class="d-inline-block {{ participation.personnage.joueur == app.user ? 'text-your-xp' : 'text-xp' }}">
                            <strong class="text-medium">+{{participation.xpGagne}}</strong> <span class="text-small">XP</span>
                        </div><br/>
                    {% endif %}

                    <a class="character-portrait-link" href="{{path('characters_profile',{id:participation.personnage.id})}}" >
                        {% if participation.estMort == 1 %}<img class="character-icon-dead" src="{{ asset(MORT_ICO) }}" alt="est mort" />{% endif %}
                        <span class="hover-tooltip character-name pj {% if participation.personnage.joueur == app.user %}me{% endif %} {% if participation.xpGagne == 0 or participation.estMort == 1 %}gray{% endif %}">
                            {{participation.personnage.prenom}}
                        </span>
                        <img
                            class="character-portrait large pj 
                            {% if participation.personnage.joueur == app.user %} me outlined{% endif %}
                            {% if participation.estMort == 1 %}effect-dead{% elseif participation.xpGagne == 0 %}grayscale{% endif %}"
                            src="{{asset(participation.personnage.icone|default( attribute(_context, 'NA_PERSO_PORTRAIT' ~ gender_variable_sufix|default ) ) ) }}"
                            alt="Icone personnage" />
                    </a>
                </div>
            {% endfor %}
        </div>

        {% set scene_image = scene.image|default(NA_SCENE) %}
        {% set scene_srcset = image_srcset(scene_image) %}

        <div class="ratio-169 gradient-after-top-down">
            <img class="ratio-cropped" src="{{ asset(scene_image) }}"
                {% if scene_srcset %}
                    srcset="{{ scene_srcset }}"
                    sizes="(max-width: 991.98px) 100vw, 920px"
                {% endif %}
                {% if lazy ?? true %}loading="lazy"{% endif %}
                alt="Image d'une scène">
        </div>
        

    </div>

    <div class="scene-body relative mb-2">

        <div class="scene-title-container blur-cartouche">
            <img class="scene-icon" src="{{ asset(STORY_SCENE_ICO) }}" alt="Icône scène">
            <h2 class="heading-scene">{{ scene.titre }}</h2>
        </div>

        {{ include('parts/description.html.twig', {text: scene.texte, variant: 'compact'}, with_context = false) }}

    </div>


    {% if is_gm() %}
        {% set color, entity, record, redirect = 'link-gm', 'scene', scene, 'episode' %}
        <div class="d-flex justify-content-center">

            {% set action = 'edit' %}
            {{ include('/btns/btn-line.html.twig', {classes: 'mr-5'}) }}

            {% set action = 'delete' %}
            {{ include('/btns/btn-line.html.twig', {classes: 'ml-5'}) }}

        </div>
    {% endif %}

    {{ include('/parts/divider-ornament.html.twig', is_gm() ? {} : {classes: 'my-3 mt-lg-n4 mb-lg-5'}) }}

</article>
