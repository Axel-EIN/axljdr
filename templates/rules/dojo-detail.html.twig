{% extends 'element.html.twig' %}

{% block stylesheets %}
    {{parent()}}
    <link rel="stylesheet" href="{{asset('css/pages/dojo.css')}}" />
{% endblock %}

{% block element_content %}

    <div class="col-12">
        <div class="card card-page">

            <div class="relative">

                <a id="banner-icon-clan" class="hover-zoom" href="{{ path('world_clan', {id:dojo.clan.id} ) }}" >
                    <img class="img-96 filter-shadow" src="{{ asset(dojo.clan.mon|default(NA_MON)) }}" alt="Mon d'une faction" title="Voir la faction {{dojo.clan.nom}}" />
                </a>

                {{ include('/parts/card-top-image.html.twig', {
                    image: dojo.imageAffichee,
                    alt: "Image de l'École",
                    img_class: 'crop-169 top',
                    title: name,
                    classes: 'gradient-desktop',
                    state: element_state(dojo),
                }) }}

                <div id="text-zone">

                    <div>
                        <h2 class="heading-cardtitle">Trait bonus</h2>
                        {% set labels = {'constitution':'Constitution','volonte':'Volonté','reflexes':'Réflexes','intuition':'Intuition','agilite':'Agilité','intelligence':'Intelligence','forceStat':'Force','perception':'Perception','vide':'Vide'} %}
                        <span class="text-zone-blur text-xp text-big">{{ dojo.bonusStatNom ? (labels[dojo.bonusStatNom] ?? dojo.bonusStatNom) ~ ' +1' : '—' }}</span>
                    </div>

                    <div>
                        <h2 class="heading-cardtitle">Compétences</h2>
                        <ul class="text-zone-blur">{{ dojo.competences|list_items|raw }}</ul>
                    </div>

                    <div>
                        <h2 class="heading-cardtitle">Équipement</h2>
                        <ul class="text-zone-blur">{{ dojo.equipements|list_items|raw }}</ul>
                    </div>

                </div>

            </div>

            {{ include('parts/description.html.twig', {text: dojo.description, variant: 'aerated'}, with_context = false) }}

        </div>
    </div>

    <div class="col-12 col-lg-8 card-stack">

        <div class="card card-body">
            <h2 class="heading-cardtitle">Techniques</h2>
            <hr>

            {% for i in 1..5 %}
                {% if attribute(dojo, 'tech' ~ i ~ 'Nom') is not empty %}
                    <div class="technique" id="technique-{{ i }}">
                        <div class="tech-rank" style="color: {{ dojo.clan.couleur }}">
                            <strong>Rang</strong><br/>
                            <span class="number-skillrank-effect skill-rank-number">{{ i }}</span>
                        </div>
                        <div>
                            <h3 class="label-amerigo">{{ attribute(dojo, 'tech' ~ i ~ 'Nom') }}</h3>
                            <p class="text-justify text-regular">{{ attribute(dojo, 'tech' ~ i ~ 'Desc')|raw|nl2br }}</p>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}

            {% if dojo.techSpecialNom is not empty %}
                <div class="technique-special" id="technique-special">
                    <h3 class="label-amerigo">{{ dojo.techSpecialNom }}</h3>
                    <p>{{ dojo.techSpecialDesc|raw|nl2br }}</p>
                </div>
            {% endif %}

        </div>

        {% if dojo.sorts is defined and dojo.sorts is not empty %}
        <div class="card card-body">
            <h2 class="heading-cardtitle">Magie</h2>
            <hr>

            <div class="d-flex justify-content-around align-items-start">
                <div>
                    <h4>Affinité</h4>
                    <span class="text-stamp text-large">{{dojo.affinite}}</span>
                </div>
                <div>
                    <h4>Déficience</h4>
                    <span class="text-stamp text-large">{{dojo.deficience}}</span>
                </div>
                <div>
                    <h4>Sorts de départ</h4>
                    {{dojo.sorts|list_items|raw}}
                </div>
            </div>

        </div>
        {% endif %}

    </div>

    {{ include('/parts/picture-grid.html.twig', {
        variant: 'portrait',
        title: 'Personnages joueurs',
        items: player_characters, route: 'characters_profile', hide_dead: true,
        wrapper: 'col-12 col-lg-4',
        per_row: {desktop: 2, tablet: 4, mobile: 2},
        empty_message: "Il n'y a pas encore de personnages dans cette école.",
    }) }}

    {{ include('/parts/picture-grid.html.twig', {
        variant: 'rule',
        title: 'Autres Écoles',
        items: other_dojos, route: 'rules_dojo',
        na_image: NA_ECOLE,
    }) }}

{% endblock %}
