{% set size = size|default(96) %}
{% set principal = (character is defined ? character : false) ? user.mainCharacter : null %}

{% if principal %}
  <span class="avatar" style="--avatar-size: {{ size }}px">
    <img src="{{ asset(principal.icone|default(NA_PERSO_PORTRAIT)) }}"
         alt="Portrait de {{ principal.prenom }}" title="{{ principal.nom }} {{ principal.prenom }}" />
  </span>
{% elseif user.avatar %}
  <span class="avatar" style="--avatar-size: {{ size }}px">
    <img src="{{ asset(user.avatar) }}" alt="Avatar de {{ user.pseudo }}" title="{{ user.pseudo }}" />
  </span>
{% else %}
  <span class="avatar initial" style="--avatar-size: {{ size }}px" title="{{ user.pseudo }}">{{ user.pseudo|first|upper }}</span>
{% endif %}
