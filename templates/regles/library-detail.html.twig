{% extends 'element.html.twig' %}

{% block stylesheets %}
        {{parent()}}
        <link rel="stylesheet" href="{{asset('css/components/rule-lore-part.css')}}" />
        <link rel="stylesheet" href="{{asset('css/pages/library.css')}}" />
{% endblock %}

{% block element_content %}

    {% set accueil = app.request.get('tab') is not defined or app.request.get('tab') is empty %}
    {# Au pluriel les onglets qui nomment des choses denombrables, pas ceux qui
       qualifient (Magie, Mental...). Table des formes que le `s` par defaut manque. #}
    {% set pluriel_onglet = un_element.entity in ['avantage', 'competence', 'objet'] ? 's' : '' %}
    {% set pluriel_sous_onglet = un_element.entity == 'objet' ? 's' : '' %}
    {% set pluriels = {
        'BUGEI': 'Bugei', 'COUTEAU': 'Couteaux', 'DIVERS': 'Divers',
        'HAST': 'Hast', 'MARCHAND': 'Marchand', 'NINJUTSU': 'Ninjutsu',
    } %}

    {# On repart du premier sous-onglet des qu'on ne peut pas garder le courant :
       hors bibliotheque mixable, il n'a aucune raison d'exister sous le nouvel onglet. #}
    {% set a_sous_onglets = un_element.subTabField is defined and un_element.subTabField is not empty %}
    {% set subtab = a_sous_onglets and (app.request.get('subtab') is empty or un_element.mixable != true)
        ? 'first' : app.request.get('subtab') %}

    {% set onglets = [] %}
    {% for tab in tabs %}
        {% set onglets = onglets|merge([{
            label: pluriels[tab|upper]|default(tab|capitalize ~ pluriel_onglet),
            path: path('regles_library', {id: un_element.id, tab: tab, subtab: subtab}),
            actif: app.request.get('tab') == tab,
        }]) %}
    {% endfor %}

    {# Sur l'accueil le sommaire pose sur l'image remplace les onglets, mais lui
       n'existe qu'au-dessus de 992px : sous ce palier la barre reste seule a naviguer. #}
    <nav class="mb-3{% if accueil %} d-lg-none{% endif %}">
        <div class="col-12 p-0 m-0">
            <ul id="tabs">
                <li>
                    <a href="{{ path( 'regles_library', {id: un_element.id} ) }}"
                    class="tab {% if accueil %}active{% endif %}">
                            <i class="fa-solid fa-house" title="Lire l'introduction"></i>
                    </a>
                </li>
                {% for onglet in onglets %}
                    <li>
                        <a href="{{ onglet.path }}" class="tab {% if onglet.actif %}active{% endif %}">
                            {{ onglet.label|upper }}
                        </a>
                    </li>
                {% endfor %}

                {% if un_element.mixable is defined and un_element.mixable == true %}
                    <li>
                        <a href="{{ path('regles_library', {id: un_element.id, tab: 'all', subtab: subtab}) }}"
                            class="tab {% if app.request.get('tab') == 'all' %}active{% endif %}">
                            <i class="fa-solid fa-list" title="Voir tout"></i>
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>

        {% if app.request.get('tab') is defined and app.request.get('tab') is not empty and subtabs is defined and subtabs is not empty %}
            <div class="col-12 p-0 m-0 ml-4 mt-3 pl-2">
                <ul id="sub-tabs">
                    {% for subtab in subtabs %}
                        <li class="mt-auto mb-auto">
                            <a href="{{ path('regles_library', {id: un_element.id, 'tab' : app.request.get('tab'), 'subtab' : subtab } ) }}"
                                class="{% if app.request.get('subtab') is defined and app.request.get('subtab') == subtab %}active{% endif %}">
                                {% if app.request.get('tab') == 'MAGIE' %}
                                    {% if subtab == 'UNIVERSEL' %}
                                        {{subtab}}
                                    {% else %}
                                        <img class="img-48" src="/assets/icons/elements/{{subtab|lower}}.png" title='{{subtab}}' alt='Icône {{subtab}}' />
                                    {% endif %}
                                {% elseif app.request.get('tab') == 'MAHO' %}
                                    <img class="img-48" src="/assets/icons/elements/{{subtab|lower}}-maho.png" title='{{subtab}} Maho' alt='Icône {{subtab}} Maho' />
                                {% elseif app.request.get('tab') == 'KIHO' %}
                                    <img class="img-48" src="/assets/icons/elements/{{subtab|lower}}-kiho.png" title='{{subtab}} Kiho' alt='Icône {{subtab}} Kiho' />
                                {% else %}
                                    {{ pluriels[subtab|upper]|default(subtab|capitalize ~ pluriel_sous_onglet) }}
                                {% endif %}
                            </a>
                        </li>
                    {% endfor %}
                    {% if un_element.mixable is defined and un_element.mixable == true %}
                        <li>
                            <a href="{{ path('regles_library', {id: un_element.id, 'tab' : app.request.get('tab'), 'subtab' : 'all' } ) }}"
                            class="{% if app.request.get('subtab') is defined and app.request.get('subtab') == 'all' %}active{% endif %}">
                                    <i class="fa-solid fa-list" title="Voir tout"></i>
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        {% endif %}
    </nav>

    {% if accueil %}

        <div class="col-12">
            <div class="card card-page">

                <div class="relative">

                    {{ include('parts/sommaire.html.twig', {items: onglets}) }}

                    {{ include('/parts/card-top-image.html.twig', {
                        image: un_element.image,
                        na_image: NA_LIBRARY,
                        alt: 'Image de ' ~ nom,
                        pdf: un_element.pdf,
                        img_class: 'crop-169',
                        titre: nom,
                    }) }}
                </div>

                <div class="part-body">
                    {% if un_element.aside is defined and un_element.aside is not empty %}
                        <aside class="aside">
                            <p>{{ un_element.aside|raw|nl2br }}</p>
                        </aside>
                    {% endif %}

                    <div class="card-description">{{ un_element.description|raw|nl2br }}</div>
                </div>

                {{ include('/parts/divider-ornament.html.twig') }}

            </div>
        </div>

    {% else %}

        {% if (filters is defined and filters is not empty) or keywords is defined and keywords is not empty %}
            <div class="col-12 mt-3 library-row">

                <div class="col-12 col-md-4">
                    <label for="keyword-select">Filtrer par Mot Clés :</label>
                    <select name="filter" id="keyword-select" >
                        <option value="">TOUS</option>
                        {% for keyword in keywords %}
                            <option value={{keyword}} {% if app.request.get('keyword') == keyword %}selected{% endif %}>{{keyword}}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-12 col-md-4">
                    <label for="filter-select">Filtrer par {{un_element.filterField|capitalize}} :</label>
                    <select name="filter" id="filter-select" >
                        <option value="">TOUS</option>
                        {% for one_filter in filters %}
                            <option value={{one_filter}} {% if app.request.get('filter') == one_filter %}selected{% endif %}>{{one_filter}}</option>
                        {% endfor %}
                    </select>
                </div>


            </div>
        {% endif %}

        {% if subtabs is empty or subtabs is not empty and app.request.get('subtab') is defined and app.request.get('subtab') is not empty %}
            <div class="col-12 library-row">
                {{ include('regles/list-' ~ un_element.entity ~ '.html.twig') }}
            </div>
        {% endif %}

    {% endif %}

    {{ include('/parts/picture-grid.html.twig', {
        title: 'Autres Bibliothèques',
        items: otherLibraries, route: 'regles_library',
        na_image: NA_LIBRARY,
        ratio: '43',
    }) }}

{% endblock %}

{% block javascripts %}
    {{parent()}}
    <script src="{{ asset('scripts/library.js') }}"></script>
{% endblock %}