{% set location = location|default(null) %}
{% set character = character|default(null) %}
{% set present_characters = present_characters|default([]) %}
{% set element = location ?? character %}
{% set state = element_state(element) %}
{% set readable = element_readable(element) %}
{% set type = character ? character.classe.nom ?? null : location.type %}

{% if character and readable %}
  <img class="map-panel-banner portrait" src="{{ asset(character.illustration|default(NA_PERSO_ILLU)) }}" alt="Illustration de {{ character.nomComplet }}" />
{% elseif location and location.image %}
  <img class="map-panel-banner" src="{{ asset(image_small(location.image)) }}" alt="Image de {{ location.nom }}" />
{% endif %}

<div class="map-panel-body">
  <h2 class="map-panel-title">
    {{ character ? character.nomComplet : location.nom }}
    {{ include('parts/badge-access.html.twig', {state: state, variant: 'inline'}) }}
  </h2>

  {% if readable %}
    <div class="map-panel-details">
      {% if element.clan %}
        <img class="img-24" src="{{ asset(image_small(element.clan.mon|default(NA_MON))) }}" alt="" />
        <span>{{ element.clan.nom }}</span>
      {% endif %}
      {% if type %}<span>{{ type }}</span>{% endif %}
    </div>

    {% if element.description %}
      <p class="map-panel-description">{{ element.description|striptags|raw }}</p>
    {% endif %}
  {% endif %}

  {% if present_characters is not empty %}
    <div>
      <h3 class="map-panel-heading">Personnages présents</h3>
      <div class="map-panel-party">
        {% for present_character in present_characters %}
          <a href="{{ path('characters_profile', {id: present_character.id}) }}" title="{{ present_character.nomComplet }}">
            <img src="{{ asset(present_character.icone|default(NA_PERSO_PORTRAIT)) }}" alt="Portrait de {{ present_character.prenom }}" />
          </a>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if history is not empty %}
    <div>
      <h3 class="map-panel-heading">Dernières scènes</h3>
      <ul class="map-panel-history">
        {% for entry in history %}
          {% set last_scene = entry.lines|first.scene %}
          <li>
            <a href="{{ path('story_episode', {id: entry.episode.id, '_fragment': 'scn' ~ last_scene.numero}) }}">
              <span class="text-muted">#{{ entry.episode.numeroSaison }}</span>
              {{ last_scene.titre }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  {% if readable %}
    {% if character %}
      <a class="btn-primary-style btn-medium text-center" href="{{ path('characters_profile', {id: character.id}) }}">Voir le profil</a>
    {% else %}
      <a class="btn-primary-style btn-medium text-center" href="{{ path('world_location', {id: location.id}) }}">Ouvrir la fiche</a>
    {% endif %}
  {% endif %}
</div>
