<div class="episodes-line">
  <span class="text-light">Il y a <strong class="text-accent-light">{{ episode.chapitreParent.episodes|length }} ÉPISODES</strong> dans ce chapitre.</span>
  <div class="episodes-carousel mt-2 d-none d-lg-flex">
    {% for listed_episode in episode.chapitreParent.episodes %}
      {% if listed_episode.scenes|length > 0 or is_gm() %}
        <div class="vignette-episode {% if listed_episode.id == episode.id %}active{% endif %}">
          <span class="title">{{listed_episode.titre}}</span>
          <div class="ratio-169">
            <a class="{% if listed_episode.id == episode.id %}link-disabled{% endif %}" href="{{ path('story_episode', { id : listed_episode.id, '_fragment': 'read-head' } ) }}" >
              <img class="ratio-cropped" src="{{ asset(image_small(listed_episode.image|default(NA_SESSION))) }}" loading="lazy" alt="image d'une session" />
            </a>
          </div>
          {% if listed_episode.id == episode.id %}<i class="absolute arrow-down fa-sharp fa-solid fa-sort-down fa-2xl text-primary"></i>{% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <div class="dropdown d-lg-none mt-2">
    <a  class="banner-nav-toggle chevron-toggle text-white py-2 px-3 d-inline-flex align-items-center"
        style="background-color: {{ episode.chapitreParent.couleur }}"
        data-toggle="dropdown" href="#" role="button"
        aria-expanded="false" aria-label="Choisir un autre épisode">
      <strong>#{{ episode.numeroSaison }} {{ episode.titre }}</strong>
      <i class="fas fa-chevron-down ml-2"></i>
    </a>
    <div class="dropdown-menu dropdown-dark">
      {% for listed_episode in episode.chapitreParent.episodes %}
        {% if listed_episode.id != episode.id and (listed_episode.scenes|length > 0 or is_gm()) %}
          <a class="dropdown-item" href="{{ path('story_episode', { id: listed_episode.id, '_fragment': 'read-head' } ) }}">
            #{{ listed_episode.numeroSaison }} {{ listed_episode.titre }}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
