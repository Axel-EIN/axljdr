{% extends 'element.html.twig' %}

{% block stylesheets %}
    {{parent()}}
    <link rel="stylesheet" href="{{asset('css/components/banner-intro.css')}}" />
{% endblock %}

{% block element_content %}

    {{ include('rules/class-banner.html.twig', {character_class, classes}) }}

    {{ include('/parts/picture-grid.html.twig', {
        title: 'Écoles de ' ~ character_class.nom,
        variant: 'rule',
        items: class_dojos, route: 'rules_dojo',
        na_image: NA_ECOLE,
        per_row: {desktop: 4, mobile: 2},
        wrapper: 'col-12 col-lg-8',
        empty_message: "Il n'y a pas encore d'école disponible pour cette classe.",
    }) }}

    {{ include('/parts/picture-grid.html.twig', {
        variant: 'portrait',
        title: 'Personnages joueurs',
        items: player_characters, route: 'characters_profile', hide_dead: true,
        limit: 16,
        wrapper: 'col-12 col-lg-4',
        per_row: {desktop: 2, tablet: 4, mobile: 2},
        empty_message: "Il n'y a pas encore de personnages disponibles pour cette classe.",
    }) }}

    {{ include('/parts/picture-grid.html.twig', {
        title: 'Autres Classes',
        variant: 'emblem',
        items: classes|filter(other => other.id != character_class.id), route: 'rules_class',
        na_image: NA_CLASS_ICO, field: 'icone',
        per_row: {desktop: 6, mobile: 3},
    }) }}

{% endblock %}
