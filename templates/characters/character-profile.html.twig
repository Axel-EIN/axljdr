{% extends 'element.html.twig' %}

{% block stylesheets %}
    {{parent()}}
    <link rel="stylesheet" href="{{asset('css/components/history.css')}}" />
    <link rel="stylesheet" href="{{asset('css/components/edit-mode.css')}}" />
    <link rel="stylesheet" href="{{asset('css/components/map.css')}}" />
    <link rel="stylesheet" href="{{asset('css/pages/character-profile.css')}}" />
{% endblock %}

{% block element_content %}

{% if character.illustration is null and character.genre == 'F' %}
    {% set NA_PERSO_ILLU = NA_PERSO_ILLU_F %}
{% elseif character.illustration is null and character.genre == 'M' %}
    {% set NA_PERSO_ILLU = NA_PERSO_ILLU_M %}
{% endif %}

{% set illustration_src = asset(character.illustration|default(NA_PERSO_ILLU)) %}
{% set illustration_preset = image_preset('vertical450') %}

<div class="col-12 d-lg-none order-0 relative">
    <div class="profile-banner-mobile">
        <img src="{{ illustration_src }}" alt="{{ character.nomComplet }}" title="{{ character.nomComplet }}" />
    </div>
    {{ include('parts/badge-access.html.twig', {state: element_state(character)}) }}
</div>

{# ============================= #}
{# ===== [CARD] LEFT INFOS ===== #}
{# ============================= #}

<div class="col-12 col-lg-4 order-2 order-lg-1">
    <div class="card card-body profile-infos">

        {% set sheet_visible = character.fichePersonnage is not null and (is_own_character or is_gm()) %}
        {% set sheet_addable = character.fichePersonnage is null and is_gm() %}

        <div class="relative">
            <div class="profile-illustration d-none d-lg-block {{ sheet_visible or sheet_addable ? 'with-btn' }}">
                <img class="img-fluid w-100" src="{{ illustration_src }}" width="{{ illustration_preset.width }}" height="{{ illustration_preset.height }}" alt="{{ character.nomComplet }}" title="{{ character.nomComplet }}" />
                {{ include('parts/badge-access.html.twig', {state: element_state(character)}) }}
            </div>

            {% if sheet_visible or sheet_addable %}
                <div class="profile-btn-sheet">
                    {% if sheet_visible %}
                        <a class="btn-primary-style btn-medium{% if not is_own_character %} gm{% endif %}" href="{{ path('characters_sheet', {id: character.fichePersonnage.id}) }}">
                            <i class="fas fa-scroll"></i> Voir la Fiche de Jeu
                        </a>
                    {% else %}
                        {{ include('btns/btn-add-element.html.twig', {
                            entity: 'sheet', label_one: 'Fiche Personnage', options: 'character=' ~ character.id, position: ''
                        }) }}
                    {% endif %}

                    {% if is_gm() %}
                        <a class="btn-primary-style btn-medium gm" href="{{ path('characters_profile_markdown', {id: character.id}) }}">
                            <i class="fa-solid fa-square-binary"></i> Export Infos .md
                        </a>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        <ul class="list-group list-group-flush profile-infos-list">

        {% if xp > 0 %}
            <li class="list-group-item infos-item profile-xp-and-rank">
                <span class="badge-rank-{{rank}} large">RANG {{rank}}</span>
                <span class="xp-number">{{xp}} XP</span>
            </li>
        {% endif %}

        {% if character.clan is defined and character.clan is not empty %}
            <li class="list-group-item infos-item">
                Clan :
                <a href="{{ path('world_clan', {id: character.clan.id} ) }}">
                    {{ character.clan.nom }}
                    <img class="img-48" src="{{ asset(image_small(character.clan.mon|default(NA_MON))) }}" alt="Mon du Clan {{character.clan.nom}}" title="Mon du Clan {{character.clan.nom}}" />
                </a>
            </li>
        {% endif %}

        {% if character.famille is defined and character.famille is not empty %}
            <li class="list-group-item infos-item">
                Famille :
                <a href="{{ path('world_clan', {id: character.clan.id, '_fragment': character.famille.nom } ) }}">
                    {{ character.famille.nom }}
                    <img
                    class="img-48 rounded-circle" src="{{ asset(image_small(character.famille.mon|default(NA_MON))) }}"
                    alt="Mon de la Famille {{character.famille.nom}}" title="Mon de la Famille {{character.famille.nom}}"
                    />
                </a>
            </li>
        {% endif %}

        {% if character.ecole is defined and character.ecole is not empty %}
            <li class="list-group-item infos-item">
                École :
                <a href="{{ path('rules_dojo', {id: character.ecole.id} ) }}">
                    {{ character.ecole.nom }}
                    <img class="img-48" src="{{ asset(image_small(character.classe.icone|default(NA_CLASS_ICO))) }}" alt="Classe {{character.classe.nom}}" title="Classe {{character.classe.nom}}" />
                </a>
            </li>
        {% endif %}

      {% if character.joueur is not empty %}
        <li class="list-group-item infos-item">Joueur : <span class="bold">{{ character.joueur.pseudo }}</span></li>
      {% endif %}

      {% if free_position or current_position %}
        <li class="list-group-item infos-item{% if map_visible %} with-map{% endif %}">
          Position :
          <a href="{{ known_position ? path('map', {location: current_position.id}) : path('map') }}" title="Voir sur la carte">
            {{ free_position ? EN_DEPLACEMENT : (known_position ? current_position.nom : 'Inconnue') }}
            <i class="fa-solid fa-map-location-dot"></i>
          </a>
          {% if map_visible %}
            {{ include('parts/map.html.twig', {
              locations,
              current: known_position ? current_position : null,
              party: known_position ? {(current_position.id): [character]} : {},
              center: free_position,
              wanderers: free_position ? [free_position] : [],
              zoom: known_position ? current_position.zoom : null,
              variant: 'mini',
              hide_minimap: true,
            }, with_context = false) }}
          {% endif %}
        </li>
      {% endif %}
    </ul>

  </div>
</div>

{# ======================= #}
{# ===== [CARD] MAIN ===== #}
{# ======================= #}

<div class="col-12 col-lg-8 order-1 order-lg-2">
    <div class="card card-body">

        {% if can_edit %}
        {{ form_start(form, {action: path('characters_profile_edit', {id: character.id})}) }}
        {% endif %}

        <div class="profile-maincontent profile-zone">

            {# ================================ #}
            {# ===== [CARD-SECTION] STORY ===== #}
            {# ================================ #}

            <h2 class="profile-description-title">Histoire</h2>

            {% if character.titres is defined and character.titres is not empty %}
                <h4 class="card-title-cartouche">{{ character.titres }}</h4>
            {% endif %}

            <p class="text-description text-compact read-only">{{ character.description|default('')|raw|nl2br }}</p>

            {% if can_edit %}
                {{ form_widget(form.description, {attr: {class: 'edit-only'}}) }}
                {{ include('/btns/btn-interactive-edit-actions.html.twig', {label: 'Éditer'}) }}
            {% endif %}

            {# ========================================= #}
            {# ===== [CARD-SECTION] DEVELOPPEMENTS ===== #}
            {# ========================================= #}

            <div class="profile-developments">
                {% for development in developments %}
                    {% set scene = development.scene %}
                    {% set episode = scene.episodeParent %}
                    {% set chapter = episode.chapitreParent %}
                    {% set scene_url = path('story_episode', {id: episode.id, '_fragment': 'scn' ~ scene.numero}) %}

                    <article class="development-line">
                        <div class="development-head">
                            <span class="development-title">
                                <a href="{{ scene_url }}">
                                    <img class="img-18 invert mr-1 align-middle" src="{{ asset(STORY_EPISODE_ICO) }}" alt="" />
                                    <strong>{{ scene.titre }}</strong>
                                </a>
                                {% if is_gm() %}
                                    {{ include('/btns/btn-icon-edit.html.twig', {
                                    entity: 'development', record: development, position: 'align-middle',
                                    redirect: 'development', size: 'btn-icon-mini', color: 'link-gm',
                                    }) }}
                                {% endif %}
                            </span>

                            <span class="development-meta">{{ chapter.titre }} — EP #{{ episode.numeroSaison }} - Scène {{ scene.numero }}</span>
                            {% if development.estMort %}
                                <strong class="text-dead">MORT</strong>
                            {% endif %}
                        </div>

                        <div class="development-content">
                            <p class="text-description text-compact">{{ development.content|raw|nl2br }}</p>
                            <a class="development-image" href="{{ scene_url }}" title="Voir la scène {{ scene.numero }}">
                                <img src="{{ asset(image_small(scene.image|default(NA_SCENE))) }}" loading="lazy" alt="Scène {{ scene.numero }} — {{ scene.titre }}" />
                            </a>
                        </div>
                    </article>
                {% endfor %}

                <div class="action-zone">
                    {{ include('/btns/btn-add-element.html.twig', {
                        entity: 'development', label_one: 'développement',
                        position: '', options: 'character=' ~ character.id,
                        variant: 'btn-quaternary-style link-gm',
                    }) }}
                </div>
            </div>

            {% if can_edit %}

                {# ================================================ #}
                {# ===== [CARD-SECTION] SECRET PLAYER'S NOTES ===== #}
                {# ================================================ #}

                <div class="profile-zone">
                    {{ include('/parts/divider-ornament.html.twig') }}
                    <h2 class="profile-description-title">Secrets</h2>

                    {% if character.playerNotes is not empty %}
                        <p class="text-description text-compact read-only">{{ character.playerNotes|nl2br }}</p>
                    {% else %}
                        <p class="profile-description-na">Rien pour le moment.</p>
                    {% endif %}

                    {{ form_widget(form.playerNotes, {attr: {class: 'edit-only'}}) }}
                    {{ include('/btns/btn-interactive-edit-actions.html.twig', {label: 'Éditer'}) }}
                </div>


                {% if is_gm() %}
                    {# ===================================== #}
                    {# ===== [CARD-SECTION] GM's NOTES ===== #}
                    {# ===================================== #}

                    <div class="profile-zone">
                        {{ include('/parts/divider-ornament.html.twig') }}
                        <h2 class="profile-description-title gm">Notes du Maître de Jeu</h2>

                        {% if character.gmNotes is not empty %}
                            <p class="text-description text-compact read-only">{{ character.gmNotes|nl2br }}</p>
                        {% else %}
                            <p class="profile-description-na">Rien pour le moment.</p>
                        {% endif %}

                        {{ form_widget(form.gmNotes, {attr: {class: 'edit-only'}}) }}
                        {{ include('/btns/btn-interactive-edit-actions.html.twig', {label: 'Éditer'}) }}
                    </div>
                {% endif %}

                {{ form_end(form) }}
            {% endif %}

        </div>
    </div>
</div>

{# ========================== #}
{# ===== [CARD] HISTORY ===== #}
{# ========================== #}

<div class="col-12 col-lg-8 order-3">
    <div class="card card-body">
        <h2 class="heading-cardtitle">Historique</h2>
        <hr>
        <div class="card-text profile-history">
            {{ include('parts/history.html.twig', {history, current_season}) }}
            {% if creation_xp > 0 %}
            <p class="profile-creation">Création du personnage {{ character.prenom }} avec <strong>{{ creation_xp }}xp</strong>.</p>
            {% endif %}
        </div>
    </div>
</div>

{# =================================== #}
{# ===== [CARD] OTHER CHARACTERS ===== #}
{# =================================== #}

{{ include('/parts/picture-grid.html.twig', {
    variant: 'portrait',
    title: character.estPj ? 'Autres PJs' : 'Autres PNJs',
    items: other_characters, route: 'characters_profile', hide_dead: true,
    limit: 12,
    wrapper: 'col-12 col-lg-4 order-4',
    per_row: {desktop: 2, tablet: 4, mobile: 2},
    empty_message: "Il n'y a pas d'autres personnage.",
}) }}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if map_visible %}<script src="{{ asset('scripts/map.js') }}"></script>{% endif %}
    {% if can_edit %}
        <script>
            (function () {
            const bindEditMode = (selector, action) => document.querySelectorAll(selector).forEach(
                btn => btn.addEventListener('click', () => btn.closest('.profile-zone').classList[action]('edit-mode'))
            );
            bindEditMode('[data-edit-open]', 'add');
            bindEditMode('[data-edit-cancel]', 'remove');
            })();
        </script>
    {% endif %}
{% endblock %}
