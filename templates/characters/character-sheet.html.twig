{% extends 'element.html.twig' %}

{% macro stat_mod(id, value, unit) %}
  <div class="stat-mod edit-only">
    <label for="mod-input-{{ id }}">Modificateur ({{ unit }})</label>
    {% if unit == 'XgY' %}
      <input type="text" id="mod-input-{{ id }}" class="form-control form-control-sm" value="{{ value }}" placeholder="ex: 1g0" pattern="\d+g\d+" />
    {% else %}
      <input type="number" id="mod-input-{{ id }}" class="form-control form-control-sm" value="{{ value }}" />
    {% endif %}
  </div>
{% endmacro %}
{% import _self as sheet_macros %}

{% block stylesheets %}
  {{parent()}}
  <link rel="stylesheet" href="{{asset('css/components/spell.css')}}" />
  <link rel="stylesheet" href="{{asset('css/components/edit-mode.css')}}" />
  <link rel="stylesheet" href="{{asset('css/pages/character-sheet.css')}}" />
{% endblock %}

{% set character_class_id = sheet.personnage.classe ? sheet.personnage.classe.id : 0 %}
{% set advantage_items = {av1: sheet.avantage1, av2: sheet.avantage2, dv1: sheet.desavantage1, dv2: sheet.desavantage2} %}

{% set initiative_mod = sheet.initiativeModifier ?? 0 %}
{% set wound_levels = constant('App\\Entity\\FichePersonnage::NIVEAUX_BLESSURE') %}
{% set healthy_hp_per_earth = constant('App\\Entity\\FichePersonnage::PV_INDEMNE_PAR_TERRE') %}
{% set wounded_hp_per_earth = constant('App\\Entity\\FichePersonnage::PV_BLESSURE_PAR_TERRE') %}
{% set attack_rolled_mod, attack_kept_mod = 0, 0 %}
{% if sheet.attaqueModifier %}
  {% set attack_mod_split = sheet.attaqueModifier|split('g') %}
  {% set attack_rolled_mod = attack_mod_split[0]|default(0) %}
  {% set attack_kept_mod = attack_mod_split[1]|default(0) %}
{% endif %}
{% set damage_rolled_mod, damage_kept_mod = 0, 0 %}
{% if sheet.dmgModifier %}
  {% set damage_mod_split = sheet.dmgModifier|split('g') %}
  {% set damage_rolled_mod = damage_mod_split[0]|default(0) %}
  {% set damage_kept_mod = damage_mod_split[1]|default(0) %}
{% endif %}

{% block element_content %}

{% set family_bonus_name = (sheet.personnage.famille is not empty) ? sheet.personnage.famille.bonusStatNom : null %}
{% set dojo_bonus_name   = (sheet.personnage.ecole is not empty) ? sheet.personnage.ecole.bonusStatNom : null %}

{% set constitution_bonus_count = sheet.bonusAttribut('constitution') %}
{% set willpower_bonus_count = sheet.bonusAttribut('volonte') %}
{% set reflexes_bonus_count = sheet.bonusAttribut('reflexes') %}
{% set intuition_bonus_count = sheet.bonusAttribut('intuition') %}
{% set agility_bonus_count = sheet.bonusAttribut('agilite') %}
{% set intelligence_bonus_count = sheet.bonusAttribut('intelligence') %}
{% set strength_bonus_count = sheet.bonusAttribut('forceStat') %}
{% set perception_bonus_count = sheet.bonusAttribut('perception') %}
{% set void_bonus_count = sheet.bonusAttribut('vide') %}

{% set eff_constitution = sheet.attributEffectif('constitution') %}
{% set eff_willpower = sheet.attributEffectif('volonte') %}
{% set eff_reflexes = sheet.attributEffectif('reflexes') %}
{% set eff_intuition = sheet.attributEffectif('intuition') %}
{% set eff_agility = sheet.attributEffectif('agilite') %}
{% set eff_intelligence = sheet.attributEffectif('intelligence') %}
{% set eff_strength = sheet.attributEffectif('forceStat') %}
{% set eff_perception = sheet.attributEffectif('perception') %}
{% set eff_void = sheet.attributEffectif('vide') %}

<div class="col-12">
  <div id="character-sheet" class="card card-page text-grayslate">

  <div class="row">

    <div class="col-12 col-lg-8">

      <div class="row mb-2 mb-lg-4">
        <div class="col-12 col-lg-6">
          <ul>
            {% set trait_labels = {
              constitution: 'Constitution', volonte: 'Volonté', reflexes: 'Réflèxes',
              intuition: 'Intuition', agilite: 'Agilité', intelligence: 'Intelligence',
              forceStat: 'Force', perception: 'Perception', vide: 'Vide'
            } %}
            <li>
              <span class="label">Clan :</span>
              {% if sheet.personnage.clan %}
                <a class="extrabold" href="{{ path('world_clan', {id: sheet.personnage.clan.id}) }}">
                  <img  class="img-24" src="{{ asset(image_small(sheet.personnage.clan.mon|default(NA_MON))) }}"
                        title="Mon du clan {{ sheet.personnage.clan.nom }}" />
                  {{ sheet.personnage.clan.nom }}
                </a>
              {% else %}
                Aucun
              {% endif %}
            </li>
            <li>
              <span class="label">Famille :</span>
              {% if sheet.personnage.famille %}
                <a class="extrabold" href="{{ path('world_clan', {id: sheet.personnage.clan.id, '_fragment': sheet.personnage.famille.nom}) }}">
                  <img  class="img-24 rounded-circle" src="{{ asset(image_small(sheet.personnage.famille.mon|default(NA_MON))) }}"
                        title="Mon de la famille {{ sheet.personnage.famille.nom }}" />
                  {{ sheet.personnage.famille.nom }}
                </a>
                {% if family_bonus_name %}
                  <small class="text-success ml-1">+1 {{ trait_labels[family_bonus_name] ?? family_bonus_name }}</small>{% endif %}
              {% else %}
                Aucun
              {% endif %}
            </li>
            <li class="sheet-class-line">
              <span class="label">Classe :</span>
              {% if sheet.personnage.classe %}
                <a class="extrabold" href="{{ path('rules_class', {id: sheet.personnage.classe.id}) }}">
                  <img  class="img-24" src="{{ asset(image_small(sheet.personnage.classe.icone|default(NA_MON))) }}"
                        title="Mon de la classe {{ sheet.personnage.classe.nom }}" />
                  {{ sheet.personnage.classe.nom }}
                </a>
              {% else %}
                Aucun
              {% endif %}
            </li>
            <li>
              <span class="label">Ecole :</span>
              {% if sheet.personnage.classe %}
                <a class="d-lg-none" href="{{ path('rules_class', {id: sheet.personnage.classe.id}) }}"
                   title="Classe {{ sheet.personnage.classe.nom }}">
                  <img class="img-24" src="{{ asset(image_small(sheet.personnage.classe.icone|default(NA_MON))) }}" alt="" />
                </a>
              {% endif %}
              {% if sheet.personnage.ecole %}
                <a class="extrabold" href="{{ path('rules_dojo', {id: sheet.personnage.ecole.id}) }}">
                  {{ sheet.personnage.ecole.nom }}
                </a>
                {% if dojo_bonus_name %}
                  <small class="text-success ml-1">+1 {{ (trait_labels[dojo_bonus_name] ?? dojo_bonus_name)|u.truncate(8, '…') }}</small>
                {% endif %}
              {% else %}
                Aucun
              {% endif %}
            </li>
          </ul>
        </div>
        <div class="col-12 col-lg-6">
          <ul>
            <li>
              <span class="label">Rang Général :</span>
              <span class="ml-auto badge-rank-{{rank}}">RANG {{rank}}</span>
            </li>

            {% if is_own_character or is_gm() %}

              <li>
                <span class="label">Expérience :</span>
                <strong><span class="xp-total-value">{{ xp.total }}</span>xp</strong>
                &nbsp;
                <small>
                  (
                  {{ xp.creation }}
                  {% if xp.disadvantages > 0 %}
                    + <span class="xp-disadvantages-value text-success">{{ xp.disadvantages }}</span>
                  {% endif %}
                  + {{ xp.progression }}
                  )
                </small>
              </li>
              <li>
                <span class="label">Dépensés :</span>
                <strong><span class="xp-spent-value">{{ xp.spent }}</span>xp</strong>
                &nbsp;
                <small>
                  (
                  <span class="xp-traits-value">
                    {% if xp.advantages > 0 %}
                      <span class="xp-advantages-value text-danger">{{ xp.advantages }} +</span>
                    {% endif %}
                    {{ xp.traits }}
                  </span>
                  +
                  <span class="xp-skills-value">{{ xp.skills }}</span>
                  )
                </small>
              </li>
              <li>
                <span class="label">Restants :</span>
                <strong><span class="xp-remaining text-success">{{ xp.remaining }}xp</span></strong>
              </li>
            {% endif %}

          </ul>
        </div>
      </div>

      <hr class="my-2 d-none d-lg-block">

      <div class="row mt-4 d-none d-lg-flex">
        <div class="col-12 rings-board"
             style="--mon-clan: url('{{ asset(sheet.personnage.clan.mon|default(NA_MON)) }}');">

          {% for i in 1..3 %}
            <img class="rings-glow" src="{{ asset(sheet.personnage.classe.icone|default(NA_MON)) }}" />
          {% endfor %}

          <div class="row text-center">
            <div class="col-2"></div>

            <div class="col-4 flex-col align-items-center">
              <div class="flex align-items-start">
                <span class="ring-rank" data-ring="terre">
                  {{ min(eff_constitution, eff_willpower) }}
                </span>
                <img src="{{FLAT_TERRE}}" class="ml-3 img-72" />
              </div>

              <div class="align-self-start">
                <span
                  class="trait-rank
                    {% if eff_constitution > eff_willpower %} text-strong {% endif %}"
                  data-trait-eff="constitution" data-base="{{ sheet.constitution }}"
                  data-bonus="{{ constitution_bonus_count }}" data-multiplier="4"
                >
                  <span class="eff-display">{{ eff_constitution }}</span>
                </span>
                &nbsp;
                Constitution
                {% if constitution_bonus_count > 0 %}
                  <small class="text-success extrabold">+{{ constitution_bonus_count }}</small>
                {% endif %}
                {% if is_own_character or is_gm() %}
                  <span class="text-alternate edit-only" data-cost-for="constitution">
                    {% if xp.trait.constitution > 0 %}-{{ xp.trait.constitution }}xp{% endif %}
                  </span>
                {% endif %}
              </div>
              
              <div class="align-self-start">
                <span
                  class="trait-rank
                    {% if eff_willpower > eff_constitution %} text-strong {% endif %}"
                  data-trait-eff="volonte" data-base="{{ sheet.volonte }}"
                  data-bonus="{{ willpower_bonus_count }}" data-multiplier="4"
                >
                  <span class="eff-display">{{ eff_willpower }}</span>
                </span>
                &nbsp;
                Volonté
                {% if willpower_bonus_count > 0 %}
                  <small class="text-success extrabold">+{{ willpower_bonus_count }}</small>
                {% endif %}
                {% if is_own_character or is_gm() %}
                  <span class="text-alternate edit-only" data-cost-for="volonte">
                    {% if xp.trait.volonte > 0 %}-{{ xp.trait.volonte }}xp{% endif %}
                  </span>
                {% endif %}
              </div>
            </div>

            <div class="col-4 flex-col align-items-center">
              <div class="flex align-items-start">
                <img src="{{FLAT_AIR}}" class="img-72 mr-3" />
                <span class="ring-rank" data-ring="air">
                  {{ min(eff_reflexes, eff_intuition) }}
                </span>
              </div>

              <div class="align-self-end">
                {% if is_own_character or is_gm() %}
                  <span class="text-alternate edit-only" data-cost-for="reflexes">
                    {% if xp.trait.reflexes > 0 %}-{{ xp.trait.reflexes }}xp{% endif %}
                  </span>
                {% endif %}
                Réflèxes
                {% if reflexes_bonus_count > 0 %}
                  <small class="text-success extrabold">+{{ reflexes_bonus_count }}</small>
                {% endif %}
                &nbsp;
                <span
                  class="trait-rank
                    {% if eff_reflexes > eff_intuition %} text-strong {% endif %}"
                  data-trait-eff="reflexes" data-base="{{ sheet.reflexes }}"
                  data-bonus="{{ reflexes_bonus_count }}" data-multiplier="4"
                >
                  <span class="eff-display">{{ eff_reflexes }}</span>
                </span>
              </div>

              <div class="align-self-end">
                {% if is_own_character or is_gm() %}
                  <span class="text-alternate edit-only" data-cost-for="intuition">
                    {% if xp.trait.intuition > 0 %}-{{ xp.trait.intuition }}xp{% endif %}
                  </span>
                {% endif %}
                Intuition
                {% if intuition_bonus_count > 0 %}
                  <small class="text-success extrabold">+{{ intuition_bonus_count }}</small>
                {% endif %}
                &nbsp;
                <span
                  class="trait-rank
                    {% if eff_intuition > eff_reflexes %} text-strong {% endif %}"
                  data-trait-eff="intuition" data-base="{{ sheet.intuition }}"
                  data-bonus="{{ intuition_bonus_count }}" data-multiplier="4"
                >
                  <span class="eff-display">{{ eff_intuition }}</span>
                </span>
              </div>
            </div>

            <div class="col-2"></div>
          </div>

          <div class="row text-center mt-3">

            <div class="col-1"></div>

            <div class="col-4 flex-col align-items-center">
              <div class="flex align-items-center">
                <span class="ring-rank" data-ring="eau">
                  {{ min(eff_strength, eff_perception) }}
                </span>
                <img src="{{FLAT_EAU}}" class="img-72 ml-3" />
              </div>

              <div class="align-self-start">
                <span
                  class="trait-rank
                    {% if eff_strength > eff_perception %} text-strong {% endif %}"
                  data-trait-eff="forceStat" data-base="{{ sheet.forceStat }}"
                  data-bonus="{{ strength_bonus_count }}" data-multiplier="4"
                >
                  <span class="eff-display">{{ eff_strength }}</span>
                </span>
                &nbsp;
                Force
                {% if strength_bonus_count > 0 %}
                  <small class="text-success extrabold">+{{ strength_bonus_count }}</small>
                {% endif %}
                {% if is_own_character or is_gm() %}
                  <span class="text-alternate edit-only" data-cost-for="forceStat">
                    {% if xp.trait.forceStat > 0 %}-{{ xp.trait.forceStat }}xp{% endif %}
                  </span>
                {% endif %}
              </div>

              <div class="align-self-start">
                <span
                  class="trait-rank
                    {% if eff_perception > eff_strength %} text-strong {% endif %}"
                  data-trait-eff="perception" data-base="{{ sheet.perception }}"
                  data-bonus="{{ perception_bonus_count }}" data-multiplier="4"
                >
                  <span class="eff-display">{{ eff_perception }}</span>
                </span>
                &nbsp;
                Perception
                {% if perception_bonus_count > 0 %}
                  <small class="text-success extrabold">+{{ perception_bonus_count }}</small>
                {% endif %}
                {% if is_own_character or is_gm() %}
                  <span class="text-alternate edit-only" data-cost-for="perception">
                    {% if xp.trait.perception > 0 %}-{{ xp.trait.perception }}xp{% endif %}
                  </span>
                {% endif %}
              </div>
            </div>

            <div class="col-2 m-0 p-0">
              {% if is_own_character or is_gm() %}
                <div class="flex-col p-1 bg-strong text-fade text-small rounded-8 edit-only">
                  <div class="label-amerigo">Exp.</div>
                  <div class="flex w-100 justify-content-between {% if xp.disadvantages == 0 %}d-none{% endif %}" id="xp-disadvantages-row">
                    Désavantages
                    <span id="xp-disadvantages-total" class="text-success">+{{ xp.disadvantages }}xp</span>
                  </div>
                  <div class="flex w-100 justify-content-between {% if xp.advantages == 0 %}d-none{% endif %}" id="xp-advantages-row">
                    Avantages
                    <span id="xp-advantages-total" class="text-danger">-{{ xp.advantages }}xp</span>
                  </div>
                  <div class="flex w-100 justify-content-between">
                    Traits
                    <span id="xp-traits-total">-{{ xp.traits }}xp</span>
                  </div>
                  <div class="flex w-100 justify-content-between">
                    Compétences
                    <span id="xp-skills-total">-{{ xp.skills }}xp</span>
                  </div>
                  <div class="flex w-100 justify-content-between extrabold">
                    Restants
                    <span class="xp-remaining text-success">{{ xp.remaining }}xp</span>
                  </div>
                </div>
              {% endif %}
            </div>

            <div class="col-4 flex-col align-items-center">
              <div class="flex align-items-center">
                <img src="{{FLAT_FEU}}" class="img-72 mr-2" />
                <span class="ring-rank" data-ring="feu">
                  {{ min(eff_agility, eff_intelligence) }}
                </span>
              </div>

              <div class="align-self-end">
                {% if is_own_character or is_gm() %}
                  <span class="text-alternate edit-only" data-cost-for="agilite">
                    {% if xp.trait.agilite > 0 %}-{{ xp.trait.agilite }}xp{% endif %}
                  </span>
                {% endif %}
                Agilité
                {% if agility_bonus_count > 0 %}
                  <small class="text-success extrabold">+{{ agility_bonus_count }}</small>
                {% endif %}
                &nbsp;
                <span
                  class="trait-rank
                    {% if eff_agility > eff_intelligence %} text-strong {% endif %}"
                  data-trait-eff="agilite" data-base="{{ sheet.agilite }}"
                  data-bonus="{{ agility_bonus_count }}" data-multiplier="4"
                >
                  <span class="eff-display">{{ eff_agility }}</span>
                </span>
              </div>

              <div class="align-self-end">
                {% if is_own_character or is_gm() %}
                  <span class="text-alternate edit-only" data-cost-for="intelligence">
                    {% if xp.trait.intelligence > 0 %}-{{ xp.trait.intelligence }}xp{% endif %}
                  </span>
                {% endif %}
                Intelligence
                {% if intelligence_bonus_count > 0 %}
                  <small class="text-success extrabold">+{{ intelligence_bonus_count }}</small>
                {% endif %}
                &nbsp;
                <span
                  class="trait-rank
                    {% if eff_intelligence > eff_agility %} text-strong {% endif %}"
                  data-trait-eff="intelligence" data-base="{{ sheet.intelligence }}"
                  data-bonus="{{ intelligence_bonus_count }}" data-multiplier="4"
                >
                  <span class="eff-display">{{ eff_intelligence }}</span>
                </span>
              </div>
            </div>

            <div class="col-1"></div>
          </div>

          <div class="row text-center">

            <div class="col-4"></div>

            <div class="col-4 flex-col align-items-center">
              <div class="flex align-items-center">
                <img class="img-72 ml-5 mr-3" src="{{FLAT_VIDE}}"/>
                <span class="ring-rank"
                  data-trait-eff="vide" data-base="{{ sheet.vide }}"
                  data-bonus="{{ void_bonus_count }}" data-multiplier="6"
                >
                  <span class="eff-display">{{ eff_void }}</span>
                </span>
              </div>
              <div class="flex align-items-center">
                {% if is_own_character or is_gm() %}
                  <span class="text-alternate edit-only" data-cost-for="vide">
                    {% if xp.trait.vide > 0 %}-{{ xp.trait.vide }}xp{% endif %}
                  </span>
                  &nbsp;
                {% endif %}
                <span class="h6 m-0 mb-0 mt-2 ml-2 mr-2">Vide</span>
                &nbsp;
                {% if void_bonus_count > 0 %}
                  <small class="text-success extrabold">+{{ void_bonus_count }}</small>
                {% endif %}
              </div>
            </div>

            <div class="col-4"></div>
          </div>

        </div>

        {% if is_own_character or is_gm() %}
          <div class="my-4 d-flex w-100 justify-content-center align-items-center">
            <button type="button" id="btn-sheet-edit" class="btn-primary-style btn-large{% if not is_own_character %} gm{% endif %}">
              <i class="fas fa-edit"></i> {{ is_own_character ? 'Éditer ma fiche' : 'Éditer la fiche' }}
            </button>
            <button type="button" id="btn-sheet-cancel" class="btn btn-secondary btn-sm ml-3" style="display:none;">
              <i class="fas fa-times"></i> Annuler
            </button>
            <button type="button" id="btn-sheet-save" class="btn btn-success btn-sm ml-3" style="display:none;">
              <i class="fas fa-check"></i> Valider
            </button>
            <a class="btn-icon-medium primary{% if not is_own_character %} gm{% endif %} ml-3" href="{{ path('characters_sheet_pdf', {id: sheet.id}) }}">
              <i class="fas fa-print" title="Imprimer la fiche en PDF"></i>
            </a>
          </div>
        {% endif %}

      </div>

    </div>

    {% set mobile_rings = [
      { name: 'Terre', icon: FLAT_TERRE, rank: min(eff_constitution, eff_willpower), traits: [
        { name: 'Constitution', val: eff_constitution, bonus: constitution_bonus_count },
        { name: 'Volonté',      val: eff_willpower,      bonus: willpower_bonus_count }
      ] },
      { name: 'Air', icon: FLAT_AIR, rank: min(eff_reflexes, eff_intuition), traits: [
        { name: 'Réflèxes',  val: eff_reflexes,  bonus: reflexes_bonus_count },
        { name: 'Intuition', val: eff_intuition, bonus: intuition_bonus_count }
      ] },
      { name: 'Eau', icon: FLAT_EAU, rank: min(eff_strength, eff_perception), traits: [
        { name: 'Force',      val: eff_strength,  bonus: strength_bonus_count },
        { name: 'Perception', val: eff_perception, bonus: perception_bonus_count }
      ] },
      { name: 'Feu', icon: FLAT_FEU, rank: min(eff_agility, eff_intelligence), traits: [
        { name: 'Agilité',      val: eff_agility,      bonus: agility_bonus_count },
        { name: 'Intelligence', val: eff_intelligence, bonus: intelligence_bonus_count }
      ] },
      { name: 'Vide', icon: FLAT_VIDE, rank: eff_void, traits: [] }
    ] %}
    <div class="illu-col col-12 col-lg-4 order-first order-lg-last">
      <div class="sheet-illu-wrap">
        {% set illustration_preset = image_preset('vertical450') %}
        <img class="sheet-illu img-fluid rounded-8 d-block mx-auto" src="{{ asset(sheet.personnage.illustration|default(NA_PERSO_ILLU)) }}" width="{{ illustration_preset.width }}" height="{{ illustration_preset.height }}" />

        <div class="sheet-traits d-lg-none">
          {% for mobile_ring in mobile_rings %}
            <div{% if mobile_ring.traits is empty %} class="sheet-ring-solo"{% endif %}>
              <div class="sheet-ring-line">
                <img class="sheet-ring-icon" src="{{ mobile_ring.icon }}" alt="" />
                <span class="text-plus extrabold">{{ mobile_ring.name }}</span>
                <strong class="sheet-ring-rank text-plus">{{ mobile_ring.rank }}</strong>
              </div>
              {% for trait in mobile_ring.traits %}
                <div class="sheet-trait-line">
                  <span>{{ trait.name }}</span>
                  {% if trait.bonus > 0 %}<small class="text-success">+{{ trait.bonus }}</small>{% endif %}
                  <strong class="sheet-trait-value">{{ trait.val }}</strong>
                </div>
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </div>

      <ul class="sheet-standings">
        {% for field in ['honneur', 'gloire', 'infamie', 'statut'] %}
          {% set value = attribute(sheet, field) %}
          <li>
            <span class="label">{{ field|capitalize }}</span>
            <strong class="read-only">{{ value is null ? '—' : value|number_format(1, '.', '') }}</strong>
            <input type="number" min="0" max="10" step="0.1" id="standing-input-{{ field }}"
                   class="form-control form-control-sm edit-only" value="{{ value }}" />
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="row block-row">

    <section class="col-12 col-lg-8">

      {% if is_own_character or is_gm() %}
        <div class="card card-block">

          <div class="card-title-cartouche d-flex align-items-center">
            Avantages & Désavantages
            <small class="ml-auto text-lowercase text-danger">
              <i class="fas fa-eye mr-1"></i>
              visible uniquement par le joueur ou le MJ
            </small>
          </div>

          <div class="row p-3">

            {% for kind, advantage_group in {
              advantage: {title: 'Avantages', slots: ['av1', 'av2'], sign: '-', color: 'text-danger'},
              disadvantage: {title: 'Désavantages', slots: ['dv1', 'dv2'], sign: '+', color: 'text-success'},
            } %}
              <div class="col-12 col-lg-6">
                <h6>{{ advantage_group.title }}</h6>
                <ul class="list-decored flex-col gap-4 ml-2">
                  {% for slot in advantage_group.slots %}
                    {% set item = advantage_items[slot] %}
                    <li data-advantage-slot="{{ slot }}" data-advantage-kind="{{ kind }}"
                        data-advantage-id="{{ item ? item.id : 0 }}"
                        {% if not item %}class="advantage-row-empty"{% endif %}
                    >
                      {% set advantage_text = item ? (item.summary ?: item.description|striptags) : '' %}
                      <div>
                        <span data-advantage-name class="text-strong extrabold">
                          {% if item %}<a href="{{ element_url(item) }}">{{ item.nom }}</a>{% endif %}
                        </span>
                      </div>
                      <div class="text-clamp-2 text-small text-body-c" data-advantage-summary
                           {% if item and not item.summary %}data-toggle="tooltip" title="{{ advantage_text }}"{% endif %}>
                        {{ advantage_text }}
                      </div>
                      <span class="edit-only {{ advantage_group.color }} text-small ml-2" data-advantage-cost>
                        {% if item %}{{ advantage_group.sign }}{{ xp.slots[slot] }}xp
                          {% if xp.slots[slot] != item.cout %}
                            (promo)
                          {% endif %}
                        {% endif %}
                      </span>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endfor %}

          </div>
        </div>
      {% endif %}

      <div class="card card-body card-block">
        <table class="table m-0 p-0" id="skill-table">
          <thead>
            <tr class="card-title-cartouche p-0 py-2">
              <th class="text-mini font-regular font-barlow text-center text-lowercase px-1" style='width: 24px;' scope="col">
                Comp. École
              </th>
              <th class="px-0 py-2 font-regular" scope="col">
                Compétences
                <span class="skill-legend text-reddanger"><i class="skill-degrading fa-solid fa-arrow-down-wide-short" aria-hidden="true"></i>compétence dégradante</span>
              </th>
              <th class="px-1 py-2 text-small font-barlow semi-visible text-center" scope="col">Rang</th>
              <th class="px-1 py-2 text-small font-barlow semi-visible text-center d-none d-lg-table-cell" scope="col">Trait</th>
              <th class="skill-cap px-1 py-2 text-small font-barlow semi-visible text-center" scope="col">Capacité R3</th>
              <th class="skill-cap px-1 py-2 text-small font-barlow semi-visible text-center" scope="col">Capacité R6</th>
              <th class="px-0 py-2 text-small semi-visible edit-only" scope="col">Coût XP</th>
            </tr>
          </thead>
          <tbody>
            {% set filled_slots = [] %}
            {% set empty_slots = [] %}
            {% for i in 1..20 %}
              {% set skill = attribute(sheet, 'competence' ~ i) %}
              {% set val  = attribute(sheet, 'valeur' ~ i) %}
              {% set specs = attribute(sheet, 'specialisations' ~ i) %}
              {% set dojo_skill = attribute(sheet, 'compEcole' ~ i)|default(0) %}
              {% set dojo_spec  = attribute(sheet, 'speEcole'  ~ i)|default('') %}
              {% set slot = {i: i, skill: skill, val: val, specs: specs, dojo_skill: dojo_skill, dojo_spec: dojo_spec} %}
              {% if skill is empty %}
                {% set empty_slots = empty_slots|merge([slot]) %}
              {% else %}
                {% set filled_slots = filled_slots|merge([slot]) %}
              {% endif %}
            {% endfor %}

            {% for slot in filled_slots|sort((a, b) =>
                [a.dojo_skill > 0 ? 0 : 1, a.skill.nom|u.ascii|lower]
                <=> [b.dojo_skill > 0 ? 0 : 1, b.skill.nom|u.ascii|lower]
            ) %}
                {% set spec_bitmask = slot.specs|default('') %}
                {% set dojo_spec_bitmask   = slot.dojo_spec|default('') %}
                {% set bought_specs = [] %}
                {% for k in 1..6 %}
                  {% set spec_label = attribute(slot.skill, 'specialisation' ~ k) %}
                  {% set spec_bit = (spec_bitmask|length >= k) ? spec_bitmask|slice(k - 1, 1) : '0' %}
                  {% if spec_label and spec_bit == '1' %}
                    {% set bought_specs = bought_specs|merge([spec_label]) %}
                  {% endif %}
                {% endfor %}
                {% set cost_slot = xp.skill[slot.i] %}
                <tr
                  class="p-0" data-skill-row="{{ slot.i }}" data-skill-id="{{ slot.skill.id }}"
                  data-skill-val="{{ slot.val ?? 0 }}" data-skill-specs="{{ spec_bitmask }}"
                  data-skill-dojo="{{ slot.dojo_skill ?? 0 }}" data-skill-dojo-spec="{{ dojo_spec_bitmask }}"
                >
                  <td class="text-center" data-skill-dojo-cell>
                    {% if slot.dojo_skill > 0 %}
                      <img src="{{ asset(image_small(sheet.personnage.ecole.clan.mon)) }}" class="img-24" title="Compétence de l'École {{ sheet.personnage.ecole.nom }}" />
                    {% else %}
                      <span class="d-inline-flex icon-20 rounded-circle border-base">&nbsp;</span>
                    {% endif %}
                  </td>
                  <th class="text-strong extrabold" scope="row" data-skill-name>
                    <a href="{{ element_url(slot.skill) }}"><strong>{{ slot.skill.nom }}</strong></a>
                    {% if slot.skill.degradante %}<i class="skill-degrading after fa-solid fa-arrow-down-wide-short" title="Compétence dégradante"></i>{% endif %}
                  </th>
                  <td class="text-strong extrabold text-center" data-skill-val-cell>{{ slot.val ?? '' }}</td>
                  <td class="text-body-c text-mini text-center d-none d-lg-table-cell" title="{{ slot.skill.trait }}" data-skill-trait-cell>{{ slot.skill.traitCourt }}</td>
                  {% for rank_cap, cap_text in {3: slot.skill.mastery3Text, 6: slot.skill.mastery6Text} %}
                    {% set cap_long = not attribute(slot.skill, 'mastery' ~ rank_cap ~ 'Summary') %}
                    <td class="skill-cap text-mini text-body-c text-center" rowspan="2">
                      {% if slot.val >= rank_cap %}
                        <span class="text-clamp-2"{% if cap_long %} data-toggle="tooltip" title="{{ cap_text|striptags }}"{% endif %}>{{ cap_text|striptags }}</span>
                      {% endif %}
                    </td>
                  {% endfor %}
                  <td class="edit-only text-alternate" data-skill-cost-cell>{% if cost_slot.rank > 0 %}-{{ cost_slot.rank }}xp{% endif %}</td>
                </tr>
                <tr data-skill-specs-row="{{ slot.i }}" class="skill-specs-row">
                  <td></td>
                  <td colspan="3" data-skill-specs-cell>
                    {% if bought_specs|length > 0 %}
                      <small class="text-body-c">
                        <span class="text-alternate">Spé. :</span>
                        {% for bought_spec in bought_specs %}
                          <span{% if 'dégradante' in bought_spec|lower %} class="text-reddanger extrabold"{% endif %}>{{ bought_spec }}</span>{% if not loop.last %}, {% endif %}
                        {% endfor %}
                      </small>
                    {% endif %}
                  </td>
                  <td class="edit-only text-alternate" data-skill-specs-cost-cell>
                    {% if cost_slot.specialisations > 0 %}
                      <small>-{{ cost_slot.specialisations }}xp (spé)</small>
                    {% endif %}
                  </td>
                </tr>
            {% endfor %}

            {% for slot in empty_slots %}
              <tr data-skill-row="{{ slot.i }}" data-skill-id="0" data-skill-val="0" data-skill-specs="" data-skill-dojo="0" data-skill-dojo-spec="" class="skill-row-empty">
                <td class="text-center" data-skill-dojo-cell></td>
                <th class="text-strong extrabold" scope="row" data-skill-name></th>
                <td class="text-strong extrabold text-center" data-skill-val-cell></td>
                <td class="text-body-c text-mini text-center d-none d-lg-table-cell" data-skill-trait-cell></td>
                <td class="skill-cap" rowspan="2"></td>
                <td class="skill-cap" rowspan="2"></td>
                <td class="edit-only text-alternate" data-skill-cost-cell></td>
              </tr>
              <tr data-skill-specs-row="{{ slot.i }}" class="skill-specs-row skill-row-empty">
                <td></td>
                <td class="text-body-c" colspan="3" data-skill-specs-cell></td>
                <td class="edit-only text-alternate" data-skill-specs-cost-cell></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% set dojo = sheet.personnage.ecole %}
      {% set class_name = sheet.personnage.classe ? sheet.personnage.classe.nom : '' %}

      {% if dojo %}
        {% set techniques = [] %}
        {% if class_name in ['Shugenja', 'Moine'] and dojo.techSpecialNom is not empty %}
          {% set techniques = [{
            rank: null, anchor: 'technique-special', name: dojo.techSpecialNom,
            summary: dojo.techSpecialSummary, description: dojo.techSpecialDesc|striptags
          }] %}
        {% endif %}
        {% for i in 1..rank %}
          {% if attribute(dojo, 'tech' ~ i ~ 'Nom') is not empty %}
            {% set techniques = techniques|merge([{
              rank: i, anchor: 'technique-' ~ i, name: attribute(dojo, 'tech' ~ i ~ 'Nom'),
              summary: attribute(dojo, 'tech' ~ i ~ 'Summary'), description: attribute(dojo, 'tech' ~ i ~ 'Desc')|striptags
            }]) %}
          {% endif %}
        {% endfor %}

        <div class="card card-block">
          <div class="card-title-cartouche">Techniques d'École</div>

          <ul class="technique-list">
            {% for technique in techniques %}
              <li>
                <span class="number-skillrank-effect">
                  {% if technique.rank %}{{ technique.rank }}{% else %}<i class="fa-solid fa-star text-small" title="Technique spéciale"></i>{% endif %}
                </span>
                <div>
                  <strong class="text-strong extrabold"><a href="{{ element_url(dojo) }}#{{ technique.anchor }}">{{ technique.name }}</a></strong>
                  <p class="text-small text-body-c{% if not technique.summary %} text-clamp-2{% endif %}"
                     {% if not technique.summary %}data-toggle="tooltip" title="{{ technique.description }}"{% endif %}>
                    {{ technique.summary ?: technique.description }}
                  </p>
                </div>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% set spells_by_ring = {} %}
      {% set kihos_by_ring = {} %}
      {% set tattoos = sheet.knownSpells|filter(s => s.categorie == 'TATOUAGE')|sort((a, b) => a.nom|u.ascii|lower <=> b.nom|u.ascii|lower) %}
      {% for spell in sheet.knownSpells|filter(s => s.categorie != 'TATOUAGE') %}
        {% if spell.categorie == 'KIHO' %}
          {% set kihos_by_ring = kihos_by_ring|merge({ (spell.anneau): (kihos_by_ring[spell.anneau] ?? [])|merge([spell]) }) %}
        {% else %}
          {% set spells_by_ring = spells_by_ring|merge({ (spell.anneau): (spells_by_ring[spell.anneau] ?? [])|merge([spell]) }) %}
        {% endif %}
      {% endfor %}

    {# ====================================== #}
    {# ===== [CARD-BLOC-SECTION] SPELLS ===== #}
    {# ====================================== #}

      {% if class_name == 'Shugenja' or spells_by_ring is not empty %}

        {% set rings = {TERRE: FLAT_TERRE, AIR: FLAT_AIR, FEU: FLAT_FEU, EAU: FLAT_EAU} %}
        {% set is_ishiken = (sheet.avantage1 and sheet.avantage1.nom == 'Ishiken-Do')
                          or (sheet.avantage2 and sheet.avantage2.nom == 'Ishiken-Do') %}
        {% if is_ishiken %}
          {% set rings = rings|merge({VIDE: FLAT_VIDE}) %}
        {% endif %}

        <div class="card card-block">

          <div class="card-title-cartouche">Magie</div>

          <div class="row no-gutters magic-header">

            <div class="col-6 col-lg-3">
              <h6>Affinité</h6>
              <strong class="text-{{ dojo.affinite|upper }} text-uppercase">{{ dojo.affinite|default('—') }}</strong>
            </div>

            <div class="col-6 col-lg-3">
              <h6>Déficience</h6>
              <strong class="text-{{ dojo.deficience|upper }} text-uppercase">{{ dojo.deficience|default('—') }}</strong>
            </div>

            <div class="col-6 col-lg-3">
              <h6>Technique de l'École</h6>
              {% if dojo and dojo.techSpecialNom is not empty %}
                <a  class="spell-link extrabold" role="button" tabindex="0"
                    data-toggle="popover" data-html="true" data-trigger="focus"
                    data-container="body" data-placement="top"
                    title="{{ dojo.techSpecialNom }}"
                    data-content="{{ dojo.techSpecialDesc|raw|nl2br|e('html_attr') }}">
                  {{ dojo.techSpecialNom }}
                </a>
              {% else %}
                —
              {% endif %}
            </div>

            <div class="col-6 col-lg-3">
              <h6>Sorts universels</h6>
              <ul class="spell-list" data-spell-list="UNIVERSEL">
                {% for spell in spells_by_ring['UNIVERSEL']|default([]) %}
                  {{ include('/characters/character-sheet-spell-line.html.twig', {spell: spell}) }}
                {% endfor %}
              </ul>
              <div class="spell-add edit-only" data-spell-add="UNIVERSEL"></div>
            </div>

          </div>

          <div class="row no-gutters magic-rings">
            {% for ring, icon in rings %}
              <div class="col-6 col-lg knownspells-column">
                <h6 class="element-header text-{{ ring }}-lighten bg-{{ ring }}-darken extrabold">
                  <img class="img-24" src="{{ asset(icon) }}" />{{ ring|lower|capitalize }}
                </h6>
                <ul class="spell-list" data-spell-list="{{ ring }}">
                  {% for spell in spells_by_ring[ring]|default([]) %}
                    {{ include('/characters/character-sheet-spell-line.html.twig', {spell: spell}) }}
                  {% endfor %}
                </ul>
                <div class="spell-add edit-only" data-spell-add="{{ ring }}"></div>
              </div>
            {% endfor %}
          </div>

        </div>

      {% endif %}

        {# ===================================== #}
        {# ===== [CARD-BLOC-SECTION] KIHOS ===== #}
        {# ===================================== #}

      {% if class_name == 'Moine' or kihos_by_ring is not empty %}

        <div class="card card-block">

          <div class="card-title-cartouche">Kihos</div>

          <div class="row no-gutters magic-rings">
            {% for ring, icon in {TERRE: FLAT_TERRE, AIR: FLAT_AIR, FEU: FLAT_FEU, EAU: FLAT_EAU, VIDE: FLAT_VIDE} %}
              <div class="col-6 col-lg knownspells-column">
                <h6 class="element-header text-{{ ring }}-lighten bg-{{ ring }}-darken extrabold">
                  <img class="img-24" src="{{ asset(icon) }}" />{{ ring|lower|capitalize }}
                </h6>
                <ul class="spell-list" data-spell-list="KIHO_{{ ring }}">
                  {% for kiho in kihos_by_ring[ring]|default([]) %}
                    {{ include('/characters/character-sheet-spell-line.html.twig', {spell: kiho}) }}
                  {% endfor %}
                </ul>
                <div class="spell-add edit-only" data-spell-add="KIHO_{{ ring }}"></div>
              </div>
            {% endfor %}
          </div>

        </div>

      {% endif %}

      {% if dojo and dojo.hasTattoos %}
        <div class="card card-block">
          <div class="card-title-cartouche">Tatouages</div>

          {% set tattoo_emblem = dojo.clan.mon|default(NA_MON) %}
          <div class="tattoo-board">
            <ul class="spell-list" data-spell-list="TATOUAGE" data-spell-emblem="{{ asset(tattoo_emblem) }}">
              {% for tattoo in tattoos %}
                {{ include('/characters/character-sheet-spell-line.html.twig', {spell: tattoo, emblem: tattoo_emblem}) }}
              {% else %}
                <li class="spell-empty read-only">Aucun tatouage.</li>
              {% endfor %}
            </ul>
            <div class="spell-add edit-only" data-spell-add="TATOUAGE"></div>
          </div>
        </div>
      {% endif %}

      {% if is_own_character or is_gm() %}
        {% set report = {
          sex: {label: 'Sexe', value: sheet.personnage.genre == 'F' ? 'Femme' : (sheet.personnage.genre == 'M' ? 'Homme' : '')},
          age: {label: 'Age', value: sheet.age},
          height: {label: 'Taille', value: sheet.height},
          weight: {label: 'Poids', value: sheet.weight},
          hair: {label: 'Cheveux', value: sheet.hair},
          eyes: {label: 'Yeux', value: sheet.eyes}
        } %}
        <div class="card card-block">
          <div class="card-title-cartouche">Apparence</div>

          <ul class="appearance-board">
            {% for field, entry in report %}
              <li>
                <span class="label">{{ entry.label }}</span>
                <strong class="read-only">{{ entry.value ?: '—' }}</strong>
                {% if field != 'sex' %}
                  <input type="{{ field == 'age' ? 'number' : 'text' }}" {% if field == 'age' %}min="0"{% endif %}
                         id="look-input-{{ field }}" class="form-control form-control-sm edit-only"
                         value="{{ entry.value }}" />
                {% endif %}
              </li>
            {% endfor %}
          </ul>

          <div class="appearance-text">
            <p class="read-only">{{ sheet.appearance ?: 'Aucune description.' }}</p>
            <textarea id="look-input-appearance" rows="2"
                      class="form-control form-control-sm edit-only">{{ sheet.appearance }}</textarea>
          </div>
        </div>

        <div class="card card-block">
          <div class="card-title-cartouche">Notes de Jeu</div>

          <div class="appearance-text">
            <p class="read-only">{{ sheet.notes ? sheet.notes|nl2br : 'Aucune note.' }}</p>
            <textarea id="look-input-notes" rows="5"
                      class="form-control form-control-sm edit-only">{{ sheet.notes }}</textarea>
          </div>
        </div>
      {% endif %}

    </section>

    <section class="col-12 col-lg-4">

      <div class="card card-block">

        <div class="card-title-cartouche">
          Statistiques de Combat
        </div>

        <div>
          <ul class="list-group list-group-flush">

            {% set initiative_rolled = eff_reflexes + rank %}
            {% set initiative_kept = eff_reflexes %}
            <li class="list-group-item p-0 px-3 py-1 flex flex-wrap gap-2">
              <div class="flex-grow-1 flex-col">
                Initiative
                <span class="ml-2">
                  <strong class="text-strong" data-stat="initiative">{{initiative_rolled}}g{{initiative_kept}}{% if initiative_mod != 0 %} {{ initiative_mod > 0 ? '+' : '' }}{{ initiative_mod }}{% endif %}</strong>
                  &nbsp;
                  <i
                    class="fa-solid fa-dice text-accent"
                    data-tooltip-stat="initiative"
                    data-toggle="tooltip" data-placement="right" data-html="true"
                    title="
                      <div class='text-mini text-left'>
                        /lancer
                        <br/>Réflèxes + RangGen.
                        <br/>/garder
                        Réflèxes
                        <br/>
                        <br/>/lancer {{eff_reflexes}} + {{rank}}
                        <br/>/garder {{eff_reflexes}}
                        {% if initiative_mod != 0 %}
                          <br/>Modificateur : {{ initiative_mod > 0 ? '+' : '' }}{{ initiative_mod }}
                        {% endif %}
                      </div>"
                  >
                  </i>
                </span>
              </div>
              <div class="text-right text-small">
                <strong data-stat="initiative-avg">{{ (((rank + eff_reflexes) ~ 'g' ~ eff_reflexes)|expected_roll) + initiative_mod }}</strong>
                <div data-stat="heavy-weapon"{% if not (sheet.armeActuelle and sheet.armeActuelle.type == 'LOURDE') %} class="d-none"{% endif %}>-5 (arme lourde)</div>
              </div>
              {{ sheet_macros.stat_mod('initiative', sheet.initiativeModifier ?? '', 'nombre') }}
            </li>

            {% set combat_skill_value = 0 %}
            {% if sheet.compCombatActuelle %}
              {% for i in 1..20 %}
                {% set slot_skill = attribute(sheet, 'competence' ~ i) %}
                {% if slot_skill and slot_skill.id == sheet.compCombatActuelle.id %}
                  {% set combat_skill_value = attribute(sheet, 'valeur' ~ i) ?? 0 %}
                {% endif %}
              {% endfor %}
            {% endif %}

            <li class="list-group-item p-0 px-3 py-1 flex gap-2 edit-only"
                data-combat-skill-row
                data-combat-skill-id="{{ sheet.compCombatActuelle ? sheet.compCombatActuelle.id : 0 }}">
              <div class="flex-grow-1">
                Compétence de combat
                <i  class="fas fa-info-circle text-disabled ml-1"
                  data-toggle="tooltip" data-placement="right"
                  title="Compétence Bugei utilisée pour le calcul du Jet d'Attaque"></i>
                <span data-combat-skill-select-cell class="ml-2"></span>
              </div>
            </li>

            {% set attack_rolled = eff_agility + attack_rolled_mod + (combat_skill_value / 2)|round(0, 'ceil') %}
            {% set attack_kept = eff_agility + attack_kept_mod %}
            <li class="list-group-item p-0 px-3 py-1 flex flex-wrap gap-2">
              <div class="flex-grow-1 stat-attack-with-skill{% if not sheet.compCombatActuelle %} d-none{% endif %}">
                Attaque <span class="text-small text-grayash">(<span data-stat="combat-skill-name">{{ sheet.compCombatActuelle ? sheet.compCombatActuelle.nom : '' }}</span>)</span>
                <br/>
                <span>
                  <strong class="text-strong ml-2" data-stat="attack">{{attack_rolled}}g{{attack_kept}}</strong>
                  &nbsp;
                  <i
                    class="fa-solid fa-dice text-accent"
                    data-tooltip-stat="attack"
                    data-toggle="tooltip" data-placement="right" data-html="true"
                    title="
                      <div class='text-mini text-left'>
                        /lancer
                        <br/>Agilité + CompCombat/2 arrSup.
                        <br/>/garder
                        Agilité
                        <br/>
                        <br/>/lancer {{eff_agility}} + {{combat_skill_value / 2}}
                        <br/>/garder {{eff_agility}}
                        {% if sheet.attaqueModifier %}
                          Modificateur : {{ sheet.attaqueModifier }}
                        {% endif %}
                      </div>
                    "></i>
                </span>
              </div>
              <div class="text-right text-small stat-attack-with-skill{% if not sheet.compCombatActuelle %} d-none{% endif %}">
                <strong data-stat="attack-avg">{{(attack_rolled ~ 'g' ~ attack_kept)|expected_roll}}</strong>
                <br/><span class="edit-only">en Assaut : <span data-stat="attack-assault-avg">{{((attack_rolled + 2) ~ 'g' ~ (attack_kept + 1))|expected_roll}}</span></span>
              </div>
              <div class="stat-attack-no-skill{% if sheet.compCombatActuelle %} d-none{% endif %}">
                Jet Attaque
                <br/>
                <small class="text-alternate">Choisissez une compétence de combat principal</small>
              </div>
              {{ sheet_macros.stat_mod('attack', sheet.attaqueModifier ?? '', 'XgY') }}
            </li>

            <li class="list-group-item p-0 px-3 py-1 flex gap-2 edit-only"
                data-current-weapon-row
                data-current-weapon-id="{{ sheet.armeActuelle ? sheet.armeActuelle.id : 0 }}">
              <div class="flex-grow-1">
                Arme actuelle
                <i  class="fas fa-info-circle text-disabled ml-1"
                  data-toggle="tooltip" data-placement="right"
                  title="Arme utilisée pour le calcul du Jet de Dommages, choisie parmi l'inventaire"></i>
                <span data-current-weapon-select-cell class="ml-2"></span>
              </div>
            </li>

            <li class="list-group-item p-0 px-3 py-1 flex gap-2 edit-only"
                data-armor-row
                data-armor-id="{{ sheet.armure ? sheet.armure.id : 0 }}">
              <div class="flex-grow-1">
                Armure actuelle
                <i  class="fas fa-info-circle text-disabled ml-1"
                  data-toggle="tooltip" data-placement="right"
                  title="Armure portée, choisie parmi l'inventaire"></i>
                <span data-armor-select-cell class="ml-2"></span>
              </div>
            </li>

            {% set damage_parts = sheet.armeActuelle ? sheet.armeActuelle.vd|default('0g1')|split('g') : ['0', '1'] %}
            {% set damage_rolled = damage_parts[0] + damage_rolled_mod + eff_strength %}
            {% set damage_kept = damage_parts[1] + damage_kept_mod %}
            <li class="list-group-item px-3 py-2 flex flex-wrap gap-2">
              <div class="flex-grow-1 flex-col stat-damage-with-weapon{% if not sheet.armeActuelle %} d-none{% endif %}">
                <span>
                  Dommages <span class="text-small text-grayash">(<span data-stat="current-weapon-name">{{ sheet.armeActuelle ? sheet.armeActuelle.nom : '' }}</span>)</span>
                </span>
                <span class="ml-2 text-grayash">
                  <strong class="text-strong" data-stat="damage">{{ damage_rolled ~ 'g' ~ damage_kept }}</strong>
                  &nbsp;
                  <i class="fa-solid fa-dice text-accent"
                      data-tooltip-stat="damage"
                      data-toggle="tooltip" data-placement="right" data-html="true"
                      title="
                        <div class='text-mini text-left'>
                          /lancer
                          <br/>VD de l'Arme + Force
                          <br/>/garder VD de l'Arme
                          <br/>
                          <br/><img class='img-56' src={{ asset(image_small(sheet.armeActuelle ? sheet.armeActuelle.icon|default(NA_OBJET) : NA_OBJET)) }} />
                          <br/>- VD {{ sheet.armeActuelle ? sheet.armeActuelle.nom : '' }} : {{ sheet.armeActuelle ? sheet.armeActuelle.vd|default('0g1') : '0g1' }}
                          <br/>- Force : +{{ eff_strength }}g0
                          {% if sheet.dmgModifier %}
                            <br/>
                            <br/>Modificateurs :
                            <br/> - Av./Techniques : +{{ sheet.dmgModifier }}
                          {% endif %}
                        </div>"
                  >
                  </i>
                </span>
              </div>
              <div class="text-right text-small stat-damage-with-weapon{% if not sheet.armeActuelle %} d-none{% endif %}">
                <strong data-stat="damage-avg">{{ ( damage_rolled ~  'g' ~ damage_kept  )|expected_roll }}</strong>
                <br/><span class="edit-only">3 Aug. : <span data-stat="damage-raise3-avg">{{ ( (damage_rolled + 3) ~  'g' ~ damage_kept  )|expected_roll }}</span></span>
              </div>
              <div class="stat-damage-no-weapon{% if sheet.armeActuelle %} d-none{% endif %}">
                Jet Dommages
                <br/>
                <small class="text-alternate">Choisissez une arme principale</small>
              </div>
              {{ sheet_macros.stat_mod('dmg', sheet.dmgModifier ?? '', 'XgY') }}
            </li>

            {% set tn_mod = sheet.ndModifier ?? 0 %}
            <li class="list-group-item px-3 py-2 flex flex-wrap gap-2">
              <div class="flex-grow-1">
                ND pour être touché
                <br/><strong class="text-strong ml-2" data-stat="tn-hit">{{ eff_reflexes * 5 + rank + tn_mod }}</strong>
                &nbsp;
                <i
                  class="fa-solid fa-arrow-trend-up"
                  data-toggle="tooltip" data-placement="right" data-html="true"
                  title="
                    <div class='text-mini'>
                      5 x Réflexes + Rang Général{% if tn_mod != 0 %}<br/>Modificateur : {{ tn_mod > 0 ? '+' : '' }}{{ tn_mod }}{% endif %}
                    </div>"
                >
                </i>
              </div>
              {% if sheet.armure %}
                <small class="text-right">
                  <strong data-stat="tn-hit-armor">{{ eff_reflexes * 5 + rank + sheet.armure.ndArmure + tn_mod }}</strong>
                  <br/>
                  Avec Armure
                </small>
              {% endif %}
              {{ sheet_macros.stat_mod('tn', sheet.ndModifier ?? '', 'nombre') }}
            </li>

            {% if sheet.armure %}
              <li class="list-group-item px-3 py-2 flex">
                <div class="flex-grow-1" >
                  Armure <span class="text-small text-grayash">({{ sheet.armure.nom }})</span>
                  <br/><strong class="text-strong ml-2">+{{ sheet.armure.ndArmure }} au ND pour être touché</strong>
                  <br/><strong class="text-strong ml-2">-{{ sheet.armure.reduction }} Réduction de dommages</strong>
                </div>
              </li>
            {% endif %}

            {% set armor_reduction = sheet.armure ? sheet.armure.reduction : 0 %}
            {% set reduction_mod = sheet.reductionModifier ?? 0 %}
            <li class="list-group-item px-3 py-2 d-flex flex-wrap">
              <div class="flex-grow-1">
                Réduction
                <br><strong class="ml-2 text-strong">{{ armor_reduction + reduction_mod }}</strong>
                &nbsp;
                <i
                  class="fa-solid fa-shield-halved"
                  data-toggle="tooltip" data-placement="right" data-html="true"
                  title="
                    <div class='text-mini text-left'>
                      {% if sheet.armure %}
                        {{ sheet.armure.nom }} : {{ sheet.armure.reduction }}
                      {% endif %}
                      {% if reduction_mod != 0 %}
                        <br/>Modificateur : {{ reduction_mod > 0 ? '+' : '' }}{{ reduction_mod }}
                      {% endif %}
                    </div>
                "></i>
              </div>
              <div class="text-right">
                {% if reduction_mod != 0 %}
                  <br/><small class="text-muted">({{ armor_reduction }} armure {{ reduction_mod > 0 ? '+' : '' }}{{ reduction_mod }} modif.)</small>
                {% endif %}
              </div>
              {{ sheet_macros.stat_mod('reduction', sheet.reductionModifier ?? '', 'nombre') }}
            </li>

            <li class="list-group-item px-3 py-2 d-flex">
              <div class="flex-grow-1">
                Points de Vie
                <br><strong class="ml-2 text-strong" data-stat="hp-total">{{ sheet.pvMax }}</strong>
                &nbsp;
                <i
                  class="fa-solid fa-heart-pulse text-primary"
                  data-toggle="tooltip" data-placement="right" data-html="true"
                  title="
                    <div class='text-mini'>
                      1 * (TERRE * {{ healthy_hp_per_earth }})
                      <br/>
                      +
                      <br/> {{ wound_levels|length - 1 }} * (TERRE * {{ wounded_hp_per_earth }})
                    </div>
                "></i>
              </div>
              <div class="flex-grow-1">
                Récupération
                <br><strong class="ml-2 text-strong" data-stat="recovery">{{(eff_constitution * 2) + rank}}</strong>
                &nbsp;
                <i 
                  class="fas fa-briefcase-medical text-success"
                  data-toggle="tooltip" data-placement="right" data-html="true"
                  title="
                    <div class='text-mini'>
                      (Constitution * 2) + RangGen.
                    </div>
                "></i>
                &nbsp;<span class="text-small">par nuit<small>
              </div>
            </li>
          </ul>
          <table class="table table-striped text-center text-regular">
            <thead>
              <tr>
                <th>État</th>
                <th>Malus</th>
                <th>HP</th>
              </tr>
            </thead>
            <tbody>
              {% for state, malus in wound_levels %}
                <tr>
                  <td>{{ state }}</td>
                  <td>{{ malus is null ? 'ne peut agir' : (malus > 0 ? '+' ~ malus : malus) }}</td>
                  {% if loop.first %}
                    <td data-stat="hp-healthy">{{ healthy_hp_per_earth * sheet.terre }}</td>
                  {% else %}
                    <td data-stat="hp-wounded">{{ wounded_hp_per_earth * sheet.terre }}</td>
                  {% endif %}
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>

      {% if is_own_character or is_gm() %}
        <div class="card card-block mb-2">
          <div class="card-title-cartouche">Armes</div>

          <table class="inventory-weapons">
            <thead>
              <tr><th>Arme</th><th>Taille</th><th>Poids</th><th>VD / Force</th><th class="edit-only"></th></tr>
            </thead>
            <tbody data-inventory-list="weapons">
              {% for weapon in sheet.inventoryItems|filter(o => o.categorie == 'ARME')|sort((a, b) => a.nom|u.ascii|lower <=> b.nom|u.ascii|lower) %}
                <tr class="inventory-line" data-inventory-id="{{ weapon.id }}" data-inventory-category="ARME">
                  <th scope="row" class="inventory-name">{{ weapon.nom }}</th>
                  <td>{{ weapon.taille|lower|capitalize|default('—') }}</td>
                  <td>{{ weapon.poids|lower|capitalize|default('—') }}</td>
                  <td class="extrabold">{{ weapon.vdOuForce|default('—') }}</td>
                  <td class="edit-only" data-inventory-remove></td>
                </tr>
              {% else %}
                <tr class="inventory-empty read-only"><td colspan="4">Aucune arme.</td></tr>
              {% endfor %}
            </tbody>
          </table>
          <div class="inventory-add edit-only" data-inventory-add="weapons"></div>
        </div>

        <div class="card card-block">
          <div class="card-title-cartouche">Équipement & Possessions</div>

          {% set inventory_order = {'OBJET': 0, 'PROJECTILE': 1, 'ARMURE': 2} %}
          <ul class="inventory-list" data-inventory-list="items">
            {% for object in sheet.inventoryItems|filter(o => o.categorie != 'ARME')|sort((a, b) =>
                [inventory_order[a.categorie]|default(9), a.nom|u.ascii|lower]
                <=> [inventory_order[b.categorie]|default(9), b.nom|u.ascii|lower]) %}
              <li class="inventory-line" data-inventory-id="{{ object.id }}" data-inventory-category="{{ object.categorie }}">
                <span class="inventory-name">{{ object.nom }}</span>
                {% if object.categorie == 'ARMURE' %}
                  <i class="fa-solid fa-shield-halved text-graydust" title="Armure"></i>
                {% endif %}
              </li>
            {% else %}
              <li class="inventory-empty read-only">Aucun objet.</li>
            {% endfor %}
          </ul>
          <div class="inventory-add edit-only" data-inventory-add="items"></div>

          <ul class="purse-board">
            {% for coin in ['koku', 'bu', 'zeni'] %}
              <li>
                <img src="{{ asset('/assets/icons/money/' ~ coin ~ '.png') }}" alt="" />
                <span class="purse-label">{{ coin|capitalize }}</span>
                <strong class="read-only">{{ attribute(sheet, coin) ?? 0 }}</strong>
                <input type="number" min="0" id="purse-input-{{ coin }}"
                       class="form-control form-control-sm edit-only"
                       value="{{ attribute(sheet, coin) ?? 0 }}" />
              </li>
            {% endfor %}
          </ul>

          <p class="purse-rate text-small text-body-c">1 koku = 5 bu = 50 zeni</p>
        </div>
      {% endif %}
    </section>
  </div>

  </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(function () {
            $('[data-toggle="tooltip"]').tooltip();
            $('[data-toggle="popover"]').popover();
        });
    </script>

    {% if is_own_character or is_gm() %}
    <script>
        window.SHEET_CONFIG = {
            xpBase: {{ xp.creation + xp.progression }},
            characterClassId: {{ character_class_id }},
            rank: {{ rank }},
            armorTn: {{ sheet.armure and sheet.armure.ndArmure ? sheet.armure.ndArmure : 0 }},
            tnModifier: {{ sheet.ndModifier ?? 0 }},
            healthyHpPerEarth: {{ healthy_hp_per_earth }},
            woundedHpPerEarth: {{ wounded_hp_per_earth }},
            woundLevels: {{ wound_levels|length - 1 }},
            editUrl: {{ path('characters_sheet_edit', {id: sheet.id})|json_encode|raw }},
            csrfToken: {{ csrf_token('player_sheet')|json_encode|raw }},
            skills: {{ skills_json|json_encode|raw }},
            advantages: {{ advantages_json|json_encode|raw }},
            disadvantages: {{ disadvantages_json|json_encode|raw }},
            weapons: {{ weapons_json|default([])|json_encode|raw }},
            spells: {{ spells_json|default([])|json_encode|raw }},
            objects: {{ objects_json|default([])|json_encode|raw }},
            bareHandsId: {{ bare_hands_id ?? 'null' }},
            rollMap: {{ roll_map()|json_encode|raw }},
            currentWeaponId: {{ sheet.armeActuelle ? sheet.armeActuelle.id : 0 }},
            currentCombatSkillId: {{ sheet.compCombatActuelle ? sheet.compCombatActuelle.id : 0 }},
            initiativeModifier: {{ sheet.initiativeModifier ?? 0 }},
            attackRolledMod:  {{ attack_rolled_mod }},
            attackKeptMod:  {{ attack_kept_mod }},
            damageRolledMod:  {{ damage_rolled_mod }},
            damageKeptMod:  {{ damage_kept_mod }},
            attackModifierStr:    {% if sheet.attaqueModifier %}{{ sheet.attaqueModifier|json_encode|raw }}{% else %}null{% endif %},
            damageModifierStr:        {% if sheet.dmgModifier %}{{ sheet.dmgModifier|json_encode|raw }}{% else %}null{% endif %}
        };
    </script>
    <script>
    (function () {
        const cfg = window.SHEET_CONFIG;
        const COST_PER_SPEC = {{ constant('App\\Service\\XpRanker::SPECIALISATION_COST') }};
        const traits = ['constitution','volonte','reflexes','intuition','agilite','intelligence','forceStat','perception','vide'];
        const btnEdit = document.getElementById('btn-sheet-edit');
        const btnCancel = document.getElementById('btn-sheet-cancel');
        const btnSave = document.getElementById('btn-sheet-save');
        const article = document.getElementById('character-sheet');

        function traitCost(eff, bonusCount, multiplier) {
            const freeRank = 2 + bonusCount;
            if (eff <= freeRank) return 0;
            const baseDeduct = freeRank * (freeRank + 1) / 2;
            return Math.round(multiplier * (eff * (eff + 1) / 2 - baseDeduct));
        }

        function getTraitBase(name) {
            const span = document.querySelector(`[data-trait-eff="${name}"]`);
            if (!span) return 0;
            const select = span.querySelector('select');
            if (select) return parseInt(select.value, 10);
            return parseInt(span.dataset.base, 10);
        }

        function skillCost(val, dojoCount) {
            if (!val || val < 1) return 0;
            const n = parseInt(dojoCount, 10) || 0;
            const raw = Math.round(val * (val + 1) / 2);
            const offset = Math.round(n * (n + 1) / 2);
            return Math.max(0, raw - offset);
        }

        function expectedRoll(rolled, kept) {
            if (kept < 1) return 0;
            if (rolled < kept) kept = rolled;
            let bonus = 0;
            if (rolled > 10) { bonus += rolled - 10; rolled = 10; }
            if (kept   > 10) { bonus += (kept - 10) * 2; kept = 10; }
            const row = cfg.rollMap[rolled];
            if (!row) return 0;
            return (row[kept] ?? 0) + bonus;
        }

        function getCombatSkillId() {
            const row = document.querySelector('[data-combat-skill-row]');
            const select = row ? row.querySelector('select.combat-skill-select') : null;
            if (select) return parseInt(select.value, 10) || 0;
            return parseInt(cfg.currentCombatSkillId, 10) || 0;
        }

        function getCombatSkillValue() {
            const skillId = getCombatSkillId();
            if (!skillId) return 0;
            const rows = document.querySelectorAll('[data-skill-row]');
            for (const row of rows) {
                const skillSelect = row.querySelector('.skill-select');
                const valSelect = row.querySelector('.val-select');
                const rowSkillId = skillSelect ? (parseInt(skillSelect.value, 10) || 0) : (parseInt(row.dataset.skillId, 10) || 0);
                if (rowSkillId === skillId) {
                    return valSelect ? (parseInt(valSelect.value, 10) || 0) : (parseInt(row.dataset.skillVal, 10) || 0);
                }
            }
            return 0;
        }

        function getCurrentWeaponId() {
            const row = document.querySelector('[data-current-weapon-row]');
            const select = row ? row.querySelector('select.current-weapon-select') : null;
            if (select) return parseInt(select.value, 10) || 0;
            return parseInt(cfg.currentWeaponId, 10) || 0;
        }

        function setTooltipHtml(el, html) {
            if (!el) return;
            el.setAttribute('data-original-title', html);
            el.setAttribute('title', html);
        }

        function buildInitiativeTooltip(effReflexes, rank) {
            const initMod = cfg.initiativeModifier || 0;
            const mod = initMod !== 0
                ? `<br/>Modificateur : ${initMod > 0 ? '+' : ''}${initMod}`
                : '';
            return `<div class='text-mini text-left'>`
                + `/lancer<br/>Réflèxes + RangGen.<br/>/garder Réflèxes`
                + `<br/><br/>/lancer ${effReflexes} + ${rank}<br/>/garder ${effReflexes}${mod}`
                + `</div>`;
        }

        function buildAttackTooltip(effAgility, combatSkillValue) {
            const mod = cfg.attackModifierStr ? `<br/>Modificateur : ${cfg.attackModifierStr}` : '';
            return `<div class='text-mini text-left'>`
                + `/lancer<br/>Agilité + CompCombat/2 arrSup.<br/>/garder Agilité`
                + `<br/><br/>/lancer ${effAgility} + ${combatSkillValue / 2}<br/>/garder ${effAgility}${mod}`
                + `</div>`;
        }

        function buildDamageTooltip(effStrength, weapon) {
            if (!weapon) return '';
            const mod = cfg.damageModifierStr
                ? `<br/><br/>Modificateurs :<br/> - Av./Techniques : +${cfg.damageModifierStr}`
                : '';
            return `<div class='text-mini text-left'>`
                + `/lancer<br/>VD de l'Arme + Force<br/>/garder VD de l'Arme`
                + `<br/><br/>- VD ${weapon.nom} : ${weapon.vd || '0g1'}`
                + `<br/>- Force : +${effStrength}g0${mod}`
                + `</div>`;
        }

        function recalculate() {
            let totalTraits = 0;
            const eff = {};
            traits.forEach(name => {
                const span = document.querySelector(`[data-trait-eff="${name}"]`);
                if (!span) return;
                const base = getTraitBase(name);
                const bonus = parseInt(span.dataset.bonus, 10) || 0;
                const mult = parseInt(span.dataset.multiplier, 10);
                const effVal = base + bonus;
                eff[name] = effVal;
                const cost = traitCost(effVal, bonus, mult);
                totalTraits += cost;
                const valNode = span.querySelector('.eff-display');
                if (valNode) valNode.textContent = effVal;
                const costSpan = document.querySelector(`[data-cost-for="${name}"]`);
                if (costSpan) costSpan.textContent = cost > 0 ? `-${cost} xp` : '';
            });

            const rings = {
                terre: Math.min(eff.constitution, eff.volonte),
                air:   Math.min(eff.reflexes, eff.intuition),
                eau:   Math.min(eff.forceStat, eff.perception),
                feu:   Math.min(eff.agilite, eff.intelligence),
            };
            Object.keys(rings).forEach(r => {
                const node = document.querySelector(`[data-ring="${r}"]`);
                if (node) node.textContent = rings[r];
            });

            const pairs = {
                constitution: 'volonte', volonte: 'constitution',
                reflexes: 'intuition',   intuition: 'reflexes',
                forceStat: 'perception', perception: 'forceStat',
                agilite: 'intelligence', intelligence: 'agilite',
            };
            Object.keys(pairs).forEach(name => {
                const span = document.querySelector(`[data-trait-eff="${name}"]`);
                if (!span) return;
                const isHigher = eff[name] > eff[pairs[name]];
                span.classList.toggle('text-strong', isHigher);
                span.classList.toggle('extrabold', isHigher);
            });

            const initiativeRolled = cfg.rank + eff.reflexes;
            const initiativeKept = eff.reflexes;
            const initMod    = cfg.initiativeModifier || 0;
            const initNode = document.querySelector('[data-stat="initiative"]');
            if (initNode) {
                const suffix = initMod !== 0 ? ` ${initMod > 0 ? '+' : ''}${initMod}` : '';
                initNode.textContent = `${initiativeRolled}g${initiativeKept}${suffix}`;
            }

            const combatSkillId  = getCombatSkillId();
            const combatSkillValue = getCombatSkillValue();
            const attackRolled = eff.agilite + Math.ceil(combatSkillValue / 2) + cfg.attackRolledMod;
            const attackKept = eff.agilite + cfg.attackKeptMod;
            const attackNode = document.querySelector('[data-stat="attack"]');
            if (attackNode) attackNode.textContent = `${attackRolled}g${attackKept}`;

            const initAvgNode = document.querySelector('[data-stat="initiative-avg"]');
            if (initAvgNode) initAvgNode.textContent = expectedRoll(initiativeRolled, initiativeKept) + initMod;

            const attackAvgNode = document.querySelector('[data-stat="attack-avg"]');
            if (attackAvgNode) attackAvgNode.textContent = expectedRoll(attackRolled, attackKept);

            const attackAssaultAvgNode = document.querySelector('[data-stat="attack-assault-avg"]');
            if (attackAssaultAvgNode) attackAssaultAvgNode.textContent = expectedRoll(attackRolled + 2, attackKept + 1);

            const combatSkill = combatSkillId
                ? (cfg.skills || []).find(c => c.id === combatSkillId)
                : null;
            document.querySelectorAll('.stat-attack-with-skill').forEach(el => el.classList.toggle('d-none', !combatSkill));
            document.querySelectorAll('.stat-attack-no-skill').forEach(el => el.classList.toggle('d-none', !!combatSkill));
            const combatSkillNameNode = document.querySelector('[data-stat="combat-skill-name"]');
            if (combatSkillNameNode) combatSkillNameNode.textContent = combatSkill ? combatSkill.nom : '';

            const currentWeaponId = getCurrentWeaponId();
            const currentWeapon   = currentWeaponId
                ? (cfg.weapons || []).find(a => a.id === currentWeaponId)
                : null;
            const weaponDr = currentWeapon ? currentWeapon.vd : null;
            const damageNode         = document.querySelector('[data-stat="damage"]');
            const damageAvgNode      = document.querySelector('[data-stat="damage-avg"]');
            const damageRaise3AvgNode  = document.querySelector('[data-stat="damage-raise3-avg"]');
            if (weaponDr) {
                const parts = weaponDr.split('g');
                const rolled = (parseInt(parts[0], 10) || 0) + eff.forceStat + cfg.damageRolledMod;
                const kept   = (parseInt(parts[1], 10) || 0) + cfg.damageKeptMod;
                if (damageNode)        damageNode.textContent        = `${rolled}g${kept}`;
                if (damageAvgNode)     damageAvgNode.textContent     = expectedRoll(rolled, kept);
                if (damageRaise3AvgNode) damageRaise3AvgNode.textContent = expectedRoll(rolled + 3, kept);
            }
            document.querySelectorAll('.stat-damage-with-weapon').forEach(el => el.classList.toggle('d-none', !currentWeapon));
            document.querySelectorAll('.stat-damage-no-weapon').forEach(el => el.classList.toggle('d-none', !!currentWeapon));
            const weaponNameNode = document.querySelector('[data-stat="current-weapon-name"]');
            if (weaponNameNode) weaponNameNode.textContent = currentWeapon ? currentWeapon.nom : '';
            const heavyWeaponNode = document.querySelector('[data-stat="heavy-weapon"]');
            if (heavyWeaponNode) heavyWeaponNode.classList.toggle('d-none', !(currentWeapon && currentWeapon.type === 'LOURDE'));

            const tnBase = eff.reflexes * 5 + cfg.rank + (cfg.tnModifier || 0);
            const tnNode = document.querySelector('[data-stat="tn-hit"]');
            if (tnNode) tnNode.textContent = tnBase;
            const armorTnNode = document.querySelector('[data-stat="tn-hit-armor"]');
            if (armorTnNode) armorTnNode.textContent = tnBase + cfg.armorTn;

            const earth = Math.min(eff.constitution, eff.volonte);
            const hpHealthy = document.querySelector('[data-stat="hp-healthy"]');
            if (hpHealthy) hpHealthy.textContent = cfg.healthyHpPerEarth * earth;
            document.querySelectorAll('[data-stat="hp-wounded"]').forEach(td => {
                td.textContent = cfg.woundedHpPerEarth * earth;
            });
            const hpTotal = document.querySelector('[data-stat="hp-total"]');
            if (hpTotal) hpTotal.textContent = earth * (cfg.healthyHpPerEarth + cfg.woundLevels * cfg.woundedHpPerEarth);

            const recoveryNode = document.querySelector('[data-stat="recovery"]');
            if (recoveryNode) recoveryNode.textContent = eff.constitution * 2 + cfg.rank;

            let totalSkills = 0;
            let totalSpecs = 0;
            document.querySelectorAll('[data-skill-row]').forEach(row => {
                const skillSelect = row.querySelector('.skill-select');
                const valSelect = row.querySelector('.val-select');
                let skillId, val, dojoCount;
                if (skillSelect && valSelect) {
                    skillId = parseInt(skillSelect.value, 10) || 0;
                    val = parseInt(valSelect.value, 10) || 0;
                } else {
                    skillId = parseInt(row.dataset.skillId, 10) || 0;
                    val = parseInt(row.dataset.skillVal, 10) || 0;
                }
                const dojoWrap = row.querySelector('.skill-dojo-sort');
                if (dojoWrap) {
                    dojoCount = parseInt(dojoWrap.dataset.state, 10) || 0;
                } else {
                    dojoCount = parseInt(row.dataset.skillDojo, 10) || 0;
                }
                const rowCost = (skillId > 0 && val > 0) ? skillCost(val, dojoCount) : 0;
                if (rowCost > 0) totalSkills += rowCost;
                const costCell = row.querySelector('[data-skill-cost-cell]');
                if (costCell) costCell.textContent = rowCost > 0 ? `-${rowCost}xp` : '';
                let paidSpecs = 0;
                const specsRow = document.querySelector(`[data-skill-specs-row="${row.dataset.skillRow}"]`);
                if (skillId > 0 && specsRow) {
                    const wraps = specsRow.querySelectorAll('.skill-spec-sort');
                    if (wraps.length > 0) {
                        wraps.forEach(w => {
                            if ((parseInt(w.dataset.state, 10) || 0) === 1) paidSpecs += 1;
                        });
                    } else {
                        const specMask   = row.dataset.skillSpecs || '';
                        const dojoSpecMask = row.dataset.skillDojoSpec || '';
                        for (let k = 0; k < specMask.length; k++) {
                            if (specMask[k] === '1' && dojoSpecMask[k] !== '1') paidSpecs += 1;
                        }
                    }
                    totalSpecs += paidSpecs * COST_PER_SPEC;
                }
                const specsCostCell = specsRow ? specsRow.querySelector('[data-skill-specs-cost-cell]') : null;
                if (specsCostCell) {
                    specsCostCell.innerHTML = paidSpecs > 0 ? `<small>-${paidSpecs * COST_PER_SPEC}xp (spé)</small>` : '';
                }
            });
            totalSkills = totalSkills + totalSpecs;

            const advantageById    = new Map((cfg.advantages    || []).map(a => [a.id, a]));
            const disadvantageById = new Map((cfg.disadvantages || []).map(a => [a.id, a]));
            let advantagesCost = 0;
            let disadvantagesGain = 0;
            document.querySelectorAll('[data-advantage-slot]').forEach(li => {
                const select = li.querySelector('select.advantage-select');
                const id = select ? parseInt(select.value, 10) : parseInt(li.dataset.advantageId, 10);
                const kind = li.dataset.advantageKind;
                const advantage = id ? (kind === 'advantage' ? advantageById.get(id) : disadvantageById.get(id)) : null;
                const cost = advantage ? advantage.coutEffectif : 0;
                if (advantage) {
                    if (kind === 'advantage') advantagesCost += cost; else disadvantagesGain += cost;
                }
                const costSpan = li.querySelector('[data-advantage-cost]');
                if (costSpan) {
                    if (advantage) {
                        const sign = kind === 'advantage' ? '-' : '+';
                        const promo = cost !== advantage.cout ? ' <small class="text-success">(promo)</small>' : '';
                        costSpan.innerHTML = `${sign}${cost}xp${promo}`;
                    } else {
                        costSpan.innerHTML = '';
                    }
                }
            });

            const totalSpent = totalTraits + totalSkills + advantagesCost;
            const effectiveXp = cfg.xpBase + disadvantagesGain;
            const remaining = effectiveXp - totalSpent;

            const tt = document.getElementById('xp-traits-total');
            if (tt) tt.textContent = `-${totalTraits}xp`;
            const tc = document.getElementById('xp-skills-total');
            if (tc) tc.textContent = `-${totalSkills}xp`;
            const advantageRow = document.getElementById('xp-advantages-row');
            if (advantageRow) {
                advantageRow.classList.toggle('d-none', advantagesCost === 0);
                const advantagesTotal = document.getElementById('xp-advantages-total');
                if (advantagesTotal) advantagesTotal.textContent = `-${advantagesCost}xp`;
            }
            const disadvantageRow = document.getElementById('xp-disadvantages-row');
            if (disadvantageRow) {
                disadvantageRow.classList.toggle('d-none', disadvantagesGain === 0);
                const disadvantagesTotal = document.getElementById('xp-disadvantages-total');
                if (disadvantagesTotal) disadvantagesTotal.textContent = `+${disadvantagesGain}xp`;
            }
            document.querySelectorAll('.xp-traits-value').forEach(n => { n.textContent = totalTraits; });
            document.querySelectorAll('.xp-skills-value').forEach(n => { n.textContent = totalSkills; });
            document.querySelectorAll('.xp-spent-value').forEach(n => { n.textContent = totalSpent; });
            document.querySelectorAll('.xp-total-value').forEach(n => { n.textContent = effectiveXp; });
            document.querySelectorAll('.xp-advantages-value').forEach(n => { n.textContent = advantagesCost; });
            document.querySelectorAll('.xp-disadvantages-value').forEach(n => { n.textContent = disadvantagesGain; });
            document.querySelectorAll('.xp-remaining').forEach(tr => {
                tr.textContent = `${remaining} xp`;
                tr.classList.toggle('text-danger', remaining < 0);
                tr.classList.toggle('text-success', remaining >= 0);
            });

            setTooltipHtml(
                document.querySelector('[data-tooltip-stat="initiative"]'),
                buildInitiativeTooltip(eff.reflexes, cfg.rank)
            );
            setTooltipHtml(
                document.querySelector('[data-tooltip-stat="attack"]'),
                buildAttackTooltip(eff.agilite, combatSkillValue)
            );
            const dmgTooltipEl = document.querySelector('[data-tooltip-stat="damage"]');
            if (dmgTooltipEl && currentWeapon) {
                setTooltipHtml(dmgTooltipEl, buildDamageTooltip(eff.forceStat, currentWeapon));
            }

            if (btnSave) {
                btnSave.disabled = remaining < 0;
                btnSave.classList.toggle('btn-danger', remaining < 0);
                btnSave.classList.toggle('btn-success', remaining >= 0);
            }
        }

        const SKILL_CAT_ORDER = ['Bugei', 'Noble', 'Marchand', 'Dégradante'];
        function buildSkillSelect(selectedId) {
            const select = document.createElement('select');
            select.className = 'form-control form-control-sm skill-select';
            const emptyOpt = document.createElement('option');
            emptyOpt.value = '0';
            emptyOpt.textContent = '— Aucune —';
            select.appendChild(emptyOpt);
            const byCat = {};
            cfg.skills.forEach(c => {
                const cat = c.categorie || 'Autres';
                if (!byCat[cat]) byCat[cat] = [];
                byCat[cat].push(c);
            });
            const extraCats = Object.keys(byCat)
                .filter(cat => !SKILL_CAT_ORDER.includes(cat))
                .sort((a, b) => a.localeCompare(b, 'fr'));
            const orderedCats = SKILL_CAT_ORDER.filter(cat => byCat[cat]).concat(extraCats);
            orderedCats.forEach(cat => {
                const group = document.createElement('optgroup');
                group.label = cat;
                byCat[cat]
                    .slice()
                    .sort((a, b) => (a.nom || '').localeCompare(b.nom || '', 'fr'))
                    .forEach(c => {
                        const opt = document.createElement('option');
                        opt.value = c.id;
                        opt.dataset.traitCourt = c.traitCourt;
                        opt.textContent = c.nom;
                        if (parseInt(selectedId, 10) === c.id) opt.selected = true;
                        group.appendChild(opt);
                    });
                select.appendChild(group);
            });
            return select;
        }

        function knownSpellIds() {
            return Array.from(document.querySelectorAll('[data-spell-id]'))
                .map(li => parseInt(li.dataset.spellId, 10));
        }

        function buildSpellSelect(ring) {
            const select = document.createElement('select');
            select.className = 'form-control form-control-sm spell-select';
            const emptyOpt = document.createElement('option');
            emptyOpt.value = '0';
            emptyOpt.textContent = '— Ajouter —';
            select.appendChild(emptyOpt);
            const known = knownSpellIds();
            let group = null;
            let groupLevel = null;
            (cfg.spells || [])
                .filter(s => s.anneau === ring && !known.includes(s.id))
                .forEach(s => {
                    if (s.niveau !== null && s.niveau !== groupLevel) {
                        groupLevel = s.niveau;
                        group = document.createElement('optgroup');
                        group.label = 'Niveau ' + s.niveau;
                        select.appendChild(group);
                    }
                    const opt = document.createElement('option');
                    opt.value = s.id;
                    opt.textContent = s.nom;
                    (s.niveau === null ? select : group).appendChild(opt);
                });
            return select;
        }

        function buildSpellRemove() {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'spell-remove text-danger';
            btn.title = 'Retirer ce sort';
            btn.innerHTML = '<i class="fa-solid fa-xmark"></i>';
            btn.addEventListener('click', () => {
                btn.closest('.spell-line').remove();
                refreshSpellSelects();
            });
            return btn;
        }

        function insertSpellLine(spell, ring) {
            const list = document.querySelector(`[data-spell-list="${ring}"]`);
            if (!list) return;

            const empty = list.querySelector('.spell-empty');
            if (empty) empty.remove();

            const li = document.createElement('li');
            li.className = 'spell-line';
            li.dataset.spellId = spell.id;
            if (list.dataset.spellEmblem) {
                const emblem = document.createElement('img');
                emblem.className = 'img-24';
                emblem.src = list.dataset.spellEmblem;
                emblem.alt = '';
                li.appendChild(emblem);
            }
            const name = document.createElement('span');
            name.className = 'spell-name';
            name.textContent = spell.nom;
            li.appendChild(name);
            if (spell.niveau !== null) {
                const rank = document.createElement('strong');
                const color = ring.replace('KIHO_', '');
                rank.className = 'text-rank reduced bg-' + (color === 'UNIVERSEL' ? 'black' : color);
                rank.textContent = spell.niveau;
                li.appendChild(rank);
            }
            li.appendChild(buildSpellRemove());

            const spellLevel = spell.niveau || 0;
            const next = Array.from(list.children).find(existing => {
                const badge = existing.querySelector('.text-rank');
                const level = badge ? parseInt(badge.textContent, 10) || 0 : 0;
                if (level !== spellLevel) return level > spellLevel;
                return existing.querySelector('.spell-link, .spell-name')
                    .textContent.trim().localeCompare(spell.nom, 'fr') > 0;
            });
            list.insertBefore(li, next || null);
        }

        function refreshSpellSelects() {
            document.querySelectorAll('[data-spell-add]').forEach(wrap => {
                const ring = wrap.dataset.spellAdd;
                const select = buildSpellSelect(ring);
                select.addEventListener('change', () => {
                    const spell = (cfg.spells || []).find(s => s.id === parseInt(select.value, 10));
                    if (!spell) return;
                    insertSpellLine(spell, ring);
                    refreshSpellSelects();
                });
                wrap.innerHTML = '';
                wrap.appendChild(select);
            });
        }

        const INVENTORY_GROUPS = [
            ['OBJET', 'Divers'],
            ['ARME', 'Armes'],
            ['PROJECTILE', 'Projectiles'],
            ['ARMURE', 'Armures'],
        ];

        function inventoryRank(category) {
            const i = INVENTORY_GROUPS.findIndex(([c]) => c === category);
            return i === -1 ? INVENTORY_GROUPS.length : i;
        }

        function inventoryKind(category) {
            return category === 'ARME' ? 'weapons' : 'items';
        }

        function inventoryIds() {
            return Array.from(document.querySelectorAll('[data-inventory-id]'))
                .map(li => parseInt(li.dataset.inventoryId, 10));
        }

        function appendInventoryRemove(line) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'inventory-remove text-danger';
            btn.title = 'Retirer cet objet';
            btn.innerHTML = '<i class="fa-solid fa-xmark"></i>';
            btn.addEventListener('click', () => {
                line.remove();
                refreshInventorySelect();
                refreshEquipmentSelects();
                recalculate();
            });
            (line.querySelector('[data-inventory-remove]') || line).appendChild(btn);
        }

        function buildWeaponLine(object) {
            const tr = document.createElement('tr');
            const name = document.createElement('th');
            name.scope = 'row';
            name.className = 'inventory-name';
            name.textContent = object.nom;
            tr.appendChild(name);

            const label = v => v ? v.charAt(0).toUpperCase() + v.slice(1).toLowerCase() : '—';
            [label(object.taille), label(object.poids), object.vdOuForce || '—'].forEach((value, i) => {
                const td = document.createElement('td');
                if (i === 2) td.className = 'extrabold';
                td.textContent = value;
                tr.appendChild(td);
            });

            const remove = document.createElement('td');
            remove.className = 'edit-only';
            remove.dataset.inventoryRemove = '';
            tr.appendChild(remove);
            return tr;
        }

        function buildItemLine(object) {
            const li = document.createElement('li');
            const name = document.createElement('span');
            name.className = 'inventory-name';
            name.textContent = object.nom;
            li.appendChild(name);

            if (object.categorie === 'ARMURE') {
                const icon = document.createElement('i');
                icon.className = 'fa-solid fa-shield-halved text-graydust';
                li.appendChild(icon);
            }
            return li;
        }

        function insertInventoryLine(object) {
            const kind = inventoryKind(object.categorie);
            const list = document.querySelector(`[data-inventory-list="${kind}"]`);
            if (!list) return;

            const empty = list.querySelector('.inventory-empty');
            if (empty) empty.remove();

            const line = kind === 'weapons' ? buildWeaponLine(object) : buildItemLine(object);
            line.classList.add('inventory-line');
            line.dataset.inventoryId = object.id;
            line.dataset.inventoryCategory = object.categorie;
            appendInventoryRemove(line);

            const rank = inventoryRank(object.categorie);
            const next = Array.from(list.children).find(existing => {
                const other = inventoryRank(existing.dataset.inventoryCategory);
                if (other !== rank) return other > rank;
                return existing.querySelector('.inventory-name').textContent.trim().localeCompare(object.nom, 'fr') > 0;
            });
            list.insertBefore(line, next || null);
        }

        function refreshInventorySelect() {
            const owned = inventoryIds();

            document.querySelectorAll('[data-inventory-add]').forEach(wrap => {
                const kind = wrap.dataset.inventoryAdd;
                const select = document.createElement('select');
                select.className = 'form-control form-control-sm';
                const emptyOpt = document.createElement('option');
                emptyOpt.value = '0';
                emptyOpt.textContent = kind === 'weapons' ? '— Ajouter une arme —' : '— Ajouter un objet —';
                select.appendChild(emptyOpt);

                const freeObjects = (cfg.objects || [])
                    .filter(o => !owned.includes(o.id) && inventoryKind(o.categorie) === kind);
                const keyOf = o => kind === 'weapons' ? (o.type || 'DIVERS') : o.categorie;
                const groups = new Map();

                if (kind === 'weapons') {
                    freeObjects.map(keyOf)
                        .sort((a, b) => a.localeCompare(b, 'fr'))
                        .forEach(type => groups.set(type, type.charAt(0) + type.slice(1).toLowerCase()));
                } else {
                    INVENTORY_GROUPS.forEach(([category, title]) => groups.set(category, title));
                    freeObjects.forEach(o => { if (!groups.has(o.categorie)) groups.set(o.categorie, o.categorie); });
                }

                groups.forEach((title, key) => {
                    const groupObjects = freeObjects.filter(o => keyOf(o) === key);
                    if (!groupObjects.length) return;

                    const group = document.createElement('optgroup');
                    group.label = title;
                    groupObjects.forEach(o => {
                        const opt = document.createElement('option');
                        opt.value = o.id;
                        opt.textContent = o.nom;
                        group.appendChild(opt);
                    });
                    select.appendChild(group);
                });

                select.addEventListener('change', () => {
                    const object = (cfg.objects || []).find(o => o.id === parseInt(select.value, 10));
                    if (!object) return;
                    insertInventoryLine(object);
                    refreshInventorySelect();
                    refreshEquipmentSelects();
                });

                wrap.innerHTML = '';
                wrap.appendChild(select);
            });
        }

        function buildAdvantageSelect(kind, selectedId) {
            const select = document.createElement('select');
            select.className = 'form-control form-control-sm advantage-select';
            const emptyOpt = document.createElement('option');
            emptyOpt.value = '0';
            emptyOpt.textContent = '— Aucun —';
            select.appendChild(emptyOpt);
            const list = (kind === 'advantage') ? (cfg.advantages || []) : (cfg.disadvantages || []);
            list.forEach(a => {
                if (a.exclusiveId && a.exclusiveId !== cfg.characterClassId && a.id !== selectedId) return;
                const opt = document.createElement('option');
                opt.value = a.id;
                opt.textContent = a.nom;
                if (a.id === selectedId) opt.selected = true;
                select.appendChild(opt);
            });
            return select;
        }

        function buildCombatSkillSelect(selectedId) {
            const select = document.createElement('select');
            select.className = 'form-control form-control-sm combat-skill-select';
            const emptyOpt = document.createElement('option');
            emptyOpt.value = '0';
            emptyOpt.textContent = '— Aucune —';
            select.appendChild(emptyOpt);
            (cfg.skills || [])
                .filter(c => c.categorie === 'Bugei')
                .forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.id;
                    opt.textContent = c.nom;
                    if (parseInt(selectedId, 10) === c.id) opt.selected = true;
                    select.appendChild(opt);
                });
            return select;
        }

        function buildOwnedSelect(category, selectedId, className, extras) {
            const select = document.createElement('select');
            select.className = 'form-control form-control-sm ' + className;
            const emptyOpt = document.createElement('option');
            emptyOpt.value = '0';
            emptyOpt.textContent = '— Aucune —';
            select.appendChild(emptyOpt);

            const owned = new Set(inventoryIds());
            const choices = (cfg.objects || []).filter(o => owned.has(o.id) && o.categorie === category);

            (extras || []).forEach(id => {
                const idNum = parseInt(id, 10) || 0;
                if (!idNum || choices.some(o => o.id === idNum)) return;
                const object = (cfg.objects || []).find(o => o.id === idNum);
                if (object) choices.push(object);
            });

            const drById = new Map((cfg.weapons || []).map(a => [a.id, a.vd]));
            choices.forEach(object => {
                const opt = document.createElement('option');
                opt.value = object.id;
                const vd = drById.get(object.id);
                opt.textContent = vd ? `${object.nom} (${vd})` : object.nom;
                if (parseInt(selectedId, 10) === object.id) opt.selected = true;
                select.appendChild(opt);
            });

            return select;
        }

        function refreshEquipmentSelects() {
            [
                ['[data-current-weapon-row]', '[data-current-weapon-select-cell]', 'currentWeaponId', 'ARME', 'current-weapon-select', [cfg.bareHandsId]],
                ['[data-armor-row]', '[data-armor-select-cell]', 'armorId', 'ARMURE', 'armor-select', []],
            ].forEach(([rowSel, cellSel, dataKey, category, className, extras]) => {
                const row = document.querySelector(rowSel);
                const cell = row ? row.querySelector(cellSel) : null;
                if (!cell) return;

                const previous = cell.querySelector('select');
                const currentId = previous ? previous.value : (row.dataset[dataKey] || 0);
                const select = buildOwnedSelect(category, currentId, className, extras.concat([currentId]));
                select.addEventListener('change', recalculate);
                cell.innerHTML = '';
                cell.appendChild(select);
            });
        }

        function buildValSelect(selectedVal) {
            const select = document.createElement('select');
            select.className = 'form-control form-control-sm val-select';
            const targetVal = parseInt(selectedVal, 10) >= 1 ? parseInt(selectedVal, 10) : 1;
            for (let i = 1; i <= 10; i++) {
                const opt = document.createElement('option');
                opt.value = i;
                opt.textContent = i;
                if (targetVal === i) opt.selected = true;
                select.appendChild(opt);
            }
            return select;
        }

        function sortSkillRowsAlphabetically() {
            const tbody = document.querySelector('#skill-table tbody');
            if (!tbody) return;
            [...tbody.querySelectorAll('[data-skill-row]')]
                .sort((a, b) => {
                    const na = a.querySelector('[data-skill-name]').textContent.trim();
                    const nb = b.querySelector('[data-skill-name]').textContent.trim();
                    if (!na || !nb) return (!na) - (!nb);
                    const ea = (parseInt(a.dataset.skillDojo, 10) || 0) > 0 ? 0 : 1;
                    const eb = (parseInt(b.dataset.skillDojo, 10) || 0) > 0 ? 0 : 1;
                    if (ea !== eb) return ea - eb;
                    return na.localeCompare(nb, 'fr');
                })
                .forEach(row => {
                    tbody.appendChild(row);
                    const specsRow = tbody.querySelector(`[data-skill-specs-row="${row.dataset.skillRow}"]`);
                    if (specsRow) tbody.appendChild(specsRow);
                });
        }

        function enterEditMode() {
            article.classList.add('edit-mode');
            sortSkillRowsAlphabetically();
            btnEdit.style.display = 'none';
            btnCancel.style.display = '';
            btnSave.style.display = '';

            traits.forEach(name => {
                const span = document.querySelector(`[data-trait-eff="${name}"]`);
                if (!span) return;
                const base = parseInt(span.dataset.base, 10);
                const select = document.createElement('select');
                select.className = 'form-control form-control-sm';
                for (let i = 1; i <= 10; i++) {
                    const opt = document.createElement('option');
                    opt.value = i;
                    opt.textContent = i;
                    if (i === base) opt.selected = true;
                    select.appendChild(opt);
                }
                select.addEventListener('change', recalculate);
                span.prepend(select);
            });

            document.querySelectorAll('[data-skill-row]').forEach(row => {
                const skillId = parseInt(row.dataset.skillId, 10) || 0;
                const val = parseInt(row.dataset.skillVal, 10) || 0;
                const skillDojo = parseInt(row.dataset.skillDojo, 10) || 0;
                const dojoSpecMask = row.dataset.skillDojoSpec || '';
                const dojoCell = row.querySelector('[data-skill-dojo-cell]');
                const nameCell = row.querySelector('[data-skill-name]');
                const valCell = row.querySelector('[data-skill-val-cell]');
                const traitCell = row.querySelector('[data-skill-trait-cell]');
                const costCell = row.querySelector('[data-skill-cost-cell]');
                const specsCell = getSpecsCell(row);

                const skillSelect = buildSkillSelect(skillId);
                const valSelect = buildValSelect(val);
                valSelect.addEventListener('change', recalculate);
                valCell.innerHTML = '';
                valCell.appendChild(valSelect);

                dojoCell.innerHTML = '';
                const dojoWrap = document.createElement('span');
                dojoWrap.className = 'skill-dojo-sort';
                dojoWrap.title = "Cycle : rien → offerte +1 → offerte +2";
                const dojoIcon = document.createElement('i');
                dojoWrap.appendChild(dojoIcon);
                const dojoTag = document.createElement('small');
                dojoTag.className = 'skill-dojo-tag';
                dojoWrap.appendChild(dojoTag);
                dojoCell.appendChild(dojoWrap);
                bindTriState(dojoWrap, dojoIcon, skillDojo, SKILL_DOJO_ICONS, (state) => {
                    dojoTag.textContent = state === 2 ? 'offerte école R2' : '';
                });
                if (skillId === 0) {
                    valSelect.style.display = 'none';
                    dojoWrap.style.display = 'none';
                }

                renderSpecsCheckboxes(specsCell, skillId, row.dataset.skillSpecs || '', dojoSpecMask);

                skillSelect.addEventListener('change', () => {
                    const opt = skillSelect.options[skillSelect.selectedIndex];
                    const newSkillId = parseInt(skillSelect.value, 10) || 0;
                    traitCell.textContent = opt && opt.dataset.traitCourt ? opt.dataset.traitCourt : '';
                    valSelect.style.display = newSkillId > 0 ? '' : 'none';
                    dojoWrap.style.display = newSkillId > 0 ? '' : 'none';
                    renderSpecsCheckboxes(specsCell, newSkillId, '', '');
                    recalculate();
                });
                nameCell.innerHTML = '';
                nameCell.appendChild(skillSelect);
            });

            const combatSkillRow = document.querySelector('[data-combat-skill-row]');
            if (combatSkillRow) {
                const cell = combatSkillRow.querySelector('[data-combat-skill-select-cell]');
                const currentId = parseInt(combatSkillRow.dataset.combatSkillId, 10) || 0;
                if (cell) {
                    cell.innerHTML = '';
                    const select = buildCombatSkillSelect(currentId);
                    select.addEventListener('change', recalculate);
                    cell.appendChild(select);
                }
            }

            refreshEquipmentSelects();

            document.querySelectorAll('[data-advantage-slot]').forEach(li => {
                const kind = li.dataset.advantageKind;
                const currentId = parseInt(li.dataset.advantageId, 10) || 0;
                const nameSpan = li.querySelector('[data-advantage-name]');
                const summary  = li.querySelector('[data-advantage-summary]');
                const select = buildAdvantageSelect(kind, currentId);
                select.addEventListener('change', () => {
                    const newId = parseInt(select.value, 10) || 0;
                    if (summary) {
                        const list = (kind === 'advantage') ? (cfg.advantages || []) : (cfg.disadvantages || []);
                        const advantage = list.find(a => a.id === newId);
                        const description = advantage ? (advantage.description || '').replace(/<[^>]*>/g, '') : '';
                        summary.textContent = advantage ? (advantage.summary || description) : '';
                        $(summary).tooltip('dispose');
                        summary.removeAttribute('title');
                        if (advantage && !advantage.summary) {
                            summary.title = description;
                            $(summary).tooltip();
                        }
                    }
                    recalculate();
                });
                if (nameSpan) {
                    nameSpan.innerHTML = '';
                    nameSpan.appendChild(select);
                }
            });

            document.querySelectorAll('.spell-line').forEach(li => li.appendChild(buildSpellRemove()));
            refreshSpellSelects();
            document.querySelectorAll('.inventory-line').forEach(appendInventoryRemove);
            refreshInventorySelect();
        }

        function getSpecsCell(row) {
            const specsRow = document.querySelector(`[data-skill-specs-row="${row.dataset.skillRow}"]`);
            return specsRow ? specsRow.querySelector('[data-skill-specs-cell]') : null;
        }

        const SKILL_DOJO_ICONS = {
            0: 'sort-icon fa-regular fa-square',
            1: 'sort-icon fa-solid fa-graduation-cap',
            2: 'sort-icon fa-solid fa-graduation-cap'
        };
        const SPEC_DOJO_ICONS = {
            0: 'sort-icon fa-regular fa-square',
            1: 'sort-icon fa-solid fa-square-check',
            2: 'sort-icon fa-solid fa-graduation-cap'
        };
        function bindTriState(wrap, icon, initialState, iconClasses, onState) {
            function apply(state) {
                wrap.dataset.state = String(state);
                icon.className = iconClasses[state] || iconClasses[0];
                if (typeof onState === 'function') onState(state);
            }
            apply(Math.max(0, Math.min(2, parseInt(initialState, 10) || 0)));
            wrap.addEventListener('click', (e) => {
                e.preventDefault();
                const cur = parseInt(wrap.dataset.state, 10) || 0;
                apply((cur + 1) % 3);
                recalculate();
            });
        }

        function renderSpecsCheckboxes(cell, skillId, bitmask, dojoBitmask) {
            if (!cell) return;
            cell.innerHTML = '';
            if (!skillId) return;
            const skill = cfg.skills.find(c => c.id === skillId);
            if (!skill || !Array.isArray(skill.specialisations)) return;
            skill.specialisations.forEach((label, idx) => {
                if (!label) return;
                const wrap = document.createElement('span');
                wrap.className = 'skill-spec-sort';
                wrap.dataset.specIndex = String(idx);
                const icon = document.createElement('i');
                wrap.appendChild(icon);
                const txt = document.createElement('span');
                txt.textContent = label;
                wrap.appendChild(txt);
                const tag = document.createElement('small');
                tag.className = 'spec-dojo-tag';
                tag.textContent = 'offerte école';
                wrap.appendChild(tag);

                let initial = 0;
                if (dojoBitmask && dojoBitmask[idx] === '1') initial = 2;
                else if (bitmask && bitmask[idx] === '1') initial = 1;
                bindTriState(wrap, icon, initial, SPEC_DOJO_ICONS);

                cell.appendChild(wrap);
            });
        }

        function readBitmask(row) {
            const specsRow = document.querySelector(`[data-skill-specs-row="${row.dataset.skillRow}"]`);
            if (!specsRow) return '';
            const wraps = specsRow.querySelectorAll('.skill-spec-sort');
            if (wraps.length === 0) return '';
            const bits = ['0','0','0','0','0','0'];
            wraps.forEach(w => {
                const idx = parseInt(w.dataset.specIndex, 10);
                const state = parseInt(w.dataset.state, 10) || 0;
                if (state >= 1 && idx >= 0 && idx < 6) bits[idx] = '1';
            });
            return bits.join('');
        }

        function readDojoSpecBitmask(row) {
            const specsRow = document.querySelector(`[data-skill-specs-row="${row.dataset.skillRow}"]`);
            if (!specsRow) return '';
            const wraps = specsRow.querySelectorAll('.skill-spec-sort');
            if (wraps.length === 0) return '';
            const bits = ['0','0','0','0','0','0'];
            wraps.forEach(w => {
                const idx = parseInt(w.dataset.specIndex, 10);
                const state = parseInt(w.dataset.state, 10) || 0;
                if (state === 2 && idx >= 0 && idx < 6) bits[idx] = '1';
            });
            return bits.join('');
        }

        function submitSheet() {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = cfg.editUrl;

            function addInput(name, value) {
                const i = document.createElement('input');
                i.type = 'hidden';
                i.name = name;
                i.value = value;
                form.appendChild(i);
            }

            traits.forEach(name => {
                const span = document.querySelector(`[data-trait-eff="${name}"]`);
                const select = span ? span.querySelector('select') : null;
                if (select) addInput(`player_sheet[${name}]`, select.value);
            });

            document.querySelectorAll('[data-skill-row]').forEach(row => {
                const i = row.dataset.skillRow;
                const skillSelect = row.querySelector('.skill-select');
                const valSelect = row.querySelector('.val-select');
                const dojoWrap = row.querySelector('.skill-dojo-sort');
                const skillId = skillSelect && parseInt(skillSelect.value, 10) > 0 ? skillSelect.value : '';
                const valVal = skillId !== '' && valSelect && valSelect.value ? valSelect.value : '';
                const specsVal     = skillId !== '' ? readBitmask(row) : '';
                const dojoSpecValue     = skillId !== '' ? readDojoSpecBitmask(row) : '';
                const skillDojoValue = skillId !== '' && dojoWrap
                    ? String(parseInt(dojoWrap.dataset.state, 10) || 0)
                    : '0';
                addInput(`player_sheet[competence${i}]`, skillId);
                addInput(`player_sheet[valeur${i}]`, valVal);
                addInput(`player_sheet[specialisations${i}]`, specsVal);
                addInput(`player_sheet[compEcole${i}]`, skillDojoValue);
                addInput(`player_sheet[speEcole${i}]`, dojoSpecValue);
            });

            const slotToField = {av1: 'avantage1', av2: 'avantage2', dv1: 'desavantage1', dv2: 'desavantage2'};
            Object.keys(slotToField).forEach(slot => {
                const li = document.querySelector(`[data-advantage-slot="${slot}"]`);
                if (!li) return;
                const select = li.querySelector('select.advantage-select');
                const id = select && parseInt(select.value, 10) > 0 ? select.value : '';
                addInput(`player_sheet[${slotToField[slot]}]`, id);
            });

            const combatSkillSelect = document.querySelector('select.combat-skill-select');
            const combatSkillId = combatSkillSelect && parseInt(combatSkillSelect.value, 10) > 0 ? combatSkillSelect.value : '';
            addInput('player_sheet[compCombatActuelle]', combatSkillId);

            const currentWeaponSelect = document.querySelector('select.current-weapon-select');
            const currentWeaponId = currentWeaponSelect && parseInt(currentWeaponSelect.value, 10) > 0 ? currentWeaponSelect.value : '';
            addInput('player_sheet[armeActuelle]', currentWeaponId);

            const armorSelect = document.querySelector('select.armor-select');
            const armorId = armorSelect && parseInt(armorSelect.value, 10) > 0 ? armorSelect.value : '';
            addInput('player_sheet[armure]', armorId);

            ['koku', 'bu', 'zeni'].forEach(coin => {
                const el = document.getElementById(`purse-input-${coin}`);
                addInput(`player_sheet[${coin}]`, el ? el.value.trim() : '');
            });

            ['honneur', 'gloire', 'infamie', 'statut'].forEach(field => {
                const el = document.getElementById(`standing-input-${field}`);
                addInput(`player_sheet[${field}]`, el ? el.value.trim() : '');
            });

            const lookIds = {
                age: 'look-input-age', height: 'look-input-height', weight: 'look-input-weight',
                hair: 'look-input-hair', eyes: 'look-input-eyes', appearance: 'look-input-appearance',
                notes: 'look-input-notes',
            };
            Object.keys(lookIds).forEach(field => {
                const el = document.getElementById(lookIds[field]);
                addInput(`player_sheet[${field}]`, el ? el.value.trim() : '');
            });

            const modIds = {
                initiativeModifier: 'mod-input-initiative',
                attaqueModifier:    'mod-input-attack',
                dmgModifier:        'mod-input-dmg',
                ndModifier:         'mod-input-tn',
                reductionModifier:  'mod-input-reduction',
            };
            Object.keys(modIds).forEach(field => {
                const el = document.getElementById(modIds[field]);
                addInput(`player_sheet[${field}]`, el ? el.value.trim() : '');
            });

            document.querySelectorAll('[data-inventory-id]').forEach(li => {
                addInput('player_sheet[inventoryItems][]', li.dataset.inventoryId);
            });

            document.querySelectorAll('[data-spell-id]').forEach(li => {
                addInput('player_sheet[knownSpells][]', li.dataset.spellId);
            });

            addInput('player_sheet[_token]', cfg.csrfToken);
            document.body.appendChild(form);
            form.submit();
        }

        if (btnEdit) btnEdit.addEventListener('click', enterEditMode);
        if (btnCancel) btnCancel.addEventListener('click', () => location.reload());
        if (btnSave) btnSave.addEventListener('click', submitSheet);
    })();
    </script>
    {% endif %}
{% endblock %}
