{% if items is defined and (items is not empty or empty_message is defined) %}

  {% set reveal_session = reveal_session|default(false) %}
  {% set hide_dead = hide_dead|default(false) %}
  {% set items = items|filter(item => element_listed(item, reveal_session) and not (hide_dead and item.dead)) %}
  {% set scroll = scroll|default(false) %}
  {% set items = keep_order|default(false) ? items : element_sort(items, scroll) %}
  {% set variant = variant|default('landscape') %}
  {% set shape = {landscape: '1610', rule: '43', icon: '11'}[variant]|default('1610') %}
  {% set pin = {portrait: 'pin-topleft', icon: 'pin-downcenter'}[variant]|default('') %}
  {% set show_label = variant != 'portrait' %}
  {% set is_mj = app.user and is_granted('ROLE_MJ') %}
  {% set access_label = access_label|default(false) and is_mj %}
  {% set plain = reveal_session %}
  {% set badge_hover = badge_hover|default(false) %}
  {% set catalog = catalog|default(false) %}
  {% set type_badges = type_badges|default([]) %}
  {% set type_icon = type_icon|default(false) %}

  {% if scroll and per_row is not defined %}{% set per_row = {desktop: 6, mobile: 2} %}{% endif %}
  {% if per_row is defined %}
    {% set cols = per_row is iterable ? per_row : {desktop: per_row} %}
    {% set style = '--grid-min: 0' %}
    {% for palier, nombre in cols %}
      {% set style = style ~ '; --cols-' ~ palier ~ ': ' ~ nombre %}
    {% endfor %}
  {% else %}
    {% set style = min_size is defined ? '--grid-min: ' ~ min_size : '' %}
  {% endif %}
  {% if max_size is defined %}{% set style = style ~ '; --image-max: ' ~ max_size %}{% endif %}
  {% if gap is defined %}{% set style = style ~ '; --gap: ' ~ gap %}{% endif %}

  {% if title is defined %}
    <div class="{{ wrapper|default('col-12') }}">
      <div class="card card-body">
        {% if btn_add is defined %}{{ include('/btns/btn-add-element.html.twig', btn_add, with_context = false) }}{% endif %}
        <h2 class="heading-cardtitle">{{ title }}</h2>
        <hr>
  {% endif %}

  {% set wrapper_class = title is not defined ? wrapper|default('') : '' %}

  {% if scroll %}
    <div class="picture-scroller {{ wrapper_class }}"{% if scroll_id is defined %} id="{{ scroll_id }}"{% endif %}>
      <button type="button" class="scroller-btn" data-direction="-1" aria-label="Défiler vers la gauche"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
  {% endif %}

  <div class="picture-grid {{ scroll ? 'scroll' : wrapper_class }}" style="{{ style }}">
    {% for item in limit is defined ? items|slice(0, limit) : items %}

      {% set state = element_state(item, reveal_session) %}
      {% set hidden = not element_readable(item) %}
      {% set locked = not plain and not access_label and state == 'locked' %}
      {% set restricted = plain and hidden %}
      {% set item_class = plain ? (restricted ? 'restricted' : 'hover-zoom') : (element_unseen(item) and not access_label ? 'access-hidden ' : '') ~ (locked ? 'locked ' : '') ~ (catalog ? 'catalog ' : '') ~ (hidden or locked ? '' : 'hover-zoom') %}
      {% set name = item.nomComplet is defined ? item.nomComplet : (item.nom is defined ? item.nom : item.titre) %}
      {% set alt = hidden ? 'À découvrir' : name %}
      {% set pdf_only = item.pdf|default(null) and not item.hasParts|default(false) %}
      {% set image_na = pdf_only ? NA_PDF : na_image|default(NA_ICON) %}
      {% set pdf_link = pdf_only and not is_mj and app.user %}
      {% set href = pdf_link ? asset(item.pdf) : (route is defined ? path(route, {id: item.id}) : element_url(item)) %}

      <a class="picture-item {{ variant }} {{ item_class }}"
         {% if hidden or not href %}aria-disabled="true"{% else %}{% if show_label %}title="{{ name }}" {% endif %}{% if pdf_link %}target="_blank" rel="noopener" {% endif %}href="{{ href }}"{% endif %}>
        <div class="image-container {% if locked %}slight-fade{% endif %}">

          {% if not access_label %}
            {% if catalog %}
              {{ include('parts/badge-catalog.html.twig', {item: item}) }}
            {% else %}
              {% set pinned = badge_hover and not is_mj and element_individual(item) %}
              {{ include('parts/badge-access.html.twig', {
                state: pinned and state == 'common-discovered' ? 'unlocked' : state,
                variant: badge_hover and not pinned ? 'hover-only' : '',
              }) }}
            {% endif %}
          {% endif %}

          {% if locked %}
            <img class="icon-lock{% if variant == 'icon' %} in-icon{% endif %}" src="{{ asset(LOCKED_ICO) }}" alt="Cadenas" />
          {% endif %}

          {% if element_fresh(item) %}{{ include('parts/badge-new.html.twig', {variant: pin}) }}{% endif %}

          {% if variant == 'portrait' %}
            {% set na_genre = item.genre == 'F' ? NA_PERSO_PORTRAIT_F : (item.genre == 'M' ? NA_PERSO_PORTRAIT_M : NA_PERSO_PORTRAIT) %}
            <img class="picture {{ item.dead|default(false) ? 'effect-dead' }}" src="{{ asset(item.icone|default(na_genre)) }}" alt="{{ alt }}" />
            {% if not hidden and item.dead|default(false) %}
              <img class="character-icon-dead" src="{{ asset(MORT_ICO) }}" alt="est mort" />
            {% endif %}

          {% elseif variant == 'emblem' %}
            <span class="hover-ray">
              <img class="picture" src="{{ asset(attribute(item, field|default('mon'))|default(image_na)) }}" alt="{{ alt }}" />
            </span>

          {% elseif variant == 'icon' %}
            <img class="picture" src="{{ asset(item.icone|default(image_na)) }}" alt="{{ alt }}" />

          {% else %}
            {% if pdf_only %}<img class="badge-corner" src="{{ asset(PDF) }}" alt="Icône PDF" />{% endif %}
            <div class="frame ratio-{{ shape }}">
              <img class="ratio-cropped" src="{{ asset(item.imageAffichee|default(item.image|default(image_na))) }}" alt="{{ alt }}" />
              {% if not hidden and item.icone|default(null) %}
                <img class="hover-icon" src="{{ asset(item.icone) }}" alt="" />
              {% endif %}
            </div>
          {% endif %}

          {% if not show_label and not hidden %}
            <span class="hover-tooltip"><span class="label">{{ name }}</span></span>
          {% endif %}
        </div>

        {% if show_label %}
          <div class="label">
            {%- set clan = item.clan|default(null) -%}
            {%- set clan_color = clan and element_listed(clan) ? clan.couleur : null -%}
            {%- if type_icon and item.typeIcon|default(null) -%}
              <span class="label-icon" title="{{ item.type }}"{% if clan_color %} style="--clan-color: {{ clan_color }}"{% endif %}><i class="{{ item.typeIcon }}" aria-hidden="true"></i></span>
            {%- endif -%}
            {%- if item.type|default(null) in type_badges -%}
              <span class="label-badge"{% if clan_color %} style="--clan-color: {{ clan_color }}"{% endif %}>{{ item.type }}</span>
            {%- endif -%}
            {{ name }}
            {%- if access_label -%}
              <div class="label-access">{{ include('parts/badge-access.html.twig', {state: state, variant: 'inline mini'}) }}</div>
            {%- endif %}
          </div>
        {% endif %}

        {% if restricted %}
          <span class="access-tooltip">Connectez votre personnage pour vérifier l'accès à cet élément</span>
        {% endif %}
      </a>

    {% else %}
      <span class="grid-empty text-muted font-italic">{{ empty_message|default('') }}</span>
    {% endfor %}
  </div>

  {% if scroll %}
      <button type="button" class="scroller-btn" data-direction="1" aria-label="Défiler vers la droite"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
    </div>
  {% endif %}

  {% if title is defined %}
      </div>
    </div>
  {% endif %}

{% endif %}
