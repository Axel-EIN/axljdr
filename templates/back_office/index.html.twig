{% extends 'base.html.twig' %}

{% block title %}Panneau d'Administration {{ parent() }}{% endblock %}

{% block stylesheets %}
    {{parent()}}
    <link rel="stylesheet" href="{{asset('css/forms.css')}}" />
    <link rel="stylesheet" href="{{asset('css/pages/backoffice.css')}}" />
{% endblock %}

{% block body %}

    <main class="container-fluid page-min">
        <div class="container py-5 relative">
            <h1 class="heading-gmpanel text-center">
                {% block h1 %}
                  Panneau
                    {% if app.user and is_granted("ROLE_ADMIN") %}
                      d'Administration
                    {% else %}
                      du Maître
                    {% endif %}
                {% endblock %}
            </h1>

            {{ include('back_office/nav-admin.html.twig') }}
            {{ include('parts/flash-messages.html.twig') }}

            {% block child %}

                {% if is_gm() %}
                    {% for section in [
                        {title: 'Aventure',    text: "Éléments ajoutés pour le descriptif de l'aventure."},
                        {title: 'Personnages', text: 'Tous les personnages enregistrés.'},
                        {title: 'Univers',     text: "Éléments ajoutés pour le descriptif de l'univers de jeu."},
                        {title: 'Règles',      text: 'Éléments ajoutés pour les mécaniques de jeu.'},
                    ] %}
                        <h2 class="heading-categorysubsection mt-5">{{ section.title }}</h2>
                        <p class="mb-4 text-muted">{{ section.text }}</p>
                        <section class="row pb-5">
                            {% for admin_element in admin_elements|filter(e => e.category == section.title) %}
                                {{ include('back_office/card-element-summary.html.twig', admin_element) }}
                            {% endfor %}
                        </section>
                    {% endfor %}
                {% endif %}

                {% if app.user and is_granted("ROLE_ADMIN") %}
                    <h2 class="heading-categorysubsection mt-5">Comptes Utilisateurs</h2>
                    <p class="mb-4 text-muted">Tous les comptes utilisateurs.</p>
                    <section class="row pb-5">
                        {{ include('back_office/card-element-summary.html.twig', {
                            label: 'Utilisateurs',
                            element: 'user',
                            count: userCount,
                            last: lastUser,
                            name: lastUser ? lastUser.pseudo : null,
                            image: lastUser ? lastUser.avatar : null,
                        }) }}
                    </section>
                {% endif %}

            {% endblock %}

        </div>
    </main>

{% endblock %}

{% block javascripts %}
    {{parent()}}
    <script src="{{ asset('scripts/forms.js') }}"></script>
{% endblock %}