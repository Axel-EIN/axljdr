{% extends 'element.html.twig' %}

{% block element_content %}

    <div class="col-12">
        <div class="card card-page">
        
            {{ include('/parts/card-top-image.html.twig', {image: record.image, na_image: NA_ARCHIVE, alt: 'Image de ' ~ name, img_class: 'crop-169', title: name, state: element_state(record)}) }}

            {{ include('parts/description.html.twig', {text: record.contenu, variant: 'aerated'}, with_context = false) }}
        
            {% if record.auteur is not empty %}
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <strong>Auteur&nbsp;:</strong> {{ record.auteur.nom }} <strong>{{ record.auteur.prenom }}</strong> 
                    </li>
                </ul>
            {% endif %}

            {{ include('/parts/divider-ornament.html.twig') }}

            {% if is_gm() %}
                {% set redirect, element, record, color, action = 'world', 'archive', record, 'link-gm', 'delete' %}
                {{ include('/btns/btn-line.html.twig') }}
            {% endif %}

        </div>
    </div>

    {{ include('/parts/picture-grid.html.twig', {
        title: 'Autres Archives',
        items: other_archives, route: 'world_archive',
        na_image: NA_ARCHIVE,
    }) }}

{% endblock %}
