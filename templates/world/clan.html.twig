{% extends 'element.html.twig' %}

{% block stylesheets %}
    {{parent()}}
    <link rel="stylesheet" href="{{asset('css/components/banner-intro.css')}}" />
    <link rel="stylesheet" href="{{asset('css/pages/clan.css')}}" />
    <link rel="stylesheet" href="{{asset('css/components/map.css')}}" />
{% endblock %}

{% block element_content %}

    {{ include('world/clan-banner.html.twig', {clan, all_clans}) }}

    <div class="col-12 col-lg-8">
        <div class="card card-body relative">

            {{ include('/btns/btn-add-element.html.twig', {
                entity: 'family', label_one: 'une famille',
                position: 'topright-corner-inside-more', options: 'clanID=' ~ clan.id,
            }) }}

            <h2 class="heading-cardtitle">Familles</h2>
            <div class="card-text">

                {% for family in clan.familles %}
                    <hr{% if not loop.first %} class="my-5"{% endif %}>
                    <article id="{{ family.nom }}" class="family relative">

                        {% if is_gm() %}
                            {% set redirect, entity, record, size, color, position = 'clan', 'family', family, 'btn-icon-small', 'link-gm', 'topright-corner-snap' %}
                            {{ include('/btns/btn-icon-edit.html.twig') }}
                        {% endif %}

                        <div class="family-mon">
                            <img class="img-fluid circle-crop" src="{{ asset(family.mon|default(NA_MON)) }}" alt="Mon Famille" />

                            {% if family.chef is not empty %}
                                <a class="family-daimyo hover-zoom" href="{{ path('characters_profile', {id: family.chef.id} ) }}" title="{{ family.chef.nomComplet }}">
                                    <span class="text-muted">Daimyo</span>
                                    <img class="character-portrait medium" src="{{ asset(family.chef.icone|default(NA_PERSO_PORTRAIT)) }}" alt="Icône du personnage" />
                                </a>
                            {% endif %}
                        </div>

                        <div class="family-header">
                            <h3><strong>{{ family.nom }}</strong></h3>
                            {% if family.bonusStatNom %}
                                {% set labels = {'constitution':'Constitution','volonte':'Volonté','reflexes':'Réflexes','intuition':'Intuition','agilite':'Agilité','intelligence':'Intelligence','forceStat':'Force','perception':'Perception','vide':'Vide'} %}
                                <strong style="color: {{ clan.couleur }}">Trait bonus : {{ labels[family.bonusStatNom] ?? family.bonusStatNom }} +1</strong>
                            {% endif %}
                        </div>

                        <p class="family-description text-description">{{ family.description|raw|nl2br }}</p>

                    </article>
                {% else %}
                    <span class="text-muted"><i>Familles à venir</i></span>
                {% endfor %}

            </div>
        </div>
    </div>

    {{ include('/parts/picture-grid.html.twig', {
        title: 'Écoles',
        variant: 'rule',
        items: clan.ecoles, route: 'rules_dojo',
        na_image: NA_ECOLE,
        per_row: 1,
        wrapper: 'col-12 col-lg-4',
        btn_add: {entity: 'dojo', label_one: 'une école', position: 'topright-corner-inside-more', options: 'clanID=' ~ clan.id},
        empty_message: 'Écoles à venir.',
    }) }}

    {% set territory_placed = clan.locX is not empty and clan.locY is not empty %}

    {% set territory_visible_mobile = clan.territoireDesc is not empty %}
    {% if territory_placed or territory_visible_mobile %}
    <div class="col-12{% if not territory_visible_mobile %} d-none d-lg-block{% endif %}">
        <div class="card card-body">
            <h2 class="heading-cardtitle">Territoires</h2>
            <hr>

            {% if territory_placed %}
                {{ include('parts/map.html.twig', {
                    locations: clan.lieux.toArray, center: clan, zoom: clan.zoom, territories: true, labels: true, large_markers: true, emblem: clan.mon|default(NA_MON),
                    emblem_at: clan.emblemX is not null and clan.emblemY is not null ? {locX: clan.emblemX, locY: clan.emblemY} : null,
                }, with_context = false) }}
            {% endif %}

            {% if territory_visible_mobile %}
                {{ include('parts/description.html.twig', {text: clan.territoireDesc, variant: 'aerated'}, with_context = false) }}
            {% endif %}

        </div>
    </div>
    {% endif %}

    {% set clan_locations = clan.lieux.toArray|filter(l => element_listed(l)) %}
    {% set fortified_types = ['Palais Fortifié', 'Forteresse', 'Palais'] %}
    {% set urban_types = ['Cité', 'Ville', 'Village'] %}
    {% set location_groups = [
        {title: 'Forteresses & Palais', column: '', per_row: 6, items: clan_locations|filter(l => l.type in fortified_types)},
        {title: 'Cités, Villes & Villages', column: 'col-lg-6', per_row: 3, items: clan_locations|filter(l => l.type in urban_types)},
        {title: 'Autres', column: 'col-lg-6', per_row: 3, items: clan_locations|filter(l => l.type not in fortified_types|merge(urban_types))},
    ] %}

    <div class="col-12">
        <div class="card card-body">

            {{ include('/btns/btn-add-element.html.twig', {
                entity: 'location', label_one: 'un lieu',
                position: 'topright-corner-inside-more', options: 'filter[0]=' ~ clan.nom|url_encode,
            }) }}

            <h2 class="heading-cardtitle">Lieux</h2>
            <hr>

            {% if clan_locations is not empty %}
                <div class="row">
                    {% for group in location_groups|filter(group => group.items is not empty) %}
                        <div class="col-12 {{ group.column }} mt-2 mb-4">
                            <h3 class="heading-amerigo mb-3">{{ group.title }}</h3>
                            {{ include('/parts/picture-grid.html.twig', {
                                variant: 'icon',
                                items: group.items, route: 'world_location', na_image: NA_LIEU_ICO,
                                per_row: {desktop: group.per_row, tablet: 4, mobile: 2},
                            }) }}
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <span class="text-muted font-italic">Il n'y a pas encore de lieu rattaché à ce clan.</span>
            {% endif %}

        </div>
    </div>

    {% if clan.longDescription is defined and clan.longDescription is not empty %}
        {% set col_side, portraits_per_row = "col-12 col-lg-4", 2 %}
        <div class="col-12 col-lg-8">
            <div class="card card-body">
                <h2 class="heading-cardtitle">Autres</h2>
                <hr>
                {{ include('parts/description.html.twig', {text: clan.longDescription}, with_context = false) }}
            </div>
        </div>
    {% else %}
        {% set col_side, portraits_per_row = "col-12", 8 %}
    {% endif %}

    {{ include('/parts/picture-grid.html.twig', {
        variant: 'portrait',
        title: 'Personnages',
        items: clan.personnages, route: 'characters_profile', hide_dead: true,
        wrapper: col_side,
        per_row: {desktop: portraits_per_row, tablet: 4, mobile: 2},
        empty_message: "Il n'y a pas encore de personnage rattaché à ce clan.",
    }) }}

{% endblock %}

{% block javascripts %}
    {{parent()}}
    <script src="{{ asset('scripts/clan.js') }}"></script>
    <script src="{{ asset('scripts/map.js') }}"></script>
{% endblock %}
