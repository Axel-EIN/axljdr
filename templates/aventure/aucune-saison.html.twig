{% extends 'base.html.twig' %}
{% block title %}Aucune saison {{ parent() }}{% endblock %}
{% block body %}
  <main class="container-fluid mt-2 pb-5 mb-5">
    <div class="container relative text-center pt-5">
      {{ include('parts/messages-flashes.html.twig') }}

      <h1 class="element-title m-0 p-0"><strong>Pas encore de saison disponible</strong></h1>
      <hr class="m-0 mb-3">
      <p class="text-muted font-italic">L'aventure n'a pas encore commencé.</p>

      {% if app.user and is_granted('ROLE_MJ') %}
        <a href="{{ path('admin_saison_create') }}" class="btn btn-accent mt-3">Créer la première saison</a>
      {% endif %}
    </div>
  </main>
{% endblock %}
