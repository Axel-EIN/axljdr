{% extends 'element.html.twig' %}

{% block stylesheets %}
    {{parent()}}
    <link rel="stylesheet" href="{{asset('css/components/history.css')}}" />
    <link rel="stylesheet" href="{{asset('css/components/edit-mode.css')}}" />
    <link rel="stylesheet" href="{{asset('css/components/map.css')}}" />
    <link rel="stylesheet" href="{{asset('css/pages/character-profile.css')}}" />
{% endblock %}

{% block element_content %}

{% if personnage.illustration is null and personnage.genre == 'F' %}
    {% set NA_PERSO_ILLU = NA_PERSO_ILLU_F %}
{% elseif personnage.illustration is null and personnage.genre == 'M' %}
    {% set NA_PERSO_ILLU = NA_PERSO_ILLU_M %}
{% endif %}

{% set illustration_src = asset(personnage.illustration|default(NA_PERSO_ILLU)) %}
{% set illustration_preset = image_preset('vertical450') %}

<div class="col-12 d-lg-none order-0 relative">
    <div class="profile-banner-mobile">
        <img src="{{ illustration_src }}" alt="{{ personnage.nomComplet }}" title="{{ personnage.nomComplet }}" />
    </div>
    {{ include('parts/badge-access.html.twig', {state: element_state(personnage)}) }}
</div>

{# ============================= #}
{# ===== [CARD] LEFT INFOS ===== #}
{# ============================= #}

<div class="col-12 col-lg-4 order-2 order-lg-1">
    <div class="card card-body profile-infos">

        {% set fiche_visible = personnage.fichePersonnage is not null and (est_le_joueur or is_mj()) %}
        {% set fiche_addable = personnage.fichePersonnage is null and is_mj() %}

        <div class="relative">
            <div class="profile-illustration d-none d-lg-block {{ fiche_visible or fiche_addable ? 'with-btn' }}">
                <img class="img-fluid w-100" src="{{ illustration_src }}" width="{{ illustration_preset.width }}" height="{{ illustration_preset.height }}" alt="{{ personnage.nomComplet }}" title="{{ personnage.nomComplet }}" />
                {{ include('parts/badge-access.html.twig', {state: element_state(personnage)}) }}
            </div>

            {% if fiche_visible %}
                <div class="profile-btn-fiche">
                    <a class="btn-primary-style btn-medium{% if not est_le_joueur %} gm{% endif %}" href="{{ path('personnage_fiche', {id: personnage.fichePersonnage.id}) }}">
                        <i class="fas fa-scroll"></i> Voir la Fiche de Jeu
                    </a>
                </div>
            {% elseif fiche_addable %}
                <div class="profile-btn-fiche">
                    {{ include('btns/btn-add-element.html.twig', {
                        entity: 'fiche', label_one: 'Fiche Personnage', options: 'personnage=' ~ personnage.id, position: ''
                    }) }}
                </div>
            {% endif %}
        </div>

        <ul class="list-group list-group-flush profile-infos-list">

        {% if xp > 0 %}
            <li class="list-group-item infos-item profile-xp-and-rank">
                <span class="badge-rang-{{rang}} large">RANG {{rang}}</span>
                <span class="xp-number">{{xp}} XP</span>
            </li>
        {% endif %}

        {% if personnage.clan is defined and personnage.clan is not empty %}
            <li class="list-group-item infos-item">
                Clan :
                <a href="{{ path('world_clan', {id: personnage.clan.id} ) }}">
                    {{ personnage.clan.nom }}
                    <img class="img-48" src="{{ asset(image_small(personnage.clan.mon|default(NA_MON))) }}" alt="Mon du Clan {{personnage.clan.nom}}" title="Mon du Clan {{personnage.clan.nom}}" />
                </a>
            </li>
        {% endif %}

        {% if personnage.famille is defined and personnage.famille is not empty %}
            <li class="list-group-item infos-item">
                Famille :
                <a href="{{ path('world_clan', {id: personnage.clan.id, '_fragment': personnage.famille.nom } ) }}">
                    {{ personnage.famille.nom }}
                    <img
                    class="img-48 rounded-circle" src="{{ asset(image_small(personnage.famille.mon|default(NA_MON))) }}"
                    alt="Mon de la Famille {{personnage.famille.nom}}" title="Mon de la Famille {{personnage.famille.nom}}"
                    />
                </a>
            </li>
        {% endif %}

        {% if personnage.ecole is defined and personnage.ecole is not empty %}
            <li class="list-group-item infos-item">
                École :
                <a href="{{ path('regles_ecole', {id: personnage.ecole.id} ) }}">
                    {{ personnage.ecole.nom }}
                    <img class="img-48" src="{{ asset(image_small(personnage.classe.icone|default(NA_CLASS_ICO))) }}" alt="Classe {{personnage.classe.nom}}" title="Classe {{personnage.classe.nom}}" />
                </a>
            </li>
        {% endif %}

      {% if personnage.joueur is not empty %}
        <li class="list-group-item infos-item">Joueur : <span class="bold">{{ personnage.joueur.pseudo }}</span></li>
      {% endif %}

      {% if position_libre or position_actuelle %}
        <li class="list-group-item infos-item{% if carte_visible %} with-map{% endif %}">
          Position :
          <a href="{{ position_connue ? path('map', {location: position_actuelle.id}) : path('map') }}" title="Voir sur la carte">
            {{ position_libre ? EN_DEPLACEMENT : (position_connue ? position_actuelle.nom : 'Inconnue') }}
            <i class="fa-solid fa-map-location-dot"></i>
          </a>
          {% if carte_visible %}
            {{ include('parts/map.html.twig', {
              lieux,
              current: position_connue ? position_actuelle : null,
              party: position_connue ? {(position_actuelle.id): [personnage]} : {},
              center: position_libre,
              wanderers: position_libre ? [position_libre] : [],
              zoom: position_connue ? position_actuelle.zoom : null,
              variant: 'mini',
              hide_minimap: true,
            }, with_context = false) }}
          {% endif %}
        </li>
      {% endif %}
    </ul>

  </div>
</div>

{# ======================= #}
{# ===== [CARD] MAIN ===== #}
{# ======================= #}

<div class="col-12 col-lg-8 order-1 order-lg-2">
    <div class="card card-body">

        {% if peut_editer %}
        {{ form_start(form, {action: path('personnage_profil_edit', {id: personnage.id})}) }}
        {% endif %}

        <div class="profile-maincontent profile-zone">

            {# ================================ #}
            {# ===== [CARD-SECTION] STORY ===== #}
            {# ================================ #}

            <h2 class="profile-description-title">Histoire</h2>

            {% if personnage.titres is defined and personnage.titres is not empty %}
                <h4 class="card-title-cartouche">{{ personnage.titres }}</h4>
            {% endif %}

            <p class="text-description text-compact read-only">{{ personnage.description|default('')|raw|nl2br }}</p>

            {% if peut_editer %}
                {{ form_widget(form.description, {attr: {class: 'edit-only'}}) }}
                {{ include('/btns/btn-interactive-edit-actions.html.twig', {label: 'Éditer'}) }}
            {% endif %}

            {# ========================================= #}
            {# ===== [CARD-SECTION] DEVELOPPEMENTS ===== #}
            {# ========================================= #}

            <div class="profile-developments">
                {% for development in developments %}
                    {% set scene = development.scene %}
                    {% set episode = scene.episodeParent %}
                    {% set chapitre = episode.chapitreParent %}
                    {% set scene_url = path('story_episode', {id: episode.id, '_fragment': 'scn' ~ scene.numero}) %}

                    <article class="development-line">
                        <div class="development-head">
                            <span class="development-title">
                                <a href="{{ scene_url }}">
                                    <img class="img-18 invert mr-1 align-middle" src="{{ asset(STORY_EPISODE_ICO) }}" alt="" />
                                    <strong>{{ scene.titre }}</strong>
                                </a>
                                {% if is_mj() %}
                                    {{ include('/btns/btn-icon-edit.html.twig', {
                                    entity: 'development', un_element: development, position: 'align-middle',
                                    redirect: 'development', size: 'btn-icon-mini', color: 'link-gm',
                                    }) }}
                                {% endif %}
                            </span>

                            <span class="development-meta">{{ chapitre.titre }} — EP #{{ episode.numeroSaison }} - Scène {{ scene.numero }}</span>
                            {% if development.estMort %}
                                <strong class="text-dead">MORT</strong>
                            {% endif %}
                        </div>

                        <div class="development-content">
                            <p class="text-description text-compact">{{ development.content|raw|nl2br }}</p>
                            <a class="development-image" href="{{ scene_url }}" title="Voir la scène {{ scene.numero }}">
                                <img src="{{ asset(image_small(scene.image|default(NA_SCENE))) }}" loading="lazy" alt="Scène {{ scene.numero }} — {{ scene.titre }}" />
                            </a>
                        </div>
                    </article>
                {% endfor %}

                <div class="zone-actions">
                    {{ include('/btns/btn-add-element.html.twig', {
                        entity: 'development', label_one: 'développement',
                        position: '', options: 'personnage=' ~ personnage.id,
                        variant: 'btn-quaternary-style link-gm',
                    }) }}
                </div>
            </div>

            {% if peut_editer %}

                {# ================================================ #}
                {# ===== [CARD-SECTION] SECRET PLAYER'S NOTES ===== #}
                {# ================================================ #}

                <div class="profile-zone">
                    {{ include('/parts/divider-ornament.html.twig') }}
                    <h2 class="profile-description-title">Secrets</h2>

                    {% if personnage.playerNotes is not empty %}
                        <p class="text-description text-compact read-only">{{ personnage.playerNotes|nl2br }}</p>
                    {% else %}
                        <p class="profile-description-na">Rien pour le moment.</p>
                    {% endif %}

                    {{ form_widget(form.playerNotes, {attr: {class: 'edit-only'}}) }}
                    {{ include('/btns/btn-interactive-edit-actions.html.twig', {label: 'Éditer'}) }}
                </div>


                {% if is_mj() %}
                    {# ===================================== #}
                    {# ===== [CARD-SECTION] GM's NOTES ===== #}
                    {# ===================================== #}

                    <div class="profile-zone">
                        {{ include('/parts/divider-ornament.html.twig') }}
                        <h2 class="profile-description-title gm">Notes du Maître de Jeu</h2>

                        {% if personnage.gmNotes is not empty %}
                            <p class="text-description text-compact read-only">{{ personnage.gmNotes|nl2br }}</p>
                        {% else %}
                            <p class="profile-description-na">Rien pour le moment.</p>
                        {% endif %}

                        {{ form_widget(form.gmNotes, {attr: {class: 'edit-only'}}) }}
                        {{ include('/btns/btn-interactive-edit-actions.html.twig', {label: 'Éditer'}) }}
                    </div>
                {% endif %}

                {{ form_end(form) }}
            {% endif %}

        </div>
    </div>
</div>

{# ========================== #}
{# ===== [CARD] HISTORY ===== #}
{# ========================== #}

<div class="col-12 col-lg-8 order-3">
    <div class="card card-body">
        <h2 class="heading-cardtitle">Historique</h2>
        <hr>
        <div class="card-text profile-historique">
            {{ include('parts/history.html.twig', {historique, saison_courante}) }}
            {% if xp_creation > 0 %}
            <p class="profile-creation">Création du personnage {{ personnage.prenom }} avec <strong>{{ xp_creation }}xp</strong>.</p>
            {% endif %}
        </div>
    </div>
</div>

{# =================================== #}
{# ===== [CARD] OTHER CHARACTERS ===== #}
{# =================================== #}

{{ include('/parts/picture-grid.html.twig', {
    variant: 'portrait',
    title: personnage.estPj ? 'Autres PJs' : 'Autres PNJs',
    items: autresPersonnages, route: 'personnage_profil', hide_dead: true,
    limit: 12,
    wrapper: 'col-12 col-lg-4 order-4',
    per_row: {desktop: 2, tablet: 4, mobile: 2},
    empty_message: "Il n'y a pas d'autres personnage.",
}) }}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if carte_visible %}<script src="{{ asset('scripts/map.js') }}"></script>{% endif %}
    {% if peut_editer %}
        <script>
            (function () {
            const bascule = (selecteur, action) => document.querySelectorAll(selecteur).forEach(
                btn => btn.addEventListener('click', () => btn.closest('.profile-zone').classList[action]('edit-mode'))
            );
            bascule('[data-edit-open]', 'add');
            bascule('[data-edit-cancel]', 'remove');
            })();
        </script>
    {% endif %}
{% endblock %}
