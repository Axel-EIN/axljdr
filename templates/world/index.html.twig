{% extends 'category.html.twig' %}
{% block title %}L'Univers de l'Aventure {{ parent() }}{% endblock %}

{% block stylesheets %}
    {{parent()}}
    <link rel="stylesheet" href="{{asset('css/components/picture-grid.css')}}" />
    <link rel="stylesheet" href="{{asset('css/pages/world.css')}}" />
{% endblock %}

{% block section_content1 %}
    {{ include('/parts/picture-grid.html.twig', {
        catalog: true,
        items: archives, route: 'world_archive', na_image: NA_ARCHIVE,
        wrapper: 'col-12', per_row: {desktop: 6, mobile: 2},
        empty_message: "Pas d'archives disponibles.",
    }) }}
{% endblock %}

{% block section_content2 %}
    {% set majeur = constant('App\\Entity\\FactionType::MAJEUR') %}
    {% set mineur = constant('App\\Entity\\FactionType::MINEUR') %}
    {% set titres = constant('App\\Entity\\FactionType::GROUPS') %}
    {% set intros = constant('App\\Entity\\FactionType::INTROS') %}
    {% if factions|filter(clans => clans is not empty) is empty %}
        <p class="col-12 text-muted font-italic">Pas de factions disponibles.</p>
    {% else %}

        <div class="col-12 col-lg-9">
            <h4 class="text-primarydark">{{ titres[majeur] }}</h4>
            <p class="faction-intro">{{ intros[majeur] }}</p>
            {{ include('/parts/picture-grid.html.twig', {
                catalog: true,
                variant: 'emblem',
                items: factions[majeur], route: 'world_clan', na_image: NA_MON,
                per_row: {desktop: 4, mobile: 2},
            }) }}
        </div>

        <div class="col-12 col-lg-3 border-left mt-4 mt-lg-0">
            {% for type, clans in factions|filter((clans, type) => type not in [majeur, mineur] and clans is not empty) %}
                <h4 class="text-primarydark text-center">{{ titres[type] }}</h4>
                <p class="faction-intro">{{ intros[type] }}</p>
                {{ include('/parts/picture-grid.html.twig', {
                    catalog: true,
                    variant: 'emblem',
                    items: clans, route: 'world_clan', na_image: NA_MON,
                    max_size: '6rem',
                    per_row: {desktop: 2, mobile: 3},
                }) }}
            {% endfor %}
        </div>

        {% if factions[mineur] is not empty %}
            <div class="col-12">
                <h4 class="text-primarydark mt-4">{{ titres[mineur] }}</h4>
                <p class="faction-intro">{{ intros[mineur] }}</p>
                {{ include('/parts/picture-grid.html.twig', {
                    catalog: true,
                    variant: 'emblem',
                    items: factions[mineur], route: 'world_clan', na_image: NA_MON,
                    per_row: {desktop: 8, mobile: 3},
                    gap: '1.5rem',
                }) }}
            </div>
        {% endif %}

    {% endif %}
{% endblock %}

{% block section_content3 %}
    {% for groupe in groupesLieux %}
        {% set scroller_id = 'lieux-' ~ loop.index %}
        <div class="col-12">
            <h3 class="heading-amerigo category-section-sub-heading flex-wrap relative">
                <span class="heading-mons">
                    {% for clan in groupe.clans|default([]) %}
                        <img class="img-40" src="{{ asset(image_small(clan.mon|default(NA_MON))) }}" alt="Mon de la faction" title="{{ clan.nom }}" />
                    {% endfor %}
                    {% if groupe.clans|default([]) is empty or groupe.sansGroupe|default(false) %}
                        <img class="img-40" src="{{ asset(NA_MON) }}" alt="Mon de la faction" />
                    {% endif %}
                </span>
                {{ groupe.titre }}
                {% set dots_color = groupe.clans|default([])|length == 1 ? (groupe.clans|first).couleur : null %}
                <span class="scroller-dots" data-scroller="{{ scroller_id }}"{% if dots_color %} style="--clan-color: {{ dots_color }}"{% endif %}></span>
            </h3>
            {{ include('/parts/picture-grid.html.twig', {
                catalog: true,
                variant: 'icon',
                scroll: true, scroll_id: scroller_id,
                type_icon: true,
                items: groupe.lieux, route: 'world_lieu', na_image: NA_LIEU_ICO,
                per_row: {desktop: 6, mobile: 2},
            }) }}
        </div>
    {% else %}
        <p class="col-12 text-muted font-italic">Pas de lieux disponibles.</p>
    {% endfor %}
{% endblock %}

{% block section_content4 %}
    {{ include('/parts/picture-grid.html.twig', {
        catalog: true,
        items: lores, route: 'world_lore', na_image: NA_ARCHIVE,
        wrapper: 'col-12', per_row: {desktop: 6, mobile: 2},
        empty_message: 'Pas de lore disponible.',
    }) }}
{% endblock %}
