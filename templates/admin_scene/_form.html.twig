<div class="col-12">
    {{ form_start(form, {'attr': {'id': 'form1'}}) }}
        <div class="row form-wrapper">
            <div class="col-3">{{ form_row(form.titre) }}</div>
            <div class="col-3">{{ form_row(form.episodeParent) }}</div>
            <div class="col-3">{{ form_row(form.lieu) }}</div>
            <div class="col-2">{{ form_row(form.temps) }}</div>
            <div class="col-1">{{ form_row(form.numero) }}</div>

            <div class="col-12">{{ form_row(form.texte,{ 'attr': {'rows': '15'} }) }}</div>

            <div class="col-12">{{ form_row(form.foundObjects) }}</div>

            <div class="offset-2 col-8 mt-3 mb-5">
                {{ include('parts/image-field.html.twig', {
                    field: form.image, input_id: 'admin_scene_image', prefix: 'image',
                    current: scene.image|default(null), fallback: NA_SCENE,
                    label: 'Image (1280×720 16:9 recommandé)', width: 1280, height: 720 }) }}
            </div>

            {% macro character_options(characters, selected_id) %}
                {% set current_clan = '__init__' %}
                {% for p in characters %}
                    {% set clan_name = p.clan ? p.clan.nom : 'Sans clan' %}
                    {% if clan_name != current_clan %}
                        {% if current_clan != '__init__' %}</optgroup>{% endif %}
                        <optgroup label="{{ clan_name }}">
                        {% set current_clan = clan_name %}
                    {% endif %}
                    <option value="{{ p.id }}" {% if selected_id is not null and p.id == selected_id %}selected{% endif %}>
                        {{ p.nomComplet }}
                    </option>
                {% endfor %}
                {% if current_clan != '__init__' %}</optgroup>{% endif %}
            {% endmacro %}
            {% import _self as macros %}

            <div class="col-12">
                Participants (facultatif) :<br/>
                <div class="form-row">

                    <div class="col-6 text-center">
                        <div class="d-flex">
                            <small class="ml-1">bonus x2</small>
                            <small class="ml-auto mr-3">XP gagné / mort</small>
                        </div>
                        {% if type != 'create' and pc_participations is not empty %}
                            {% for participation in pc_participations %}
                                {% set pc_count = loop.index0 %}
                                <div class="participants form-row">
                                    <input class="mt-1 col-1" type="checkbox" title="Bonus XP x2 (rattrapage)" name="participants_xpBonus[{{ pc_count }}]" id="data[participants_xpBonus][{{ pc_count }}]" {% if participation.xpBonus %}checked{% endif %} />
                                    <select class="form-control mt-1 ml-1 col-7" name="participants[{{ pc_count }}]" required id="data[participants][{{ pc_count }}]">
                                        {{ macros.character_options(all_pcs, participation.personnage.id) }}
                                    </select>
                                    <input class="form-control ml-1 mt-1 col-2" type="number" value="{{ participation.xpGagne }}" name="participants_xp[{{ pc_count }}]" id="data[participants_xp][{{ pc_count }}]" />
                                    <input class="mt-1 ml-1 col-1" type="checkbox" title="Mort" name="participants_dead[{{ pc_count }}]" id="data[participants_dead][{{ pc_count }}]" {% if participation.estMort %}checked{% endif %} />
                                </div>
                            {% endfor %}
                        {% endif %}
                        <button type="button" class="btn btn-medium btn-secondary-style mt-3" id="add-participants">Ajouter un PJ</button>
                    </div>

                    <div class="col-6 text-center">
                        <div class="text-right"><small class="mr-4">Mort</small></div>
                        {% if type != 'create' and npc_participations is not empty %}
                            {% for npc_participation in npc_participations %}
                                {% set npc_count = loop.index0 %}
                                <div class="npc_participants form-row">
                                    <select class="form-control mt-1 col-10" name="npc_participants[{{ npc_count }}]" required id="data[npc_participants][{{ npc_count }}]">
                                        {{ macros.character_options(all_npcs, npc_participation.personnage.id) }}
                                    </select>
                                    <input class="mt-1 ml-1 col-1" type="checkbox" name="npc_participants_dead[{{ npc_count }}]" id="data[npc_participants_dead][{{ npc_count }}]" {% if npc_participation.estMort %}checked{% endif %} />
                                </div>
                            {% endfor %}
                        {% endif %}
                        <button type="button" class="btn btn-medium btn-secondary-style mt-3" id="add-npc_participants">Ajouter un PNJ</button>
                    </div>

                </div>
            </div>

            {{ include('/btns/btn-form.html.twig') }}
        </div>
    {{ form_end(form) }}
</div>

<script type="text/javascript">
    {% set pcs_data = [] %}
    {% for p in all_pcs %}
        {% set pcs_data = pcs_data|merge([{
            id: p.id, nomComplet: p.nomComplet,
            clan: p.clan ? p.clan.nom : 'Sans clan'
        }]) %}
    {% endfor %}
    {% set npcs_data = [] %}
    {% for p in all_npcs %}
        {% set npcs_data = npcs_data|merge([{
            id: p.id, nomComplet: p.nomComplet,
            clan: p.clan ? p.clan.nom : 'Sans clan'
        }]) %}
    {% endfor %}
    const pjs  = {{ pcs_data|json_encode|raw }};
    const pnjs = {{ npcs_data|json_encode|raw }};

    document.addEventListener('DOMContentLoaded', function() {

        function buildOptionsHtml(list) {
            let html = '';
            let currentClan = null;
            list.forEach(p => {
                if (p.clan !== currentClan) {
                    if (currentClan !== null) html += '</optgroup>';
                    html += '<optgroup label="' + escapeHtml(p.clan) + '">';
                    currentClan = p.clan;
                }
                html += '<option value="' + p.id + '">' + escapeHtml(p.nomComplet) + '</option>';
            });
            if (currentClan !== null) html += '</optgroup>';
            return html;
        }

        function escapeHtml(s) {
            return String(s)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function setupParticipantSection(opts) {
            const $form = $('#form1');
            const $addBtn = $('#' + opts.addBtnId);

            function rebuildRemoveButton() {
                $form.find('.' + opts.removeBtnClass).remove();
                if ($form.find('div.' + opts.rowClass).length > 0) {
                    $addBtn.after(' <button type="button" class="' + opts.removeBtnClass
                        + ' btn mt-1 ml-2 btn-tertiary-style">Retirer</button>');
                }
            }
            rebuildRemoveButton();

            $addBtn.click(function(e) {
                e.preventDefault();
                const n = $form.find("select[name^='" + opts.selectNamePrefix + "[']").length;
                const optionsHtml = buildOptionsHtml(opts.data);
                const selectHtml = '<select class="' + opts.selectClass
                    + '" name="' + opts.selectNamePrefix + '[' + n + ']" required '
                    + 'id="data[' + opts.selectNamePrefix + '][' + n + ']">'
                    + optionsHtml
                    + '</select>';
                const prefix = opts.prefixInputs ? opts.prefixInputs(n) : '';
                const html = '<div class="' + opts.rowClass + ' form-row">'
                    + prefix + selectHtml + opts.extraInputs(n) + '</div>';
                $addBtn.before(html);
                rebuildRemoveButton();
            });

            $(document).on('click', '.' + opts.removeBtnClass, function(e) {
                e.preventDefault();
                $form.find('div.' + opts.rowClass).last().remove();
                rebuildRemoveButton();
            });
        }

        setupParticipantSection({
            data:              pjs,
            addBtnId:          'add-participants',
            removeBtnClass:    'remove-participants',
            rowClass:          'participants',
            selectNamePrefix:  'participants',
            selectClass:       'form-control mt-1 ml-1 col-7',
            prefixInputs: function(n) {
                return '<input class="mt-1 col-1" type="checkbox" title="Bonus XP x2 (rattrapage)" name="participants_xpBonus[' + n + ']"'
                     + ' id="data[participants_xpBonus][' + n + ']" />';
            },
            extraInputs: function(n) {
                return '<input class="form-control ml-1 mt-1 col-2" type="number" name="participants_xp[' + n + ']"'
                     + ' value="0" id="data[participants_xp][' + n + ']" />'
                     + '<input class="mt-1 ml-1 col-1" type="checkbox" title="Mort" name="participants_dead[' + n + ']"'
                     + ' id="data[participants_dead][' + n + ']" />';
            }
        });

        setupParticipantSection({
            data:              pnjs,
            addBtnId:          'add-npc_participants',
            removeBtnClass:    'remove-npc_participants',
            rowClass:          'npc_participants',
            selectNamePrefix:  'npc_participants',
            selectClass:       'form-control mt-1 col-10',
            extraInputs: function(n) {
                return '<input class="mt-1 ml-1 col-1" type="checkbox" name="npc_participants_dead[' + n + ']"'
                     + ' id="data[npc_participants_dead][' + n + ']" />';
            }
        });

    });
</script>
