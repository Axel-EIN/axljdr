{% extends 'base.html.twig' %}
{% block title %}{{entity|capitalize}} {{nom}} {{parent()}} {% endblock %}
{% block body %}
  <main class="container-fluid element-page mt-3 mt-lg-2 pb-0 pb-lg-5 mb-0 mb-lg-5">
    <div class="container relative">

      <!-- FIL D'ARIANE -->
      <nav>
        <span>
          <a href="{{ path('aventure') }}"><i class="fas fa-home"></i></a>
          &nbsp;>&nbsp;
          {% if category == 'personnages' and entity == 'fiche' %}
            <a href="{{ path(category) }}"><strong>{{category|capitalize}}</strong></a>
            >
            <a href="{{ path('personnage_profil', {id: fiche.personnage.id}) }}"><strong>{{nom|capitalize}}</strong></a>
            >
            <strong>Fiche Personnage</strong>
          {% else %}
            <a href="{{ path(category, {'_fragment': entity} ) }}"><strong>{{category|capitalize}}</strong></a>
            &nbsp;>&nbsp;
            <strong>{{ nom }}</strong>
          {% endif %}
        </span>
      </nav>   

      <!-- MESSAGE FLASHES -->
      {{ include('parts/messages-flashes.html.twig') }}

      <!-- MAIN SECTION -->
      <section class="mt-3 mt-lg-4 mb-0 mb-lg-5">

        <!-- H1 TITLE -->
        <h1 class="element-title relative m-0 p-0">
          {% if category == 'personnages' and entity == 'fiche' %}
            <strong><i class="fas fa-address-card fiche-titre-ico mr-2"></i>Fiche de {{ nom }}</strong>
          {% else %}
            <strong>{{ nom }}</strong>
          {% endif %}

          {% if app.user and is_granted("ROLE_MJ") %}
            <!-- MJ - BTN ICON EDIT - RIGHT SNAP -->
            {% set redirect, size, color, position = entity, 'btn-icon-medium', 'text-accent', 'right-snap' %}
            {{ include('/parts/btn-icon-edit.html.twig') }}
          {% endif %}
        </h1>
        <hr class="m-0 mb-3 hr-title">

        <!-- ELEMENT CONTENT -->
        <article class="row">
          {% block element_content %}{% endblock %}            
        </article>
      </section>
    </div>
  </main>
{% endblock %}
