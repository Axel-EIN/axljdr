{% extends 'category.html.twig' %}
{% block title %}Accueil {{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{asset('css/components/picture-grid.css')}}" />
    <link rel="stylesheet" href="{{asset('css/components/episode-card.css')}}" />
    <link rel="stylesheet" href="{{asset('css/components/map.css')}}" />
    <link rel="stylesheet" href="{{asset('css/pages/news.css')}}" />
{% endblock %}

{% block section_content1 %}

    {% set chapter = last_episode ? last_episode.chapitreParent : null %}
    {% set chapter_image = chapter ? chapter.image|default(NA_CHAPITRE) : null %}
    {% set episode_preset = image_preset('landscape720') %}

    <div class="col-12 col-lg-7">
        <div class="card card-body session-card on-image{{ image_bright(chapter_image) ? ' bright' }}"
            {% if chapter %}style="--chapter-color: {{ chapter.couleur }}; --chapter-image: url('{{ asset(chapter_image) }}');"{% endif %}>

            {% if last_episode %}
                <div class="session-split">
                    <div>
                        {{ include('/story/episode-card.html.twig', {
                            episode: last_episode,
                            wrapper: 'w-100',
                            lazy: false,
                            user_characters_episode_totals: [],
                        }) }}
                    </div>

                    {% if ranking %}
                        {{ include('/news/ranking.html.twig', {items: ranking, mine: my_characters}) }}
                    {% endif %}
                </div>

                <div class="session-groups">
                    <div class="session-pair">
                        <div class="session-group">
                            <h3 class="label-amerigo news-subtitle text-white mt-4">Lieux</h3>
                            {{ include('/parts/picture-grid.html.twig', {
                                items: session_locations,
                                reveal_session: true,
                                badge_hover: true,
                                variant: 'icon',
                                na_image: NA_LIEU_ICO,
                                per_row: 2,
                                limit: 4,
                                empty_message: 'Aucun lieu visité',
                            }) }}
                        </div>

                        <div class="session-group">
                            <h3 class="label-amerigo news-subtitle text-white mt-4">Rencontres</h3>
                            {{ include('/parts/picture-grid.html.twig', {
                                items: session_characters,
                                reveal_session: true,
                                badge_hover: true,
                                variant: 'portrait',
                                per_row: 4,
                                empty_message: 'Aucun personnage rencontré',
                            }) }}
                        </div>
                    </div>

                    <div class="session-group">
                        <h3 class="label-amerigo news-subtitle text-white mt-4">Objets</h3>
                        {{ include('/parts/picture-grid.html.twig', {
                            items: session_objects,
                            field: 'icon',
                            reveal_session: true,
                            badge_hover: true,
                            variant: 'rule',
                            per_row: {desktop: 4, tablet: 4, mobile: 3},
                            empty_message: 'Aucun objet découvert',
                        }) }}
                    </div>

                    {% if session_previous is not empty %}
                        <div class="session-group">
                            <h3 class="label-amerigo news-subtitle text-white mt-4">Séances précédentes</h3>
                            {% for episode in session_previous %}
                                <a class="episode-row inverted" href="{{ path('story_episode', {id: episode.id}) }}">
                                    <span class="episode-number">#{{ episode.numeroSaison }}</span>
                                    <span class="episode-text">
                                        <strong>{{ episode.titre }}</strong>
                                        <span class="episode-sub">{{ episode.chapitreParent.titre }}</span>
                                    </span>
                                    <img class="episode-picture" src="{{ asset(image_small(episode.image|default(NA_SESSION))) }}" width="{{ episode_preset.width }}" height="{{ episode_preset.height }}" loading="lazy" alt="" />
                                </a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                {% if chapter %}
                    {% set season = chapter.saisonParent %}
                    <div class="session-links">
                        <a class="session-link" href="{{ path('story_season', {id: season.id}) }}">
                            <img src="{{ asset(STORY_SEASON_ICO) }}" alt="Icône de saison" />
                            <span>Saison {{ season.numero }}</span>
                        </a>

                        <a class="session-link" href="{{ path('story_season', {id: season.id}) }}#read-head-ch-id{{ chapter.id }}">
                            <img src="{{ asset(STORY_CHAPTER_ICO) }}" alt="Icône de chapitre" />
                            <span>Chapitre {{ chapter.numero }} — {{ chapter.titre }}</span>
                        </a>
                    </div>
                {% endif %}
            {% else %}
                <p class="texte-attente">Le premier résumé de séance n'a pas encore été publié.</p>
            {% endif %}
        </div>
    </div>

    <div class="col-12 col-lg-5 news-aside">

        {% if my_character %}
            <div class="card card-body participations-card"
                style="--character-image: url('{{ asset(my_character.illustration|default(NA_PERSO_ILLU)) }}');{% if my_character.clan %} --faction-color: {{ my_character.clan.couleur }};{% endif %}">
                <div class="character-status">
                    <div class="status-head">
                        <h3 class="status-name font-present text-white">{{ my_character.nomComplet }}</h3>
                        <span class="badge-rang-{{ my_summary.rank }} large">RANG {{ my_summary.rank }}</span>
                    </div>
                    {% set wound_levels = constant('App\\Entity\\FichePersonnage::NIVEAUX_BLESSURE')|keys %}
                    {% if my_summary.maxHp %}
                        <div class="status-hp-bar">
                            {% for level in wound_levels %}
                                <span class="filled" title="{{ level }}"></span>
                            {% endfor %}
                        </div>
                    {% endif %}
                    <div class="status-body">
                        <nav class="status-actions" aria-label="Raccourcis du personnage">
                            <a class="status-link" href="{{ path('characters_profile', {id: my_character.id}) }}" aria-label="Voir le profil">
                                <i class="fa-solid fa-user" aria-hidden="true"></i>
                                <span class="hover-tooltip below">Voir le profil</span>
                            </a>
                            {% if my_character.fichePersonnage %}
                                <a class="status-link" href="{{ path('characters_sheet', {id: my_character.fichePersonnage.id}) }}" aria-label="Voir la Fiche de Jeu">
                                    <i class="fa-solid fa-scroll" aria-hidden="true"></i>
                                    <span class="hover-tooltip below">Voir la Fiche de Jeu</span>
                                </a>
                            {% endif %}
                            <a class="status-link" href="{{ path('map') }}" aria-label="Voir sur la carte">
                                <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
                                <span class="hover-tooltip below">Voir sur la carte</span>
                            </a>
                        </nav>
                        {% if my_summary.maxHp %}
                            <div class="status-hp-values text-your-xp">{{ my_summary.maxHp }} / {{ my_summary.maxHp }}<span class="status-label">{{ wound_levels|first }}</span></div>
                        {% endif %}
                    </div>
                </div>

                {% if map_visible %}
                    <div class="participations-map d-none d-lg-block">
                        <h3 class="label-amerigo news-subtitle">Position</h3>
                        {{ include('parts/map.html.twig', {
                            locations,
                            current: current_position,
                            party: current_position ? {(current_position.id): [my_character]} : {},
                            center: free_position,
                            wanderers: free_position ? [free_position] : [],
                            zoom: current_position ? current_position.zoom : null,
                            variant: 'mini',
                        }, with_context = false) }}
                    </div>
                {% endif %}

                {% if my_participations is not empty %}
                    <h3 class="label-amerigo news-subtitle">Participations</h3>
                    {% for participation in my_participations %}
                        {% set scene = participation.scene %}
                        {% set episode = scene.episodeParent %}
                        {% set character = participation.personnage %}
                        {% set episode_totals = participations_xp[participation.id]|default(null) %}
                        <a class="episode-row" href="{{ path('story_episode', {id: episode.id}) }}">
                            <span class="portrait-slot">
                                <img class="character-portrait medium outlined {{ participation.estMort ? 'effect-dead' }}"
                                     src="{{ asset(character.icone|default(NA_PERSO_PORTRAIT)) }}"
                                     alt="Portrait de {{ character.prenom }}" title="{{ character.prenom }}" />
                                {% if participation.estMort %}<img class="character-icon-dead" src="{{ asset(MORT_ICO) }}" alt="est mort" />{% endif %}
                                {% if episode_totals %}<span class="episode-xp">{{ include('parts/xp-gain.html.twig', {xp: episode_totals.xp, total: episode_totals.xpWithBonus, sign: '+'}) }}</span>{% endif %}
                            </span>
                            <span class="episode-text">
                                <strong>{{ episode.titre }}</strong>
                                {% if scene.lieu %}<span class="episode-sub">{{ scene.lieu.nom }}</span>{% endif %}
                            </span>
                            <img class="episode-picture" src="{{ asset(image_small(episode.image|default(NA_SESSION))) }}" width="{{ episode_preset.width }}" height="{{ episode_preset.height }}" loading="lazy" alt="" />
                        </a>
                    {% endfor %}
                {% endif %}
            </div>

            <div class="card card-body discoveries-card">
                <h3 class="label-amerigo news-subtitle"><i class="fa-solid fa-eye" aria-hidden="true"></i> Découvertes</h3>

                {% for discovery in discoveries %}
                    <h4 class="news-qualifier">{{ discovery.title }}</h4>
                    {{ include('/parts/picture-grid.html.twig', {
                        items: discovery.elements,
                        keep_order: true,
                        badge_pinned: true,
                        variant: discovery.variant,
                        field: discovery.field|default(null),
                        na_image: {location: NA_LIEU_ICO}[discovery.key]|default(null),
                        per_row: discovery.max,
                        empty_message: discovery.empty,
                    }) }}
                {% endfor %}
            </div>
        {% else %}
            <div class="card card-body ranking-card">
                <h3 class="label-amerigo news-subtitle">Classement Général</h3>
                {{ include('/news/ranking.html.twig', {items: general_ranking}) }}
            </div>
        {% endif %}

    </div>

{% endblock %}

{% block section_content2 %}
    <div class="col-12">
        <div class="news-board">
            {% for group in groups %}
                <div class="card card-body news-group{{ group.large|default(false) ? ' large' }}">
                    <h3 class="label-amerigo news-subtitle">{{ group.title }}</h3>
                    {% if group.sections is defined %}
                        <div class="news-sections">
                            {% for section in group.sections %}
                                <div class="news-section" style="--span: {{ section.max }}">
                                    <h4 class="news-qualifier">{{ section.title }}</h4>
                                    {{ include('/parts/picture-grid.html.twig', {
                                        items: section.elements,
                                        badge_hover: true,
                                        variant: group.variant|default('landscape'),
                                        field: group.field|default(null),
                                        per_row: section.max,
                                        wrapper: 'compact',
                                    }) }}
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        {{ include('/parts/picture-grid.html.twig', {
                            items: group.elements,
                            badge_hover: true,
                            variant: group.variant|default('landscape'),
                            field: group.field|default(null),
                            per_row: group.perRow,
                            wrapper: 'compact',
                        }) }}
                    {% endif %}
                </div>
            {% endfor %}

            {% if not my_character %}
                <div class="card card-body news-group{{ secrets_large ? ' large' }} locked">
                    <h3 class="label-amerigo news-subtitle">Secrets</h3>
                    <img class="news-lock fa-beat-fade" src="{{ asset(LOCKED_ICO) }}" alt="Cadenas" />
                    {% if app.user %}
                        <p>Les secrets de votre personnage apparaîtront ici.</p>
                    {% else %}
                        <p>Connectez-vous pour voir les secrets de votre personnage.</p>
                        <a class="btn btn-medium btn-secondary-style" href="{{ path('app_login') }}">Se connecter</a>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if map_visible %}<script src="{{ asset('scripts/map.js') }}"></script>{% endif %}
{% endblock %}
