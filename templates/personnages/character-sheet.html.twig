                <span data-arme-actuelle-select-cell class="ml-2"></span>
              </div>
            </li>

            {% set vdparts = fiche.armeActuelle ? fiche.armeActuelle.vd|default('0g1')|split('g') : ['0', '1'] %}
            {% set JetDmglances = vdparts[0] + dmgModL + eff_forceStat %}
            {% set JetDmgGardes = vdparts[1] + dmgModG %}
            <li class="list-group-item px-3 py-2 flex gap-2">
              <div class="flex-grow-1 flex-col stat-dommages-with-arme{% if not fiche.armeActuelle %} d-none{% endif %}">
                <span>
                  Dommages <span class="text-small text-gray-ash">(<span data-stat="arme-actuelle-nom">{{ fiche.armeActuelle ? fiche.armeActuelle.nom : '' }}</span>)</span>
                </span>
                <span class="ml-2 text-gray-ash">
                  <strong class="text-strong" data-stat="dommages">{{ JetDmglances ~ 'g' ~ JetDmgGardes }}</strong>
                  &nbsp;
                  <i class="fa-solid fa-dice text-accent"
                      data-tooltip-stat="dommages"
                      data-toggle="tooltip" data-placement="right" data-html="true"
                      title="
                        <div class='text-mini text-left'>
                          /lancer
                          <br/>VD de l'Arme + Force
                          <br/>/garder VD de l'Arme
                          <br/>
                          <br/><img class='img-56' src={{ asset(fiche.armeActuelle ? fiche.armeActuelle.image|default(NA_OBJET) : NA_OBJET) }} />
                          <br/>- VD {{ fiche.armeActuelle ? fiche.armeActuelle.nom : '' }} : {{ fiche.armeActuelle ? fiche.armeActuelle.vd|default('0g1') : '0g1' }}
                          <br/>- Force : +{{ eff_forceStat }}g0
                          {% if fiche.dmgModifier %}
                            <br/>
                            <br/>Modificateurs :
                            <br/> - Av./Techniques : +{{ fiche.dmgModifier }}
                          {% endif %}
                        </div>"
                  >
                  </i>
                </span>
              </div>
              <div class="text-right text-small stat-dommages-with-arme{% if not fiche.armeActuelle %} d-none{% endif %}">
                <strong data-stat="dommages-avg">{{ ( JetDmglances ~  'g' ~ JetDmgGardes  )|jeter }}</strong>
                <br/><span class="edit-only">3 Aug. : <span data-stat="dommages-aug3-avg">{{ ( (JetDmglances + 3) ~  'g' ~ JetDmgGardes  )|jeter }}</span></span>
              </div>
              <div class="stat-dommages-no-arme{% if fiche.armeActuelle %} d-none{% endif %}">
                Jet Dommages
                <br/>
                <small class="text-alternate">Choisissez une arme principale</small>
              </div>
            </li>

            {% set nd_mod = fiche.ndModifier ?? 0 %}
            <li class="list-group-item px-3 py-2 flex gap-2">
              <div class="flex-grow-1">
                ND pour être touché
                <br/><strong class="text-strong ml-2" data-stat="nd-touche">{{ eff_reflexes * 5 + nd_mod }}</strong>
                &nbsp;
                <i
                  class="fa-solid fa-arrow-trend-up"
                  data-toggle="tooltip" data-placement="right" data-html="true"
                  title="
                    <div class='text-mini'>
                      Réflèxes * 5{% if nd_mod != 0 %}<br/>Modificateur : {{ nd_mod > 0 ? '+' : '' }}{{ nd_mod }}{% endif %}
                    </div>"
                >
                </i>
              </div>
              {% if fiche.armure %}
                <small class="text-right">
                  <strong data-stat="nd-touche-armure">{{ fiche.armure.ndArmure + (eff_reflexes * 5) + nd_mod }}</strong>
                  <br/>
                  Avec Armure
                </small>
              {% endif %}
            </li>

            {% if fiche.armure %}
              <li class="list-group-item px-3 py-2 flex">
                <div class="flex-grow-1" >
                  Armure <span class="text-small text-gray-ash">({{ fiche.armure.nom }})</span>
                  <br/><strong class="text-strong ml-2">+{{ fiche.armure.ndArmure }} au ND pour être touché</strong>
                  <br/><strong class="text-strong ml-2">-{{ fiche.armure.reduction }} Réduction de dommages</strong>
                </div>
              </li>
            {% endif %}

            {% set reduction_armure = fiche.armure ? fiche.armure.reduction : 0 %}
            {% set reduction_mod = fiche.reductionModifier ?? 0 %}
            <li class="list-group-item px-3 py-2 d-flex">
              <div class="flex-grow-1">
                Réduction
                <br><strong class="ml-2 text-strong">{{ reduction_armure + reduction_mod }}</strong>
                &nbsp;
                <i
                  class="fa-solid fa-shield-halved"
                  data-toggle="tooltip" data-placement="right" data-html="true"
                  title="
                    <div class='text-mini text-left'>
                      {% if fiche.armure %}
                        {{ fiche.armure.nom }} : {{ fiche.armure.reduction }}
                      {% endif %}
                      {% if reduction_mod != 0 %}
                        <br/>Modificateur : {{ reduction_mod > 0 ? '+' : '' }}{{ reduction_mod }}
                      {% endif %}
                    </div>
                "></i>
              </div>
              <div class="text-right">
                {% if reduction_mod != 0 %}
                  <br/><small class="text-muted">({{ reduction_armure }} armure {{ reduction_mod > 0 ? '+' : '' }}{{ reduction_mod }} modif.)</small>
                {% endif %}
              </div>
            </li>

            <li class="list-group-item px-3 py-2 d-flex">
              <div class="flex-grow-1">
                Points de Vie
                <br><strong class="ml-2 text-strong" data-stat="hp-total">{{ (5 * min(eff_constitution, eff_volonte)) + (7 * (2 * min(eff_constitution, eff_volonte))) }}</strong>
                &nbsp;
                <i
                  class="fa-solid fa-heart-pulse text-primary"
                  data-toggle="tooltip" data-placement="right" data-html="true"
                  title="
                    <div class='text-mini'>
                      1 * (TERRE * 5)
                      <br/>
                      +
                      <br/> 7 * (TERRE * 2)
                    </div>
                "></i>
              </div>
              <div class="flex-grow-1">
                Récupération
                <br><strong class="ml-2 text-strong" data-stat="recuperation">{{(eff_constitution * 2) + rang}}</strong>
                &nbsp;
                <i 
                  class="fas fa-briefcase-medical text-success"
                  data-toggle="tooltip" data-placement="right" data-html="true"
                  title="
                    <div class='text-mini'>
                      (Constitution * 2) + RangGen.
                    </div>
                "></i>
                &nbsp;<span class="text-small">par nuit<small>
              </div>
            </li>
          </ul>
          <table class="table table-striped text-center text-regular">
            <thead>
              <tr>
                <th>Etat</th>
                <th>Malus</th>
                <th>HP</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Indemne</td>
                <td>0</td>
                <td data-stat="hp-indemne">{{ 5*min(eff_constitution, eff_volonte) }}</td>
              </tr>
              <tr>
                <td>Egratiné</td>
                <td>+3</td>
                <td data-stat="hp-blesse">{{ 2*min(eff_constitution, eff_volonte) }}</td>
              </tr>
              <tr>
                <td>Légerement blessé</td>
                <td>+5</td>
                <td data-stat="hp-blesse">{{ 2*min(eff_constitution, eff_volonte) }}</td>
              </tr>
              <tr>
                <td>Blessé</td>
                <td>+10</td>
                <td data-stat="hp-blesse">{{ 2*min(eff_constitution, eff_volonte) }}</td>
              </tr>
              <tr>
                <td>Gravement blessé</td>
                <td>+15</td>
                <td data-stat="hp-blesse">{{ 2*min(eff_constitution, eff_volonte) }}</td>
              </tr>
              <tr>
                <td>Impotent</td>
                <td>+20</td>
                <td data-stat="hp-blesse">{{ 2*min(eff_constitution, eff_volonte) }}</td>
              </tr>
              <tr>
                <td>Epuisé</td>
                <td>+30</td>
                <td data-stat="hp-blesse">{{ 2*min(eff_constitution, eff_volonte) }}</td>
              </tr>
              <tr>
                <td>Hors de Combat</td>
                <td>ne peut agir</td>
                <td data-stat="hp-blesse">{{ 2*min(eff_constitution, eff_volonte) }}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
  </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(function () {
            $('[data-toggle="tooltip"]').tooltip();
            $('[data-toggle="popover"]').popover();
        });
    </script>

    {% if est_le_joueur or is_granted('ROLE_MJ') %}
    <script>
        window.FICHE_CONFIG = {
            xpTotal: {{ xp_total }},
            persoClanId: {{ perso_clan_id }},
            persoClasseId: {{ perso_classe_id }},
            rang: {{ rang }},
            armureNd: {{ fiche.armure and fiche.armure.ndArmure ? fiche.armure.ndArmure : 0 }},
            ndModifier: {{ fiche.ndModifier ?? 0 }},
            editUrl: {{ path('personnage_fiche_edit', {id: fiche.id})|json_encode|raw }},
            csrfToken: {{ csrf_token('joueur_fiche_personnage')|json_encode|raw }},
            competences: {{ competences_json|json_encode|raw }},
            avantages: {{ avantages_json|json_encode|raw }},
            desavantages: {{ desavantages_json|json_encode|raw }},
            armes: {{ armes_json|default([])|json_encode|raw }},
            spells: {{ spells_json|default([])|json_encode|raw }},
            mainsNuesId: {{ mains_nues_id ?? 'null' }},
            jetMap: {{ jet_map()|json_encode|raw }},
            armeVd: {% if fiche.armeActuelle and fiche.armeActuelle.vd %}{{ fiche.armeActuelle.vd|json_encode|raw }}{% else %}null{% endif %},
            armeId: {{ fiche.arme ? fiche.arme.id : 0 }},
            arme2Id: {{ fiche.arme2 ? fiche.arme2.id : 0 }},
            armeActuelleId: {{ fiche.armeActuelle ? fiche.armeActuelle.id : 0 }},
            compCombatActuelleId: {{ fiche.compCombatActuelle ? fiche.compCombatActuelle.id : 0 }},
            initiativeModifier: {{ fiche.initiativeModifier ?? 0 }},
            atkModL:  {{ atkModL }},
            atkModG:  {{ atkModG }},
            dmgModL:  {{ dmgModL }},
            dmgModG:  {{ dmgModG }},
            attaqueModifierStr:    {% if fiche.attaqueModifier %}{{ fiche.attaqueModifier|json_encode|raw }}{% else %}null{% endif %},
            dmgModifierStr:        {% if fiche.dmgModifier %}{{ fiche.dmgModifier|json_encode|raw }}{% else %}null{% endif %}
        };
    </script>
    <script>
    (function () {
        const cfg = window.FICHE_CONFIG;
        const COUT_PAR_SPE = {{ cout_par_spe }};
        const traits = ['constitution','volonte','reflexes','intuition','agilite','intelligence','forceStat','perception','vide'];
        const btnEdit = document.getElementById('btn-fiche-edit');
        const btnCancel = document.getElementById('btn-fiche-cancel');
        const btnValider = document.getElementById('btn-fiche-valider');
        const article = document.getElementById('character-sheet');

        // === Calcul du coût d'un trait ===
        // bonusCount = nombre de sources (famille/école) offrant un rang gratuit sur ce trait (0, 1 ou 2).
        function traitCost(eff, bonusCount, multiplier) {
            const freeRank = 2 + bonusCount;
            if (eff <= freeRank) return 0;
            const baseDeduct = freeRank * (freeRank + 1) / 2;
            return Math.round(multiplier * (eff * (eff + 1) / 2 - baseDeduct));
        }

        // === Récupère la valeur courante d'un trait (base) ===
        function getTraitBase(name) {
            const span = document.querySelector(`[data-trait-eff="${name}"]`);
            if (!span) return 0;
            const select = span.querySelector('select');
            if (select) return parseInt(select.value, 10);
            return parseInt(span.dataset.base, 10);
        }

        // === Coût d'une compétence (val * (val + 1) / 2), avec décalage si offerte ===
        // n = nb de rangs offerts par l'école (0, 1, 2). Le coût démarre au rang n+1.
        function compCost(val, nEcole) {
            if (!val || val < 1) return 0;
            const n = parseInt(nEcole, 10) || 0;
            const raw = Math.round(val * (val + 1) / 2);
            const offset = Math.round(n * (n + 1) / 2);
            return Math.max(0, raw - offset);
        }

        // === Lookup du score moyen d'un jet XgY dans la matrice fournie par PHP ===
        // Miroir JS de AppExtension::calculerJet. Le map est partagé via cfg.jetMap ;
        // seule cette logique wrapper doit être maintenue des deux côtés.
        function jeterMap(rolled, kept) {
            if (kept < 1) return 0;
            // Plus de dés gardés que lancés : on cap les gardés au nombre de lancés
            if (rolled < kept) kept = rolled;
            // Dés surnuméraires au dessus de 10 : +1 par dé lancé, +2 par dé gardé
            let bonus = 0;
            if (rolled > 10) { bonus += rolled - 10; rolled = 10; }
            if (kept   > 10) { bonus += (kept - 10) * 2; kept = 10; }
            const row = cfg.jetMap[rolled];
            if (!row) return 0;
            return (row[kept] ?? 0) + bonus;
        }

        // === ID actuellement choisi pour la compétence de combat (Bugei) ===
        function getCompCombatId() {
            const row = document.querySelector('[data-comp-combat-row]');
            const select = row ? row.querySelector('select.comp-combat-select') : null;
            if (select) return parseInt(select.value, 10) || 0;
            return parseInt(cfg.compCombatActuelleId, 10) || 0;
        }

        // === Valeur du slot dont la compétence == compCombatActuelle ===
        function getCompCombatVal() {
            const compId = getCompCombatId();
            if (!compId) return 0;
            const rows = document.querySelectorAll('[data-comp-row]');
            for (const row of rows) {
                const compSelect = row.querySelector('.comp-select');
                const valSelect = row.querySelector('.val-select');
                const rowCompId = compSelect ? (parseInt(compSelect.value, 10) || 0) : (parseInt(row.dataset.compId, 10) || 0);
                if (rowCompId === compId) {
                    return valSelect ? (parseInt(valSelect.value, 10) || 0) : (parseInt(row.dataset.compVal, 10) || 0);
                }
            }
            return 0;
        }

        // === ID et VD de l'arme actuellement utilisée pour le jet de dommages ===
        function getArmeActuelleId() {
            const row = document.querySelector('[data-arme-actuelle-row]');
            const select = row ? row.querySelector('select.arme-actuelle-select') : null;
            if (select) return parseInt(select.value, 10) || 0;
            return parseInt(cfg.armeActuelleId, 10) || 0;
        }

        function getArmeActuelleVd() {
            const id = getArmeActuelleId();
            if (!id) return null;
            const arme = (cfg.armes || []).find(a => a.id === id);
            return arme ? arme.vd : null;
        }

        // === Mise à jour du tooltip Bootstrap ===
        // BS4 cache le titre rendu dans data-original-title après init ; on l'écrase
        // pour que le prochain hover reflète les valeurs courantes.
        function setTooltipHtml(el, html) {
            if (!el) return;
            el.setAttribute('data-original-title', html);
            el.setAttribute('title', html);
        }

        function buildInitiativeTooltip(effRefl, rang) {
            const initMod = cfg.initiativeModifier || 0;
            const mod = initMod !== 0
                ? `<br/>Modificateur : ${initMod > 0 ? '+' : ''}${initMod}`
                : '';
            return `<div class='text-mini text-left'>`
                + `/lancer<br/>Réflèxes + RangGen.<br/>/garder Réflèxes`
                + `<br/><br/>/lancer ${effRefl} + ${rang}<br/>/garder ${effRefl}${mod}`
                + `</div>`;
        }

        function buildAttaqueTooltip(effAgi, compCombatVal) {
            const mod = cfg.attaqueModifierStr ? `<br/>Modificateur : ${cfg.attaqueModifierStr}` : '';
            return `<div class='text-mini text-left'>`
                + `/lancer<br/>Agilité + CompCombat/2 arrSup.<br/>/garder Agilité`
                + `<br/><br/>/lancer ${effAgi} + ${compCombatVal / 2}<br/>/garder ${effAgi}${mod}`
                + `</div>`;
        }

        function buildDommagesTooltip(effFor, arme) {
            if (!arme) return '';
            const mod = cfg.dmgModifierStr
                ? `<br/><br/>Modificateurs :<br/> - Av./Techniques : +${cfg.dmgModifierStr}`
                : '';
            return `<div class='text-mini text-left'>`
                + `/lancer<br/>VD de l'Arme + Force<br/>/garder VD de l'Arme`
                + `<br/><br/>- VD ${arme.nom} : ${arme.vd || '0g1'}`
                + `<br/>- Force : +${effFor}g0${mod}`
                + `</div>`;
        }

        // === Recalcul global ===
        function recalculate() {
            let totalTraits = 0;
            const eff = {};
            traits.forEach(name => {
                const span = document.querySelector(`[data-trait-eff="${name}"]`);
                if (!span) return;
                const base = getTraitBase(name);
                const bonus = parseInt(span.dataset.bonus, 10) || 0;
                const mult = parseInt(span.dataset.multiplier, 10);
                const effVal = base + bonus;
                eff[name] = effVal;
                const cost = traitCost(effVal, bonus, mult);
                totalTraits += cost;
                // Mettre à jour l'affichage de la valeur effective
                const valNode = span.querySelector('.eff-display');
                if (valNode) valNode.textContent = effVal;
                // Mettre à jour le coût affiché
                const costSpan = document.querySelector(`[data-cost-for="${name}"]`);
                if (costSpan) costSpan.textContent = cost > 0 ? `-${cost} xp` : '';
            });

            // Mettre à jour les anneaux (min des 2 traits associés)
            const rings = {
                terre: Math.min(eff.constitution, eff.volonte),
                air:   Math.min(eff.reflexes, eff.intuition),
                eau:   Math.min(eff.forceStat, eff.perception),
                feu:   Math.min(eff.agilite, eff.intelligence),
            };
            Object.keys(rings).forEach(r => {
                const node = document.querySelector(`[data-ring="${r}"]`);
                if (node) node.textContent = rings[r];
            });

            // Marquer en noir le trait le plus élevé de chaque paire
            const pairs = {
                constitution: 'volonte', volonte: 'constitution',
                reflexes: 'intuition',   intuition: 'reflexes',
                forceStat: 'perception', perception: 'forceStat',
                agilite: 'intelligence', intelligence: 'agilite',
            };
            Object.keys(pairs).forEach(name => {
                const span = document.querySelector(`[data-trait-eff="${name}"]`);
                if (!span) return;
                const isHigher = eff[name] > eff[pairs[name]];
                span.classList.toggle('text-strong', isHigher);
                span.classList.toggle('extrabold', isHigher);
            });

            // === Statistiques de combat ===
            // Initiative : Réflexes + RangGen, avec un modificateur flat (initiativeModifier int)
            const initLances = cfg.rang + eff.reflexes;
            const initGardes = eff.reflexes;
            const initMod    = cfg.initiativeModifier || 0;
            const initNode = document.querySelector('[data-stat="initiative"]');
            if (initNode) {
                const suffix = initMod !== 0 ? ` ${initMod > 0 ? '+' : ''}${initMod}` : '';
                initNode.textContent = `${initLances}g${initGardes}${suffix}`;
            }

            // Attaque : Agilité + CompCombat/2 (avec attaqueModifier sur lancers et gardés)
            const compCombatId  = getCompCombatId();
            const compCombatVal = getCompCombatVal();
            const attaqueLances = eff.agilite + Math.ceil(compCombatVal / 2) + cfg.atkModL;
            const attaqueGardes = eff.agilite + cfg.atkModG;
            const attaqueNode = document.querySelector('[data-stat="attaque"]');
            if (attaqueNode) attaqueNode.textContent = `${attaqueLances}g${attaqueGardes}`;

            // Moyennes (lookup dans la matrice exposée par PHP)
            const initAvgNode = document.querySelector('[data-stat="initiative-avg"]');
            if (initAvgNode) initAvgNode.textContent = jeterMap(initLances, initGardes) + initMod;

            const attaqueAvgNode = document.querySelector('[data-stat="attaque-avg"]');
            if (attaqueAvgNode) attaqueAvgNode.textContent = jeterMap(attaqueLances, attaqueGardes);

            // En Assaut : +2 dés lancés, +1 dé gardé
            const attaqueAssautAvgNode = document.querySelector('[data-stat="attaque-assaut-avg"]');
            if (attaqueAssautAvgNode) attaqueAssautAvgNode.textContent = jeterMap(attaqueLances + 2, attaqueGardes + 1);

            // Bascule comp combat sélectionnée / absente + mise à jour du nom
            const compCombat = compCombatId
                ? (cfg.competences || []).find(c => c.id === compCombatId)
                : null;
            document.querySelectorAll('.stat-attaque-with-comp').forEach(el => el.classList.toggle('d-none', !compCombat));
            document.querySelectorAll('.stat-attaque-no-comp').forEach(el => el.classList.toggle('d-none', !!compCombat));
            const compCombatNomNode = document.querySelector('[data-stat="comp-combat-nom"]');
            if (compCombatNomNode) compCombatNomNode.textContent = compCombat ? compCombat.nom : '';

            const armeActuelleId = getArmeActuelleId();
            const armeActuelle   = armeActuelleId
                ? (cfg.armes || []).find(a => a.id === armeActuelleId)
                : null;
            const armeVd = armeActuelle ? armeActuelle.vd : null;
            const dommagesNode         = document.querySelector('[data-stat="dommages"]');
            const dommagesAvgNode      = document.querySelector('[data-stat="dommages-avg"]');
            const dommagesAug3AvgNode  = document.querySelector('[data-stat="dommages-aug3-avg"]');
            if (armeVd) {
                const parts = armeVd.split('g');
                // VD de l'arme + Force + dmgModifier (lancers et gardés)
                const rolled = (parseInt(parts[0], 10) || 0) + eff.forceStat + cfg.dmgModL;
                const kept   = (parseInt(parts[1], 10) || 0) + cfg.dmgModG;
                if (dommagesNode)        dommagesNode.textContent        = `${rolled}g${kept}`;
                if (dommagesAvgNode)     dommagesAvgNode.textContent     = jeterMap(rolled, kept);
                // 3 Augmentations : +3 dés lancés (dés gardés inchangés)
                if (dommagesAug3AvgNode) dommagesAug3AvgNode.textContent = jeterMap(rolled + 3, kept);
            }
            document.querySelectorAll('.stat-dommages-with-arme').forEach(el => el.classList.toggle('d-none', !armeActuelle));
            document.querySelectorAll('.stat-dommages-no-arme').forEach(el => el.classList.toggle('d-none', !!armeActuelle));
            const armeNomNode = document.querySelector('[data-stat="arme-actuelle-nom"]');
            if (armeNomNode) armeNomNode.textContent = armeActuelle ? armeActuelle.nom : '';

            // ND pour être touché : Réflexes × 5 (base) + ndModifier ; +ndArmure si armure
            const ndBase = eff.reflexes * 5 + (cfg.ndModifier || 0);
            const ndNode = document.querySelector('[data-stat="nd-touche"]');
            if (ndNode) ndNode.textContent = ndBase;
            const ndArmureNode = document.querySelector('[data-stat="nd-touche-armure"]');
            if (ndArmureNode) ndArmureNode.textContent = ndBase + cfg.armureNd;

            const terre = Math.min(eff.constitution, eff.volonte);
            const hpIndemne = document.querySelector('[data-stat="hp-indemne"]');
            if (hpIndemne) hpIndemne.textContent = 5 * terre;
            document.querySelectorAll('[data-stat="hp-blesse"]').forEach(td => {
                td.textContent = 2 * terre;
            });
            const hpTotal = document.querySelector('[data-stat="hp-total"]');
            if (hpTotal) hpTotal.textContent = 5 * terre + 7 * (2 * terre);

            // Récupération : Constitution × 2 + RangGen
            const recupNode = document.querySelector('[data-stat="recuperation"]');
            if (recupNode) recupNode.textContent = eff.constitution * 2 + cfg.rang;

            let totalComps = 0;
            let totalSpecs = 0;
            document.querySelectorAll('[data-comp-row]').forEach(row => {
                const compSelect = row.querySelector('.comp-select');
                const valSelect = row.querySelector('.val-select');
                let compId, val, nEcole;
                if (compSelect && valSelect) {
                    compId = parseInt(compSelect.value, 10) || 0;
                    val = parseInt(valSelect.value, 10) || 0;
                } else {
                    compId = parseInt(row.dataset.compId, 10) || 0;
                    val = parseInt(row.dataset.compVal, 10) || 0;
                }
                const ecoleWrap = row.querySelector('.comp-ecole-tri');
                if (ecoleWrap) {
                    nEcole = parseInt(ecoleWrap.dataset.state, 10) || 0;
                } else {
                    nEcole = parseInt(row.dataset.compEcole, 10) || 0;
                }
                const rowCost = (compId > 0 && val > 0) ? compCost(val, nEcole) : 0;
                if (rowCost > 0) totalComps += rowCost;
                // Mettre à jour la cellule de coût du rang
                const costCell = row.querySelector('[data-comp-cost-cell]');
                if (costCell) costCell.textContent = rowCost > 0 ? `-${rowCost}xp` : '';
                // Comptage des spécialisations achetées payantes (state === 1 = achetée non offerte)
                let paidSpecs = 0;
                const specsRow = document.querySelector(`[data-comp-specs-row="${row.dataset.compRow}"]`);
                if (compId > 0 && specsRow) {
                    const wraps = specsRow.querySelectorAll('.comp-spec-tri');
                    if (wraps.length > 0) {
                        wraps.forEach(w => {
                            if ((parseInt(w.dataset.state, 10) || 0) === 1) paidSpecs += 1;
                        });
                    } else {
                        const bm   = row.dataset.compSpecs || '';
                        const bmEc = row.dataset.compSpeEcole || '';
                        for (let k = 0; k < bm.length; k++) {
                            if (bm[k] === '1' && bmEc[k] !== '1') paidSpecs += 1;
                        }
                    }
                    totalSpecs += paidSpecs * COUT_PAR_SPE;
                }
                // Mettre à jour la cellule de coût des spés sur la ligne des spés
                const specsCostCell = specsRow ? specsRow.querySelector('[data-comp-specs-cost-cell]') : null;
                if (specsCostCell) {
                    specsCostCell.innerHTML = paidSpecs > 0 ? `<small>-${paidSpecs * COUT_PAR_SPE}xp (spé)</small>` : '';
                }
            });
            totalComps = totalComps + totalSpecs;

            // === Coût/gain des avantages/désavantages (dynamique) ===
            const avantageById    = new Map((cfg.avantages    || []).map(a => [a.id, a]));
            const desavantageById = new Map((cfg.desavantages || []).map(a => [a.id, a]));
            function effectiveCost(av) {
                if (!av) return 0;
                const qualifies = av.discount && (
                    (av.discountClanId   && av.discountClanId   === cfg.persoClanId)
                    || (av.discountClan2Id  && av.discountClan2Id  === cfg.persoClanId)
                    || (av.discountClasseId && av.discountClasseId === cfg.persoClasseId)
                );
                return qualifies ? av.discount : av.cout;
            }
            let coutAvantages = 0;
            let gainDesavantages = 0;
            document.querySelectorAll('[data-av-slot]').forEach(li => {
                const select = li.querySelector('select.av-select');
                const id = select ? parseInt(select.value, 10) : parseInt(li.dataset.avId, 10);
                const kind = li.dataset.avKind;
                const av = id ? (kind === 'avantage' ? avantageById.get(id) : desavantageById.get(id)) : null;
                const cost = effectiveCost(av);
                if (av) {
                    if (kind === 'avantage') coutAvantages += cost; else gainDesavantages += cost;
                }
                // Mise à jour de l'affichage du coût/gain sur la ligne
                const costSpan = li.querySelector('[data-av-cost]');
                if (costSpan) {
                    if (av) {
                        const sign = kind === 'avantage' ? '-' : '+';
                        const promo = (av.discount && cost !== av.cout) ? ' <small class="text-success">(promo)</small>' : '';
                        costSpan.innerHTML = `${sign}${cost}xp${promo}`;
                    } else {
                        costSpan.innerHTML = '';
                    }
                }
            });

            const totalSpent = totalTraits + totalComps + coutAvantages;
            const xpEffectif = cfg.xpTotal + gainDesavantages;
            const remaining = xpEffectif - totalSpent;

            // Mettre à jour les totaux affichés
            const tt = document.getElementById('xp-traits-total');
            if (tt) tt.textContent = `-${totalTraits}xp`;
            const tc = document.getElementById('xp-comps-total');
            if (tc) tc.textContent = `-${totalComps}xp`;
            const avRow = document.getElementById('xp-avant-row');
            if (avRow) {
                avRow.classList.toggle('d-none', coutAvantages === 0);
                const avTotal = document.getElementById('xp-avant-total');
                if (avTotal) avTotal.textContent = `-${coutAvantages}xp`;
            }
            const dvRow = document.getElementById('xp-desav-row');
            if (dvRow) {
                dvRow.classList.toggle('d-none', gainDesavantages === 0);
                const dvTotal = document.getElementById('xp-desav-total');
                if (dvTotal) dvTotal.textContent = `+${gainDesavantages}xp`;
            }
            document.querySelectorAll('.xp-traits-value').forEach(n => { n.textContent = totalTraits; });
            document.querySelectorAll('.xp-comps-value').forEach(n => { n.textContent = totalComps; });
            document.querySelectorAll('.xp-spent-value').forEach(n => { n.textContent = totalSpent; });
            document.querySelectorAll('.xp-total-value').forEach(n => { n.textContent = xpEffectif; });
            document.querySelectorAll('.xp-avant-value').forEach(n => { n.textContent = coutAvantages; });
            document.querySelectorAll('.xp-desav-value').forEach(n => { n.textContent = gainDesavantages; });
            document.querySelectorAll('.xp-remaining').forEach(tr => {
                tr.textContent = `${remaining} xp`;
                tr.classList.toggle('text-danger', remaining < 0);
                tr.classList.toggle('text-success', remaining >= 0);
            });

            // Mise à jour des tooltips dynamiques (initiative, attaque, dommages)
            setTooltipHtml(
                document.querySelector('[data-tooltip-stat="initiative"]'),
                buildInitiativeTooltip(eff.reflexes, cfg.rang)
            );
            setTooltipHtml(
                document.querySelector('[data-tooltip-stat="attaque"]'),
                buildAttaqueTooltip(eff.agilite, compCombatVal)
            );
            const dmgTooltipEl = document.querySelector('[data-tooltip-stat="dommages"]');
            if (dmgTooltipEl && armeActuelle) {
                setTooltipHtml(dmgTooltipEl, buildDommagesTooltip(eff.forceStat, armeActuelle));
            }

            // Désactiver le bouton Valider si XP restant négatif
            if (btnValider) {
                btnValider.disabled = remaining < 0;
                btnValider.classList.toggle('btn-danger', remaining < 0);
                btnValider.classList.toggle('btn-success', remaining >= 0);
            }
        }

        // === Construit un <select> de compétences (avec optgroups par catégorie) ===
        // Ordre des catégories : Bugei, Noble, Marchand, Dégradante (puis le reste alphabétique).
        // À l'intérieur de chaque catégorie : tri alphabétique par nom.
        const COMP_CAT_ORDER = ['Bugei', 'Noble', 'Marchand', 'Dégradante'];
        function buildCompSelect(selectedId) {
            const select = document.createElement('select');
            select.className = 'form-control form-control-sm comp-select';
            const emptyOpt = document.createElement('option');
            emptyOpt.value = '0';
            emptyOpt.textContent = '— Aucune —';
            select.appendChild(emptyOpt);
            const byCat = {};
            cfg.competences.forEach(c => {
                const cat = c.categorie || 'Autres';
                if (!byCat[cat]) byCat[cat] = [];
                byCat[cat].push(c);
            });
            const extraCats = Object.keys(byCat)
                .filter(cat => !COMP_CAT_ORDER.includes(cat))
                .sort((a, b) => a.localeCompare(b, 'fr'));
            const orderedCats = COMP_CAT_ORDER.filter(cat => byCat[cat]).concat(extraCats);
            orderedCats.forEach(cat => {
                const group = document.createElement('optgroup');
                group.label = cat;
                byCat[cat]
                    .slice()
                    .sort((a, b) => (a.nom || '').localeCompare(b.nom || '', 'fr'))
                    .forEach(c => {
                        const opt = document.createElement('option');
                        opt.value = c.id;
                        opt.dataset.trait = c.trait;
                        opt.textContent = c.nom;
                        if (parseInt(selectedId, 10) === c.id) opt.selected = true;
                        group.appendChild(opt);
                    });
                select.appendChild(group);
            });
            return select;
        }

        // === Construit un <select> d'avantages/désavantages pour un slot ===
        // kind = 'avantage' | 'desavantage' ; filtre les exclusifs incompatibles avec la classe.
        // === Sorts connus : ids presents dans le bloc Magie ===
        function knownSpellIds() {
            return Array.from(document.querySelectorAll('[data-spell-id]'))
                .map(li => parseInt(li.dataset.spellId, 10));
        }

        // === <select> d'ajout d'un sort, groupe par niveau, sans les sorts deja connus ===
        function buildSpellSelect(ring) {
            const select = document.createElement('select');
            select.className = 'form-control form-control-sm spell-select';
            const emptyOpt = document.createElement('option');
            emptyOpt.value = '0';
            emptyOpt.textContent = '— Ajouter —';
            select.appendChild(emptyOpt);
            const known = knownSpellIds();
            let group = null;
            let groupLevel = null;
            (cfg.spells || [])
                .filter(s => s.anneau === ring && !known.includes(s.id))
                .forEach(s => {
                    if (s.niveau !== groupLevel) {
                        groupLevel = s.niveau;
                        group = document.createElement('optgroup');
                        group.label = 'Niveau ' + s.niveau;
                        select.appendChild(group);
                    }
                    const opt = document.createElement('option');
                    opt.value = s.id;
                    opt.textContent = s.nom;
                    group.appendChild(opt);
                });
            return select;
        }

        function buildSpellRemove() {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'spell-remove text-danger';
            btn.title = 'Retirer ce sort';
            btn.innerHTML = '<i class="fa-solid fa-xmark"></i>';
            btn.addEventListener('click', () => {
                btn.closest('.spell-line').remove();
                refreshSpellSelects();
            });
            return btn;
        }

        // Un sort ajoute n'a pas son detail cote client : son popover revient au
        // rechargement qui suit la validation.
        function insertSpellLine(spell, ring) {
            const list = document.querySelector(`[data-spell-list="${ring}"]`);
            if (!list) return;

            const li = document.createElement('li');
            li.className = 'spell-line';
            li.dataset.spellId = spell.id;
            const name = document.createElement('span');
            name.className = 'spell-name';
            name.textContent = spell.nom;
            const rank = document.createElement('strong');
            rank.className = 'text-rank reduced bg-' + (ring === 'UNIVERSEL' ? 'black' : ring);
            rank.textContent = spell.niveau;
            li.append(name, rank, buildSpellRemove());

            const next = Array.from(list.children).find(existing => {
                const level = parseInt(existing.querySelector('.text-rank').textContent, 10) || 0;
                if (level !== spell.niveau) return level > spell.niveau;
                return existing.querySelector('.spell-link, .spell-name')
                    .textContent.trim().localeCompare(spell.nom, 'fr') > 0;
            });
            list.insertBefore(li, next || null);
        }

        function refreshSpellSelects() {
            document.querySelectorAll('[data-spell-add]').forEach(wrap => {
                const ring = wrap.dataset.spellAdd;
                const select = buildSpellSelect(ring);
                select.addEventListener('change', () => {
                    const spell = (cfg.spells || []).find(s => s.id === parseInt(select.value, 10));
                    if (!spell) return;
                    insertSpellLine(spell, ring);
                    refreshSpellSelects();
                });
                wrap.innerHTML = '';
                wrap.appendChild(select);
            });
        }

        function buildAvantageSelect(kind, selectedId) {
            const select = document.createElement('select');
            select.className = 'form-control form-control-sm av-select';
            const emptyOpt = document.createElement('option');
            emptyOpt.value = '0';
            emptyOpt.textContent = '— Aucun —';
            select.appendChild(emptyOpt);
            const list = (kind === 'avantage') ? (cfg.avantages || []) : (cfg.desavantages || []);
            list.forEach(a => {
                // Exclusif à une autre classe → on masque (sauf si c'est l'avantage actuellement sélectionné)
                if (a.exclusiveId && a.exclusiveId !== cfg.persoClasseId && a.id !== selectedId) return;
                const opt = document.createElement('option');
                opt.value = a.id;
                opt.textContent = a.nom;
                if (a.id === selectedId) opt.selected = true;
                select.appendChild(opt);
            });
            return select;
        }

        // === Construit un <select> de compétences Bugei pour le compCombat ===
        function buildCompCombatSelect(selectedId) {
            const select = document.createElement('select');
            select.className = 'form-control form-control-sm comp-combat-select';
            const emptyOpt = document.createElement('option');
            emptyOpt.value = '0';
            emptyOpt.textContent = '— Aucune —';
            select.appendChild(emptyOpt);
            (cfg.competences || [])
                .filter(c => c.categorie === 'Bugei')
                .forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.id;
                    opt.textContent = c.nom;
                    if (parseInt(selectedId, 10) === c.id) opt.selected = true;
                    select.appendChild(opt);
                });
            return select;
        }

        // === Construit un <select> d'armes : arme, arme2 + "Mains Nues" (universel) ===
        function buildArmeActuelleSelect(armeId, arme2Id, selectedId) {
            const select = document.createElement('select');
            select.className = 'form-control form-control-sm arme-actuelle-select';
            const emptyOpt = document.createElement('option');
            emptyOpt.value = '0';
            emptyOpt.textContent = '— Aucune —';
            select.appendChild(emptyOpt);
            const armesById = new Map((cfg.armes || []).map(a => [a.id, a]));
            const ids = [armeId, arme2Id];
            if (cfg.mainsNuesId) ids.push(cfg.mainsNuesId);
            const seen = new Set();
            ids.forEach(id => {
                const idNum = parseInt(id, 10) || 0;
                if (!idNum || seen.has(idNum)) return;
                seen.add(idNum);
                const arme = armesById.get(idNum);
                if (!arme) return;
                const opt = document.createElement('option');
                opt.value = arme.id;
                opt.textContent = `${arme.nom} (${arme.vd || ''})`;
                if (parseInt(selectedId, 10) === arme.id) opt.selected = true;
                select.appendChild(opt);
            });
            return select;
        }

        // === Construit un <select> de rang (1-10, pas de vide) ===
        function buildValSelect(selectedVal) {
            const select = document.createElement('select');
            select.className = 'form-control form-control-sm val-select';
            const targetVal = parseInt(selectedVal, 10) >= 1 ? parseInt(selectedVal, 10) : 1;
            for (let i = 1; i <= 10; i++) {
                const opt = document.createElement('option');
                opt.value = i;
                opt.textContent = i;
                if (targetVal === i) opt.selected = true;
                select.appendChild(opt);
            }
            return select;
        }

        // En lecture les competences sont groupees par categorie ; en edition les
        // en-tetes disparaissent et un simple ordre alphabetique
        // se lit mieux. Chaque ligne emmene sa ligne de specialisations. Les
        // emplacements vides n'ont pas encore de nom : ils ferment la liste.
        // Pas de restauration a prevoir, Annuler recharge la page.
        function sortCompRowsAlphabetically() {
            const tbody = document.querySelector('#comp-table tbody');
            if (!tbody) return;
            [...tbody.querySelectorAll('[data-comp-row]')]
                .sort((a, b) => {
                    const na = a.querySelector('[data-comp-name]').textContent.trim();
                    const nb = b.querySelector('[data-comp-name]').textContent.trim();
                    if (!na || !nb) return (!na) - (!nb);
                    return na.localeCompare(nb, 'fr');
                })
                .forEach(row => {
                    tbody.appendChild(row);
                    const specsRow = tbody.querySelector(`[data-comp-specs-row="${row.dataset.compRow}"]`);
                    if (specsRow) tbody.appendChild(specsRow);
                });
        }

        function enterEditMode() {
            article.classList.add('fiche-edit-mode');
            sortCompRowsAlphabetically();
            btnEdit.style.display = 'none';
            btnCancel.style.display = '';
            btnValider.style.display = '';

            // Traits : préfixer la valeur effective d'un <select> pour la base.
            // On conserve .eff-display dans le span pour que recalculate() puisse
            // l'actualiser (affichage base+bonus pendant l'édition).
            traits.forEach(name => {
                const span = document.querySelector(`[data-trait-eff="${name}"]`);
                if (!span) return;
                const base = parseInt(span.dataset.base, 10);
                const select = document.createElement('select');
                select.className = 'form-control form-control-sm';
                for (let i = 1; i <= 10; i++) {
                    const opt = document.createElement('option');
                    opt.value = i;
                    opt.textContent = i;
                    if (i === base) opt.selected = true;
                    select.appendChild(opt);
                }
                select.addEventListener('change', recalculate);
                span.prepend(select);
            });

            // Compétences : remplacer chaque ligne par des selects
            document.querySelectorAll('[data-comp-row]').forEach(row => {
                const compId = parseInt(row.dataset.compId, 10) || 0;
                const val = parseInt(row.dataset.compVal, 10) || 0;
                const compEcole = parseInt(row.dataset.compEcole, 10) || 0;
                const speEcoleMask = row.dataset.compSpeEcole || '';
                const ecoleCell = row.querySelector('[data-comp-ecole-cell]');
                const nameCell = row.querySelector('[data-comp-name]');
                const valCell = row.querySelector('[data-comp-val-cell]');
                const traitCell = row.querySelector('[data-comp-trait-cell]');
                const costCell = row.querySelector('[data-comp-cost-cell]');
                const specsCell = getSpecsCell(row);

                const compSelect = buildCompSelect(compId);
                const valSelect = buildValSelect(val);
                valSelect.addEventListener('change', recalculate);
                valCell.innerHTML = '';
                valCell.appendChild(valSelect);

                // Tri-state "école" : posé dans sa propre cellule (colonne École)
                ecoleCell.innerHTML = '';
                const ecoleWrap = document.createElement('span');
                ecoleWrap.className = 'comp-ecole-tri';
                ecoleWrap.title = "Cycle : rien → offerte +1 → offerte +2";
                const ecoleIcon = document.createElement('i');
                ecoleWrap.appendChild(ecoleIcon);
                const ecoleTag = document.createElement('small');
                ecoleTag.className = 'comp-ecole-tag';
                ecoleWrap.appendChild(ecoleTag);
                ecoleCell.appendChild(ecoleWrap);
                bindTriState(ecoleWrap, ecoleIcon, compEcole, COMP_ECOLE_ICONS, (state) => {
                    ecoleTag.textContent = state === 2 ? 'offerte école R2' : '';
                });
                if (compId === 0) {
                    valSelect.style.display = 'none';
                    ecoleWrap.style.display = 'none';
                }

                renderSpecsCheckboxes(specsCell, compId, row.dataset.compSpecs || '', speEcoleMask);

                compSelect.addEventListener('change', () => {
                    const opt = compSelect.options[compSelect.selectedIndex];
                    const newCompId = parseInt(compSelect.value, 10) || 0;
                    traitCell.textContent = opt && opt.dataset.trait ? opt.dataset.trait : '';
                    valSelect.style.display = newCompId > 0 ? '' : 'none';
                    ecoleWrap.style.display = newCompId > 0 ? '' : 'none';
                    // Reset des spés + école quand la compétence change
                    renderSpecsCheckboxes(specsCell, newCompId, '', '');
                    recalculate();
                });
                nameCell.innerHTML = '';
                nameCell.appendChild(compSelect);
            });

            // Compétence de combat (Jet d'Attaque) : insérer un <select> Bugei
            const compCombatRow = document.querySelector('[data-comp-combat-row]');
            if (compCombatRow) {
                const cell = compCombatRow.querySelector('[data-comp-combat-select-cell]');
                const currentId = parseInt(compCombatRow.dataset.compCombatId, 10) || 0;
                if (cell) {
                    cell.innerHTML = '';
                    const select = buildCompCombatSelect(currentId);
                    select.addEventListener('change', recalculate);
                    cell.appendChild(select);
                }
            }

            // Arme actuelle (Jet de Dommages) : insérer un <select> arme/arme2
            const armeActuelleRow = document.querySelector('[data-arme-actuelle-row]');
            if (armeActuelleRow) {
                const cell = armeActuelleRow.querySelector('[data-arme-actuelle-select-cell]');
                const currentId = parseInt(armeActuelleRow.dataset.armeActuelleId, 10) || 0;
                const armeId    = parseInt(armeActuelleRow.dataset.armeId, 10) || 0;
                const arme2Id   = parseInt(armeActuelleRow.dataset.arme2Id, 10) || 0;
                if (cell) {
                    cell.innerHTML = '';
                    const select = buildArmeActuelleSelect(armeId, arme2Id, currentId);
                    select.addEventListener('change', recalculate);
                    cell.appendChild(select);
                }
            }

            // Avantages / Désavantages : remplacer le nom par un select
            document.querySelectorAll('[data-av-slot]').forEach(li => {
                const kind = li.dataset.avKind;
                const currentId = parseInt(li.dataset.avId, 10) || 0;
                const nameSpan = li.querySelector('[data-av-name]');
                const tooltip  = li.querySelector('[data-av-tooltip]');
                const select = buildAvantageSelect(kind, currentId);
                select.addEventListener('change', () => {
                    const newId = parseInt(select.value, 10) || 0;
                    // Met à jour le tooltip avec la nouvelle description
                    if (tooltip) {
                        const list = (kind === 'avantage') ? (cfg.avantages || []) : (cfg.desavantages || []);
                        const av = list.find(a => a.id === newId);
                        if (av) {
                            tooltip.setAttribute('title', av.description || '');
                            tooltip.setAttribute('data-original-title', av.description || '');
                            tooltip.classList.remove('d-none');
                        } else {
                            tooltip.classList.add('d-none');
                        }
                    }
                    recalculate();
                });
                if (nameSpan) {
                    nameSpan.innerHTML = '';
                    nameSpan.appendChild(select);
                }
            });

            // Sorts : une croix par ligne et un select d'ajout par colonne
            document.querySelectorAll('.spell-line').forEach(li => li.appendChild(buildSpellRemove()));
            refreshSpellSelects();
        }

        function getSpecsCell(row) {
            const specsRow = document.querySelector(`[data-comp-specs-row="${row.dataset.compRow}"]`);
            return specsRow ? specsRow.querySelector('[data-comp-specs-cell]') : null;
        }

        // Câble un wrap qui cycle entre 3 états au clic (0 → 1 → 2 → 0).
        // L'icône Font Awesome est swappée selon l'état via la table passée en paramètre.
        // onState(state) est appelé à chaque application pour mettre à jour les libellés annexes.
        const COMP_ECOLE_ICONS = {
            0: 'tri-icon fa-regular fa-square',
            1: 'tri-icon fa-solid fa-graduation-cap',
            2: 'tri-icon fa-solid fa-graduation-cap'
        };
        const SPEC_ECOLE_ICONS = {
            0: 'tri-icon fa-regular fa-square',
            1: 'tri-icon fa-solid fa-square-check',
            2: 'tri-icon fa-solid fa-graduation-cap'
        };
        function bindTriState(wrap, icon, initialState, iconClasses, onState) {
            function apply(state) {
                wrap.dataset.state = String(state);
                icon.className = iconClasses[state] || iconClasses[0];
                if (typeof onState === 'function') onState(state);
            }
            apply(Math.max(0, Math.min(2, parseInt(initialState, 10) || 0)));
            wrap.addEventListener('click', (e) => {
                e.preventDefault();
                const cur = parseInt(wrap.dataset.state, 10) || 0;
                apply((cur + 1) % 3);
                recalculate();
            });
        }

        function renderSpecsCheckboxes(cell, compId, bitmask, bitmaskEcole) {
            if (!cell) return;
            cell.innerHTML = '';
            if (!compId) return;
            const comp = cfg.competences.find(c => c.id === compId);
            if (!comp || !Array.isArray(comp.specialisations)) return;
            comp.specialisations.forEach((label, idx) => {
                if (!label) return;
                const wrap = document.createElement('span');
                wrap.className = 'comp-spec-tri';
                wrap.dataset.specIndex = String(idx);
                const icon = document.createElement('i');
                wrap.appendChild(icon);
                const txt = document.createElement('span');
                txt.textContent = label;
                wrap.appendChild(txt);
                const tag = document.createElement('small');
                tag.className = 'spec-ecole-tag';
                tag.textContent = 'offerte école';
                wrap.appendChild(tag);

                // État initial : 2 si école, 1 si achetée sans école, 0 sinon
                let initial = 0;
                if (bitmaskEcole && bitmaskEcole[idx] === '1') initial = 2;
                else if (bitmask && bitmask[idx] === '1') initial = 1;
                bindTriState(wrap, icon, initial, SPEC_ECOLE_ICONS);

                cell.appendChild(wrap);
            });
        }

        function readBitmask(row) {
            const specsRow = document.querySelector(`[data-comp-specs-row="${row.dataset.compRow}"]`);
            if (!specsRow) return '';
            const wraps = specsRow.querySelectorAll('.comp-spec-tri');
            if (wraps.length === 0) return '';
            const bits = ['0','0','0','0','0','0'];
            wraps.forEach(w => {
                const idx = parseInt(w.dataset.specIndex, 10);
                const state = parseInt(w.dataset.state, 10) || 0;
                if (state >= 1 && idx >= 0 && idx < 6) bits[idx] = '1';
            });
            return bits.join('');
        }

        function readSpeEcoleBitmask(row) {
            const specsRow = document.querySelector(`[data-comp-specs-row="${row.dataset.compRow}"]`);
            if (!specsRow) return '';
            const wraps = specsRow.querySelectorAll('.comp-spec-tri');
            if (wraps.length === 0) return '';
            const bits = ['0','0','0','0','0','0'];
            wraps.forEach(w => {
                const idx = parseInt(w.dataset.specIndex, 10);
                const state = parseInt(w.dataset.state, 10) || 0;
                if (state === 2 && idx >= 0 && idx < 6) bits[idx] = '1';
            });
            return bits.join('');
        }

        function submitFiche() {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = cfg.editUrl;

            function addInput(name, value) {
                const i = document.createElement('input');
                i.type = 'hidden';
                i.name = name;
                i.value = value;
                form.appendChild(i);
            }

            traits.forEach(name => {
                const span = document.querySelector(`[data-trait-eff="${name}"]`);
                const select = span ? span.querySelector('select') : null;
                if (select) addInput(`joueur_fiche_personnage[${name}]`, select.value);
            });

            document.querySelectorAll('[data-comp-row]').forEach(row => {
                const i = row.dataset.compRow;
                const compSelect = row.querySelector('.comp-select');
                const valSelect = row.querySelector('.val-select');
                const ecoleWrap = row.querySelector('.comp-ecole-tri');
                const compId = compSelect && parseInt(compSelect.value, 10) > 0 ? compSelect.value : '';
                // N'envoie un rang que si une compétence est sélectionnée
                const valVal = compId !== '' && valSelect && valSelect.value ? valSelect.value : '';
                const specsVal     = compId !== '' ? readBitmask(row) : '';
                const speEcVal     = compId !== '' ? readSpeEcoleBitmask(row) : '';
                const compEcoleVal = compId !== '' && ecoleWrap
                    ? String(parseInt(ecoleWrap.dataset.state, 10) || 0)
                    : '0';
                addInput(`joueur_fiche_personnage[competence${i}]`, compId);
                addInput(`joueur_fiche_personnage[valeur${i}]`, valVal);
                addInput(`joueur_fiche_personnage[specialisations${i}]`, specsVal);
                addInput(`joueur_fiche_personnage[compEcole${i}]`, compEcoleVal);
                addInput(`joueur_fiche_personnage[speEcole${i}]`, speEcVal);
            });

            // Avantages / Désavantages
            const slotToField = {av1: 'avantage1', av2: 'avantage2', dv1: 'desavantage1', dv2: 'desavantage2'};
            Object.keys(slotToField).forEach(slot => {
                const li = document.querySelector(`[data-av-slot="${slot}"]`);
                if (!li) return;
                const select = li.querySelector('select.av-select');
                const id = select && parseInt(select.value, 10) > 0 ? select.value : '';
                addInput(`joueur_fiche_personnage[${slotToField[slot]}]`, id);
            });

            // Compétence de combat et arme actuelle
            const compCombatSelect = document.querySelector('select.comp-combat-select');
            const compCombatId = compCombatSelect && parseInt(compCombatSelect.value, 10) > 0 ? compCombatSelect.value : '';
            addInput('joueur_fiche_personnage[compCombatActuelle]', compCombatId);

            const armeActuelleSelect = document.querySelector('select.arme-actuelle-select');
            const armeActuelleId = armeActuelleSelect && parseInt(armeActuelleSelect.value, 10) > 0 ? armeActuelleSelect.value : '';
            addInput('joueur_fiche_personnage[armeActuelle]', armeActuelleId);

            // arme2 n'est pas éditable ici mais doit être renvoyée pour ne pas être écrasée par Symfony
            addInput('joueur_fiche_personnage[arme2]', cfg.arme2Id || '');

            // Modificateurs (init/attaque/dmg/ND/réduction)
            const modIds = {
                initiativeModifier: 'mod-input-initiative',
                attaqueModifier:    'mod-input-attaque',
                dmgModifier:        'mod-input-dmg',
                ndModifier:         'mod-input-nd',
                reductionModifier:  'mod-input-reduction',
            };
            Object.keys(modIds).forEach(field => {
                const el = document.getElementById(modIds[field]);
                addInput(`joueur_fiche_personnage[${field}]`, el ? el.value.trim() : '');
            });

            // Sorts connus : ce qui est affiche est ce qui est enregistre
            document.querySelectorAll('[data-spell-id]').forEach(li => {
                addInput('joueur_fiche_personnage[knownSpells][]', li.dataset.spellId);
            });

            addInput('joueur_fiche_personnage[_token]', cfg.csrfToken);
            document.body.appendChild(form);
            form.submit();
        }

        if (btnEdit) btnEdit.addEventListener('click', enterEditMode);
        if (btnCancel) btnCancel.addEventListener('click', () => location.reload());
        if (btnValider) btnValider.addEventListener('click', submitFiche);
    })();
    </script>
    {% endif %}
{% endblock %}
