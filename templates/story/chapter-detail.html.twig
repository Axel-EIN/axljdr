{% set chapter_image = chapter.image|default(NA_CHAPITRE) %}
<section id="read-head-ch-id{{ chapter.id }}" class="chapter-backdrop banner" style="--chapter-color: {{ chapter.couleur }}">

  <img class="chapter-backdrop-image zoomed{{ image_bright(chapter_image) ? ' bright' }}" src="{{ asset(chapter_image) }}" {% if lazy ?? true %}loading="lazy"{% endif %} alt="" />

  <div class="container">

    {% if is_gm() %}

      {% if chapter.numero == season.chapitres|length %}
        {% set label, number, position = 'Ajouter', (chapter.numero + 1), 'top-center' %}
      {% else %}
        {% set label, number, position = 'Insérer', (chapter.numero + 1), 'top-center' %}
      {% endif %}

      <div class="{{position}} mt-1">
        {{ include('/btns/btn-line-insert.html.twig') }}
      </div>

    {% endif %}

    {% set visible_episodes = [] %}
    {% for episode in chapter.episodes %}
      {% if episode.scenes|length > 0 or is_gm() %}
        {% set visible_episodes = visible_episodes|merge([episode]) %}
      {% endif %}
    {% endfor %}

    <div class="header header-chapter d-flex flex-column" >
      <span class="chapter-number text-left">
        {% if is_gm() %}
          {% set color, position, redirect, entity, record, size = 'text-white50', 'mr-2 align-middle', 'story', 'chapter', chapter, 'btn-icon-medium' %}
          {{ include('/btns/btn-icon-edit.html.twig') }}
        {% endif %}
        CHAPITRE {{ chapter.numero }}
      </span>
      <div><hr></div>

      {{ include('story/chapter-characters.html.twig', {chapter, mode: 'locations'}) }}

      <div>
        <h2 class="heading-chapter{% if chapter.titre|length > 20 %} reduced{% endif %}">{{ chapter.titre|relief|raw }}</h2>
        <div class="chapter-intro relative">
          {{ include('story/chapter-characters.html.twig', {chapter}) }}
          {% if chapter.citation is not empty %}
            <p class="quote quote-chapter">{{ chapter.citation|nl2br }}</p>
          {% endif %}
          {% if visible_episodes is not empty %}
            <button type="button" class="btn-primary-style btn-large voir" data-toggle="collapse"
               data-target="#ch{{ chapter.numero }}-episodes" aria-controls="ch{{ chapter.numero }}-episodes"
               aria-expanded="false" aria-label="Voir les épisodes du chapitre {{ chapter.numero }}">
              <i class="fa-solid fa-scroll fa-bounce" aria-hidden="true"></i>&nbsp;&nbsp;Voir les Épisodes
            </button>
          {% else %}
            <div class="alert alert-light mx-auto alert-persist">
              <strong>Il n'y a pas encore de session disponible !</strong>&nbsp;&nbsp;
              {% if is_gm() %}
                <a class="btn-quaternary-style text-white50" href="{{path('admin_episode_create')}}?number=1&chapterID={{chapter.id}}&redirect=story">
                  <i class="fas fa-plus-square" aria-hidden="true"></i>&nbsp;&nbsp;<strong>Ajouter une Session</strong>
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>

    </div>

    <div id="ch{{ chapter.numero }}-episodes" class="collapse mb-4 mt-2">
      <div class="container">
        <div class="row justify-content-center relative">

          {% for episode in visible_episodes %}
            {{ include('/story/episode-card.html.twig') }}
          {% endfor %}

          {% if is_gm() %}
            <a class="absolute btn-display-icon" href="{{path('admin_episode_create')}}?number={{(chapter.episodes|length)+1}}&chapterID={{chapter.id}}&redirect=story">
              <i class="fas fa-plus-square" title="Ajouter une Session"></i>
            </a>
          {% endif %}

        </div>
      </div>
    </div>

  </div>
</section>
