<div class="zone-actions">
  <button type="button" class="btn-quaternary-style read-only" data-edit-open>
    <i class="fas fa-edit" aria-hidden="true"></i>
    &nbsp;&nbsp;{{ label }}
  </button>
  <button type="button" class="btn-quaternary-style text-muted edit-only" data-edit-cancel>
    <i class="fas fa-times" aria-hidden="true"></i>
    &nbsp;&nbsp;Annuler
  </button>
  <button type="submit" class="btn-quaternary-style text-success edit-only">
    <i class="fas fa-check" aria-hidden="true"></i>
    &nbsp;&nbsp;Valider
  </button>
</div>
