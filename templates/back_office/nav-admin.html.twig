<nav class="nav justify-content-center align-items-center">

    {% if is_gm() %}
    
        {% set navs = [
            {element: 'season', label: 'Saisons'},
            {element: 'chapter', label: 'Chapitres'},
            {element: 'episode', label: 'Épisodes'},
            {element: 'scene', label: 'Scènes'},
            {element: 'character', label: 'Personnages'},
            {element: 'sheet', label: 'Fiches'},
            {element: 'development', label: 'Développements'},
            {element: 'clan', label: 'Factions'},
            {element: 'family', label: 'Familles'},
            {element: 'archive', label: 'Archives'},
            {element: 'location', label: 'Lieux'},
            {element: 'lore', label: 'Lores'},
            {element: 'rule', label: 'Règles'},
            {element: 'library', label: 'Bibliothèques'},
            {element: 'class', label: 'Classes'},
            {element: 'dojo', label: 'Écoles'},
            {element: 'advantage', label: 'Avantages / Désavantages'},
            {element: 'skill', label: 'Compétences'},
            {element: 'object', label: 'Objets'},
            {element: 'spell', label: 'Sorts'},
        ] %}

        {% for nav in navs %}
            {% set element, label = nav.element, nav.label %}
            {{ include('/back_office/btn-gm-tab-link.html.twig') }}
        {% endfor %}

    {% endif %}

    {% if app.user and is_granted("ROLE_ADMIN") %}

        <a class="nav-link admin-link {% if app.request.get('_route') == 'admin_user'
                            or app.request.get('_route') == 'admin_user_create'
                            or app.request.get('_route') == 'admin_user_edit' %}active{% endif %}" 
                            href="{{ path('admin_user') }}">Utilisateurs</a>
                            
    {% endif %}

