{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{parent()}}
    <link rel="stylesheet" href="{{asset('css/pages/campaign.css')}}" />
    <link rel="stylesheet" href="{{asset('css/components/chapter.css')}}" />
{% endblock %}
{% block title %}L'Aventure Saison {{ saison.numero }} {{ parent() }}{% endblock %}
{% block body %}

<section class="saison-bar container-fluid" style="background-color: {{ saison.couleur }}">
    <div class="container">
        {{ include('/parts/messages-flashes.html.twig') }}
        {# Invisible plutot qu'absente : sinon le titre n'est plus centre. #}
        <a class="btn-quaternary-style text-white-50{{ saison_precedente is empty ? ' invisible' : '' }}"
           {% if saison_precedente is not empty %}href="{{ path('aventure_saison', {id: saison_precedente.id}) }}" title="Voir saison précédente"{% endif %}>
            <span class="text-small"><i class="fa-solid fa-caret-left"></i><span class="d-none d-lg-inline"> Saison Précédente</span></span>
        </a>

        <h1 class="h1-saison">
            {% if saison_suivante is empty %}
                SAISON {{ saison.numero }} en cours
            {% else %}
                SAISON {{ saison.numero }} - {{ saison.titre|upper }}
            {% endif %}
        </h1>

        <a class="btn-quaternary-style text-white-50{{ saison_suivante is empty ? ' invisible' : '' }}"
           {% if saison_suivante is not empty %}href="{{ path('aventure_saison', {id: saison_suivante.id}) }}" title="Voir saison suivante"{% endif %}>
            <span class="text-small"><span class="d-none d-lg-inline">Saison Suivante </span><i class="fa-solid fa-caret-right"></i></span>
        </a>
    </div>
</section>

<main class="relative">

    {% set color, entity, parent, parentID, redirect = 'text-white-50', 'chapitre', 'saison', saison.id, 'aventure' %}
    {% for un_chapitre in saison.chapitres|reverse %}
        {{ include('/aventure/chapter-detail.html.twig') }}
    {% else %}

        <section class="header-bg-img chapter-banner header-bg-no-chapter"
                 style="--chapter-color: #400000; --chapter-image: url('{{ asset(NA_169) }}')">
            <div class="container">
                <div class="header header-chapter d-flex flex-column justify-content-end" >
                    <div class="alert alert-light mx-auto alert-persist mt-3 mb-3">
                        <strong>Désolé, il n'y a pas encore de Chapitre dans cette Saison.</strong>
                    </div>
                </div>
            </div>
        </section>

    {% endfor %}

</main>

{% endblock %}
