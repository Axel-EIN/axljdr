{% extends 'element.html.twig' %}

{% block stylesheets %}
    {{parent()}}
    <link rel="stylesheet" href="{{asset('css/components/banner-intro.css')}}" />
    <link rel="stylesheet" href="{{asset('css/pages/clan.css')}}" />
    <link rel="stylesheet" href="{{asset('css/components/map.css')}}" />
{% endblock %}

{% block element_content %}

    {{ include('world/clan-banner.html.twig', {clan, all_clans}) }}

    <div class="col-12 col-lg-8">
        <div class="card card-body relative">

            {{ include('/btns/btn-add-element.html.twig', {
                entity: 'famille', label_one: 'une famille',
                position: 'topright-corner-inside-more', options: 'clanID=' ~ clan.id,
            }) }}

            <h2 class="heading-cardtitle">Familles</h2>
            <div class="card-text">

                {% for une_famille in clan.familles %}
                    <hr{% if not loop.first %} class="my-5"{% endif %}>
                    <article id="{{ une_famille.nom }}" class="famille relative">

                        {% if is_mj() %}
                            {% set redirect, entity, un_element, size, color, position = 'clan', 'famille', une_famille, 'btn-icon-small', 'link-gm', 'topright-corner-snap' %}
                            {{ include('/btns/btn-icon-edit.html.twig') }}
                        {% endif %}

                        <div class="famille-mon">
                            <img class="img-fluid circle-crop" src="{{ asset(une_famille.mon|default(NA_MON)) }}" alt="Mon Famille" />

                            {% if une_famille.chef is not empty %}
                                <a class="famille-daimyo hover-zoom" href="{{ path('personnage_profil', {id: une_famille.chef.id} ) }}" title="{{ une_famille.chef.nomComplet }}">
                                    <span class="text-muted">Daimyo</span>
                                    <img class="character-portrait medium" src="{{ asset(une_famille.chef.icone|default(NA_PERSO_PORTRAIT)) }}" alt="Icône du personnage" />
                                </a>
                            {% endif %}
                        </div>

                        <div class="famille-entete">
                            <h3><strong>{{ une_famille.nom }}</strong></h3>
                            {% if une_famille.bonusStatNom %}
                                {% set labels = {'constitution':'Constitution','volonte':'Volonté','reflexes':'Réflexes','intuition':'Intuition','agilite':'Agilité','intelligence':'Intelligence','forceStat':'Force','perception':'Perception','vide':'Vide'} %}
                                <strong style="color: {{ clan.couleur }}">Trait bonus : {{ labels[une_famille.bonusStatNom] ?? une_famille.bonusStatNom }} +1</strong>
                            {% endif %}
                        </div>

                        <p class="famille-description text-description">{{ une_famille.description|raw|nl2br }}</p>

                    </article>
                {% else %}
                    <span class="text-muted"><i>Familles à venir</i></span>
                {% endfor %}

            </div>
        </div>
    </div>

    {{ include('/parts/picture-grid.html.twig', {
        title: 'Écoles',
        variant: 'rule',
        items: clan.ecoles, route: 'regles_ecole',
        na_image: NA_ECOLE,
        per_row: 1,
        wrapper: 'col-12 col-lg-4',
        btn_add: {entity: 'ecole', label_one: 'une école', position: 'topright-corner-inside-more', options: 'clanID=' ~ clan.id},
        empty_message: 'Écoles à venir.',
    }) }}

    {% set territoire_place = clan.locX is not empty and clan.locY is not empty %}

    {% set territoire_visible_mobile = clan.territoireDesc is not empty %}
    {% if territoire_place or territoire_visible_mobile %}
    <div class="col-12{% if not territoire_visible_mobile %} d-none d-lg-block{% endif %}">
        <div class="card card-body">
            <h2 class="heading-cardtitle">Territoires</h2>
            <hr>

            {% if territoire_place %}
                {{ include('parts/map.html.twig', {
                    lieux: clan.lieux.toArray, center: clan, zoom: clan.zoom, territories: true, labels: true, large_markers: true, emblem: clan.mon|default(NA_MON),
                    emblem_at: clan.emblemX is not null and clan.emblemY is not null ? {locX: clan.emblemX, locY: clan.emblemY} : null,
                }, with_context = false) }}
            {% endif %}

            {% if territoire_visible_mobile %}
                {{ include('parts/description.html.twig', {text: clan.territoireDesc, variant: 'aerated'}, with_context = false) }}
            {% endif %}

        </div>
    </div>
    {% endif %}

    {% set lieux_clan = clan.lieux.toArray|filter(l => element_listed(l)) %}
    {% set types_forts = ['Palais Fortifié', 'Forteresse', 'Palais'] %}
    {% set types_urbains = ['Cité', 'Ville', 'Village'] %}
    {% set groupes_lieux = [
        {titre: 'Forteresses & Palais', colonne: '', par_ligne: 6, items: lieux_clan|filter(l => l.type in types_forts)},
        {titre: 'Cités, Villes & Villages', colonne: 'col-lg-6', par_ligne: 3, items: lieux_clan|filter(l => l.type in types_urbains)},
        {titre: 'Autres', colonne: 'col-lg-6', par_ligne: 3, items: lieux_clan|filter(l => l.type not in types_forts|merge(types_urbains))},
    ] %}

    <div class="col-12">
        <div class="card card-body">

            {{ include('/btns/btn-add-element.html.twig', {
                entity: 'lieu', label_one: 'un lieu',
                position: 'topright-corner-inside-more', options: 'filter[0]=' ~ clan.nom|url_encode,
            }) }}

            <h2 class="heading-cardtitle">Lieux</h2>
            <hr>

            {% if lieux_clan is not empty %}
                <div class="row">
                    {% for groupe in groupes_lieux|filter(groupe => groupe.items is not empty) %}
                        <div class="col-12 {{ groupe.colonne }} mt-2 mb-4">
                            <h3 class="heading-amerigo mb-3">{{ groupe.titre }}</h3>
                            {{ include('/parts/picture-grid.html.twig', {
                                variant: 'icon',
                                items: groupe.items, route: 'world_location', na_image: NA_LIEU_ICO,
                                per_row: {desktop: groupe.par_ligne, tablet: 4, mobile: 2},
                            }) }}
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <span class="text-muted font-italic">Il n'y a pas encore de lieu rattaché à ce clan.</span>
            {% endif %}

        </div>
    </div>

    {% if clan.longDescription is defined and clan.longDescription is not empty %}
        {% set col_side, portraits_par_ligne = "col-12 col-lg-4", 2 %}
        <div class="col-12 col-lg-8">
            <div class="card card-body">
                <h2 class="heading-cardtitle">Autres</h2>
                <hr>
                {{ include('parts/description.html.twig', {text: clan.longDescription}, with_context = false) }}
            </div>
        </div>
    {% else %}
        {% set col_side, portraits_par_ligne = "col-12", 8 %}
    {% endif %}

    {{ include('/parts/picture-grid.html.twig', {
        variant: 'portrait',
        title: 'Personnages',
        items: clan.personnages, route: 'personnage_profil', hide_dead: true,
        wrapper: col_side,
        per_row: {desktop: portraits_par_ligne, tablet: 4, mobile: 2},
        empty_message: "Il n'y a pas encore de personnage rattaché à ce clan.",
    }) }}

{% endblock %}

{% block javascripts %}
    {{parent()}}
    <script src="{{ asset('scripts/clan.js') }}"></script>
    <script src="{{ asset('scripts/map.js') }}"></script>
{% endblock %}
