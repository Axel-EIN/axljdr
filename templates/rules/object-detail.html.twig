{% extends 'element.html.twig' %}

{% block stylesheets %}
  {{parent()}}
  <link rel="stylesheet" href="{{asset('css/pages/object.css')}}" />
{% endblock %}

{% block element_content %}

  {% set categories = {ARME: 'Arme', ARMURE: 'Armure', PROJECTILE: 'Projectile', OBJET: 'Divers'} %}
  {% set stats = [
    {label: 'Taille',    value: record.taille|lower|capitalize},
    {label: 'Poids',     value: record.poids|lower|capitalize},
    {label: 'VD',        value: record.vd},
    {label: 'Force Arc', value: record.forceArc},
    {label: '+ND',       value: record.ndArmure},
    {label: 'Réduction', value: record.reduction}
  ]|filter(s => s.value is not empty) %}

  <div class="col-12">
    <div class="card card-page">

      <div class="relative">

        <div class="objet-stats d-none d-lg-flex">
          <span class="objet-categorie">{{ categories[record.categorie]|default(record.categorie) }}</span>
          {% if record.quality %}
            <span class="objet-quality quality-{{ record.quality|lower }}">{{ record.quality }}</span>
          {% endif %}
          {% for stat in stats %}
            <span>{{ stat.label }} : <strong>{{ stat.value }}</strong></span>
          {% endfor %}
          {% if record.prix %}<span class="objet-prix">{{ record.prix|pricer|raw }}</span>{% endif %}
        </div>

        {{ include('/parts/card-top-image.html.twig', {
          image: record.image|default(record.icon), na_image: NA_169, alt: 'Image de ' ~ record.nom,
          img_class: 'crop-169', title: name, classes: 'gradient-desktop', state: element_state(record)
        }) }}
      </div>

      <div class="objet-mobile-info d-lg-none text-center">
        <span class="objet-categorie">{{ categories[record.categorie]|default(record.categorie) }}</span>
        {% if record.quality %}
          <span class="objet-quality quality-{{ record.quality|lower }}">{{ record.quality }}</span>
        {% endif %}

        <ul class="list-decored text-left">
          {% for stat in stats %}
            <li><span class="label">{{ stat.label }} :</span> <strong>{{ stat.value }}</strong></li>
          {% endfor %}
          {% if record.prix %}
            <li><span class="label">Prix :</span> {{ record.prix|pricer|raw }}</li>
          {% endif %}
          {% if record.motCle1 or record.motCle2 %}
            <li>
              <span class="label">Mots-clés :</span>
              {{ [record.motCle1, record.motCle2]|filter(m => m is not empty)|join(', ') }}
            </li>
          {% endif %}
        </ul>
      </div>

      {% if record.motCle1 or record.motCle2 %}
        <p class="objet-motscles d-none d-lg-block">
          {% for word in [record.motCle1, record.motCle2]|filter(m => m is not empty) %}
            <span class="badge badge-secondary">{{ word }}</span>
          {% endfor %}
        </p>
      {% endif %}

      {% if record.description %}
        {{ include('parts/description.html.twig', {text: record.description, variant: 'aerated'}, with_context = false) }}
      {% endif %}

      {% if record.regles %}
        {{ include('/parts/divider-ornament.html.twig', {classes: 'my-3'}) }}

        <h2 class="heading-elementpart decorated">Règles</h2>
        {{ include('parts/description.html.twig', {text: record.regles, variant: 'aerated'}, with_context = false) }}
      {% endif %}

    </div>
  </div>

  {% if other_objects is not empty %}
    <div class="col-12">
      {{ include('/parts/picture-grid.html.twig', {
        items: other_objects,
        title: 'Autres ' ~ (categories[record.categorie]|default(record.categorie))|lower ~ 's',
        route: 'rules_object',
        variant: 'rule',
        field: 'icon',
        na_image: NA_43,
        per_row: 6
      }) }}
    </div>
  {% endif %}

{% endblock %}
