{% macro keyword_icon(key) %}
  {% set table = {
    'Affliction':  {icon: 'fa-arrow-down-wide-short', label: 'Affliction'},
    'Arme':        {icon: 'fa-gavel',                 label: 'Arme'},
    'Artisanat':   {icon: 'fa-cube',                  label: 'Artisanat'},
    'Atemi':       {icon: 'fa-hand-fist',             label: 'Atemi'},
    'Bénédiction': {icon: 'fa-arrow-up-wide-short',   label: 'Bénédiction'},
    'Detection':   {icon: 'fa-eye',                   label: 'Detection'},
    'Divination':  {icon: 'fa-hat-wizard',            label: 'Divination'},
    'Défense':     {icon: 'fa-shield-halved',         label: 'Défense'},
    'Explosion':   {icon: 'fa-bomb',                  label: 'Explosion'},
    'Glyphe':      {icon: 'fa-austral-sign',          label: 'Glyphe'},
    'Guerre':      {icon: 'fa-chess-knight',          label: 'Art de la Guerre'},
    'Illusion':    {icon: 'fa-eye-low-vision',        label: 'Illusion'},
    'Invocation':  {icon: 'fa-ghost',                 label: 'Invocation'},
    'Jade':        {icon: 'fa-gem',                   label: 'Jade'},
    'Soins':       {icon: 'fa-heart',                 label: 'Soins'},
    'Souillure':   {icon: 'fa-biohazard',             label: 'Souillure'},
    'Tonnerre':    {icon: 'fa-bolt-lightning',        label: 'Tonnerre'},
    'Voyage':      {icon: 'fa-person-running',        label: 'Voyage'},
  } %}
  {% if table[key] is defined %}<i class="fa-solid {{ table[key].icon }}" title="{{ table[key].label }}"></i>{% endif %}
{% endmacro %}
{% import _self as icons %}

{% set past_rank = 1 %}
{% set library = record %}

    <div class="col-12 list-heading">

        {% if is_gm() %}
            {% set number = items|length + 1 %}
            {% set action, entity, position, color, size = 'create', 'spell', 'topleft-overflow', 'link-gm', 'btn-icon-mini' %}
            {% set redirect = 'library&libraryID=' ~ library.id ~ '&tab=' ~ app.request.get('tab') ~ '&subtab=' ~ app.request.get('subtab') ~ '&number=' ~ number %}
            {{ include('/btns/btn-icon.html.twig') }}
        {% endif %}

        <div class="col-6 text-left">Nom</div>
        {% if app.request.get('tab') == 'KIHO' %}
            <div class="col-2"></div>
            <div class="col-2">Type Kiho</div>
        {% elseif app.request.get('tab') == 'TATOUAGE' %}
            <div class="col-5"></div>
        {% else %}
            <div class="col-4"></div>
        {% endif %}

        <div class="col-1 p-0 m-0">Mot-Clés</div>

        {% if app.request.get('tab') != 'TATOUAGE' %}
            <div class="col-1 p-0 m-0">Niveau</div>
        {% endif %}

    </div>

{% for item in items %}

    {% if item.anneau is defined %}

        {% if app.request.get('tab') == 'MAGIE' %}
            {% if item.anneau == 'AIR' %}
                {% set icon = FLAT_AIR %}
            {% elseif item.anneau == 'EAU' %}
                {% set icon = FLAT_EAU %}
            {% elseif item.anneau == 'FEU' %}
                {% set icon = FLAT_FEU %}
            {% elseif item.anneau == 'TERRE' %}
                {% set icon = FLAT_TERRE %}
            {% elseif item.anneau == 'VIDE' %}
                {% set icon = FLAT_VIDE %}
            {% endif %}
        {% elseif app.request.get('tab') == 'MAHO' %}
            {% if item.anneau == 'AIR' %}
                {% set icon = FLAT_AIR_MAHO %}
            {% elseif item.anneau == 'EAU' %}
                {% set icon = FLAT_EAU_MAHO %}
            {% elseif item.anneau == 'FEU' %}
                {% set icon = FLAT_FEU_MAHO %}
            {% elseif item.anneau == 'TERRE' %}
                {% set icon = FLAT_TERRE_MAHO %}
            {% endif %}
        {% elseif app.request.get('tab') == 'KIHO' %}
            {% if item.anneau == 'AIR' %}
                {% set icon = FLAT_AIR_KIHO %}
            {% elseif item.anneau == 'EAU' %}
                {% set icon = FLAT_EAU_KIHO %}
            {% elseif item.anneau == 'FEU' %}
                {% set icon = FLAT_FEU_KIHO %}
            {% elseif item.anneau == 'TERRE' %}
                {% set icon = FLAT_TERRE_KIHO %}
            {% elseif item.anneau == 'VIDE' %}
                {% set icon = FLAT_VIDE_KIHO %}
            {% endif %}
        {% endif %}

    {% endif %}

    {% if not element_readable(item) %}
        {{ include('rules/list-item-locked.html.twig', {entity: 'spell', classes: past_rank != item.niveau ? 'mt-3'}) }}
    {% else %}
        <div class="col-12 p-0 m-0 {% if past_rank != item.niveau %}mt-3{% endif %} relative">

            {% if is_gm() %}
                {% set position, size, color, entity, record, redirect = 'topleft-overflow', 'btn-icon-mini', 'link-gm', 'spell', item, 'library&libraryID=' ~ library.id %}
                {{ include('/btns/btn-icon-edit.html.twig') }}
            {% endif %}

            <a href="#spell{{ item.id }}" class="card item" data-toggle="collapse" role="button" aria-expanded="false" aria-controls="spell{{ item.id }}">

                <div class="item-line">

                    <div class="col-6 p-0 m-0 ml-2 text-left">
                        {% if app.request.get('tab') != 'TATOUAGE' %}
                            <img class="img-24" src="{{asset(icon|default(NA_ICON))}}" />
                        {% endif %}
                        {{ include('parts/badge-access.html.twig', {state: element_state(item), variant: 'inline'}) }}
                        <strong class="item-name ml-1">{{ item.nom }}</strong>
                        {% if is_gm() %}<em class="ml-2 text-muted">- {{ item.originalName }}</em>{% endif %}
                    </div>

                    {% if app.request.get('tab') == 'KIHO' %}
                        <div class="col-2 p-0 m-0"></div>
                        <div class="col-2 p-0 m-0 text-small">{{item.kihoType|upper}}</div>
                    {% elseif app.request.get('tab') == 'TATOUAGE' %}
                        <div class="col-5 p-0 m-0"></div>
                    {% else %}
                        <div class="col-4 p-0 m-0"></div>
                    {% endif %}

                    <div class="col-1 p-0 m-0 align-bottom text-{{item.anneau}}">

                        {% if item.keyword1 %}
                            {{ icons.keyword_icon(item.keyword1) }}
                        {% endif %}

                        {% if item.keyword2 %}
                            <span class="ml-1">
                                {{ icons.keyword_icon(item.keyword2) }}
                            </span>
                        {% endif %}

                        {% if item.keyword3 %}
                            <span class="ml-1">
                                {{ icons.keyword_icon(item.keyword3) }}
                            </span>
                        {% endif %}

                    </div>

                    {% if app.request.get('tab') != 'TATOUAGE' %}
                        {% set ring = item.anneau in ['TERRE', 'AIR', 'FEU', 'EAU', 'VIDE'] ? item.anneau : 'black' %}
                        <div class="col-1 p-0 m-0 text-{{ ring|lower }}">
                            <strong class="text-rank font-present bg-{{ ring|lower }}">{{ item.niveau }}</strong>
                        </div>
                    {% endif %}

                </div>

                <div id="spell{{ item.id }}" class="collapse">
                    {{ include('/characters/character-sheet-spell-detail.html.twig', {spell: item}) }}
                </div>

            </a>
        </div>
    {% endif %}

    {% set past_rank = item.niveau %}
{% endfor %}