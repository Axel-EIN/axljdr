{% extends 'element.html.twig' %}

{% set nom = ENTITY_LABELS[entity]|default('Élément') ~ ' à découvrir' %}

{% block element_content %}

  {% set placeholders = {
    archive: NA_ARCHIVE, clan: NA_CLAN, dojo: NA_ECOLE, library: NA_LIBRARY,
    location: NA_LIEU, lore: NA_LORE, object: NA_OBJET, rule: NA_RULE,
  } %}

  {% set attentes = {
    archive:    "Cette archive n'a pas encore été déverrouillée dans l'aventure. Seules vos actions, jeunes samuraïs, vous permettront d'en percer les secrets.",
    clan:       "Cette faction n'a pas encore été déverrouillée dans l'aventure. Seules vos actions, jeunes samuraïs, vous permettront un jour de la côtoyer.",
    dojo:       "Cette école n'a pas encore été déverrouillée dans l'aventure. Seules vos actions, jeunes samuraïs, vous permettront un jour d'en apprendre les techniques.",
    episode:    "Cet épisode n'a pas encore été déverrouillé dans l'aventure. Seules vos actions, jeunes samuraïs, vous permettront un jour d'en connaître le récit.",
    location:   "Ce lieu n'a pas encore été déverrouillé dans l'aventure. Seules vos actions, jeunes samuraïs, vous mèneront un jour jusqu'à lui.",
    lore:       "Ce savoir n'a pas encore été déverrouillé dans l'aventure. Seules vos actions, jeunes samuraïs, vous permettront un jour de le lire.",
    object:     "Cet objet n'a pas encore été déverrouillé dans l'aventure. Seules vos actions, jeunes samuraïs, vous permettront un jour de le tenir.",
    personnage: "Ce personnage n'a pas encore été déverrouillé dans l'aventure. Seules vos actions, jeunes samuraïs, vous permettront un jour de le rencontrer.",
    rule:       "Cette règle n'a pas encore été déverrouillée dans l'aventure. Seules vos actions, jeunes samuraïs, vous permettront un jour de la maîtriser.",
    library:    "Cette bibliothèque n'a pas encore été déverrouillée dans l'aventure. Seules vos actions, jeunes samuraïs, vous en ouvriront un jour les pages.",
  } %}

  <div class="col-12">
    <div class="card card-page">

      <div class="relative">
        <img class="icon-lock" src="{{ asset(LOCKED_ICO) }}" alt="Cadenas" title="À débloquer !" />
        {{ include('/parts/card-top-image.html.twig', {
          image: placeholders[entity]|default(NA_1610),
          na_image: NA_1610,
          alt: nom,
          img_class: 'crop-169 grayscale',
          titre: nom,
        }) }}
      </div>

      <p class="card-description texte-attente leading-15">{{ attentes[entity]|default("Cet élément n'a pas encore été déverrouillé dans l'aventure. Seules vos actions, jeunes samuraïs, vous permettront un jour de le découvrir.") }}</p>

    </div>
  </div>

{% endblock %}
