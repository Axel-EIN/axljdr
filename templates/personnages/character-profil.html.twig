{% extends 'element.html.twig' %}

{% block stylesheets %}
  {{parent()}}
  <link rel="stylesheet" href="{{asset('css/components/history.css')}}" />
  <link rel="stylesheet" href="{{asset('css/components/edit-mode.css')}}" />
  <link rel="stylesheet" href="{{asset('css/pages/character-profile.css')}}" />
{% endblock %}

{% block element_content %}

{% if personnage.illustration is null and personnage.genre == 'F' %}
  {% set NA_PERSO_ILLU = NA_PERSO_ILLU_F %}
{% elseif personnage.illustration is null and personnage.genre == 'M' %}
  {% set NA_PERSO_ILLU = NA_PERSO_ILLU_M %}
{% endif %}
{% set illustration_src = asset(personnage.illustration|default(NA_PERSO_ILLU)) %}

<div class="col-12 d-lg-none order-0 relative">
  <div class="profil-banner-mobile">
    <img src="{{ illustration_src }}" alt="{{personnage.nom}} {{personnage.prenom}}" title="{{personnage.nom}} {{personnage.prenom}}" />
  </div>
  {{ include('parts/badge-access.html.twig', {state: element_state(personnage)}) }}
</div>

{# ============================= #}
{# ===== [CARD] LEFT INFOS ===== #}
{# ============================= #}

<div class="col-12 col-lg-4 order-2 order-lg-1">
  <div class="card card-body profil-infos">

    <div class="relative d-none d-lg-block">
      <img class="img-fluid w-100" src="{{ illustration_src }}" alt="{{personnage.nom}} {{personnage.prenom}}" title="{{personnage.nom}} {{personnage.prenom}}" />
      {{ include('parts/badge-access.html.twig', {state: element_state(personnage)}) }}
    </div>

    <ul class="list-group list-group-flush">

      <li class="list-group-item d-flex justify-content-between align-items-center">
        <div class="d-flex flex-column">
          <span class="text-muted text-small">Création : <strong class="extrabold">{{xp_creation}}</strong></span>
          <span class="text-muted text-small">Progression : <strong class="extrabold">{{xp_progression}}</strong></span>
        </div>
        <div class="text-big text-strong extrabold">
          {% if xp > 0 %}
            {{xp}} XP
          {% endif %}
        </div>
      </li>

      <li class="list-group-item d-flex justify-content-between align-items-center">
        {% if personnage.clan is defined and personnage.clan is not empty %}
          <a class="hover-no-under" href="{{ path('empire_clan', {id: personnage.clan.id} ) }}">
            <img class="img-48" src="{{ asset(personnage.clan.mon|default(NA_MON)) }}" alt="Mon du Clan {{personnage.clan.nom}}" title="Mon du Clan {{personnage.clan.nom}}" />
            &nbsp;
            <strong class="extrabold">{{ personnage.clan.nom }}</strong>
          </a>
        {% endif %}

        {% if personnage.famille is defined and personnage.famille is not empty %}
          <a class="d-block hover-no-under overflow-hidden" href="{{ path('empire_clan', {id: personnage.clan.id, '_fragment': personnage.famille.nom } ) }}">
            <strong class="extrabold">{{ personnage.famille.nom }}</strong>
            <img
              class="img-48 rounded-circle" src="{{ asset(personnage.famille.mon|default(NA_MON)) }}"
              alt="Mon de la Famille {{personnage.famille.nom}}" title="Mon de la Famille {{personnage.famille.nom}}"
            />
          </a>
        {% endif %}
      </li>

      {% if personnage.ecole is defined and personnage.ecole is not empty %}
        <li class="list-group-item d-flex align-items-center">
            
          <a class="hover-no-under" href="{{ path('regles_ecole', {id: personnage.ecole.id} ) }}">
            <img class="img-48" src="{{ asset(personnage.classe.icone|default(NA_CLASS_ICO)) }}" alt="Classe {{personnage.classe.nom}}" title="Classe {{personnage.classe.nom}}" />
            &nbsp;
            <strong class="extrabold">{{ personnage.ecole.nom }}</strong>
          </a>           
          {% if xp > 0 %}
            <span class="ml-auto badge badge-info">RANG {{rang}}</span>
          {% endif %}
        </li>
      {% endif %} 

      {% if personnage.joueur is not empty %}
        <li class="list-group-item"><strong>Joueur :</strong> {{ personnage.joueur.pseudo }}</li>
      {% endif %}

      {% if personnage.fichePersonnage is not null and (est_le_joueur or is_granted('ROLE_MJ')) %}
        <li class="list-group-item d-flex justify-content-center profil-btn-fiche">
          <a class="btn-primary-style btn-medium" href="{{ path('personnage_fiche', {id: personnage.fichePersonnage.id}) }}">
            <i class="fas fa-scroll"></i> Voir la fiche de personnage
          </a>
        </li>
      {% elseif personnage.fichePersonnage is null and is_granted('ROLE_MJ') %}
        <li class="list-group-item d-flex justify-content-center profil-btn-fiche">
          {{ include('btns/btn-add-element.html.twig', {
            entity: 'fiche', label_one: 'Fiche Personnage', options: 'personnage=' ~ personnage.id, position: ''
          }) }}
        </li>
      {% endif %}
    </ul>

  </div>
</div>

{# ======================= #}
{# ===== [CARD] MAIN ===== #}
{# ======================= #}

<div class="col-12 col-lg-8 order-1 order-lg-2">
    <div class="card card-body">

        {% if peut_editer %}
        {{ form_start(form, {action: path('personnage_profil_edit', {id: personnage.id})}) }}
        {% endif %}

        <div class="profile-maincontent profil-zone">

            {# ================================ #}
            {# ===== [CARD-SECTION] STORY ===== #}
            {# ================================ #}

            <h2 class="profile-description-title">Histoire</h2>

            {% if personnage.titres is defined and personnage.titres is not empty %}
                <h4 class="card-title-cartouche">{{ personnage.titres }}</h4>
            {% endif %}

            <p class="profile-description read-only">{{ personnage.description|default('')|raw|nl2br }}</p>

            {% if peut_editer %}
                {{ form_widget(form.description, {attr: {class: 'edit-only'}}) }}
                {{ include('/btns/btn-interactive-edit-actions.html.twig', {label: 'Éditer'}) }}
            {% endif %}

            {# ========================================= #}
            {# ===== [CARD-SECTION] DEVELOPPEMENTS ===== #}
            {# ========================================= #}

            <div class="profil-developments">
                {% for development in developments %}
                    {% set scene = development.scene %}
                    {% set episode = scene.episodeParent %}
                    {% set chapitre = episode.chapitreParent %}
                    {% set scene_url = path('aventure_episode', {id: episode.id, '_fragment': 'scn' ~ scene.numero}) %}

                    <article class="development-line">
                        <div class="development-head">
                            <span class="development-title">
                                <a href="{{ scene_url }}"><strong>{{ scene.titre }}</strong></a>
                                {% if is_granted('ROLE_MJ') %}
                                    {{ include('/btns/btn-icon-edit.html.twig', {
                                    entity: 'development', un_element: development, position: 'align-middle',
                                    redirect: 'development', size: 'btn-icon-mini', color: 'text-accent',
                                    }) }}
                                {% endif %}
                            </span>

                            <span class="development-meta">{{ chapitre.titre }} — EP #{{ episode.numeroSaison }} - Scène {{ scene.numero }}</span>
                            {% if development.estMort %}
                                <strong class="text-dead">MORT</strong>
                            {% endif %}
                        </div>

                        <div class="development-content">
                            <p class="profile-description">{{ development.content|raw|nl2br }}</p>
                            <a class="development-image" href="{{ scene_url }}" title="Voir la scène {{ scene.numero }}">
                                <img src="{{ asset(scene.image|default(NA_SCENE)) }}" alt="Scène {{ scene.numero }} — {{ scene.titre }}" />
                            </a>
                        </div>
                    </article>
                {% endfor %}

                <div class="zone-actions">
                    {{ include('/btns/btn-add-element.html.twig', {
                        entity: 'development', label_one: 'développement',
                        position: '', options: 'personnage=' ~ personnage.id,
                        variant: 'btn-quaternary-style text-accent',
                    }) }}
                </div>
            </div>

            {% if peut_editer %}

                {# ========================================= #}
                {# ===== [CARD-SECTION] PLAYER'S NOTES ===== #}
                {# ========================================= #}

                <div class="profil-zone">
                    {{ include('/parts/divider-ornament.html.twig') }}
                    <h2 class="profile-description-title">Secrets</h2>

                    {% if personnage.playerNotes is not empty %}
                        <p class="card-description condensed read-only">{{ personnage.playerNotes|nl2br }}</p>
                    {% else %}
                        <p class="profile-description-na">Rien pour le moment.</p>
                    {% endif %}

                    {{ form_widget(form.playerNotes, {attr: {class: 'edit-only'}}) }}
                    {{ include('/btns/btn-interactive-edit-actions.html.twig', {label: 'Éditer'}) }}
                </div>


                {% if app.user and is_granted("ROLE_MJ") %}
                    {# ===================================== #}
                    {# ===== [CARD-SECTION] GM's NOTES ===== #}
                    {# ===================================== #}

                    <div class="profil-zone">
                        {{ include('/parts/divider-ornament.html.twig') }}
                        <h2 class="profile-description-title">Notes du Maître de Jeu</h2>

                        {% if personnage.gmNotes is not empty %}
                            <p class="card-description condensed read-only">{{ personnage.gmNotes|nl2br }}</p>
                        {% else %}
                            <p class="profile-description-na">Rien pour le moment.</p>
                        {% endif %}

                        {{ form_widget(form.gmNotes, {attr: {class: 'edit-only'}}) }}
                        {{ include('/btns/btn-interactive-edit-actions.html.twig', {label: 'Éditer'}) }}
                    </div>
                {% endif %}

                {{ form_end(form) }}
            {% endif %}

        </div>
    </div>
</div>

{# ========================== #}
{# ===== [CARD] HISTORY ===== #}
{# ========================== #}

<div class="col-12 col-lg-8 order-3">
    <div class="card card-body">
        <h2 class="heading-cardtitle">Historique</h2>
        <hr>
        <div class="card-text profil-historique">
            {{ include('parts/history.html.twig', {historique, saison_courante}) }}
            {% if xp_creation > 0 %}
            <p class="profil-creation">Création du personnage {{ personnage.prenom }} avec <strong>{{ xp_creation }}xp</strong>.</p>
            {% endif %}
        </div>
    </div>
</div>

{# =================================== #}
{# ===== [CARD] OTHER CHARACTERS ===== #}
{# =================================== #}

{{ include('/parts/picture-grid.html.twig', {
    variant: 'portrait',
    title: personnage.estPj ? 'Autres PJs' : 'Autres PNJs',
    items: autresPersonnages, route: 'personnage_profil',
    limit: 12,
    wrapper: 'col-12 col-lg-4 order-4',
    per_row: {desktop: 2, tablet: 4, mobile: 2},
    empty_message: "Il n'y a pas d'autres personnage.",
}) }}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if peut_editer %}
        <script>
            (function () {
            const bascule = (selecteur, action) => document.querySelectorAll(selecteur).forEach(
                btn => btn.addEventListener('click', () => btn.closest('.profil-zone').classList[action]('edit-mode'))
            );
            bascule('[data-edit-open]', 'add');
            bascule('[data-edit-cancel]', 'remove');
            })();
        </script>
    {% endif %}
{% endblock %}
