{% set lieu = lieu|default(null) %}
{% set personnage = personnage|default(null) %}
{% set presents = presents|default([]) %}
{% set element = lieu ?? personnage %}
{% set etat = element_state(element) %}
{% set lisible = element_readable(element) %}
{% set type = personnage ? personnage.classe.nom ?? null : lieu.type %}

{% if personnage and lisible %}
  <img class="map-panel-banner portrait" src="{{ asset(personnage.illustration|default(NA_PERSO_ILLU)) }}" alt="Illustration de {{ personnage.nomComplet }}" />
{% elseif lieu and lieu.image %}
  <img class="map-panel-banner" src="{{ asset(image_small(lieu.image)) }}" alt="Image de {{ lieu.nom }}" />
{% endif %}

<div class="map-panel-body">
  <h2 class="map-panel-title">
    {{ personnage ? personnage.nomComplet : lieu.nom }}
    {{ include('parts/badge-access.html.twig', {state: etat, variant: 'inline'}) }}
  </h2>

  {% if lisible %}
    <div class="map-panel-details">
      {% if element.clan %}
        <img class="img-24" src="{{ asset(image_small(element.clan.mon|default(NA_MON))) }}" alt="" />
        <span>{{ element.clan.nom }}</span>
      {% endif %}
      {% if type %}<span>{{ type }}</span>{% endif %}
    </div>

    {% if element.description %}
      <p class="map-panel-description">{{ element.description|striptags|raw }}</p>
    {% endif %}
  {% endif %}

  {% if presents is not empty %}
    <div>
      <h3 class="map-panel-heading">Personnages présents</h3>
      <div class="map-panel-party">
        {% for perso in presents %}
          <a href="{{ path('personnage_profil', {id: perso.id}) }}" title="{{ perso.nomComplet }}">
            <img src="{{ asset(perso.icone|default(NA_PERSO_PORTRAIT)) }}" alt="Portrait de {{ perso.prenom }}" />
          </a>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if historique is not empty %}
    <div>
      <h3 class="map-panel-heading">Dernières scènes</h3>
      <ul class="map-panel-history">
        {% for un_bloc in historique %}
          {% set derniere = un_bloc.lignes|first.scene %}
          <li>
            <a href="{{ path('aventure_episode', {id: un_bloc.episode.id, '_fragment': 'scn' ~ derniere.numero}) }}">
              <span class="text-muted">#{{ un_bloc.episode.numeroSaison }}</span>
              {{ derniere.titre }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  {% if lisible %}
    {% if personnage %}
      <a class="btn-primary-style btn-medium text-center" href="{{ path('personnage_profil', {id: personnage.id}) }}">Voir le profil</a>
    {% else %}
      <a class="btn-primary-style btn-medium text-center" href="{{ path('world_lieu', {id: lieu.id}) }}">Ouvrir la fiche</a>
    {% endif %}
  {% endif %}
</div>
