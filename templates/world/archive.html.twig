{% extends 'element.html.twig' %}

{% block element_content %}

    <div class="col-12">
        <div class="card card-page">
        
            {{ include('/parts/card-top-image.html.twig', {image: un_element.image, na_image: NA_ARCHIVE, alt: 'Image de ' ~ nom, img_class: 'crop-169', titre: nom, state: element_state(un_element)}) }}

            {{ include('parts/description.html.twig', {text: un_element.contenu, variant: 'aerated'}, with_context = false) }}
        
            {% if un_element.auteur is not empty %}
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <strong>Auteur&nbsp;:</strong> {{ un_element.auteur.nom }} <strong>{{ un_element.auteur.prenom }}</strong> 
                    </li>
                </ul>
            {% endif %}

            {{ include('/parts/divider-ornament.html.twig') }}

            {% if is_mj() %}
                {% set redirect, element, un_element, color, action = 'world', 'archive', un_element, 'link-gm', 'delete' %}
                {{ include('/btns/btn-line.html.twig') }}
            {% endif %}

        </div>
    </div>

    {{ include('/parts/picture-grid.html.twig', {
        title: 'Autres Archives',
        items: autresArchives, route: 'world_archive',
        na_image: NA_ARCHIVE,
    }) }}

{% endblock %}
