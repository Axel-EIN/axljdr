{% set total = total|default(xp) %}
{% set bonus = total > xp ? '×' ~ constant('App\\Entity\\Participation::XP_BONUS_MULTIPLIER') : null %}
{%- if format|default('short') == 'short' -%}
  {{ sign|default('') }}{{ xp }}&nbsp;xp{% if bonus %}&nbsp;{{ bonus }}{% endif %}
{%- elseif format == 'medium' -%}
  {{ sign|default('') }}{{ xp }}&nbsp;xp{% if bonus %} (Total avec bonus&nbsp;{{ bonus }} = {{ sign|default('') }}{{ total }}&nbsp;xp){% endif %}
{%- elseif bonus -%}
  Total avec bonus&nbsp;{{ bonus }} : {{ total }}&nbsp;xp
{%- endif -%}
