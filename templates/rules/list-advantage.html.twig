{% set library = record %}

<div class="col-12 list-heading">

    {% if is_gm() %}
        {% set action, entity, redirect, position, color, size = 'create', 'advantage', 'library&libraryID=' ~ library.id ~ '&tab=' ~ app.request.get('tab'), 'topleft-overflow', 'link-gm', 'btn-icon-mini' %}
        {{ include('/btns/btn-icon.html.twig') }}
    {% endif %}

    <span>Nom</span>
    <span class="ml-auto">
        <span>Bonus</span>
        <span class="ml-4">{% if app.request.get('tab') == 'Avantage' %}Coût{% elseif app.request.get('tab') == 'Désavantage' %}Gain{% else %}Coût / Gain{% endif %}</span>
    </span>
</div>

{% for item in items %}

    {% if not element_readable(item) %}
        {{ include('rules/list-item-locked.html.twig', {entity: 'advantage'}) }}
    {% else %}
        {% set discount_clans = item.discountClans|filter(clan => element_listed(clan)) %}
        {% set discount_classes = item.discountClasses %}
        <div class="col-12 p-0 m-0 relative">

            {% if is_gm() %}
                {% set position, size, color, entity, record, redirect = 'topleft-overflow', 'btn-icon-mini', 'link-gm', 'advantage', item, 'library&libraryID=' ~ library.id %}
                {{ include('/btns/btn-icon-edit.html.twig') }}
            {% endif %}

            <a href="#advantage{{ item.id }}" class="card item" data-toggle="collapse" role="button" aria-expanded="false" aria-controls="advantage{{ item.id }}">

                <div class="item-line">
                    {{ include('parts/badge-access.html.twig', {state: element_state(item), variant: 'inline'}) }}
                    <span class="bold item-name">{{ item.nom }}</span>
                    {% if element_fresh(item) %}{{ include('parts/badge-new.html.twig', {variant: 'inline'}) }}{% endif %}
                    {% if item.exclusive %}
                        <div class="ml-2">
                            <span class="badge badge-secondary">{{item.exclusive.nom}}</span>
                        </div>
                    {% endif %}
                    <span class="ml-auto">
                        {% for discount_class in discount_classes %}
                            <span class="badge badge-info">{{ discount_class.nom }}</span>
                        {% endfor %}
                        {% for discount_clan in discount_clans %}
                            <span class="badge badge-success">{{ discount_clan.nom }}</span>
                        {% endfor %}
                        <span class="bold ml-3 xp-cost{% if item.genre == 'Avantage' %} spend{% elseif item.genre == 'Désavantage' %} gain{% endif %}">
                            {% if item.genre == 'Avantage' %}-{% elseif item.genre == 'Désavantage' %}+{% endif %}{{ item.cout }} xp
                        </span>
                    </span>
                </div>

                <div id="advantage{{ item.id }}" class="collapse">
                    <span class="badge badge-pill badge-dark mt-2">{{item.type}}</span>
                    <p class="p-2 m-0 item-description">
                        {{ item.description|text }}
                    </p>
                    {% if item.discount and (discount_clans is not empty or discount_classes is not empty) %}
                        {% set groups = {
                            'du clan': discount_clans,
                            'de la classe': discount_classes,
                        }|filter(g => g is not empty) %}
                        <div class="text-small text-green ml-2">
                            Les personnages
                            {% for prefix, linked_entities in groups %}
                                {% if not loop.first %}ou{% endif %}
                                {{ prefix }}
                                {% for linked_entity in linked_entities %}<span class="bold">{{ linked_entity.nom }}</span>{% if not loop.last %}, {% endif %}{% endfor %}
                            {% endfor %}
                                {% if item.genre == 'Avantage' %}
                                    peuvent dépenser <span class="bold">{{item.discount}} xp</span>
                                {% elseif item.genre == 'Désavantage' %}
                                    peuvent gagner jusqu'à <span class="bold">{{item.discount}} xp</span> en prenant ce Désavantage
                                {% endif %}
                        </div>
                    {% endif %}
                    {% if item.exclusive %}
                        <div class="text-small text-secondary ml-2">
                            Exclusif aux personnages <span class="bold">{{item.exclusive.nom}}</span>
                        </div>
                    {% endif %}
                </div>

            </a>
        </div>
    {% endif %}

{% endfor %}