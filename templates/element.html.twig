{% extends 'base.html.twig' %}
{% block title %}{{ entity == 'fiche' ? 'Fiche de Jeu : ' ~ nom : entity|capitalize ~ ' ' ~ nom }} {{parent()}} {% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{asset('css/components/element.css')}}" />
  <link rel="stylesheet" href="{{asset('css/components/picture-grid.css')}}" />
{% endblock %}

{% block body %}
  <main class="container-fluid element-page">
    <div class="container relative">

      {% if category == 'personnages' and entity == 'fiche' %}
        {% set fil = [
          { label: category|capitalize, path: path(category) },
          { label: nom, path: path('personnage_profil', {id: fiche.personnage.id}) },
          { label: 'Fiche de Jeu' },
        ] %}
      {% else %}
        {% set fil = [
          { label: category|capitalize, path: path(category, {'_fragment': entity}) },
          { label: nom },
        ] %}
      {% endif %}
      {{ include('parts/breadcrumbs.html.twig', {items: fil}) }}

      {{ include('parts/messages-flashes.html.twig') }}

      <section>

        <h1 class="heading-elementdetail relative">
          {% if category == 'personnages' and entity == 'fiche' %}
            <strong>Fiche de Jeu : {{ nom }}</strong>
          {% else %}
            <strong>{{ nom }}</strong>
          {% endif %}

          {% if app.user and is_granted("ROLE_MJ") %}
            {% set redirect, size, color, position = entity, 'btn-icon-medium', 'text-accent', 'topright-corner-snap' %}
            {{ include('/btns/btn-icon-edit.html.twig') }}
          {% endif %}
        </h1>
        <hr class="hr-title">

        <article class="row">
          {% block element_content %}{% endblock %}            
        </article>
      </section>
    </div>
  </main>
{% endblock %}
