{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{asset('css/components/category.css')}}" />
{% endblock %}

{% block body %}

    <header class="header-bg-img header-bg-{{header_classname}}">
        <div class="container">
            <div class="header d-flex flex-column justify-content-center align-items-center">
                <div class="text-center d-flex justify-content-center">
                    <strong class="h1 text-white">
                        {{header_up}}
                    </strong>
                </div>
                <hr class="w-50">
                {% set has_long_word = false %}
                {% for word in header_down|split(' ') %}
                    {% if word|length > 9 %}{% set has_long_word = true %}{% endif %}
                {% endfor %}
                <h1 class="heading-category{% if has_long_word %} reduced{% endif %}">
                    {{header_down|relief|raw}}
                </h1>
            </div>
        </div>
    </header>

    <main class="container-fluid category-page">
        <div class="container">

            {% block content_top %}{% endblock %}

            {% set counter = 1 %}
            {% for section in sections %}
                {% set entity, label_one = section['entity'], section['label_one']|default(null) %}

                <section id="{{section['entity']}}">

                    <div class="relative">
                        <h2 class="heading-categorysubsection">
                            <span class="small-word">{{section['titleLight']}}</span><strong>{{section['titleStrong']}}</strong>
                        </h2>
                        <hr class="d-none d-lg-block">
                        <div class="section-aside">
                            {% if block('section_aside' ~ counter) is defined %}{{ block('section_aside' ~ counter) }}{% endif %}
                            {% if label_one is not empty %}
                                {{ include('/btns/btn-add-element.html.twig', {entity, label_one, position: ''}) }}
                            {% endif %}
                        </div>
                    </div>
                    <div class="row">

                        {{ block('section_content' ~ counter) }}
                        
                    </div>
                </section>

                {% set counter = counter + 1 %}
            {% endfor %}
            
        </div>
    </main>

{% endblock %}