{% extends 'element.html.twig' %}

{% block stylesheets %}
  {{parent()}}
  <link rel="stylesheet" href="{{asset('css/components/spell.css')}}" />
  <link rel="stylesheet" href="{{asset('css/pages/character-sheet.css')}}" />
{% endblock %}

{% set cout_par_spe = 2 %}

{# Avantages / Désavantages : applique discount si le clan/classe du personnage qualifie.
   Défini hors bloc pour être accessible aux blocs element_content ET javascripts. #}
{% set perso_clan_id   = fiche.personnage.clan   ? fiche.personnage.clan.id   : 0 %}
{% set perso_classe_id = fiche.personnage.classe ? fiche.personnage.classe.id : 0 %}
{% set effective_costs = {av1: 0, av2: 0, dv1: 0, dv2: 0} %}
{% for key, item in {av1: fiche.avantage1, av2: fiche.avantage2, dv1: fiche.desavantage1, dv2: fiche.desavantage2} %}
  {% if item %}
    {% set qualifies = item.discount and (
      (item.discountClan   and item.discountClan.id   == perso_clan_id)
      or (item.discountClan2  and item.discountClan2.id  == perso_clan_id)
      or (item.discountClasse and item.discountClasse.id == perso_classe_id)
    ) %}
    {% set effective_costs = effective_costs|merge({(key): (qualifies ? item.discount : item.cout)}) %}
  {% endif %}
{% endfor %}
{% set cout_avantages_total    = effective_costs.av1 + effective_costs.av2 %}
{% set gain_desavantages_total = effective_costs.dv1 + effective_costs.dv2 %}

{# initiativeModifier est un INT (modifie le resultat), attaqueModifier et
   dmgModifier des "XgY" (modifient le jet). #}
{% set initMod = fiche.initiativeModifier ?? 0 %}
{% set atkModL, atkModG = 0, 0 %}
{% if fiche.attaqueModifier %}
  {% set atkModSplit = fiche.attaqueModifier|split('g') %}
  {% set atkModL = atkModSplit[0]|default(0) %}
  {% set atkModG = atkModSplit[1]|default(0) %}
{% endif %}
{% set dmgModL, dmgModG = 0, 0 %}
{% if fiche.dmgModifier %}
  {% set dmgModSplit = fiche.dmgModifier|split('g') %}
  {% set dmgModL = dmgModSplit[0]|default(0) %}
  {% set dmgModG = dmgModSplit[1]|default(0) %}
{% endif %}

{% block element_content %}

{% set bonusNomFamille = (fiche.personnage.famille is not empty) ? fiche.personnage.famille.bonusStatNom : null %}
{% set bonusNomEcole   = (fiche.personnage.ecole is not empty) ? fiche.personnage.ecole.bonusStatNom : null %}

{# nb_bonus_X = nombre de sources (famille/école) offrant un rang gratuit sur ce trait (0, 1 ou 2). #}
{% set nb_bonus_constitution = (bonusNomFamille == 'constitution'  ? 1 : 0) + (bonusNomEcole == 'constitution'  ? 1 : 0) %}
{% set nb_bonus_volonte      = (bonusNomFamille == 'volonte'       ? 1 : 0) + (bonusNomEcole == 'volonte'       ? 1 : 0) %}
{% set nb_bonus_reflexes     = (bonusNomFamille == 'reflexes'      ? 1 : 0) + (bonusNomEcole == 'reflexes'      ? 1 : 0) %}
{% set nb_bonus_intuition    = (bonusNomFamille == 'intuition'     ? 1 : 0) + (bonusNomEcole == 'intuition'     ? 1 : 0) %}
{% set nb_bonus_agilite      = (bonusNomFamille == 'agilite'       ? 1 : 0) + (bonusNomEcole == 'agilite'       ? 1 : 0) %}
{% set nb_bonus_intelligence = (bonusNomFamille == 'intelligence'  ? 1 : 0) + (bonusNomEcole == 'intelligence'  ? 1 : 0) %}
{% set nb_bonus_forceStat    = (bonusNomFamille == 'forceStat'     ? 1 : 0) + (bonusNomEcole == 'forceStat'     ? 1 : 0) %}
{% set nb_bonus_perception   = (bonusNomFamille == 'perception'    ? 1 : 0) + (bonusNomEcole == 'perception'    ? 1 : 0) %}
{% set nb_bonus_vide         = (bonusNomFamille == 'vide'          ? 1 : 0) + (bonusNomEcole == 'vide'          ? 1 : 0) %}

{% set eff_constitution  = fiche.constitution  + nb_bonus_constitution %}
{% set eff_volonte       = fiche.volonte       + nb_bonus_volonte %}
{% set eff_reflexes      = fiche.reflexes      + nb_bonus_reflexes %}
{% set eff_intuition     = fiche.intuition     + nb_bonus_intuition %}
{% set eff_agilite       = fiche.agilite       + nb_bonus_agilite %}
{% set eff_intelligence  = fiche.intelligence  + nb_bonus_intelligence %}
{% set eff_forceStat     = fiche.forceStat     + nb_bonus_forceStat %}
{% set eff_perception    = fiche.perception    + nb_bonus_perception %}
{% set eff_vide          = fiche.vide          + nb_bonus_vide %}

{# Rang de départ gratuit (base 2, +1 par bonus cumulé) : chaque bonus décale la franchise d'un rang. #}
{% set libre_constitution = 2 + nb_bonus_constitution %}
{% set libre_volonte      = 2 + nb_bonus_volonte %}
{% set libre_reflexes     = 2 + nb_bonus_reflexes %}
{% set libre_intuition    = 2 + nb_bonus_intuition %}
{% set libre_agilite      = 2 + nb_bonus_agilite %}
{% set libre_intelligence = 2 + nb_bonus_intelligence %}
{% set libre_forceStat    = 2 + nb_bonus_forceStat %}
{% set libre_perception   = 2 + nb_bonus_perception %}
{% set libre_vide         = 2 + nb_bonus_vide %}

{% set cout_constitution = eff_constitution > libre_constitution ? (4 * (eff_constitution * (eff_constitution + 1) / 2 - (libre_constitution * (libre_constitution + 1) / 2)))|round : 0 %}
{% set cout_volonte      = eff_volonte      > libre_volonte      ? (4 * (eff_volonte      * (eff_volonte      + 1) / 2 - (libre_volonte      * (libre_volonte      + 1) / 2)))|round : 0 %}
{% set cout_reflexes     = eff_reflexes     > libre_reflexes     ? (4 * (eff_reflexes     * (eff_reflexes     + 1) / 2 - (libre_reflexes     * (libre_reflexes     + 1) / 2)))|round : 0 %}
{% set cout_intuition    = eff_intuition    > libre_intuition    ? (4 * (eff_intuition    * (eff_intuition    + 1) / 2 - (libre_intuition    * (libre_intuition    + 1) / 2)))|round : 0 %}
{% set cout_agilite      = eff_agilite      > libre_agilite      ? (4 * (eff_agilite      * (eff_agilite      + 1) / 2 - (libre_agilite      * (libre_agilite      + 1) / 2)))|round : 0 %}
{% set cout_intelligence = eff_intelligence > libre_intelligence ? (4 * (eff_intelligence * (eff_intelligence + 1) / 2 - (libre_intelligence * (libre_intelligence + 1) / 2)))|round : 0 %}
{% set cout_forceStat    = eff_forceStat    > libre_forceStat    ? (4 * (eff_forceStat    * (eff_forceStat    + 1) / 2 - (libre_forceStat    * (libre_forceStat    + 1) / 2)))|round : 0 %}
{% set cout_perception   = eff_perception   > libre_perception   ? (4 * (eff_perception   * (eff_perception   + 1) / 2 - (libre_perception   * (libre_perception   + 1) / 2)))|round : 0 %}
{% set cout_vide         = eff_vide         > libre_vide         ? (6 * (eff_vide         * (eff_vide         + 1) / 2 - (libre_vide         * (libre_vide         + 1) / 2)))|round : 0 %}

{% set cout_traits_total = cout_constitution + cout_volonte + cout_reflexes + cout_intuition + cout_forceStat + cout_perception + cout_agilite + cout_intelligence + cout_vide %}
{% set cout_competences_total = 0 %}
{% set cout_specialisations_total = 0 %}
{% for i in 1..20 %}
  {% set val = attribute(fiche, 'valeur' ~ i) %}
  {% set comp_i = attribute(fiche, 'competence' ~ i) %}
  {% set n_ecole = attribute(fiche, 'compEcole' ~ i)|default(0) %}
  {% if comp_i is not empty and val %}
    {% set raw_cost = (val * (val + 1) / 2)|round %}
    {% set offset  = (n_ecole * (n_ecole + 1) / 2)|round %}
    {% set net = raw_cost - offset %}
    {% set cout_competences_total = cout_competences_total + (net > 0 ? net : 0) %}
  {% endif %}
  {% if comp_i is not empty %}
    {% set bm     = attribute(fiche, 'specialisations' ~ i)|default('') %}
    {% set bm_ec  = attribute(fiche, 'speEcole' ~ i)|default('') %}
    {% for k in 1..6 %}
      {% set lab_k     = attribute(comp_i, 'specialisation' ~ k) %}
      {% set bit_k     = (bm|length     >= k) ? bm|slice(k - 1, 1)    : '0' %}
      {% set bit_ec_k  = (bm_ec|length  >= k) ? bm_ec|slice(k - 1, 1) : '0' %}
      {% if lab_k and bit_k == '1' and bit_ec_k != '1' %}
        {% set cout_specialisations_total = cout_specialisations_total + cout_par_spe %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endfor %}
{% set cout_competences_total = cout_competences_total + cout_specialisations_total %}

{% set xp_total_effectif = xp_total + gain_desavantages_total %}
{% set cout_total        = cout_traits_total + cout_competences_total + cout_avantages_total %}

<div class="col-12">
  <div id="character-sheet" class="card card-page text-gray-slate">

  <div class="row">

    <div class="col-12 col-lg-8">

      {# mb-3 sur mobile : le mandala qui suivait est masque, la liste donne
         donc directement sur les competences. #}
      <div class="row mb-2 mb-lg-4">
        <div class="col-12 col-lg-6">
          <ul class="list-decored">
            {% set trait_labels = {
              constitution: 'Constitution', volonte: 'Volonté', reflexes: 'Réflèxes',
              intuition: 'Intuition', agilite: 'Agilité', intelligence: 'Intelligence',
              forceStat: 'Force', perception: 'Perception', vide: 'Vide'
            } %}
            <li>
              <span class="label">Clan :</span>
              {% if fiche.personnage.clan %}
                <a class="extrabold" href="{{ path('empire_clan', {id: fiche.personnage.clan.id}) }}">
                  <img  class="img-24" src="{{ asset(fiche.personnage.clan.mon|default(NA_MON)) }}"
                        title="Mon du clan {{ fiche.personnage.clan.nom }}" />
                  {{ fiche.personnage.clan.nom }}
                </a>
              {% else %}
                Aucun
              {% endif %}
            </li>
            <li>
              <span class="label">Famille :</span>
              {% if fiche.personnage.famille %}
                <a class="extrabold" href="{{ path('empire_clan', {id: fiche.personnage.clan.id, '_fragment': fiche.personnage.famille.nom}) }}">
                  <img  class="img-24 rounded-circle" src="{{ asset(fiche.personnage.famille.mon|default(NA_MON)) }}"
                        title="Mon de la famille {{ fiche.personnage.famille.nom }}" />
                  {{ fiche.personnage.famille.nom }}
                </a>
                {% if bonusNomFamille %}
                  <small class="text-success ml-1">+1 {{ trait_labels[bonusNomFamille] ?? bonusNomFamille }}</small>{% endif %}
              {% else %}
                Aucun
              {% endif %}
            </li>
            <li class="fiche-ligne-classe">
              <span class="label">Classe :</span>
              {% if fiche.personnage.classe %}
                <a class="extrabold" href="{{ path('regles_classe', {id: fiche.personnage.classe.id}) }}">
                  <img  class="img-24" src="{{ asset(fiche.personnage.classe.icone|default(NA_MON)) }}"
                        title="Mon de la classe {{ fiche.personnage.classe.nom }}" />
                  {{ fiche.personnage.classe.nom }}
                </a>
              {% else %}
                Aucun
              {% endif %}
            </li>
            <li>
              <span class="label">Ecole :</span>
              {# Mobile : la ligne Classe est masquee, son icone la represente ici
                 et garde son lien vers la page de classe. #}
              {% if fiche.personnage.classe %}
                <a class="d-lg-none" href="{{ path('regles_classe', {id: fiche.personnage.classe.id}) }}"
                   title="Classe {{ fiche.personnage.classe.nom }}">
                  <img class="img-24" src="{{ asset(fiche.personnage.classe.icone|default(NA_MON)) }}" alt="" />
                </a>
              {% endif %}
              {% if fiche.personnage.ecole %}
                <a class="extrabold" href="{{ path('regles_ecole', {id: fiche.personnage.ecole.id}) }}">
                  {{ fiche.personnage.ecole.nom }}
                </a>
                {% if bonusNomEcole %}
                  <small class="text-success ml-1">+1 {{ (trait_labels[bonusNomEcole] ?? bonusNomEcole)|u.truncate(8, '…') }}</small>
                {% endif %}
              {% else %}
                Aucun
              {% endif %}
            </li>
          </ul>
        </div>
        <div class="col-12 col-lg-6">
          <ul class="list-decored">
            <li>
              <span class="label">Rang Général :</span>
              <span class="ml-auto badge-rang-{{rang}}">RANG {{rang}}</span>
            </li>

            {% if est_le_joueur or is_granted('ROLE_MJ') %}

              <li>
                <span class="label">Expérience :</span>
                <strong><span class="xp-total-value">{{ xp_total_effectif }}</span>xp</strong>
                &nbsp;
                <small>
                  (
                  {{ xp_creation }}
                  {% if gain_desavantages_total > 0 %}
                    + <span class="xp-desav-value text-success">{{ gain_desavantages_total }}</span>
                  {% endif %}
                  + {{ xp_progression }}
                  )
                </small>
              </li>
              <li>
                <span class="label">Dépensés :</span>
                <strong><span class="xp-spent-value">{{ cout_total }}</span>xp</strong>
                &nbsp;
                <small>
                  (
                  <span class="xp-traits-value">
                    {% if cout_avantages_total > 0 %}
                      <span class="xp-avant-value text-danger">{{ cout_avantages_total }} +</span>
                    {% endif %}
                    {{ cout_traits_total }}
                  </span>
                  +
                  <span class="xp-comps-value">{{ cout_competences_total }}</span>
                  )
                </small>
              </li>
              <li>
                <span class="label">Restants :</span>
                <strong><span class="xp-remaining text-success">{{ xp_total_effectif - cout_total }}xp</span></strong>
              </li>
            {% endif %}

          </ul>
        </div>
      </div>

      {# Separe les infos du mandala, masque avec lui sous 992px. #}
      <hr class="my-2 d-none d-lg-block">

      {# Masque sur la rangee et non ses enfants : sinon son mt-4 creuse un vide. #}
      <div class="row mt-4 d-none d-lg-flex">
        <div class="col-12 anneaux-board"
             style="--mon-clan: url('{{ asset(fiche.personnage.clan.mon|default(NA_MON)) }}');">

          {% for i in 1..3 %}
            <img class="anneaux-glow" src="{{ asset(fiche.personnage.classe.icone|default(NA_MON)) }}" />
          {% endfor %}

          {# Mandala : les 12 colonnes se repartissent en 2 + 4 + 4 + 2. #}
          <div class="row text-center">
            <div class="col-2"></div>

            <div class="col-4 flex-col align-items-center">
              <div class="flex align-items-start">
                <span class="anneau-rang" data-ring="terre">
                  {{ min(eff_constitution, eff_volonte) }}
                </span>
                <img src="{{FLAT_TERRE}}" class="ml-3 img-72" />
              </div>

              <div class="align-self-start">
                <span
                  class="trait-rang
                    {% if eff_constitution > eff_volonte %} text-strong {% endif %}"
                  data-trait-eff="constitution" data-base="{{ fiche.constitution }}"
                  data-bonus="{{ nb_bonus_constitution }}" data-multiplier="4"
                >
                  <span class="eff-display">{{ eff_constitution }}</span>
                </span>
                &nbsp;
                Constitution
                {% if nb_bonus_constitution > 0 %}
                  <small class="text-success extrabold">+{{ nb_bonus_constitution }}</small>
                {% endif %}
                {% if est_le_joueur or is_granted('ROLE_MJ') %}
                  <span class="text-alternate edit-only" data-cost-for="constitution">
                    {% if cout_constitution > 0 %}-{{ cout_constitution }}xp{% endif %}
                  </span>
                {% endif %}
              </div>
              
              <div class="align-self-start">
                <span
                  class="trait-rang
                    {% if eff_volonte > eff_constitution %} text-strong {% endif %}"
                  data-trait-eff="volonte" data-base="{{ fiche.volonte }}"
                  data-bonus="{{ nb_bonus_volonte }}" data-multiplier="4"
                >
                  <span class="eff-display">{{ eff_volonte }}</span>
                </span>
                &nbsp;
                Volonté
                {% if nb_bonus_volonte > 0 %}
                  <small class="text-success extrabold">+{{ nb_bonus_volonte }}</small>
                {% endif %}
                {% if est_le_joueur or is_granted('ROLE_MJ') %}
                  <span class="text-alternate edit-only" data-cost-for="volonte">
                    {% if cout_volonte > 0 %}-{{ cout_volonte }}xp{% endif %}
                  </span>
                {% endif %}
              </div>
            </div>

            <div class="col-4 flex-col align-items-center">
              <div class="flex align-items-start">
                <img src="{{FLAT_AIR}}" class="img-72 mr-3" />
                <span class="anneau-rang" data-ring="air">
                  {{ min(eff_reflexes, eff_intuition) }}
                </span>
              </div>

              <div class="align-self-end">
                {% if est_le_joueur or is_granted('ROLE_MJ') %}
                  <span class="text-alternate edit-only" data-cost-for="reflexes">
                    {% if cout_reflexes > 0 %}-{{ cout_reflexes }}xp{% endif %}
                  </span>
                {% endif %}
                Réflèxes
                {% if nb_bonus_reflexes > 0 %}
                  <small class="text-success extrabold">+{{ nb_bonus_reflexes }}</small>
                {% endif %}
                &nbsp;
                <span
                  class="trait-rang
                    {% if eff_reflexes > eff_intuition %} text-strong {% endif %}"
                  data-trait-eff="reflexes" data-base="{{ fiche.reflexes }}"
                  data-bonus="{{ nb_bonus_reflexes }}" data-multiplier="4"
                >
                  <span class="eff-display">{{ eff_reflexes }}</span>
                </span>
              </div>

              <div class="align-self-end">
                {% if est_le_joueur or is_granted('ROLE_MJ') %}
                  <span class="text-alternate edit-only" data-cost-for="intuition">
                    {% if cout_intuition > 0 %}-{{ cout_intuition }}xp{% endif %}
                  </span>
                {% endif %}
                Intuition
                {% if nb_bonus_intuition > 0 %}
                  <small class="text-success extrabold">+{{ nb_bonus_intuition }}</small>
                {% endif %}
                &nbsp;
                <span
                  class="trait-rang
                    {% if eff_intuition > eff_reflexes %} text-strong {% endif %}"
                  data-trait-eff="intuition" data-base="{{ fiche.intuition }}"
                  data-bonus="{{ nb_bonus_intuition }}" data-multiplier="4"
                >
                  <span class="eff-display">{{ eff_intuition }}</span>
                </span>
              </div>
            </div>

            <div class="col-2"></div>
          </div>

          <div class="row text-center mt-3">

            <div class="col-1"></div>

            <div class="col-4 flex-col align-items-center">
              <div class="flex align-items-center">
                <span class="anneau-rang" data-ring="eau">
                  {{ min(eff_forceStat, eff_perception) }}
                </span>
                <img src="{{FLAT_EAU}}" class="img-72 ml-3" />
              </div>

              <div class="align-self-start">
                <span
                  class="trait-rang
                    {% if eff_forceStat > eff_perception %} text-strong {% endif %}"
                  data-trait-eff="forceStat" data-base="{{ fiche.forceStat }}"
                  data-bonus="{{ nb_bonus_forceStat }}" data-multiplier="4"
                >
                  <span class="eff-display">{{ eff_forceStat }}</span>
                </span>
                &nbsp;
                Force
                {% if nb_bonus_forceStat > 0 %}
                  <small class="text-success extrabold">+{{ nb_bonus_forceStat }}</small>
                {% endif %}
                {% if est_le_joueur or is_granted('ROLE_MJ') %}
                  <span class="text-alternate edit-only" data-cost-for="forceStat">
                    {% if cout_forceStat > 0 %}-{{ cout_forceStat }}xp{% endif %}
                  </span>
                {% endif %}
              </div>

              <div class="align-self-start">
                <span
                  class="trait-rang
                    {% if eff_perception > eff_forceStat %} text-strong {% endif %}"
                  data-trait-eff="perception" data-base="{{ fiche.perception }}"
                  data-bonus="{{ nb_bonus_perception }}" data-multiplier="4"
                >
                  <span class="eff-display">{{ eff_perception }}</span>
                </span>
                &nbsp;
                Perception
                {% if nb_bonus_perception > 0 %}
                  <small class="text-success extrabold">+{{ nb_bonus_perception }}</small>
                {% endif %}
                {% if est_le_joueur or is_granted('ROLE_MJ') %}
                  <span class="text-alternate edit-only" data-cost-for="perception">
                    {% if cout_perception > 0 %}-{{ cout_perception }}xp{% endif %}
                  </span>
                {% endif %}
              </div>
            </div>

            <div class="col-2 m-0 p-0">
              {% if est_le_joueur or is_granted('ROLE_MJ') %}
                <div class="flex-col p-1 bg-strong text-fade text-small rounded-8 edit-only">
                  <div class="label-amerigo">Exp.</div>
                  <div class="flex w-100 justify-content-between {% if gain_desavantages_total == 0 %}d-none{% endif %}" id="xp-desav-row">
                    Désavantages
                    <span id="xp-desav-total" class="text-success">+{{ gain_desavantages_total }}xp</span>
                  </div>
                  <div class="flex w-100 justify-content-between {% if cout_avantages_total == 0 %}d-none{% endif %}" id="xp-avant-row">
                    Avantages
                    <span id="xp-avant-total" class="text-danger">-{{ cout_avantages_total }}xp</span>
                  </div>
                  <div class="flex w-100 justify-content-between">
                    Traits
                    <span id="xp-traits-total">-{{ cout_traits_total }}xp</span>
                  </div>
                  <div class="flex w-100 justify-content-between">
                    Compétences
                    <span id="xp-comps-total">-{{ cout_competences_total }}xp</span>
                  </div>
                  <div class="flex w-100 justify-content-between extrabold">
                    Restants
                    <span class="xp-remaining text-success">{{ xp_total_effectif - cout_total }}xp</span>
                  </div>
                </div>
              {% endif %}
            </div>

            <div class="col-4 flex-col align-items-center">
              <div class="flex align-items-center">
                <img src="{{FLAT_FEU}}" class="img-72 mr-2" />
                <span class="anneau-rang" data-ring="feu">
                  {{ min(eff_agilite, eff_intelligence) }}
                </span>
              </div>

              <div class="align-self-end">
                {% if est_le_joueur or is_granted('ROLE_MJ') %}
                  <span class="text-alternate edit-only" data-cost-for="agilite">
                    {% if cout_agilite > 0 %}-{{ cout_agilite }}xp{% endif %}
                  </span>
                {% endif %}
                Agilité
                {% if nb_bonus_agilite > 0 %}
                  <small class="text-success extrabold">+{{ nb_bonus_agilite }}</small>
                {% endif %}
                &nbsp;
                <span
                  class="trait-rang
                    {% if eff_agilite > eff_intelligence %} text-strong {% endif %}"
                  data-trait-eff="agilite" data-base="{{ fiche.agilite }}"
                  data-bonus="{{ nb_bonus_agilite }}" data-multiplier="4"
                >
                  <span class="eff-display">{{ eff_agilite }}</span>
                </span>
              </div>

              <div class="align-self-end">
                {% if est_le_joueur or is_granted('ROLE_MJ') %}
                  <span class="text-alternate edit-only" data-cost-for="intelligence">
                    {% if cout_intelligence > 0 %}-{{ cout_intelligence }}xp{% endif %}
                  </span>
                {% endif %}
                Intelligence
                {% if nb_bonus_intelligence > 0 %}
                  <small class="text-success extrabold">+{{ nb_bonus_intelligence }}</small>
                {% endif %}
                &nbsp;
                <span
                  class="trait-rang
                    {% if eff_intelligence > eff_agilite %} text-strong {% endif %}"
                  data-trait-eff="intelligence" data-base="{{ fiche.intelligence }}"
                  data-bonus="{{ nb_bonus_intelligence }}" data-multiplier="4"
                >
                  <span class="eff-display">{{ eff_intelligence }}</span>
                </span>
              </div>
            </div>

            <div class="col-1"></div>
          </div>

          <div class="row text-center">

            <div class="col-4"></div>

            <div class="col-4 flex-col align-items-center">
              <div class="flex align-items-center">
                <img class="img-72 ml-5 mr-3" src="{{FLAT_VIDE}}"/>
                <span class="anneau-rang"
                  data-trait-eff="vide" data-base="{{ fiche.vide }}"
                  data-bonus="{{ nb_bonus_vide }}" data-multiplier="6"
                >
                  <span class="eff-display">{{ eff_vide }}</span>
                </span>
              </div>
              <div class="flex align-items-center">
                {% if est_le_joueur or is_granted('ROLE_MJ') %}
                  <span class="text-alternate edit-only" data-cost-for="vide">
                    {% if cout_vide > 0 %}-{{ cout_vide }}xp{% endif %}
                  </span>
                  &nbsp;
                {% endif %}
                <span class="h6 m-0 mb-0 mt-2 ml-2 mr-2">Vide</span>
                &nbsp;
                {% if nb_bonus_vide > 0 %}
                  <small class="text-success extrabold">+{{ nb_bonus_vide }}</small>
                {% endif %}
              </div>
            </div>

            <div class="col-4"></div>
          </div>

        </div>

        {% if est_le_joueur or is_granted('ROLE_MJ') %}
          <div class="my-4 d-flex w-100 justify-content-center align-items-center">
            <button type="button" id="btn-fiche-edit" class="btn-primary-style btn-large">
              <i class="fas fa-edit"></i> {{ est_le_joueur ? 'Éditer ma fiche' : 'Éditer la fiche' }}
            </button>
            <button type="button" id="btn-fiche-cancel" class="btn btn-secondary btn-sm ml-3" style="display:none;">
              <i class="fas fa-times"></i> Annuler
            </button>
            <button type="button" id="btn-fiche-valider" class="btn btn-success btn-sm ml-3" style="display:none;">
              <i class="fas fa-check"></i> Valider
            </button>
          </div>
        {% endif %}

      </div>

    </div>

    {% set anneaux_mobile = [
      { nom: 'Terre', icone: FLAT_TERRE, rang: min(eff_constitution, eff_volonte), traits: [
        { nom: 'Constitution', val: eff_constitution, bonus: nb_bonus_constitution },
        { nom: 'Volonté',      val: eff_volonte,      bonus: nb_bonus_volonte }
      ] },
      { nom: 'Air', icone: FLAT_AIR, rang: min(eff_reflexes, eff_intuition), traits: [
        { nom: 'Réflèxes',  val: eff_reflexes,  bonus: nb_bonus_reflexes },
        { nom: 'Intuition', val: eff_intuition, bonus: nb_bonus_intuition }
      ] },
      { nom: 'Eau', icone: FLAT_EAU, rang: min(eff_forceStat, eff_perception), traits: [
        { nom: 'Force',      val: eff_forceStat,  bonus: nb_bonus_forceStat },
        { nom: 'Perception', val: eff_perception, bonus: nb_bonus_perception }
      ] },
      { nom: 'Feu', icone: FLAT_FEU, rang: min(eff_agilite, eff_intelligence), traits: [
        { nom: 'Agilité',      val: eff_agilite,      bonus: nb_bonus_agilite },
        { nom: 'Intelligence', val: eff_intelligence, bonus: nb_bonus_intelligence }
      ] },
      { nom: 'Vide', icone: FLAT_VIDE, rang: eff_vide, traits: [] }
    ] %}
    <div class="illu-col col-12 col-lg-4 order-first order-lg-last">
      <div class="fiche-illu-wrap">
        <img class="fiche-illu img-fluid rounded-8 d-block mx-auto" src="{{ asset(fiche.personnage.illustration|default(NA_PERSO_ILLU)) }}" />

        <div class="fiche-traits d-lg-none">
          {% for anneau in anneaux_mobile %}
            {# Le Vide n'a pas de trait : c'est ce qui lui vaut la pleine largeur. #}
            <div class="fiche-anneau-groupe{% if anneau.traits is empty %} fiche-anneau-solo{% endif %}">
              <div class="fiche-anneau-line">
                <img class="fiche-anneau-ico" src="{{ anneau.icone }}" alt="" />
                <span class="text-plus extrabold">{{ anneau.nom }}</span>
                <strong class="fiche-anneau-rang text-plus">{{ anneau.rang }}</strong>
              </div>
              {% for trait in anneau.traits %}
                <div class="fiche-trait-line">
                  <span>{{ trait.nom }}</span>
                  {% if trait.bonus > 0 %}<small class="text-success">+{{ trait.bonus }}</small>{% endif %}
                  <strong class="fiche-trait-value">{{ trait.val }}</strong>
                </div>
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <div class="row bloc-row">

    <section class="col-12 col-lg-8">

      {% if est_le_joueur or is_granted('ROLE_MJ') %}
        <div class="card card-bloc">

          <div class="card-title-cartouche d-flex align-items-center">
            Avantages & Désavantages
            <small class="ml-auto text-lowercase text-danger">
              <i class="fas fa-eye mr-1"></i>
              visible uniquement par le joueur ou le MJ
            </small>
          </div>

          <div class="row p-3">

            <div class="col-12 col-lg-6">
              <h6>Avantages</h6>
              <ul class="list-decored flex-col gap-4 ml-2">
                {% for slot in ['av1', 'av2'] %}
                  {% set item = (slot == 'av1') ? fiche.avantage1 : fiche.avantage2 %}
                  <li data-av-slot="{{ slot }}" data-av-kind="avantage"
                      data-av-id="{{ item ? item.id : 0 }}"
                      {% if not item %}class="av-row-empty"{% endif %}
                  >
                    <div>
                      <span data-av-name class="text-strong extrabold">
                        {{ item ? item.nom : '' }}
                      </span>
                      <i class="fas fa-info-circle text-disabled ml-1{% if not item %} d-none{% endif %}"
                        data-toggle="tooltip" data-placement="right" data-av-tooltip
                        title="{{ item ? item.description : '' }}">
                      </i>
                    </div>
                    <span class="edit-only text-danger text-small ml-2" data-av-cost>
                      {% if item %}-{{ effective_costs[slot] }}xp
                        {% if effective_costs[slot] != item.cout %}
                          (promo)
                        {% endif %}
                      {% endif %}
                    </span>
                  </li>
                {% endfor %}
              </ul>
            </div>

            <div class="col-12 col-lg-6">
              <h6>Désavantages</h6>
              <ul class="list-decored flex-col gap-4 ml-2">
                {% for slot in ['dv1', 'dv2'] %}
                  {% set item = (slot == 'dv1') ? fiche.desavantage1 : fiche.desavantage2 %}
                  <li data-av-slot="{{ slot }}" data-av-kind="desavantage"
                      data-av-id="{{ item ? item.id : 0 }}"
                      {% if not item %} class="av-row-empty"{% endif %}
                  >
                    <div>
                      <span data-av-name class="text-strong extrabold">
                        {{ item ? item.nom : '' }}
                      </span>
                      <i class="fas fa-info-circle text-gray-dust ml-1{% if not item %} d-none{% endif %}"
                        data-toggle="tooltip" data-placement="right" data-av-tooltip
                        title="{{ item ? item.description : '' }}">
                      </i>
                    </div>
                    <span class="edit-only text-success text-small" data-av-cost>
                      {% if item %}+{{ effective_costs[slot] }}xp
                        {% if effective_costs[slot] != item.cout %}
                          (promo)
                        {% endif %}
                      {% endif %}
                    </span>
                  </li>
                {% endfor %}
              </ul>
            </div>

          </div>
        </div>
      {% endif %}

      <div class="card card-body card-bloc">
        <table class="table m-0 p-0" id="comp-table">
          <thead>
            <tr class="card-title-cartouche p-0 py-2">
              <th class="text-mini font-regular font-barlow text-center text-lowercase px-1" style='width: 24px;' scope="col">
                Comp. École
              </th>
              <th class="px-0 py-2 font-regular" scope="col">Compétences</th>
              <th class="px-0 py-2 text-small semi-visible" scope="col">Rang</th>
              <th class="px-0 py-2 text-small semi-visible d-none d-lg-table-cell" scope="col">Trait</th>
              <th class="px-0 py-2 text-small semi-visible edit-only" scope="col">Coût XP</th>
            </tr>
          </thead>
          <tbody>
            {% set filled_by_cat = {} %}
            {% set empty_slots = [] %}
            {% for i in 1..20 %}
              {% set comp = attribute(fiche, 'competence' ~ i) %}
              {% set val  = attribute(fiche, 'valeur' ~ i) %}
              {% set specs = attribute(fiche, 'specialisations' ~ i) %}
              {% set compEcole = attribute(fiche, 'compEcole' ~ i)|default(0) %}
              {% set speEcole  = attribute(fiche, 'speEcole'  ~ i)|default('') %}
              {% if comp is not empty %}
                {% set cat = comp.categorie|default('Autres') %}
                {% set filled_by_cat = filled_by_cat|merge({ (cat): (filled_by_cat[cat] ?? [])|merge([{i: i, comp: comp, val: val, specs: specs, compEcole: compEcole, speEcole: speEcole}]) }) %}
              {% else %}
                {% set empty_slots = empty_slots|merge([{i: i, comp: comp, val: val, specs: specs, compEcole: compEcole, speEcole: speEcole}]) %}
              {% endif %}
            {% endfor %}

            {# Ordre des catégories : Bugei → Noble → Marchand → Dégradante (toute autre catégorie en queue, alpha) #}
            {% set CAT_ORDER = ['Bugei', 'Noble', 'Marchand', 'Dégradante'] %}
            {% set ordered_cats = CAT_ORDER|filter(c => filled_by_cat[c] is defined) %}
            {% set extra_cats = filled_by_cat|keys|filter(c => c not in CAT_ORDER)|sort %}

            {% for cat in ordered_cats|merge(extra_cats) %}
              {# |u.ascii replie les accents : sans lui la comparaison est octet par octet
                 et « Etiquette » passe derriere « Sincerite ». #}
              {% set slots = filled_by_cat[cat]|sort((a, b) =>
                  a.comp.nom|u.ascii|lower <=> b.comp.nom|u.ascii|lower
              ) %}
              <tr class="comp-cat-header bg-gray-edge border-0">
                <th colspan="5" scope="colgroup">{{ cat }}{% if cat == 'Bugei' %} (combat){% endif %}</th>
              </tr>
              {% for slot in slots %}
                {% set bitmask = slot.specs|default('') %}
                {% set bm_ec   = slot.speEcole|default('') %}
                {% set bought_specs = [] %}
                {% for k in 1..6 %}
                  {% set lab = attribute(slot.comp, 'specialisation' ~ k) %}
                  {% set bit = (bitmask|length >= k) ? bitmask|slice(k - 1, 1) : '0' %}
                  {% set bit_ec = (bm_ec|length >= k) ? bm_ec|slice(k - 1, 1) : '0' %}
                  {% if lab and bit == '1' %}
                    {% set bought_specs = bought_specs|merge([{label: lab, ecole: bit_ec == '1'}]) %}
                  {% endif %}
                {% endfor %}
                {% set raw_cost = slot.val ? (slot.val * (slot.val + 1) / 2)|round : 0 %}
                {% set offset   = (slot.compEcole * (slot.compEcole + 1) / 2)|round %}
                {% set net_cost = raw_cost - offset > 0 ? raw_cost - offset : 0 %}
                {% set paid_specs_count = 0 %}
                {% for s in bought_specs %}{% if not s.ecole %}{% set paid_specs_count = paid_specs_count + 1 %}{% endif %}{% endfor %}
                <tr
                  class="p-0" data-comp-row="{{ slot.i }}" data-comp-id="{{ slot.comp.id }}"
                  data-comp-val="{{ slot.val ?? 0 }}" data-comp-specs="{{ bitmask }}"
                  data-comp-ecole="{{ slot.compEcole ?? 0 }}" data-comp-spe-ecole="{{ bm_ec }}"
                >
                  <td class="p-1 text-center" data-comp-ecole-cell>
                    {% if slot.compEcole > 0 %}
                      <img src="{{ asset(fiche.personnage.ecole.clan.mon) }}" class="img-24" title="Compétence de l'École {{ fiche.personnage.ecole.nom }}" />
                    {% else %}
                      <span class="d-inline-flex icon-20 rounded-circle border-base">&nbsp;</span>
                    {% endif %}
                  </td>
                  <th class="p-1 text-strong extrabold" scope="row" data-comp-name>
                    <strong>{{ slot.comp.nom }}</strong>
                  </th>
                  <td class="p-1 text-strong extrabold" data-comp-val-cell>{{ slot.val ?? '' }}</td>
                  <td class="p-1 text-body-c d-none d-lg-table-cell" data-comp-trait-cell>{{ slot.comp.trait }}</td>
                  <td class="edit-only p-1 text-alternate" data-comp-cost-cell>{% if slot.val %}-{{ net_cost }}xp{% endif %}</td>
                </tr>
                <tr data-comp-specs-row="{{ slot.i }}" class="p-0 comp-specs-row{% if bought_specs|length > 0 %} has-specs{% endif %}">
                  <td class="p-1"></td>
                  <td class="p-1" colspan="3" data-comp-specs-cell>
                    {% if bought_specs|length > 0 %}
                      <small class="text-body-c">
                        <span class="text-alternate">Spécialisations :</span>
                        {% for s in bought_specs %}
                          {{ s.label }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                      </small>
                    {% endif %}
                  </td>
                  <td class="edit-only p-1 text-alternate" data-comp-specs-cost-cell>
                    {% if paid_specs_count > 0 %}
                      <small>-{{ paid_specs_count * cout_par_spe }}xp (spé)</small>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            {% endfor %}

            {% for slot in empty_slots %}
              <tr data-comp-row="{{ slot.i }}" data-comp-id="0" data-comp-val="0" data-comp-specs="" data-comp-ecole="0" data-comp-spe-ecole="" class="comp-row-empty">
                <td class="p-1 text-center" data-comp-ecole-cell></td>
                <th class="p-1 text-strong extrabold" scope="row" data-comp-name></th>
                <td class="p-1 text-strong extrabold" data-comp-val-cell></td>
                <td class="p-1 text-body-c d-none d-lg-table-cell" data-comp-trait-cell></td>
                <td class="edit-only p-1 text-alternate" data-comp-cost-cell></td>
              </tr>
              <tr data-comp-specs-row="{{ slot.i }}" class="comp-specs-row comp-row-empty">
                <td class="p-1"></td>
                <td class="p-1 text-body-c" colspan="3" data-comp-specs-cell></td>
                <td class="edit-only p-1 text-alternate" data-comp-specs-cost-cell></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% set ecole = fiche.personnage.ecole %}
      {% set est_shugenja = fiche.personnage.classe and fiche.personnage.classe.nom == 'Shugenja' %}
      {% if est_shugenja or fiche.knownSpells|length > 0 %}

        {% set spells_by_ring = {} %}
        {% for spell in fiche.knownSpells %}
          {% set spells_by_ring = spells_by_ring|merge({ (spell.anneau): (spells_by_ring[spell.anneau] ?? [])|merge([spell]) }) %}
        {% endfor %}

        {% set rings = {TERRE: FLAT_TERRE, AIR: FLAT_AIR, FEU: FLAT_FEU, EAU: FLAT_EAU} %}
        {% set est_ishiken = (fiche.avantage1 and fiche.avantage1.nom == 'Ishiken-Do')
                          or (fiche.avantage2 and fiche.avantage2.nom == 'Ishiken-Do') %}
        {% if est_ishiken %}
          {% set rings = rings|merge({VIDE: FLAT_VIDE}) %}
        {% endif %}

        <div class="card card-bloc">

          <div class="card-title-cartouche">Magie</div>

          <div class="row no-gutters magie-entete">

            <div class="col-6 col-lg-3">
              <h6>Affinité</h6>
              <strong class="text-{{ ecole.affinite|upper }} text-uppercase">{{ ecole.affinite|default('—') }}</strong>
            </div>

            <div class="col-6 col-lg-3">
              <h6>Déficience</h6>
              <strong class="text-{{ ecole.deficience|upper }} text-uppercase">{{ ecole.deficience|default('—') }}</strong>
            </div>

            <div class="col-6 col-lg-3">
              <h6>Technique de l'École</h6>
              {% if ecole and ecole.techSpecialNom is not empty %}
                <a  class="spell-link extrabold" role="button" tabindex="0"
                    data-toggle="popover" data-html="true" data-trigger="focus"
                    data-container="body" data-placement="top"
                    title="{{ ecole.techSpecialNom }}"
                    data-content="{{ ecole.techSpecialDesc|raw|nl2br|e('html_attr') }}">
                  {{ ecole.techSpecialNom }}
                </a>
              {% else %}
                —
              {% endif %}
            </div>

            <div class="col-6 col-lg-3">
              <h6>Sorts universels</h6>
              <ul class="spell-list" data-spell-list="UNIVERSEL">
                {% for spell in spells_by_ring['UNIVERSEL']|default([]) %}
                  {{ include('/parts/spell-line.html.twig', {spell: spell}) }}
                {% endfor %}
              </ul>
              <div class="spell-add edit-only" data-spell-add="UNIVERSEL"></div>
            </div>

          </div>

          <div class="row no-gutters magie-anneaux">
            {% for ring, icone in rings %}
              <div class="col-6 col-lg knownspells-column">
                <h6 class="element-header text-{{ ring }}-lighten bg-{{ ring }}-darken extrabold">
                  <img class="img-24 invert" src="{{ asset(icone) }}" />{{ ring|lower|capitalize }}
                </h6>
                <ul class="spell-list" data-spell-list="{{ ring }}">
                  {% for spell in spells_by_ring[ring]|default([]) %}
                    {{ include('/parts/spell-line.html.twig', {spell: spell}) }}
                  {% endfor %}
                </ul>
                <div class="spell-add edit-only" data-spell-add="{{ ring }}"></div>
              </div>
            {% endfor %}
          </div>

        </div>

      {% endif %}

    </section>

    <section class="col-12 col-lg-4">

      <div class="card card-bloc">

        <div class="card-title-cartouche">
          Statistiques de Combat
        </div>

        <div>
          <ul class="list-group list-group-flush">

            <li class="list-group-item px-3 py-2 edit-only" id="modifiers-edit-block">
              <div class="text-small text-muted mb-2"><strong>Modificateurs</strong></div>
              <div class="row no-gutters" style="gap: .25rem .5rem;">
                <div class="col-12 col-sm-6">
                  <label for="mod-input-initiative" class="m-0 text-mini d-block">Init (nombre)</label>
                  <input type="number" id="mod-input-initiative" class="form-control form-control-sm" value="{{ fiche.initiativeModifier ?? '' }}" />
                </div>
                <div class="col-12 col-sm-6">
                  <label for="mod-input-attaque" class="m-0 text-mini d-block">Attaque (XgY)</label>
                  <input type="text" id="mod-input-attaque" class="form-control form-control-sm" value="{{ fiche.attaqueModifier ?? '' }}" placeholder="ex: 1g0" pattern="\d+g\d+" />
                </div>
                <div class="col-12 col-sm-6">
                  <label for="mod-input-dmg" class="m-0 text-mini d-block">Dommages (XgY)</label>
                  <input type="text" id="mod-input-dmg" class="form-control form-control-sm" value="{{ fiche.dmgModifier ?? '' }}" placeholder="ex: 1g0" pattern="\d+g\d+" />
                </div>
                <div class="col-12 col-sm-6">
                  <label for="mod-input-nd" class="m-0 text-mini d-block">ND (nombre)</label>
                  <input type="number" id="mod-input-nd" class="form-control form-control-sm" value="{{ fiche.ndModifier ?? '' }}" />
                </div>
                <div class="col-12 col-sm-6">
                  <label for="mod-input-reduction" class="m-0 text-mini d-block">Réduction (nombre)</label>
                  <input type="number" id="mod-input-reduction" class="form-control form-control-sm" value="{{ fiche.reductionModifier ?? '' }}" />
                </div>
              </div>
            </li>

            {% set JetInitL = eff_reflexes + rang %}
            {% set JetInitG = eff_reflexes %}
            <li class="list-group-item p-0 px-3 py-1 flex gap-2">
              <div class="flex-grow-1 flex-col">
                Initiative
                <span class="ml-2">
                  <strong class="text-strong" data-stat="initiative">{{JetInitL}}g{{JetInitG}}{% if initMod != 0 %} {{ initMod > 0 ? '+' : '' }}{{ initMod }}{% endif %}</strong>
                  &nbsp;
                  <i
                    class="fa-solid fa-dice text-accent"
                    data-tooltip-stat="initiative"
                    data-toggle="tooltip" data-placement="right" data-html="true"
                    title="
                      <div class='text-mini text-left'>
                        /lancer
                        <br/>Réflèxes + RangGen.
                        <br/>/garder
                        Réflèxes
                        <br/>
                        <br/>/lancer {{eff_reflexes}} + {{rang}}
                        <br/>/garder {{eff_reflexes}}
                        {% if initMod != 0 %}
                          <br/>Modificateur : {{ initMod > 0 ? '+' : '' }}{{ initMod }}
                        {% endif %}
                      </div>"
                  >
                  </i>
                </span>
              </div>
              <div class="text-right text-small">
                <strong data-stat="initiative-avg">{{ (((rang + eff_reflexes) ~ 'g' ~ eff_reflexes)|jeter) + initMod }}</strong>
                {% if fiche.arme and fiche.arme.type == 'LOURDE' %}
                  <br/>-5 (arme lourde)
                {% endif %}
              </div>
            </li>

            {# Détermine la valeur de la compétence active de combat (compCombatActuelle) en cherchant dans les slots #}
            {% set comp_combat_val = 0 %}
            {% if fiche.compCombatActuelle %}
              {% for i in 1..20 %}
                {% set ci = attribute(fiche, 'competence' ~ i) %}
                {% if ci and ci.id == fiche.compCombatActuelle.id %}
                  {% set comp_combat_val = attribute(fiche, 'valeur' ~ i) ?? 0 %}
                {% endif %}
              {% endfor %}
            {% endif %}

            <li class="list-group-item p-0 px-3 py-1 flex gap-2 edit-only"
                data-comp-combat-row
                data-comp-combat-id="{{ fiche.compCombatActuelle ? fiche.compCombatActuelle.id : 0 }}">
              <div class="flex-grow-1">
                Compétence de combat
                <i  class="fas fa-info-circle text-disabled ml-1"
                  data-toggle="tooltip" data-placement="right"
                  title="Compétence Bugei utilisée pour le calcul du Jet d'Attaque"></i>
                <span data-comp-combat-select-cell class="ml-2"></span>
              </div>
            </li>

            {% set JetAtkL = eff_agilite + atkModL + (comp_combat_val / 2)|round(0, 'ceil') %}
            {% set JetAtkG = eff_agilite + atkModG %}
            <li class="list-group-item p-0 px-3 py-1 flex gap-2">
              <div class="flex-grow-1 stat-attaque-with-comp{% if not fiche.compCombatActuelle %} d-none{% endif %}">
                Attaque <span class="text-small text-gray-ash">(<span data-stat="comp-combat-nom">{{ fiche.compCombatActuelle ? fiche.compCombatActuelle.nom : '' }}</span>)</span>
                <br/>
                <span>
                  <strong class="text-strong ml-2" data-stat="attaque">{{JetAtkL}}g{{JetAtkG}}</strong>
                  &nbsp;
                  <i
                    class="fa-solid fa-dice text-accent"
                    data-tooltip-stat="attaque"
                    data-toggle="tooltip" data-placement="right" data-html="true"
                    title="
                      <div class='text-mini text-left'>
                        /lancer
                        <br/>Agilité + CompCombat/2 arrSup.
                        <br/>/garder
                        Agilité
                        <br/>
                        <br/>/lancer {{eff_agilite}} + {{comp_combat_val / 2}}
                        <br/>/garder {{eff_agilite}}
                        {% if fiche.attaqueModifier %}
                          Modificateur : {{ fiche.attaqueModifier }}
                        {% endif %}
                      </div>
                    "></i>
                </span>
              </div>
              <div class="text-right text-small stat-attaque-with-comp{% if not fiche.compCombatActuelle %} d-none{% endif %}">
                <strong data-stat="attaque-avg">{{(JetAtkL ~ 'g' ~ JetAtkG)|jeter}}</strong>
                <br/><span class="edit-only">en Assaut : <span data-stat="attaque-assaut-avg">{{((JetAtkL + 2) ~ 'g' ~ (JetAtkG + 1))|jeter}}</span></span>
              </div>
              <div class="stat-attaque-no-comp{% if fiche.compCombatActuelle %} d-none{% endif %}">
                Jet Attaque
                <br/>
                <small class="text-alternate">Choisissez une compétence de combat principal</small>
              </div>
            </li>

            <li class="list-group-item p-0 px-3 py-1 flex gap-2 edit-only"
                data-arme-actuelle-row
                data-arme-actuelle-id="{{ fiche.armeActuelle ? fiche.armeActuelle.id : 0 }}"
                data-arme-id="{{ fiche.arme ? fiche.arme.id : 0 }}"
                data-arme2-id="{{ fiche.arme2 ? fiche.arme2.id : 0 }}">
              <div class="flex-grow-1">
                Arme actuelle
