{% extends 'other.html.twig' %}

{% set titre = 'Votre espace de compte' %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{asset('css/pages/account.css')}}" />
{% endblock %}

{% block cartes %}

  <div class="col-12 col-lg-6">
    <div class="card card-page compact">
      <h2 class="heading-cardtitle">Informations Personnelles</h2>
      <hr>

      <dl class="account-infos">
        <dt>Utilisateur</dt>
        <dd><strong>{{ app.user.pseudo }}</strong></dd>

        <dt>Votre E-mail</dt>
        <dd><strong>{{ app.user.email }}</strong></dd>

        <dt>Votre Mot de passe</dt>
        <dd>
          <strong>******</strong>
          <a href="{{ path('account_password') }}"><i class="fas fa-edit" aria-hidden="true"></i> Modifier</a>
        </dd>

        <dt>Votre statut de compte</dt>
        <dd><strong>{{ app.user.isVerified ? 'Vérifié' : 'Non-vérifié' }}</strong></dd>

        <dt>Vos rôles</dt>
        <dd>
          {% for un_role in app.user.roles %}
            <strong>{{ un_role }}</strong>{{ not loop.last ? ',' : '' }}
          {% else %}
            Il n'y a pas de rôle
          {% endfor %}
        </dd>

        <dt>Votre avatar</dt>
        <dd>
          {{ include('parts/avatar.html.twig', {user: app.user, size: 128}) }}
          <a href="{{ path('account_avatar') }}"><i class="fas fa-edit" aria-hidden="true"></i> Modifier</a>
        </dd>
      </dl>
    </div>
  </div>

  <div class="col-12 col-lg-6">
    <div class="card card-page compact">
      <h2 class="heading-cardtitle">Mon Personnage Principal</h2>
      <hr>

      {% if is_mj() %}
        <p class="text-muted font-italic">En mode MJ, vous naviguez sans personnage principal.{% if main_character %} Passez en mode Joueur pour naviguer avec lui.{% endif %}</p>
      {% endif %}

      {% if app.user.gameMaster %}
        <form class="account-row account-mode" method="post" action="{{ path('account_navigation_mode') }}">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('navigation-mode') }}" />
          <span>Mode de navigation</span>
          <div class="account-mode-switch">
            <button type="submit" name="mode" value="{{ constant('App\\Entity\\Utilisateur::MODE_GAME_MASTER') }}" class="mj{{ is_mj() ? ' active' }}" aria-pressed="{{ is_mj() ? 'true' : 'false' }}"{% if is_mj() %} disabled{% endif %} title="Tous les droits du MJ, sans personnage principal">
              <i class="fas fa-scroll" aria-hidden="true"></i> MJ
            </button>
            <button type="submit" name="mode" value="{{ constant('App\\Entity\\Utilisateur::MODE_PLAYER') }}" class="joueur{{ not is_mj() ? ' active' }}" aria-pressed="{{ is_mj() ? 'false' : 'true' }}"{% if not is_mj() %} disabled{% endif %} title="Votre personnage principal, sans les droits du MJ">
              <i class="fas fa-user" aria-hidden="true"></i> Joueur
            </button>
          </div>
        </form>
      {% endif %}

      {% if main_character %}
        <div class="account-main">
          <a href="{{ path('personnage_profil', {id: main_character.id}) }}" class="hover-zoom">
            <img src="{{ asset(main_character.icone|default(NA_PERSO_PORTRAIT)) }}" alt="Portrait de {{ main_character.prenom }}" />
          </a>
          <div>
            {% if main_character.clan %}
              <img class="img-24" src="{{ asset(image_small(main_character.clan.mon|default(NA_MON))) }}" alt="Mon du Clan {{ main_character.clan.nom }}" />
            {% endif %}
            <strong>{{ main_character.nomComplet }}</strong>
            {% if main_character.fichePersonnage is not empty %}
              <a href="{{ path('personnage_fiche', {id: main_character.fichePersonnage.id}) }}">
                <i class="fas fa-user-secret" aria-hidden="true"></i> Fiche privée
              </a>
            {% endif %}
          </div>
        </div>
      {% else %}
        <p class="text-muted font-italic">Vous n'avez pas encore de personnage.</p>
      {% endif %}

      {% if app.user.personnages|length %}
        <form class="account-row account-choice" method="post" action="{{ path('account_main_character') }}">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('main-character') }}" />
          <label for="main-character">Choisir mon personnage principal</label>
          <select id="main-character" name="character">
            <option value="">Automatique — le plus récent</option>
            {% for un_personnage in app.user.personnages %}
              <option value="{{ un_personnage.id }}"{% if app.user.mainCharacter and un_personnage.id == app.user.mainCharacter.id %} selected{% endif %}>
                {{ un_personnage.nomComplet }}
              </option>
            {% endfor %}
          </select>

          <button type="submit" class="btn-primary-style btn-medium">Valider</button>
        </form>
      {% endif %}

      <h2 class="heading-cardtitle">Mes Autres Personnages</h2>
      <hr>

      <div class="account-characters">
        {% for un_personnage in app.user.personnages|filter(p => main_character is empty or p.id != main_character.id) %}
          <article>
            <a href="{{ path('personnage_profil', {id: un_personnage.id}) }}" class="hover-zoom">
              <img src="{{ asset(un_personnage.icone|default(NA_PERSO_PORTRAIT)) }}" alt="Portrait de {{ un_personnage.prenom }}" />
            </a>
            <strong>{{ un_personnage.nomComplet }}</strong>
            {% if un_personnage.fichePersonnage is not empty %}
              <a href="{{ path('personnage_fiche', {id: un_personnage.fichePersonnage.id}) }}">
                <i class="fas fa-user-secret" aria-hidden="true"></i> Fiche privée
              </a>
            {% else %}
              <small class="text-muted">Pas encore de fiche privée</small>
            {% endif %}
          </article>
        {% else %}
          <p class="text-muted font-italic">Il n'y a pas d'autre personnage sur ce compte.</p>
        {% endfor %}
      </div>
    </div>
  </div>

{% endblock %}
