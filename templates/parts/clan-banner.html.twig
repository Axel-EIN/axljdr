{# Bandeau d'intro de la page Clan : icône/vidéo + citation + champion +
   description + nav des autres clans. Composant dédié — cf.
   parts/classe-banner.html.twig pour son pendant, sans vidéo/champion/majeur.
   Variable : clan, toutClans (tous les clans, pour la nav). #}

<section id="element-banner" class="col-12 mb-0 mb-lg-3 px-lg-1">

    <div class="row" style="background-image: linear-gradient( #00000000 ,  #00000040 , #000000EE ), linear-gradient( {{clan.couleur}}60 , {{clan.couleur}}FF ),
                            url('{{ asset( clan.image|default(NA_CLAN) ) }}');">

        <div class="row m-0 p-0">
            <!-- IF VIDEO IS AVAILABLE -->
            {% if clan.video is defined and clan.video is not empty %}

                <!-- ICON MUTE VIDEO -->
                <i id="icon-mute-video" class="fa-solid fa-video-slash invisible" onclick="unfocusVideo()"></i>

                <!-- OVERLAY -->
                <overlay id="overlay-video"
                style=" background-image:   linear-gradient( #00000050 , #000000DD ),
                                            linear-gradient(to bottom, {{clan.couleur}}40, {{clan.couleur}}BB );
                        background-blend-mode: multiply, multiply;"></overlay>

                <!-- VIDEO -->
                <video id="banner-video" autoplay loop controls muted poster="{{ asset( clan.image|default(NA_169) ) }}">
                    <source src="{{asset(clan.video)}}" type="video/mp4">
                </video>

            {% endif %}

            <!-- LEFT : ICON + QUOTE -->
            <left id="left-part" class="col-12 col-lg-5 py-3 py-lg-5 pl-lg-5 pr-lg-0 m-0 d-flex flex-column justify-content-center align-items-center" >

                {% if clan.estMajeur == 1 %}
                    <strong class="text-white mb-3 text-shadow">Clan Majeur</strong>
                {% endif %}

                {% if clan.video is defined and clan.video is not empty %}
                    <button id="btn-play" class="btn-unstyled" onclick="focusVideo()">
                        <animation id="zone-mon" class="animation-shine hover-zoom">
                            <i id="icon-play" class="invisible fa-solid fa-video fa-4x"></i>
                            <img class="img-240 filter-shadow" src="{{ asset(clan.mon|default(NA_MON)) }}" alt="Blason" title="Visualiser/Écouter la Vidéo" />
                        </animation>
                    </button>
                {% else %}
                    <img class="img-240 filter-shadow" src="{{ asset(clan.mon|default(NA_MON)) }}" alt="Icône" />
                {% endif %}

                <!-- CITATION -->
                {% if clan.citation is not empty %}
                    <span class="quote text-white m-0 pr-3">«&nbsp;{{clan.citation}}&nbsp;»</span>
                {% endif %}

                <!-- CHAMPION -->
                {% if clan.chef is not empty %}
                    <a style="color: {{ clan.couleur }}" class="d-flex justify-content-center hover-no-under hover-zoom mt-3" href="{{ path('personnage_profil', {id: clan.chef.id} ) }}">
                        <img class="img-48" src="{{ asset(clan.chef.icone|default(NA_PERSO_PORTRAIT)) }}" alt="Icône du personnage" />
                        <div class="d-flex flex-column text-left ml-3">
                            <strong>{{ clan.chef.nom }} {{ clan.chef.prenom }}</strong>
                            (Champion)
                        </div>
                    </a>
                {% endif %}

            </left>

            <!-- RIGHT : DESCRIPTION -->
            <right id="right-part" class="col-12 col-lg-7">
                <p class="text-zone-blur">
                    {{ clan.description|raw|nl2br }}
                </p>
            </right>

        </div>

        <!-- NAV OTHER CLANS -->
        <nav class="col-12 relative" style="z-index: 3; border-bottom: 4px solid {{clan.couleur}}">

            {# Desktop : tous les onglets alignes horizontalement #}
            <div class="d-none d-lg-flex justify-content-center">
                {% for un_autre_clan in toutClans %}
                    <a class="text-white py-2 px-3" {% if un_autre_clan.id == clan.id %}style="background-color: {{clan.couleur}}"{% endif %}
                    href="{{ path('empire_clan', { id: un_autre_clan.id, '_fragment' : 'element-banner' } ) }}">
                        <strong>{{un_autre_clan.nom|upper}}</strong>
                    </a>
                {% endfor %}
            </div>

            {# Mobile : seul le clan actif est affiche, le chevron deroule les autres #}
            <div class="dropdown d-lg-none text-center">
                <a  class="banner-nav-toggle chevron-toggle text-white py-2 px-3 d-inline-flex align-items-center"
                    style="background-color: {{clan.couleur}}"
                    data-toggle="dropdown" href="#" role="button"
                    aria-expanded="false" aria-label="Choisir un autre clan">
                    <strong>{{clan.nom|upper}}</strong>
                    <i class="fas fa-chevron-down ml-2"></i>
                </a>
                <div class="dropdown-menu dropdown-dark">
                    {% for un_autre_clan in toutClans|filter(c => c.id != clan.id) %}
                        <a class="dropdown-item" href="{{ path('empire_clan', { id: un_autre_clan.id, '_fragment' : 'element-banner' } ) }}">
                            {{un_autre_clan.nom|upper}}
                        </a>
                    {% endfor %}
                </div>
            </div>
        </nav>

    </div>

</section>
