{% extends 'element.html.twig' %}

{% block stylesheets %}
    {{parent()}}
    <link rel="stylesheet" href="{{asset('css/pages/dojo.css')}}" />
{% endblock %}

{% block element_content %}

    <div class="col-12">
        <div class="card card-page">

            <div class="relative">

                <a id="banner-icon-clan" class="hover-zoom" href="{{ path('empire_clan', {id:ecole.clan.id} ) }}" >
                    <img class="img-96 filter-shadow" src="{{ asset(ecole.clan.mon|default(NA_MON)) }}" alt="Mon d'une faction" title="Voir la faction {{ecole.clan.nom}}" />
                </a>

                {{ include('/parts/card-top-image.html.twig', {
                    image: ecole.imageAffichee,
                    alt: "Image de l'École",
                    img_class: 'crop-169 top',
                    titre: nom,
                    classes: 'gradient-desktop',
                }) }}

                {# Place APRES l'image : sur mobile la zone revient dans le flux et s'empile
                   sous elle ; en desktop elle est en absolute, l'ordre n'y change rien. #}
                <div id="text-zone">

                    <div>
                        <h2 class="heading-cardtitle">Trait bonus</h2>
                        {% set labels = {'constitution':'Constitution','volonte':'Volonté','reflexes':'Réflexes','intuition':'Intuition','agilite':'Agilité','intelligence':'Intelligence','forceStat':'Force','perception':'Perception','vide':'Vide'} %}
                        <span class="text-zone-blur text-xp text-big">{{ ecole.bonusStatNom ? (labels[ecole.bonusStatNom] ?? ecole.bonusStatNom) ~ ' +1' : '—' }}</span>
                    </div>

                    <div>
                        <h2 class="heading-cardtitle">Compétences</h2>
                        <ul class="text-zone-blur">{{ ecole.competences|lister|raw }}</ul>
                    </div>

                    <div>
                        <h2 class="heading-cardtitle">Équipement</h2>
                        <ul class="text-zone-blur">{{ ecole.equipements|lister|raw }}</ul>
                    </div>

                </div>

            </div>

            <p class="card-description aerated">{{ ecole.description|raw|nl2br }}</p>

        </div>
    </div>

    <div class="col-12 col-lg-8 ecole-colonne">

        <div class="card card-body">
            <h2 class="heading-cardtitle">Techniques</h2>
            <hr>

            {% for i in 1..5 %}
                {% if attribute(ecole, 'tech' ~ i ~ 'Nom') is not empty %}
                    <div class="technique">
                        <div class="tech-rang" style="color: {{ ecole.clan.couleur }}">
                            <strong>Rang</strong><br/>
                            <span class="number-skillrank-effect skill-rank-number">{{ i }}</span>
                        </div>
                        <div>
                            <h3 class="label-amerigo">{{ attribute(ecole, 'tech' ~ i ~ 'Nom') }}</h3>
                            <p class="text-justify text-regular">{{ attribute(ecole, 'tech' ~ i ~ 'Desc')|raw|nl2br }}</p>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}

            {% if ecole.techSpecialNom is not empty %}
                <div class="technique-speciale">
                    <h3 class="label-amerigo">{{ ecole.techSpecialNom }}</h3>
                    <p>{{ ecole.techSpecialDesc|raw|nl2br }}</p>
                </div>
            {% endif %}

        </div>

        {% if ecole.sorts is defined and ecole.sorts is not empty %}
        <div class="card card-body">
            <h2 class="heading-cardtitle">Magie</h2>
            <hr>

            <div class="d-flex justify-content-around align-items-start">
                <div>
                    <h4>Affinité</h4>
                    <span class="text-xp text-large">{{ecole.affinite}}</span>
                </div>
                <div>
                    <h4>Déficience</h4>
                    <span class="text-dead text-large">{{ecole.deficience}}</span>
                </div>
                <div>
                    <h4>Sorts de départ</h4>
                    {{ecole.sorts|lister|raw}}
                </div>
            </div>

        </div>
        {% endif %}

    </div>

    {{ include('/parts/picture-grid.html.twig', {
        variant: 'portrait',
        title: 'Personnages',
        items: ecole.personnages, route: 'personnage_profil',
        wrapper: 'col-12 col-lg-4',
        per_row: {desktop: 2, tablet: 4, mobile: 2},
        empty_message: "Il n'y a pas encore de personnages dans cette école.",
    }) }}

    {{ include('/parts/picture-grid.html.twig', {
        title: 'Autres Écoles',
        items: autresEcoles, route: 'regles_ecole',
        na_image: NA_ECOLE,
        ratio: '43',
    }) }}

{% endblock %}
