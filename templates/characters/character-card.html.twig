{% if element_listed(character) %}

{% set state = element_state(character) %}
{% set readable = element_readable(character) %}
{% set locked = state == 'locked' and not is_gm() %}
{% set hide_clan = hide_clan|default(false) %}
{% set compact = compact|default(false) %}

<article class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2 {{ compact ? 'py-2' : 'py-3' }} {{ character.dead or character.missing ? 'character-inactive' }}">

    {% if readable %}
        <a href="{{ path('characters_profile', {id: character.id} ) }}" title="Voir le profil de {{character.prenom}}">
    {% endif %}

    {% set zoom, translucent, hover_opaque, text, tint, grayscale = 'hover-zoom', '', '', 'text-white', '', '' %}

    {% if not readable %}
        {% set zoom, translucent, hover_opaque, text, tint, grayscale = '', 'translucent', '', 'text-white', '', 'grayscale' %}
    {% elseif character.dead %}
        {% set zoom, translucent, hover_opaque, text, tint, grayscale = 'hover-zoom', 'translucent', 'hover-opaque', 'text-danger', 'effect-dead', '' %}
    {% elseif character.missing %}
        {% set zoom, translucent, hover_opaque, text, tint, grayscale = 'hover-zoom', 'translucent', 'hover-opaque', 'text-AIR', 'missing', '' %}
    {% endif %}

            <div class="card character-card text-white shadow-more {{zoom}} {{translucent}} {{hover_opaque}} relative {{ locked ? 'locked' }}">

                {% if locked %}
                    <img class="icon-lock in-character-card" src="{{ asset(LOCKED_ICO) }}" alt="Cadenas" />
                {% endif %}

                {% if element_fresh(character) %}
                    {{ include('parts/badge-new.html.twig', { variant: 'pin-centerleft' }) }}
                {% endif %}

                {{ include('parts/badge-catalog.html.twig', {item: character}) }}

                {% if character.dead %}
                    <img class="absolute icon-dead-big" src="{{ asset(MORT_ICO) }}" alt="Icône est mort" />
                {% elseif character.missing %}
                    <i class="absolute icon-missing-big fas fa-circle-question" title="Disparu"></i>
                {% endif %}

                {% if character.clan and not hide_clan %}
                    <img class="absolute corner-badge {{grayscale}} {{tint}}" src="{{ asset(image_small(character.clan.mon|default(NA_MON))) }}" alt="Mon d'un clan"/>
                {% endif %}

                {% if character.illustration is null and character.genre == 'F' %}
                    {% set NA_PERSO_ILLU = NA_PERSO_ILLU_F %}
                {% elseif character.illustration is null and character.genre == 'M' %}
                    {% set NA_PERSO_ILLU = NA_PERSO_ILLU_M %}
                {% endif %}

                {% set illustration = character.illustration|default(NA_PERSO_ILLU) %}
                {% set illustration_srcset = image_srcset(illustration) %}

                <div class="ratio-916 gradient-after-down">
                    <img class="ratio-cropped card-img {{grayscale}} {{tint}}" src="{{ asset(illustration) }}"
                        {% if illustration_srcset %}
                            srcset="{{ illustration_srcset }}"
                            sizes="(max-width: 575.98px) 100vw, (max-width: 767.98px) 240px, (max-width: 1199.98px) 210px, 160px"
                        {% endif %}
                        loading="lazy" alt="Illustration d'un personnage" >
                </div>

                <div class="card-img-overlay">
                    <h4 class="card-title-cartouche {{text}}">{{ character.nomComplet }}</h4>
                    {% if character.estPj == 1 %}
                        <p class="card-text {{text}}"><small>{{ character.joueur.pseudo }}</small></p>
                    {% endif %}
                    {% if character.titres %}
                        <p class="card-text card-titles {{text}}"><small>{{ character.titres }}</small></p>
                    {% endif %}
                </div>
            </div>
    {% if readable %}
        </a>
    {% endif %}
</article>

{% endif %}