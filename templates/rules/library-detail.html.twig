{% extends 'element.html.twig' %}

{% block stylesheets %}
        {{parent()}}
        <link rel="stylesheet" href="{{asset('css/components/rule-lore-part.css')}}" />
        <link rel="stylesheet" href="{{asset('css/components/spell.css')}}" />
        <link rel="stylesheet" href="{{asset('css/pages/library.css')}}" />
{% endblock %}

{% block element_content %}

    {% set is_home = app.request.get('tab') is not defined or app.request.get('tab') is empty %}
    {% set has_subtabs = record.subTabField is defined and record.subTabField is not empty %}
    {% set subtab = has_subtabs
        ? (record.mixable == true ? 'all' : 'first')
        : app.request.get('subtab') %}

    {% set tab_links = [] %}
    {% for tab in tabs %}
        {% set tab_links = tab_links|merge([{
            label: tab_label(record, tab),
            path: path('rules_library', {id: record.id, tab: tab, subtab: subtab}),
            active: app.request.get('tab') == tab,
        }]) %}
    {% endfor %}

    <nav class="mt-2 mt-lg-0 mb-lg-3{% if is_home %} d-lg-none{% endif %}">
        <div class="col-12 p-0 m-0">
            <ul id="tabs">
                <li>
                    <a href="{{ path( 'rules_library', {id: record.id} ) }}"
                    class="tab {% if is_home %}active{% endif %}">
                            <i class="fa-solid fa-house" title="Lire l'introduction"></i>
                    </a>
                </li>
                {% for tab_link in tab_links %}
                    <li>
                        <a href="{{ tab_link.path }}" class="tab {% if tab_link.active %}active{% endif %}">
                            {{ tab_link.label|upper }}
                        </a>
                    </li>
                {% endfor %}

                {% if record.mixable is defined and record.mixable == true %}
                    <li>
                        <a href="{{ path('rules_library', {id: record.id, tab: 'all', subtab: subtab}) }}"
                            class="tab {% if app.request.get('tab') == 'all' %}active{% endif %}">
                            <i class="fa-solid fa-list" title="Voir tout"></i>
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>

        {% if app.request.get('tab') is not empty and subtabs is defined and subtabs is not empty %}
            <div class="col-12 p-0 mt-3 pl-4">
                <ul id="sub-tabs">
                    {% for subtab in subtabs %}
                        <li class="mt-auto mb-auto">
                            <a href="{{ path('rules_library', {id: record.id, 'tab' : app.request.get('tab'), 'subtab' : subtab } ) }}"
                                class="{% if app.request.get('subtab') is defined and app.request.get('subtab') == subtab %}active{% endif %}">
                                {% set subtab_ring = ring_icon(app.request.get('tab'), subtab) %}
                                {% if subtab_ring %}
                                    {% set subtab_name = app.request.get('tab') == 'MAGIE' ? subtab : subtab ~ ' ' ~ app.request.get('tab')|capitalize %}
                                    <img class="img-48" src="{{ asset(subtab_ring) }}" title="{{ subtab_name }}" alt="Icône {{ subtab_name }}" />
                                {% elseif app.request.get('tab') == 'MAGIE' %}
                                    {{ subtab }}
                                {% else %}
                                    {{ tab_label(record, subtab, true) }}
                                {% endif %}
                            </a>
                        </li>
                    {% endfor %}
                    {% if record.mixable is defined and record.mixable == true %}
                        <li>
                            <a href="{{ path('rules_library', {id: record.id, 'tab' : app.request.get('tab'), 'subtab' : 'all' } ) }}"
                            class="{% if app.request.get('subtab') is defined and app.request.get('subtab') == 'all' %}active{% endif %}">
                                    <i class="fa-solid fa-list" title="Voir tout"></i>
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        {% endif %}
    </nav>

    {% if is_home %}

        <div class="col-12">
            <div class="card card-page">

                <div class="relative">

                    {{ include('rule-lore-library/summary.html.twig', {items: tab_links}) }}

                    {{ include('/parts/card-top-image.html.twig', {
                        image: record.image,
                        na_image: NA_LIBRARY,
                        alt: 'Image de ' ~ name,
                        pdf_url: pdf_url(record),
                        img_class: 'crop-169',
                        title: name,
                    }) }}
                </div>

                <div class="part-body">
                    {% if record.aside is defined and record.aside is not empty %}
                        <aside class="aside">
                            <p>{{ record.aside|text }}</p>
                        </aside>
                    {% endif %}

                    <div class="card-description text-description">{{ record.description|text }}</div>
                </div>

                {{ include('rule-lore-library/part-links.html.twig', {links: part_links(record, 1)}, with_context = false) }}

                {{ include('/parts/divider-ornament.html.twig') }}

            </div>
        </div>

    {% else %}

        {% if filters is not empty or keywords is not empty %}
            <div class="col-12 mt-3 library-row">

                {% if keywords is not empty %}
                    <div class="col-12 col-md-4">
                        <label for="keyword-select">Filtrer par mot-clé :</label>
                        <select name="keyword" id="keyword-select" >
                            <option value="">TOUS</option>
                            {% for keyword in keywords %}
                                <option value="{{ keyword }}" {% if app.request.get('keyword') == keyword %}selected{% endif %}>{{keyword}}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}

                {% if filters is not empty %}
                    <div class="col-12 col-md-4">
                        <label for="filter-select">Filtrer par {{ record.filterField|lower }} :</label>
                        <select name="filter" id="filter-select" >
                            <option value="">TOUS</option>
                            {% for one_filter in filters %}
                                <option value="{{ one_filter }}" {% if app.request.get('filter') == one_filter %}selected{% endif %}>{{one_filter}}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}

            </div>
        {% endif %}

        {% if discounts is not empty %}
            <div class="col-12 mt-3 library-row">
                {% for param, discount in discounts %}
                    <div class="col-12 col-md-4">
                        <label for="discount-{{param}}-select">Filtrer par {{discount.label}} :</label>
                        <select id="discount-{{param}}-select" class="discount-select" data-param="{{param}}">
                            <option value="">TOUS</option>
                            {% for id, option_label in discount.options %}
                                <option value="{{id}}" {% if app.request.get(param) == id %}selected{% endif %}>{{option_label}}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {% if subtabs is empty or subtabs is not empty and app.request.get('subtab') is defined and app.request.get('subtab') is not empty %}
            <div class="col-12 library-row">
                {{ include('rules/list-' ~ record.entity ~ '.html.twig') }}
            </div>
        {% endif %}

    {% endif %}

    {{ include('/parts/picture-grid.html.twig', {
        variant: 'rule',
        title: 'Autres Bibliothèques',
        items: other_libraries, route: 'rules_library',
        na_image: NA_LIBRARY,
    }) }}

{% endblock %}

{% block javascripts %}
    {{parent()}}
    <script src="{{ asset('scripts/library.js') }}"></script>
{% endblock %}