{% extends 'other.html.twig' %}

{% set titre = 'Votre espace de compte' %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{asset('css/pages/account.css')}}" />
{% endblock %}

{% block cartes %}

  {% set principal = app.user.mainCharacter %}

  <div class="col-12 col-lg-6">
    <div class="card card-page">
      <h2 class="heading-cardtitle">Informations Personnelles</h2>
      <hr>

      <dl class="account-infos">
        <dt>Votre Pseudo</dt>
        <dd><strong>{{ app.user.pseudo }}</strong></dd>

        <dt>Votre E-mail</dt>
        <dd><strong>{{ app.user.email }}</strong></dd>

        <dt>Votre Mot de passe</dt>
        <dd>
          <strong>******</strong>
          <a href="{{ path('mon_compte_mdp') }}"><i class="fas fa-edit" aria-hidden="true"></i> Modifier</a>
        </dd>

        <dt>Votre statut de compte</dt>
        <dd><strong>{{ app.user.isVerified ? 'Vérifié' : 'Non-vérifié' }}</strong></dd>

        <dt>Vos rôles</dt>
        <dd>
          {% for un_role in app.user.roles %}
            <strong>{{ un_role }}</strong>{{ not loop.last ? ',' : '' }}
          {% else %}
            Il n'y a pas de rôle
          {% endfor %}
        </dd>

        <dt>Votre avatar</dt>
        <dd>
          {{ include('parts/avatar.html.twig', {user: app.user, size: 128}) }}
          <a href="{{ path('mon_compte_avatar') }}"><i class="fas fa-edit" aria-hidden="true"></i> Modifier</a>
        </dd>
      </dl>
    </div>
  </div>

  <div class="col-12 col-lg-6">
    <div class="card card-page">
      <h2 class="heading-cardtitle">Mon Personnage Principal</h2>
      <hr>

      {% if principal %}
        <div class="account-main">
          <a href="{{ path('personnage_profil', {id: principal.id}) }}" class="hover-zoom">
            <img src="{{ asset(principal.icone|default(NA_PERSO_PORTRAIT)) }}" alt="Portrait de {{ principal.prenom }}" />
          </a>
          <div>
            {% if principal.clan %}
              <img class="img-24" src="{{ asset(principal.clan.mon|default(NA_MON)) }}" alt="Mon du Clan {{ principal.clan.nom }}" />
            {% endif %}
            <strong>{{ principal.nom }} {{ principal.prenom }}</strong>
            {% if principal.fichePersonnage is not empty %}
              <a href="{{ path('personnage_fiche', {id: principal.fichePersonnage.id}) }}">
                <i class="fas fa-user-secret" aria-hidden="true"></i> Fiche privée
              </a>
            {% endif %}
          </div>
        </div>
      {% else %}
        <p class="text-muted font-italic">Vous n'avez pas encore choisi de personnage principal.</p>
      {% endif %}

      {% if app.user.personnages|length %}
        <form class="account-choice" method="post" action="{{ path('mon_compte_main_character') }}">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('main-character') }}" />
          <label for="main-character">Choisir mon personnage principal</label>
          <select id="main-character" name="personnage">
            <option value="">Automatique — le plus récent</option>
            {% for un_personnage in app.user.personnages %}
              <option value="{{ un_personnage.id }}"{% if principal and un_personnage.id == principal.id %} selected{% endif %}>
                {{ un_personnage.nom }} {{ un_personnage.prenom }}
              </option>
            {% endfor %}
          </select>
          <label class="account-choice-toggle" for="sans-personnage">
            <input type="checkbox" id="sans-personnage" name="sans_personnage" value="1"{{ app.user.withoutCharacter ? ' checked' }} />
            Naviguer sans personnage
          </label>

          <button type="submit" class="btn-primary-style btn-medium">Valider</button>
        </form>
      {% endif %}

      <h2 class="heading-cardtitle">Mes Autres Personnages</h2>
      <hr>

      <div class="account-characters">
        {% for un_personnage in app.user.personnages|filter(p => principal is empty or p.id != principal.id) %}
          <article>
            <a href="{{ path('personnage_profil', {id: un_personnage.id}) }}" class="hover-zoom">
              <img src="{{ asset(un_personnage.icone|default(NA_PERSO_PORTRAIT)) }}" alt="Portrait de {{ un_personnage.prenom }}" />
            </a>
            <strong>{{ un_personnage.nom }} {{ un_personnage.prenom }}</strong>
            {% if un_personnage.fichePersonnage is not empty %}
              <a href="{{ path('personnage_fiche', {id: un_personnage.fichePersonnage.id}) }}">
                <i class="fas fa-user-secret" aria-hidden="true"></i> Fiche privée
              </a>
            {% else %}
              <small class="text-muted">Pas encore de fiche privée</small>
            {% endif %}
          </article>
        {% else %}
          <p class="text-muted font-italic">Il n'y a pas d'autre personnage sur ce compte.</p>
        {% endfor %}
      </div>
    </div>
  </div>

{% endblock %}
