<div class="col-12">
    {{ form_start(form) }}
        <div class="row form-wrapper">
            <div class="col-6">{{ form_row(form.titre) }}</div> 
            <div class="col-3">{{ form_row(form.auteur) }}</div>
            <div class="col-3 align-self-center">{{ form_row(form.locked) }}</div>

            <div class="col-12 mt-3">{{ form_row(form.contenu,{ 'attr': {'rows': '20'} }) }}</div>

            <div class="col-12 mt-3 mb-5">
                {{ form_label(form.image, 'Image (1280×720 16:9 recommandé)') }}
                <label for="admin_archive_image" class="preview-label hover-slight-fade hover-pointer hover-icon-visible">
                    <span class="btn-icon-medium right-corner-16"><i class="fas fa-edit semi-visible text-white"></i></span>
                    <img id="image-preview" class="img-fluid border-soft" src="{{ asset(archive.image|default(NA_ARCHIVE)) }}" />
                    <span id="image-filename" class="filename"></span>
                </label>
                <div class="browser">{{form_widget(form.image, {'attr': {'class': 'input-image'}}) }}</div>

                {{ include('parts/image-cropper.html.twig', {input_id: 'admin_archive_image', width: 1280, height: 720}) }}
                {{ include('parts/image-delete-button.html.twig', {input_id: 'admin_archive_image', field_name: 'image', current: archive.image|default(null)}) }}
            </div>

            {{ include('/parts/btn-form.html.twig') }}
        </div>
    {{ form_end(form) }}
</div>
