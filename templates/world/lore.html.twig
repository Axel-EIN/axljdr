{% extends 'element.html.twig' %}

{% block stylesheets %}
  {{parent()}}
  <link rel="stylesheet" href="{{asset('css/components/rule-lore-part.css')}}" />
{% endblock %}

{% block element_content %}

  <div class="col-12">
    <div class="card card-page">

      <div class="relative">

        {{ include('rule-lore-library/summary.html.twig', {record}) }}

        {{ include('/parts/card-top-image.html.twig', {
          image: record.image,
          na_image: NA_LORE,
          alt: 'Image de ' ~ name,
          pdf: record.pdf,
          state: element_state(record),
          pdf_button: record.hasParts,
          img_class: 'crop-169',
          title: name,
        }) }}
      </div>

      {{ include('rule-lore-library/parts.html.twig', {record, entity: 'lore'}) }}

    </div>
  </div>

  {{ include('/parts/picture-grid.html.twig', {
      title: 'Autres Lores',
      items: other_lores, route: 'world_lore',
      na_image: NA_LORE,
  }) }}

{% endblock %}
