{% extends 'category.html.twig' %}
{% block title %}Accueil {{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{asset('css/components/picture-grid.css')}}" />
    <link rel="stylesheet" href="{{asset('css/components/episode-card.css')}}" />
    <link rel="stylesheet" href="{{asset('css/components/map.css')}}" />
    <link rel="stylesheet" href="{{asset('css/pages/news.css')}}" />
{% endblock %}

{% block section_content1 %}

    {% set chapitre = dernier_episode ? dernier_episode.chapitreParent : null %}
    {% set chapter_image = chapitre ? chapitre.image|default(NA_CHAPITRE) : null %}
    {% set episode_preset = image_preset('landscape720') %}

    <div class="col-12 col-lg-7">
        <div class="card card-body session-card on-image{{ image_bright(chapter_image) ? ' bright' }}"
            {% if chapitre %}style="--chapter-color: {{ chapitre.couleur }}; --chapter-image: url('{{ asset(chapter_image) }}');"{% endif %}>

            {% if dernier_episode %}
                <div class="session-split">
                    <div>
                        {{ include('/aventure/episode-card.html.twig', {
                            un_episode: dernier_episode,
                            wrapper: 'w-100',
                            lazy: false,
                            user_personnages_cumul_episodes: [],
                        }) }}
                    </div>

                    {% if classement %}
                        {{ include('/news/ranking.html.twig', {items: classement, mine: mes_personnages}) }}
                    {% endif %}
                </div>

                <div class="session-groups">
                    <div class="session-pair">
                        <div class="session-group">
                            <h3 class="label-amerigo news-subtitle text-white mt-4">Lieux</h3>
                            {{ include('/parts/picture-grid.html.twig', {
                                items: session_locations,
                                reveal_session: true,
                                badge_hover: true,
                                variant: 'icon',
                                na_image: NA_LIEU_ICO,
                                per_row: 2,
                                limit: 4,
                                empty_message: 'Aucun lieu visité',
                            }) }}
                        </div>

                        <div class="session-group">
                            <h3 class="label-amerigo news-subtitle text-white mt-4">Rencontres</h3>
                            {{ include('/parts/picture-grid.html.twig', {
                                items: session_characters,
                                reveal_session: true,
                                badge_hover: true,
                                variant: 'portrait',
                                per_row: 4,
                                empty_message: 'Aucun personnage rencontré',
                            }) }}
                        </div>
                    </div>

                    <div class="session-group">
                        <h3 class="label-amerigo news-subtitle text-white mt-4">Objets</h3>
                        {{ include('/parts/picture-grid.html.twig', {
                            items: session_objects,
                            field: 'icon',
                            reveal_session: true,
                            badge_hover: true,
                            variant: 'rule',
                            per_row: {desktop: 4, tablet: 4, mobile: 3},
                            empty_message: 'Aucun objet découvert',
                        }) }}
                    </div>

                    {% if session_previous is not empty %}
                        <div class="session-group">
                            <h3 class="label-amerigo news-subtitle text-white mt-4">Séances précédentes</h3>
                            {% for un_episode in session_previous %}
                                <a class="episode-row inverted" href="{{ path('aventure_episode', {id: un_episode.id}) }}">
                                    <span class="episode-number">#{{ un_episode.numeroSaison }}</span>
                                    <span class="episode-text">
                                        <strong>{{ un_episode.titre }}</strong>
                                        <span class="episode-sub">{{ un_episode.chapitreParent.titre }}</span>
                                    </span>
                                    <img class="episode-picture" src="{{ asset(image_small(un_episode.image|default(NA_SESSION))) }}" width="{{ episode_preset.width }}" height="{{ episode_preset.height }}" loading="lazy" alt="" />
                                </a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                {% if chapitre %}
                    {% set saison = chapitre.saisonParent %}
                    <div class="session-links">
                        <a class="session-link" href="{{ path('aventure_saison', {id: saison.id}) }}">
                            <img src="{{ asset(AVENTURE_SAISON_ICO) }}" alt="Icône de saison" />
                            <span>Saison {{ saison.numero }}</span>
                        </a>

                        <a class="session-link" href="{{ path('aventure_saison', {id: saison.id}) }}#read-head-ch-id{{ chapitre.id }}">
                            <img src="{{ asset(AVENTURE_CHAPITRE_ICO) }}" alt="Icône de chapitre" />
                            <span>Chapitre {{ chapitre.numero }} — {{ chapitre.titre }}</span>
                        </a>
                    </div>
                {% endif %}
            {% else %}
                <p class="texte-attente">Le premier résumé de séance n'a pas encore été publié.</p>
            {% endif %}
        </div>
    </div>

    <div class="col-12 col-lg-5 news-aside">

        {% if mon_personnage %}
            <div class="card card-body participations-card"
                style="--character-image: url('{{ asset(mon_personnage.illustration|default(NA_PERSO_ILLU)) }}');{% if mon_personnage.clan %} --faction-color: {{ mon_personnage.clan.couleur }};{% endif %}">
                <div class="character-status">
                    <div class="status-head">
                        <h3 class="status-name font-present text-white">{{ mon_personnage.nomComplet }}</h3>
                        <span class="badge-rang-{{ mon_recap.rang }} large">RANG {{ mon_recap.rang }}</span>
                    </div>
                    {% set niveaux_blessure = constant('App\\Entity\\FichePersonnage::NIVEAUX_BLESSURE')|keys %}
                    {% if mon_recap.pvMax %}
                        <div class="status-hp-bar">
                            {% for niveau in niveaux_blessure %}
                                <span class="filled" title="{{ niveau }}"></span>
                            {% endfor %}
                        </div>
                    {% endif %}
                    <div class="status-body">
                        <nav class="status-actions" aria-label="Raccourcis du personnage">
                            <a class="status-link" href="{{ path('personnage_profil', {id: mon_personnage.id}) }}" aria-label="Voir le profil">
                                <i class="fa-solid fa-user" aria-hidden="true"></i>
                                <span class="hover-tooltip below">Voir le profil</span>
                            </a>
                            {% if mon_personnage.fichePersonnage %}
                                <a class="status-link" href="{{ path('personnage_fiche', {id: mon_personnage.fichePersonnage.id}) }}" aria-label="Voir la Fiche de Jeu">
                                    <i class="fa-solid fa-scroll" aria-hidden="true"></i>
                                    <span class="hover-tooltip below">Voir la Fiche de Jeu</span>
                                </a>
                            {% endif %}
                            <a class="status-link" href="{{ path('carte') }}" aria-label="Voir sur la carte">
                                <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
                                <span class="hover-tooltip below">Voir sur la carte</span>
                            </a>
                        </nav>
                        {% if mon_recap.pvMax %}
                            <div class="status-hp-values text-your-xp">{{ mon_recap.pvMax }} / {{ mon_recap.pvMax }}<span class="status-label">{{ niveaux_blessure|first }}</span></div>
                        {% endif %}
                    </div>
                </div>

                {% if carte_visible %}
                    <div class="participations-map d-none d-lg-block">
                        <h3 class="label-amerigo news-subtitle">Position</h3>
                        {{ include('parts/map.html.twig', {
                            lieux,
                            current: position_actuelle,
                            party: position_actuelle ? {(position_actuelle.id): [mon_personnage]} : {},
                            center: position_libre,
                            wanderers: position_libre ? [position_libre] : [],
                            zoom: position_actuelle ? position_actuelle.zoom : null,
                            variant: 'mini',
                        }, with_context = false) }}
                    </div>
                {% endif %}

                {% if mes_participations is not empty %}
                    <h3 class="label-amerigo news-subtitle">Participations</h3>
                    {% for participation in mes_participations %}
                        {% set scene = participation.scene %}
                        {% set episode = scene.episodeParent %}
                        {% set perso = participation.personnage %}
                        {% set cumul = participations_xp[participation.id]|default(null) %}
                        <a class="episode-row" href="{{ path('aventure_episode', {id: episode.id}) }}">
                            <span class="portrait-slot">
                                <img class="character-portrait medium outlined {{ participation.estMort ? 'effect-dead' }}"
                                     src="{{ asset(perso.icone|default(NA_PERSO_PORTRAIT)) }}"
                                     alt="Portrait de {{ perso.prenom }}" title="{{ perso.prenom }}" />
                                {% if participation.estMort %}<img class="character-icon-dead" src="{{ asset(MORT_ICO) }}" alt="est mort" />{% endif %}
                                {% if cumul %}<span class="episode-xp">{{ include('parts/xp-gain.html.twig', {xp: cumul.xp, total: cumul.xpWithBonus, signe: '+'}) }}</span>{% endif %}
                            </span>
                            <span class="episode-text">
                                <strong>{{ episode.titre }}</strong>
                                {% if scene.lieu %}<span class="episode-sub">{{ scene.lieu.nom }}</span>{% endif %}
                            </span>
                            <img class="episode-picture" src="{{ asset(image_small(episode.image|default(NA_SESSION))) }}" width="{{ episode_preset.width }}" height="{{ episode_preset.height }}" loading="lazy" alt="" />
                        </a>
                    {% endfor %}
                {% endif %}
            </div>

            <div class="card card-body discoveries-card">
                <h3 class="label-amerigo news-subtitle"><i class="fa-solid fa-eye" aria-hidden="true"></i> Découvertes</h3>

                {% for decouverte in decouvertes %}
                    <h4 class="news-qualifier">{{ decouverte.titre }}</h4>
                    {{ include('/parts/picture-grid.html.twig', {
                        items: decouverte.elements,
                        keep_order: true,
                        badge_pinned: true,
                        variant: decouverte.variant,
                        field: decouverte.field|default(null),
                        na_image: {lieu: NA_LIEU_ICO}[decouverte.cle]|default(null),
                        per_row: decouverte.max,
                        empty_message: decouverte.vide,
                    }) }}
                {% endfor %}
            </div>
        {% else %}
            <div class="card card-body ranking-card">
                <h3 class="label-amerigo news-subtitle">Classement Général</h3>
                {{ include('/news/ranking.html.twig', {items: classement_general}) }}
            </div>
        {% endif %}

    </div>

{% endblock %}

{% block section_content2 %}
    <div class="col-12">
        <div class="news-board">
            {% for groupe in groupes %}
                <div class="card card-body news-group{{ groupe.large|default(false) ? ' large' }}">
                    <h3 class="label-amerigo news-subtitle">{{ groupe.titre }}</h3>
                    {% if groupe.sections is defined %}
                        <div class="news-sections">
                            {% for section in groupe.sections %}
                                <div class="news-section" style="--span: {{ section.max }}">
                                    <h4 class="news-qualifier">{{ section.titre }}</h4>
                                    {{ include('/parts/picture-grid.html.twig', {
                                        items: section.elements,
                                        badge_hover: true,
                                        variant: groupe.variant|default('landscape'),
                                        field: groupe.field|default(null),
                                        per_row: section.max,
                                        wrapper: 'compact',
                                    }) }}
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        {{ include('/parts/picture-grid.html.twig', {
                            items: groupe.elements,
                            badge_hover: true,
                            variant: groupe.variant|default('landscape'),
                            field: groupe.field|default(null),
                            per_row: groupe.perRow,
                            wrapper: 'compact',
                        }) }}
                    {% endif %}
                </div>
            {% endfor %}

            {% if not mon_personnage %}
                <div class="card card-body news-group{{ secrets_large ? ' large' }} locked">
                    <h3 class="label-amerigo news-subtitle">Secrets</h3>
                    <img class="news-lock fa-beat-fade" src="{{ asset(LOCKED_ICO) }}" alt="Cadenas" />
                    {% if app.user %}
                        <p>Les secrets de votre personnage apparaîtront ici.</p>
                    {% else %}
                        <p>Connectez-vous pour voir les secrets de votre personnage.</p>
                        <a class="btn btn-medium btn-secondary-style" href="{{ path('app_login') }}">Se connecter</a>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if carte_visible %}<script src="{{ asset('scripts/map.js') }}"></script>{% endif %}
{% endblock %}
