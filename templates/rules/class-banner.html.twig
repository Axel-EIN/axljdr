
<div id="element-banner" class="col-12">

    <div class="row" style="background-image: linear-gradient( #00000000 ,  #00000040 , #000000EE ), linear-gradient( {{character_class.couleur}}60 , {{character_class.couleur}}FF ),
                            url('{{ asset( character_class.image|default(NA_CLAN) ) }}');">

        <div class="row m-0 p-0">

            <div id="left-part" class="col-12 col-lg-5 py-3 py-lg-5 pl-lg-5 pr-lg-0 m-0 d-flex flex-column justify-content-center align-items-center" >
                <img class="img-240 invert filter-shadow" src="{{ asset(character_class.icone|default(NA_CLASS_ICO)) }}" alt="Icône" />

                {% if character_class.citation is not empty %}
                    <span class="quote text-white m-0 pr-3">«&nbsp;{{character_class.citation}}&nbsp;»</span>
                {% endif %}
            </div>

            <div id="right-part" class="col-12 col-lg-7">
                <p class="text-zone-blur text-description">
                    {{ character_class.description|raw|nl2br }}
                </p>
            </div>

        </div>

        <nav class="col-12 relative" style="z-index: 3; border-bottom: 4px solid {{character_class.couleur}}">

            <div class="d-none d-lg-flex justify-content-center">
                {% for other_class in classes %}
                    <a class="text-white py-2 px-3" {% if other_class.id == character_class.id %}style="background-color: {{character_class.couleur}}"{% endif %}
                    href="{{ path('rules_class', { id: other_class.id, '_fragment' : 'element-banner' } ) }}">
                        <strong>{{other_class.nom|upper}}</strong>
                    </a>
                {% endfor %}
            </div>

            <div class="dropdown d-lg-none text-center">
                <a  class="banner-nav-toggle chevron-toggle text-white py-2 px-3 d-inline-flex align-items-center"
                    style="background-color: {{character_class.couleur}}"
                    data-toggle="dropdown" href="#" role="button"
                    aria-expanded="false" aria-label="Choisir une autre classe">
                    <strong>{{character_class.nom|upper}}</strong>
                    <i class="fas fa-chevron-down ml-2"></i>
                </a>
                <div class="dropdown-menu dropdown-dark">
                    {% for other_class in classes|filter(c => c.id != character_class.id) %}
                        <a class="dropdown-item" href="{{ path('rules_class', { id: other_class.id, '_fragment' : 'element-banner' } ) }}">
                            {{other_class.nom|upper}}
                        </a>
                    {% endfor %}
                </div>
            </div>
        </nav>

    </div>

</div>
