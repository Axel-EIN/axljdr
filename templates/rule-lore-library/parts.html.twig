{% for i in 1..5 %}
  {% if attribute(record, 'part' ~ i ~ 'titre') is not empty %}
    <div id="part{{ i }}" class="part-header">
      {% if is_gm() %}
        {% set position, size, color, redirect, fragment = 'topright-corner-snap', 'btn-icon-medium', 'link-gm', entity, 'part' ~ i %}
        {{ include('/btns/btn-icon-edit.html.twig') }}
      {% endif %}

      <h2 class="heading-cardtitle">{{ i }}. {{ attribute(record, 'part' ~ i ~ 'titre') }}</h2>
      <hr>
    </div>
  {% endif %}

  {% if attribute(record, 'part' ~ i) is not empty %}
    <div class="part-body">
      {% if attribute(record, 'part' ~ i ~ 'aside') is not empty %}
        <aside class="aside">
          <p>{{ attribute(record, 'part' ~ i ~ 'aside')|raw|nl2br }}</p>
        </aside>
      {% endif %}
      <div class="card-description articlepart text-description">{{ attribute(record, 'part' ~ i)|raw|nl2br }}</div>
    </div>

    {{ include('/parts/divider-ornament.html.twig') }}
  {% endif %}
{% endfor %}
