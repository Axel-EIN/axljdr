{% if app.user and is_granted('ROLE_ADMIN') %}
  <div class="control-panel-bar admin">
    <a href="{{ path('back_office') }}">
      <i class="fas fa-tools"></i>
      &nbsp;&nbsp;
      Panneau d'Administration
    </a>
  </div>
{% elseif app.user and is_granted('ROLE_MJ') %}
  <div class="control-panel-bar mj">
    <a href="{{ path('back_office') }}">
      <i class="fas fa-scroll"></i>
      &nbsp;&nbsp;
      Panneau du Maître
    </a>
  </div>
{% endif %}

{% set nav_sections = [
  { label: 'ACCUEIL',      route: 'news',       actives: ['news'] },
  { label: 'AVENTURE',    route: 'aventure',    actives: ['aventure', 'aventure_saison', 'aventure_episode'] },
  { label: 'PERSONNAGES', route: 'personnages', actives: ['personnages', 'personnage_profil', 'personnage_fiche', 'personnage_fiche_edit'] },
  { label: 'UNIVERS',      route: 'empire',      actives: ['empire', 'empire_clan', 'empire_archive', 'empire_lieu', 'empire_lore'] },
  { label: 'RÈGLES',      route: 'regles',      actives: ['regles', 'regles_rule', 'regles_library', 'regles_classe', 'regles_ecole'] },
] %}
{% set route_courante = app.request.get('_route') %}
{% set section_active = nav_sections|filter(s => route_courante in s.actives)|first %}

<header class="container-fluid navigation-bar">
  <div class="container">
    <nav class="navbar navbar-expand-lg">

      <a id="logo" class="navbar-brand hover-shine" href="{{ path('news') }}">
        <img  class="img-fluid" src="{{ asset(LOGO) }}" alt="Logo AXL-JDR" title="Retour à l'Accueil" />
      </a>

      <div class="nav-mobile-menu dropdown d-lg-none">
        <button
          class="nav-link nav-mobile-toggle-full chevron-toggle{% if section_active %} active{% endif %}" type="button"
          data-toggle="dropdown" aria-expanded="false" aria-label="Ouvrir le menu des sections"
        >
          {{ section_active.label|default('MENU') }}
          <i class="fas fa-chevron-down"></i>
        </button>

        <div class="dropdown-menu dropdown-dark">
          {% for une_section in nav_sections %}
            <a class="dropdown-item{% if route_courante in une_section.actives %} active{% endif %}" href="{{ path(une_section.route) }}">{{ une_section.label }}</a>
          {% endfor %}
        </div>
      </div>

      <div class="navbar-collapse d-lg-flex justify-content-lg-between align-items-lg-center w-100" id="navbarNav">

        <ul class="navbar-nav d-none d-lg-flex">
          {% for une_section in nav_sections %}
            <li class="nav-item">
              <a  href="{{ path(une_section.route) }}"
                  class="nav-link{% if route_courante in une_section.actives %} active{% endif %}"
              >
                {{ une_section.label }}
              </a>
            </li>
          {% endfor %}
        </ul>

        {% if app.user %}
          {% set main_character = app.user.mainCharacter %}
          <div id="user-zone" class="connected">

            <div class="user-infos">
              <strong>{{ app.user.pseudo }}</strong>

              {% if main_character %}
                <a class="main-character" href="{{ path('personnage_profil', {id: main_character.id}) }}">
                  <img class="img-24" src="{{ asset(main_character.clan ? main_character.clan.mon|default(NA_MON) : NA_MON) }}" alt="Mon du clan" />
                  ({{ main_character.nom }} {{ main_character.prenom }})
                </a>
              {% endif %}

              <a class="{% if route_courante starts with 'mon_compte' %}active{% endif %}" href="{{ path('mon_compte') }}">
                <i class="fas fa-torii-gate couleur-primaire"></i>
                &nbsp;&nbsp;
                MON COMPTE
              </a>

              <small>
                <a href="{{ path('app_logout') }}">Se Déconnecter</a>
              </small>
            </div>

            <a class="avatar-link hover-shine" href="{{ path('mon_compte') }}">
              {{ include('parts/avatar.html.twig', {user: app.user, character: true}) }}
            </a>

          </div>
        {% else %}
          <div id="user-zone" class="disconnected">
            <button class="btn-primary-style btn-medium" data-toggle="modal" data-target="#connexion" alt="Boutton se connecter">Se connecter</button>
            <a class="mt-1" href="{{ path('app_register') }}">Créer un compte</a>
          </div>
        {% endif %}
      </div>
    </nav>
  </div>
</header>
