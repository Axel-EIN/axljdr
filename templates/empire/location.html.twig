{% extends 'element.html.twig' %}

{% block stylesheets %}
  {{parent()}}
  <link rel="stylesheet" href="{{asset('css/components/history.css')}}" />
  <link rel="stylesheet" href="{{asset('css/pages/location.css')}}" />
{% endblock %}

{% block element_content %}

  {% set lieu_color = (un_element.clan is defined and un_element.clan is not empty and un_element.clan.couleur is not empty) ? un_element.clan.couleur : null %}


  <div class="col-12">
    <div class="card card-page">

      <div class="relative">



        <h2 class="nickname-container d-none d-lg-flex">
          <img class="img-96 mr-2 filter-shadow" src="{{ asset(un_element.icone|default(NA_LIEU_ICO)) }}" alt="Icone de {{un_element.nom}}">
          <i class="align-middle">{{ un_element.surnom|default('') }}</i>
        </h2>

        <div class="stats d-none d-lg-flex">
          {% if un_element.clan is defined and un_element.clan is not empty %}
            <a class="d-flex justify-content-end" href="{{ path('empire_clan', {id:un_element.clan.id} ) }}" >
              <img class="mb-2 img-64 circle-crop" src="{{ asset(un_element.clan.mon|default(NA_MON)) }}" alt="Mon d'une faction" title="{{un_element.clan.nom|default('')}}" />
            </a>
          {% endif %}
          {% if un_element.type is defined and un_element.type is not empty %}<span>Type : <strong>{{ un_element.type }}</strong></span>{% endif %}
          {% if un_element.population is defined and un_element.population is not empty %}
            <span>Population : <strong>{{ un_element.population|number_format(0, ',', '.') }} habitants</strong></span>
          {% endif %}
        </div>

        {{ include('/parts/card-top-image.html.twig', {image: un_element.image, na_image: NA_LIEU, alt: 'Image de ' ~ un_element.nom, img_class: 'crop-169', titre: nom, classes: 'gradient-desktop'}) }}
      </div>

      <div class="lieu-mobile-info d-lg-none text-center">
        {% if un_element.surnom is defined and un_element.surnom is not empty %}
          <p class="lieu-surnom">{{ un_element.surnom }}</p>
        {% endif %}

        <div class="d-inline-flex justify-content-center align-items-center text-center">
          <img class="img-96 mr-5" src="{{ asset(un_element.icone|default(NA_LIEU_ICO)) }}" alt="Icone de {{un_element.nom}}" />

          <ul class="list-decored text-left">
            {% if un_element.clan is defined and un_element.clan is not empty %}
              <li>
                <span class="label">Clan :</span>
                <a class="extrabold" href="{{ path('empire_clan', {id:un_element.clan.id} ) }}">
                  <img class="img-24" src="{{ asset(un_element.clan.mon|default(NA_MON)) }}" alt="" title="Mon du clan {{un_element.clan.nom}}" />
                  {{ un_element.clan.nom }}
                </a>
              </li>
            {% endif %}
            {% if un_element.type is defined and un_element.type is not empty %}
              <li><span class="label">Type :</span> {{ un_element.type }}</li>
            {% endif %}
            {% if un_element.population is defined and un_element.population is not empty %}
              <li><span class="label">Habitants :</span> {{ un_element.population|number_format(0, ',', '.') }}</li>
            {% endif %}
          </ul>

        </div>
      </div>

      {% if un_element.description is defined and un_element.description is not empty %}
        <p class="card-description aerated">{{ un_element.description|raw|nl2br }}</p>
      {% endif %}

      {% if un_element.locX is defined and un_element.locX is not empty and un_element.locY is defined and un_element.locY is not empty %}
        {# Carte interactive : elle bugue sur mobile, d'ou son masquage. #}
        {{ include('/parts/divider-ornament.html.twig', {classes: 'my-3 d-none d-lg-flex'}) }}

        <h2 class="heading-elementpart decorated d-none d-lg-block">Carte</h2>

        <div id="map-frame" class="relative d-none d-lg-block" data-locx="{{un_element.locX}}" data-locy="{{un_element.locY}}">

          <button type="button" id="map-toggle-territoires" class="map-toggle-btn absolute"
                  data-map-clean="{{ asset('assets/maps/map-rokugan-50-clean.jpg') }}"
                  data-map-frontier="{{ asset('assets/maps/map-rokugan-50-frontier.jpg') }}">
            <i class="fa-solid fa-map mr-1"></i>
            <span class="label">Afficher territoires</span>
          </button>

          <div id="map-drag" class="map-drag" style="transform: translate(-{{un_element.locX}}%, -{{un_element.locY}}%);">

            <img class="map-image" src="{{asset('assets/maps/map-rokugan-50-clean.jpg')}}" alt="Carte de Rokugan" draggable="false" />

            {% for autre in lieux %}
              {% if autre.id != un_element.id and autre.locX is not empty and autre.locY is not empty %}
                {% set autre_locked = autre.locked and not is_granted("ROLE_MJ") %}
                {% set autre_color = (not autre_locked and autre.clan is defined and autre.clan is not empty and autre.clan.couleur is not empty) ? autre.clan.couleur : null %}
                <a href="{{ path('empire_lieu', {id: autre.id}) }}" class="absolute lieu-other-icon {% if autre_locked %}locked{% endif %}" style="left:{{autre.locX}}%; top:{{autre.locY}}%;{% if autre_color %} --clan-color: {{autre_color}};{% endif %}">
                  {% if autre_locked %}
                    <img class="lieu-other-lock fa-beat-fade" src="{{ asset(LOCKED_ICO) }}" alt="Cadenas" title="À débloquer !" />
                  {% endif %}
                  <img src="{{ asset(autre.icone|default(NA_LIEU_ICO)) }}" alt="Icone de {{ autre_locked ? 'lieu à débloquer' : autre.nom }}" />
                  <span class="hover-tooltip">{{ autre_locked ? 'À débloquer' : autre.nom }}</span>
                </a>
              {% endif %}
            {% endfor %}

            <div class="absolute localisator-icon" style="left:{{un_element.locX}}%; top:{{un_element.locY}}%">
              <i class="fa-solid fa-caret-down fa-2xl fa-bounce"></i>
            </div>

            <img class="absolute lieu-pulse-icon" style="left:{{un_element.locX}}%; top:{{un_element.locY}}%;{% if lieu_color %} --clan-color: {{lieu_color}};{% endif %}" src="{{ asset(un_element.icone|default(NA_LIEU_ICO)) }}" alt="Icone de {{un_element.nom}}" />

            <div class="absolute lieu-current-label" style="left:{{un_element.locX}}%; top:{{un_element.locY}}%;{% if lieu_color %} --clan-color: {{lieu_color}};{% endif %}">
              {{ un_element.nom }}
            </div>

          </div>

          <div id="minimap" class="absolute">
            <div class="relative overflow-hidden">
              <img class="absolute localisator-ui" style="left:{{un_element.locX}}%; top:{{un_element.locY}}%" src="{{asset('assets/maps/mini-localisator.png')}}" />
              <img class="img-fluid" src="{{asset('assets/img/lieux/minimap.jpg')}}" alt="Carte de Rokugan">
            </div>
          </div>

        </div>
      {% endif %}


      {% if un_element.carte is defined and un_element.carte is not empty %}
        {{ include('/parts/divider-ornament.html.twig') }}

        <h2 class="heading-elementpart decorated">Plan</h2>

        <img class="img-fluid" src="{{asset(un_element.carte)}}" alt="Carte du Lieu">
      {% endif %}

      {% if un_element.quartiers is defined and un_element.quartiers is not empty %}
        <p class="card-description aerated">{{ un_element.quartiers|raw|nl2br }}</p>
      {% endif %}

      {% if (un_element.description is defined and un_element.description is not empty)
        or (un_element.locX is defined and un_element.locX is not empty)
        or (un_element.carte is defined and un_element.carte is not empty)
        or (un_element.quartiers is defined and un_element.quartiers is not empty)
      %}
        {{ include('/parts/divider-ornament.html.twig') }}
        {% set ornament = true %}
      {% endif %}

      {% if app.user and is_granted("ROLE_MJ") %}
        {% set redirect, element, un_element, color, action = 'empire', 'lieu', un_element, 'text-accent', 'delete' %}
        {{ include('/parts/btn-line.html.twig', {classes: ornament is defined ? '' : 'mt-5'}) }}
      {% endif %}

    </div>
  </div>

  {% if historique is defined and historique|length > 0 %}
    <div class="col-12">
      <div class="card card-body">
        <h2 class="heading-cardtitle">Historique des visites</h2>
        <hr>
        <div class="card-text">
          {{ include('parts/historique.html.twig', {historique, saison_courante}) }}
        </div>
      </div>
    </div>
  {% endif %}

  {{ include('/parts/picture-grid.html.twig', {
      title: 'Autres Lieux',
      items: autresLieux, route: 'empire_lieu',
      na_image: NA_LIEU,
      force_image: true,
  }) }}

{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('scripts/lieu.js') }}"></script>
{% endblock %}
