{% set variant = variant|default('embedded') %}
{% set worldmap = variant == 'world' %}
{% set minimap = variant == 'mini' %}
{% set draggable = worldmap or draggable|default(false) %}
{% set current = current|default(null) %}
{% set center = current ?? center|default(null) %}
{% set highlight = highlight|default(null) %}
{% set party = party|default({}) %}
{% set wanderers = wanderers|default([]) %}
{% set trail = trail|default([]) %}
{% set recenter = recenter|default(null) %}
{% set zoom = zoom|default(null) %}
{% set territories = territories|default(false) %}
{% set labels = labels|default(false) %}
{% set territories_on = territories or territories_on|default(false) %}
{% set labels_on = worldmap or labels_on|default(false) %}
{% set large_markers = large_markers|default(false) %}
{% set hide_minimap = hide_minimap|default(false) %}
{% set emblem = emblem|default(null) %}
{% set emblem_at = emblem_at|default(center) %}
{% set main_character = navigating_character() %}
{% set main_id = main_character.id ?? null %}
{% set current_color = current.clan.couleur ?? null %}
{% set place_groups = place_groups|default([])|map(g => g|merge({locations: g.locations|filter(l => l.placed)|sort((a, b) => a.nom <=> b.nom)}))|filter(g => g.locations is not empty) %}
{% set players = players|default([]) %}
{% set placed = locations|filter(l => l.placed) %}
{% set current_city = current and current.type in ['Cité', 'Ville'] %}

<div class="map-frame {{ variant }}{% if labels %} labels-shown{% elseif not labels_on %} labels-hidden{% endif %}{% if not worldmap %} d-none d-lg-block{% endif %}{% if large_markers %} large-markers{% endif %}{% if current_city %} current-city{% endif %}{% if draggable %} draggable{% endif %}"
  {% if center %}data-locx="{{ center.locX }}" data-locy="{{ center.locY }}"{% endif %}
  {% if highlight %}data-highlight="{{ highlight.id }}"{% endif %}
  {% if zoom %}data-zoom="{{ zoom }}"{% endif %}
  {% if territories_on %}data-territories{% endif %}
>

  {% if worldmap %}
    <div class="map-search absolute">
      <div class="search-bar map">
        <i class="search-bar-icon fas fa-magnifying-glass" aria-hidden="true"></i>
        <input class="search-bar-input" type="search" placeholder="Chercher un lieu ou un personnage…" aria-label="Chercher un lieu ou un personnage" autocomplete="off" />
        <div class="search-bar-suggestions dropdown-menu dropdown-dark">
          {% for group in place_groups %}
            <div class="search-suggestions-section">
              <h6 class="dropdown-header search-suggestions-heading">
                {% for clan in group.clans|default([]) %}
                  <img class="img-18" src="{{ asset(image_small(clan.mon|default(NA_MON))) }}" alt="" />
                {% endfor %}
                {{ group.title }}
              </h6>
              {% for location in group.locations %}
                <button type="button" class="dropdown-item search-suggestion" data-location="{{ location.id }}" data-locx="{{ location.locX }}" data-locy="{{ location.locY }}">
                  <span class="search-suggestion-label">{{ location.nom }}</span>
                  <small class="search-suggestion-group">{{ location.type }}</small>
                  {{ include('parts/badge-access.html.twig', {state: element_state(location), variant: 'inline'}) }}
                </button>
              {% endfor %}
            </div>
          {% endfor %}
          {% if players is not empty %}
            <div class="search-suggestions-section">
              <h6 class="dropdown-header search-suggestions-heading">Personnages Joueurs</h6>
              {% for player in players|sort((a, b) => a.character.nomComplet <=> b.character.nomComplet) %}
                {% if player.location is null %}
                  {% set position = EN_DEPLACEMENT %}
                {% elseif element_state(player.location) == 'hidden' %}
                  {% set position = 'Lieu inconnu' %}
                {% else %}
                  {% set position = player.location.nom %}
                {% endif %}
                <button type="button" class="dropdown-item search-suggestion"{% if player.location %} data-location="{{ player.location.id }}"{% endif %} data-character="{{ player.character.id }}" data-locx="{{ player.locX }}" data-locy="{{ player.locY }}">
                  <img class="img-24" src="{{ asset(player.character.icone|default(NA_PERSO_PORTRAIT)) }}" alt="" />
                  <span class="search-suggestion-label">{{ player.character.nomComplet }}</span>
                  <small class="search-suggestion-group">{{ position }}</small>
                </button>
              {% endfor %}
            </div>
          {% endif %}
          <span class="dropdown-item-text search-suggestion-empty" hidden>Aucun résultat</span>
        </div>
      </div>
    </div>

    <aside class="map-panel absolute" hidden>
      <button type="button" class="map-panel-close" aria-label="Fermer le panneau">
        <i class="fas fa-xmark"></i>
      </button>
      <div class="map-panel-content"></div>
    </aside>
  {% endif %}

  {% if not minimap and (worldmap or not labels or not territories) %}
    <div class="map-controls absolute">
      {% if worldmap %}
        <button type="button" class="map-toggle-btn map-controls-toggle" aria-expanded="false" aria-label="Options de la carte">
          <i class="fa-solid fa-sliders"></i>
        </button>

        <button type="button" class="map-toggle-btn" data-map-toggle="fullscreen" aria-pressed="false">
          <i class="fa-solid fa-expand icon-off"></i>
          <i class="fa-solid fa-compress icon-on"></i>
          <span class="label">Plein écran</span>
        </button>
      {% endif %}

      {% if not labels %}
        <button type="button" class="map-toggle-btn{% if labels_on %} active{% endif %}" data-map-toggle="labels" aria-pressed="{{ labels_on ? 'true' : 'false' }}">
          <i class="fa-solid fa-torii-gate"></i>
          <span class="label">Lieux</span>
        </button>
      {% endif %}

      {% if not territories %}
        <button type="button" class="map-toggle-btn{% if territories_on %} active{% endif %}" data-map-toggle="territories" aria-pressed="{{ territories_on ? 'true' : 'false' }}">
          <i class="fa-solid fa-map"></i>
          <span class="label">Territoires</span>
        </button>
      {% endif %}

      {% if worldmap %}
        <button type="button" class="map-toggle-btn active" data-map-toggle="party" aria-pressed="true">
          <i class="fa-solid fa-users"></i>
          <span class="label">Personnages</span>
        </button>

        <button type="button" class="map-toggle-btn" data-map-route-toggle aria-expanded="false" aria-controls="map-route">
          <i class="fa-solid fa-route"></i>
          <span class="label">Calcul itinéraire</span>
        </button>

        <form id="map-route" class="map-route" hidden>
          {% for field in [{name: 'from', label: 'Départ'}, {name: 'to', label: 'Arrivée'}] %}
            <label class="map-route-field">
              <span>{{ field.label }}</span>
              <select name="{{ field.name }}">
                <option value="">Choisir un lieu</option>
                {% if field.name == 'from' and recenter %}
                  <option value="personnage" data-locx="{{ recenter.locX }}" data-locy="{{ recenter.locY }}" selected>Position de mon personnage</option>
                {% endif %}
                {% for group in place_groups %}
                  <optgroup label="{{ group.title }}">
                    {% for location in group.locations %}
                      <option value="{{ location.id }}" data-locx="{{ location.locX }}" data-locy="{{ location.locY }}">{{ location.nom }}</option>
                    {% endfor %}
                  </optgroup>
                {% endfor %}
              </select>
            </label>
          {% endfor %}
          <button type="submit" class="map-toggle-btn map-route-submit">Calculer</button>
          <p class="map-route-result" aria-live="polite"></p>
        </form>
      {% endif %}
    </div>
  {% endif %}

  {% if worldmap %}
    <div class="map-zoom absolute">
      <span class="map-zoom-level" aria-live="polite" title="Niveau de zoom"></span>
      <button type="button" class="map-toggle-btn" data-map-zoom="in" aria-label="Zoomer">
        <i class="fa-solid fa-plus"></i>
      </button>
      <button type="button" class="map-toggle-btn" data-map-zoom="out" aria-label="Dézoomer">
        <i class="fa-solid fa-minus"></i>
      </button>
      {% if recenter %}
        <button type="button" class="map-toggle-btn" data-map-recenter data-locx="{{ recenter.locX }}" data-locy="{{ recenter.locY }}" aria-label="Recentrer sur mon personnage" title="Recentrer sur mon personnage">
          <i class="fa-solid fa-crosshairs"></i>
        </button>
      {% endif %}
    </div>
  {% endif %}

  <div class="map-drag"{% if center %} style="transform: scale({{ zoom ?? 1 }}) translate(-{{ center.locX }}%, -{{ center.locY }}%);"{% endif %}>

    <img class="map-image" src="{{ asset('assets/maps/map-rokugan-' ~ (territories_on ? 'frontiers' : 'clean') ~ '.jpg') }}" alt="Carte de Rokugan" draggable="false"
         data-clean="{{ asset('assets/maps/map-rokugan-clean.jpg') }}"
         data-frontier="{{ asset('assets/maps/map-rokugan-frontiers.jpg') }}"
         data-clean-hd="{{ asset('assets/maps/map-rokugan-clean-zoomed.jpg') }}"
         data-frontier-hd="{{ asset('assets/maps/map-rokugan-frontiers-zoomed.jpg') }}" />

    {% if worldmap %}
      <svg class="map-route-line" aria-hidden="true"><line /></svg>
    {% endif %}

    {% if trail|length > 1 %}
      <svg class="map-trail" aria-hidden="true">
        {% for location in trail|slice(1) %}
          {% set next = trail[loop.index0] %}
          <line x1="{{ location.locX }}%" y1="{{ location.locY }}%" x2="{{ next.locX }}%" y2="{{ next.locY }}%" />
        {% endfor %}
      </svg>
    {% endif %}

    {% for other in placed %}
      {% if current is null or other.id != current.id %}
        {% set other_state = element_state(other) %}
        {% set other_secret = other_state == 'hidden' %}
        {% set other_size = other_secret ? '' : {'Cité': ' city', 'Ville': ' city', 'Région': ' region', 'Temple': ' temple'}[other.type] ?? '' %}
        {% set other_color = other_secret ? null : other.clan.couleur ?? null %}
        <a {% if other_secret %}aria-disabled="true"{% else %}href="{{ path('world_location', {id: other.id}) }}"{% if worldmap %} data-panel="{{ path('map_location', {id: other.id}) }}"{% endif %}{% endif %}
           class="absolute other-location-marker{{ other_size }}" data-location="{{ other.id }}"
           style="left:{{other.locX}}%; top:{{other.locY}}%;{% if other_color %} --clan-color: {{other_color}};{% endif %}">
          {% if other_secret %}
            <span class="other-location-unknown">?</span>
            {{ include('parts/map-label.html.twig', {name: 'Inconnu', variant: 'compact'}) }}
          {% else %}
            <img class="location-marker-icon" src="{{ asset(other.icone|default(NA_LIEU_ICO)) }}" alt="Icone de {{ other.nom }}" />
            {{ include('parts/map-label.html.twig', {
              name: other.nom,
              mon: other.clan.mon ?? null,
              details: [other.type, other.clan.nom ?? null, other_state == 'secret' ? 'Secret' : null],
              state: other_state,
              variant: 'compact',
            }) }}
          {% endif %}
          {% if element_fresh(other) %}{{ include('parts/badge-new.html.twig', {variant: 'pin-downcenter'}) }}{% endif %}
        </a>

        {% if party[other.id] is defined %}
          <div class="map-party absolute{{ other_size }}" style="left:{{other.locX}}%; top:{{other.locY}}%;">
            {% for character in party[other.id] %}
              {{ include('parts/map-portrait.html.twig', {character, mine: character.id == main_id, interactive: worldmap}, with_context = false) }}
            {% endfor %}
          </div>
        {% endif %}
      {% endif %}
    {% endfor %}

    {% for wanderer in wanderers %}
      <div class="map-party wanderer absolute" style="left:{{wanderer.locX}}%; top:{{wanderer.locY}}%;">
        {{ include('parts/map-portrait.html.twig', {
          character: wanderer.character,
          mine: wanderer.character.id == main_id,
          title: wanderer.character.nomComplet ~ ' — ' ~ EN_DEPLACEMENT,
          interactive: worldmap,
        }, with_context = false) }}
      </div>
    {% endfor %}

    {% if emblem and emblem_at %}
      <img class="absolute map-emblem" style="left:{{emblem_at.locX}}%; top:{{emblem_at.locY}}%" src="{{ asset(emblem) }}" alt="" />
    {% endif %}

    {% if current %}
      <img class="absolute location-pulse-icon" style="left:{{current.locX}}%; top:{{current.locY}}%" src="{{ asset(current.icone|default(NA_LIEU_ICO)) }}" alt="Icone de {{current.nom}}" />

      <div class="absolute location-current-label" style="left:{{current.locX}}%; top:{{current.locY}}%">Lieu actuel</div>

      {{ include('parts/map-label.html.twig', {
        name: current.nom,
        mon: current.clan.mon ?? null,
        details: [current.type, current.clan.nom ?? null],
        variant: 'absolute current',
        style: 'left:' ~ current.locX ~ '%; top:' ~ current.locY ~ '%;' ~ (current_color ? ' --clan-color: ' ~ current_color ~ ';' : ''),
      }) }}

      {% if party[current.id] is defined %}
        <div class="map-party current absolute" style="left:{{current.locX}}%; top:{{current.locY}}%;">
          {% for character in party[current.id] %}
            {{ include('parts/map-portrait.html.twig', {character, mine: character.id == main_id, interactive: worldmap}, with_context = false) }}
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}

  </div>

  {% if not hide_minimap %}
    <div class="minimap absolute">
      <div class="relative overflow-hidden">
        {% if current %}
          <img class="absolute locator-ui" style="left:{{current.locX}}%; top:{{current.locY}}%" src="{{asset('assets/maps/mini-localisator.png')}}" alt="" />
        {% else %}
          <span class="absolute minimap-view"></span>
        {% endif %}
        <img class="img-fluid" src="{{asset('assets/maps/map-rokugan-frontiers-mini.jpg')}}" alt="Carte de Rokugan">
      </div>
    </div>
  {% endif %}

</div>
