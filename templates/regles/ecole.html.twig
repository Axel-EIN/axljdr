{% extends 'element.html.twig' %}

{% block stylesheets %}
    {{parent()}}
    <link rel="stylesheet" href="{{asset('css/components/other-elements-grid.css')}}" />
    <link rel="stylesheet" href="{{asset('css/pages/ecole.css')}}" />
{% endblock %}

{% block element_content %}

    <!-- BANNER INTRO -->
    <section class="col-12 py-1 px-lg-1">
        <card class="card">

            <!-- CONTAINER IMAGE -->
            <div class="relative">

                <!-- MON -->
                <a id="banner-icon-clan" class="hover-zoom" href="{{ path('empire_clan', {id:ecole.clan.id} ) }}" >
                    <img class="img-96 filter-shadow" src="{{ asset(ecole.clan.mon|default(NA_MON)) }}" alt="Mon d'une faction" title="Voir la faction {{ecole.clan.nom}}" />
                </a>

                <!-- IMAGE -->
                <div class="gradient-after-down">
                    <img class="img-fluid" src="{{ asset(ecole.image|default('assets/placeholders/na_school_' ~ ecole.classe.nom|lower ~ '.jpg')) }}" alt="Image de l'École"  />
                </div>

                {# Place APRES l'image : sur mobile la zone repasse dans le flux
                   et se retrouve donc empilee sous l'image. Sur desktop elle est
                   en absolute (pages/ecole.css), l'ordre du DOM n'y change rien.
                   Pas de text-white sur les titres : ils doivent rester lisibles
                   sur le fond clair de la carte une fois sous l'image. #}
                <text id="text-zone" class="col-12 col-lg-10 row p-0 m-0 mb-0 mb-lg-3 justify-content-end" >

                    <div class="col-12 col-lg-4 m-0 card-description px-lg-0 py-lg-0 on-top">
                        <h2 class="element-card-title">Trait bonus</h2>
                        {% set labels = {'constitution':'Constitution','volonte':'Volonté','reflexes':'Réflexes','intuition':'Intuition','agilite':'Agilité','intelligence':'Intelligence','forceStat':'Force','perception':'Perception','vide':'Vide'} %}
                        <span class="text-zone-blur text-xp text-big" style="margin-left: 2rem;">{{ ecole.bonusStatNom ? (labels[ecole.bonusStatNom] ?? ecole.bonusStatNom) ~ ' +1' : '—' }}</span>
                    </div>

                    <div class="col-12 col-lg-4 m-0 card-description px-lg-0 py-lg-0 on-top">
                        <h2 class="element-card-title">Compétences</h2>
                        <p class="text-zone-blur mt-2 ml-lg-4"><ul>{{ ecole.competences|lister|raw }}</ul></p>
                    </div>

                    <div class="col-12 col-lg-4 m-0 card-description px-lg-0 py-lg-0 on-top">
                        <h2 class="element-card-title">Équipement</h2>
                        <p class="text-zone-blur mt-2 ml-lg-4"><ul>{{ ecole.equipements|lister|raw }}</ul></p>
                    </div>

                </text>

            </div>

            <!-- DESCRIPTION -->
            <div class="card-body"><p class="card-description text-justify px-lg-5 py-lg-3 m-0 m-lg-3 mb-lg-5 text-medium">{{ ecole.description|raw|nl2br }}</p></div>

        </card>
    </section>

    {% if ecole.personnages|length > 0 %}
        {% set col = 'col-12 col-lg-8' %}
    {% else %}
        {% set col = 'col-12' %}
    {% endif %}

    <div class="col-12 p-0 m-0 row">
        <div class="{{col}} p-0 m-0 row">

            <!-- TECHNIQUES -->
            <section class="col-12 py-1 px-0 px-lg-1 m-0">
                <div class="card card-body h-100">
                    <h2 class="element-card-title">Techniques</h2>
                    <hr>

                    {% for i in 1..5 %}
                        {% if attribute(ecole, 'tech' ~ i ~ 'Nom') is not empty %}
                            <div class="card-text row p-0 my-3 mx-0">
                                <div class="tech-rang col-12 col-lg-2 text-center" style="color: {{ ecole.clan.couleur }}">
                                    <strong>Rang</strong><br/>
                                    <span class="number-skillrank-effect skill-rank-number" >{{ i }}</span>
                                </div>
                                <div class="col-12 col-lg-10 ml-lg-n2">
                                    <h3 class="card-sub-title mb-2">{{ attribute(ecole, 'tech' ~ i ~ 'Nom')|upper }}</h3>
                                    <p class="text-justify text-regular">{{ attribute(ecole, 'tech' ~ i ~ 'Desc')|raw|nl2br }}</p>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}

                    {% if ecole.techSpecialNom is not empty %}
                        <h3 class="card-sub-title mx-3 mb-2">{{ ecole.techSpecialNom|upper }}</h3>
                        <p class="mx-3 text-justify text-medium">{{ ecole.techSpecialDesc|raw|nl2br }}</p>
                    {% endif %}

                </div>
            </section>

            {% if ecole.sorts is defined and ecole.sorts is not empty %}
            <!-- MAGIE -->
            <section class="col-12 py-1 px-0 px-lg-1 m-0">
                <div class="card card-body h-100">
                    <h2 class="element-card-title">Magie</h2>
                    <hr>

                    <div class="d-flex justify-content-around align-items-start">
                        <div>
                            <h4>Affinité</h4>
                            <span class="text-xp text-large">{{ecole.affinite}}</span>
                        </div>
                        <div>
                            <h4>Déficience</h4>
                            <span class="text-dead text-large">{{ecole.deficience}}</span>
                        </div>
                        <div>
                            <h4>Sorts de départ</h4>
                            {{ecole.sorts|lister|raw}}
                        </div>
                    </div>

                </div>
            </section>
            {% endif %}

        </div>

        <!-- PERSONNAGES -->
        <aside class="col-12 col-lg-4 px-0 px-lg-1">
            {{ include('parts/other-character-grid.html.twig', {
                titre: 'Personnages',
                personnages: ecole.personnages,
                vide_message: "Il n'y a pas encore de personnages dans cette école.",
            }) }}
        </aside>

    </div>

    {% if autresEcoles is defined and autresEcoles is not empty %}
    <!-- AUTRES ECOLES DU CLAN -->
    <aside class="col-12 py-1 px-lg-1">
        <div class="card card-body h-100 pb-1">
            <h2 class="element-card-title">Autres Écoles</h2>
            <hr>
            <div class="row vignette-grid p-0 m-lg-0 pt-2">
                {% set col, size, na_image, ratio = 'col-6 col-md-4 col-lg-2', 'small', NA_43, '43' %}
                {% for un_element in autresEcoles %}
                    {{ include('/parts/element-vignette.html.twig', {un_element}) }}
                {% endfor %}
            </div>
        </div>
    </aside>
    {% endif %}

{% endblock %}
