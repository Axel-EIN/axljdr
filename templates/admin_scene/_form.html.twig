<main class="col-12">
    {{ form_start(form, {'attr': {'id': 'form1'}}) }}
        <div class="row form-wrapper">
            <div class="col-3">{{ form_row(form.titre) }}</div>
            <div class="col-3">{{ form_row(form.episodeParent) }}</div>
            <div class="col-3">{{ form_row(form.lieu) }}</div>
            <div class="col-2">{{ form_row(form.temps) }}</div>
            <div class="col-1">{{ form_row(form.numero) }}</div>

            <div class="col-12">{{ form_row(form.texte,{ 'attr': {'rows': '15'} }) }}</div>

            <!-- IMAGE -->
            <div class="offset-2 col-8 mt-3 mb-5">
                {{ form_label(form.image, 'Image (1280×720 16:9 recommandé)') }}
                <label for="admin_scene_image" class="preview-label hover-slight-fade hover-pointer hover-icon-visible">
                    <icon class="btn-icon-medium right-corner-16"><i class="fas fa-edit semi-visible text-white"></i></icon>
                    <img id="image-preview" class="img-fluid border-soft" src="{{ asset(scene.image|default(NA_SCENE)) }}" />
                    <span id="image-filename" class="filename"></span>
                </label>
                <div class="browser">{{form_widget(form.image, {'attr': {'class': 'input-image'}}) }}</div>

                {{ include('parts/image-cropper.html.twig', {input_id: 'admin_scene_image', width: 1280, height: 720}) }}
                {{ include('parts/image-delete-button.html.twig', {input_id: 'admin_scene_image', field_name: 'image', current: scene.image|default(null)}) }}
            </div>

            {# Macro : rend les options d'un <select> personnage, groupées par clan via <optgroup>.
               Les listes tout_pjs / tout_pnjs sont déjà triées (clan puis nom) côté repository,
               donc on peut se contenter de regarder la valeur précédente pour ouvrir/fermer les groupes. #}
            {% macro perso_options(personnages, selected_id) %}
                {% set current_clan = '__init__' %}
                {% for p in personnages %}
                    {% set clan_nom = p.clan ? p.clan.nom : 'Sans clan' %}
                    {% if clan_nom != current_clan %}
                        {% if current_clan != '__init__' %}</optgroup>{% endif %}
                        <optgroup label="{{ clan_nom }}">
                        {% set current_clan = clan_nom %}
                    {% endif %}
                    <option value="{{ p.id }}" {% if selected_id is not null and p.id == selected_id %}selected{% endif %}>
                        {{ p.nom }} {{ p.prenom }}
                    </option>
                {% endfor %}
                {% if current_clan != '__init__' %}</optgroup>{% endif %}
            {% endmacro %}
            {% import _self as macros %}

            <div class="col-12">
                Participants (facultatif) :<br/>
                <div class="form-row">

                    <!-- PARTICIPATION PJs -->
                    <div class="col-6 text-center">
                        <div class="d-flex">
                            <small class="ml-1">bonus x2</small>
                            <small class="ml-auto mr-3">XP gagné / mort</small>
                        </div>
                        {% if type != 'Créer' and participations_pjs is not empty %}
                            {% for une_participation in participations_pjs %}
                                {% set nbr_pjs = loop.index0 %}
                                <div class="participants form-row">
                                    <input class="mt-1 col-1" type="checkbox" title="Bonus XP x2 (rattrapage)" name="participants_xpBonus[{{ nbr_pjs }}]" id="data[participants_xpBonus][{{ nbr_pjs }}]" {% if une_participation.xpBonus %}checked{% endif %} />
                                    <select class="form-control mt-1 ml-1 col-7" name="participants[{{ nbr_pjs }}]" required id="data[participants][{{ nbr_pjs }}]">
                                        {{ macros.perso_options(tout_pjs, une_participation.personnage.id) }}
                                    </select>
                                    <input class="form-control ml-1 mt-1 col-2" type="number" value="{{ une_participation.xpGagne }}" name="participants_xp[{{ nbr_pjs }}]" id="data[participants_xp][{{ nbr_pjs }}]" />
                                    <input class="mt-1 ml-1 col-1" type="checkbox" title="Mort" name="participants_mort[{{ nbr_pjs }}]" id="data[participants_mort][{{ nbr_pjs }}]" {% if une_participation.estMort %}checked{% endif %} />
                                </div>
                            {% endfor %}
                        {% endif %}
                        <button type="button" class="btn btn-medium btn-secondary-style mt-3" id="add-participants">Ajouter un PJ</button>
                    </div>

                    <!-- PARTICIPATION PNJs -->
                    <div class="col-6 text-center">
                        <div class="text-right"><small class="mr-4">Mort</small></div>
                        {% if type != 'Créer' and participations_pnjs is not empty %}
                            {% for une_participation_pnj in participations_pnjs %}
                                {% set nbr_pnjs = loop.index0 %}
                                <div class="participants_pnjs form-row">
                                    <select class="form-control mt-1 col-10" name="participants_pnjs[{{ nbr_pnjs }}]" required id="data[participants_pnjs][{{ nbr_pnjs }}]">
                                        {{ macros.perso_options(tout_pnjs, une_participation_pnj.personnage.id) }}
                                    </select>
                                    <input class="mt-1 ml-1 col-1" type="checkbox" name="participants_pnjs_mort[{{ nbr_pnjs }}]" id="data[participants_pnjs_mort][{{ nbr_pnjs }}]" {% if une_participation_pnj.estMort %}checked{% endif %} />
                                </div>
                            {% endfor %}
                        {% endif %}
                        <button type="button" class="btn btn-medium btn-secondary-style mt-3" id="add-participants_pnjs">Ajouter un PNJ</button>
                    </div>

                </div>
            </div>

            {{ include('/parts/btn-form.html.twig') }}
        </div>
    {{ form_end(form) }}
</main>

<script type="text/javascript">
    {# Données personnages exposées via JSON pour éviter les soucis d'échappement
       (un nom contenant un guillemet ou un caractère spécial cassait le parsing JS
       — c'était notamment la cause du rendu illisible sous Firefox Windows). #}
    {% set pjs_data = [] %}
    {% for p in tout_pjs %}
        {% set pjs_data = pjs_data|merge([{
            id: p.id, nom: p.nom, prenom: p.prenom,
            clan: p.clan ? p.clan.nom : 'Sans clan'
        }]) %}
    {% endfor %}
    {% set pnjs_data = [] %}
    {% for p in tout_pnjs %}
        {% set pnjs_data = pnjs_data|merge([{
            id: p.id, nom: p.nom, prenom: p.prenom,
            clan: p.clan ? p.clan.nom : 'Sans clan'
        }]) %}
    {% endfor %}
    const pjs  = {{ pjs_data|json_encode|raw }};
    const pnjs = {{ pnjs_data|json_encode|raw }};

    document.addEventListener('DOMContentLoaded', function() {

        // Construit la liste d'options regroupées par clan via <optgroup>.
        // Les données sont déjà triées (clan puis nom) côté backend, donc on peut
        // se contenter de comparer au clan précédent pour ouvrir/fermer un groupe.
        function buildOptionsHtml(list) {
            let html = '';
            let currentClan = null;
            list.forEach(p => {
                if (p.clan !== currentClan) {
                    if (currentClan !== null) html += '</optgroup>';
                    html += '<optgroup label="' + escapeHtml(p.clan) + '">';
                    currentClan = p.clan;
                }
                html += '<option value="' + p.id + '">' + escapeHtml(p.nom + ' ' + p.prenom) + '</option>';
            });
            if (currentClan !== null) html += '</optgroup>';
            return html;
        }

        function escapeHtml(s) {
            return String(s)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        // Factorise les boutons Ajouter/Retirer PJ et PNJ. `kind` = 'pj' | 'pnj' :
        // chacun a son row class, son select markup, ses inputs annexes (XP/mort vs mort seul).
        function setupParticipantSection(opts) {
            const $form = $('#form1');
            const $addBtn = $('#' + opts.addBtnId);

            function rebuildRemoveButton() {
                $form.find('.' + opts.removeBtnClass).remove();
                if ($form.find('div.' + opts.rowClass).length > 0) {
                    $addBtn.after(' <button type="button" class="' + opts.removeBtnClass
                        + ' btn mt-1 ml-2 btn-tertiary-style">Retirer</button>');
                }
            }
            rebuildRemoveButton();

            $addBtn.click(function(e) {
                e.preventDefault();
                const n = $form.find("select[name^='" + opts.selectNamePrefix + "[']").length;
                const optionsHtml = buildOptionsHtml(opts.data);
                const selectHtml = '<select class="' + opts.selectClass
                    + '" name="' + opts.selectNamePrefix + '[' + n + ']" required '
                    + 'id="data[' + opts.selectNamePrefix + '][' + n + ']">'
                    + optionsHtml
                    + '</select>';
                const prefix = opts.prefixInputs ? opts.prefixInputs(n) : '';
                const html = '<div class="' + opts.rowClass + ' form-row">'
                    + prefix + selectHtml + opts.extraInputs(n) + '</div>';
                $addBtn.before(html);
                rebuildRemoveButton();
            });

            $(document).on('click', '.' + opts.removeBtnClass, function(e) {
                e.preventDefault();
                $form.find('div.' + opts.rowClass).last().remove();
                rebuildRemoveButton();
            });
        }

        setupParticipantSection({
            data:              pjs,
            addBtnId:          'add-participants',
            removeBtnClass:    'remove-participants',
            rowClass:          'participants',
            selectNamePrefix:  'participants',
            selectClass:       'form-control mt-1 ml-1 col-7',
            prefixInputs: function(n) {
                return '<input class="mt-1 col-1" type="checkbox" title="Bonus XP x2 (rattrapage)" name="participants_xpBonus[' + n + ']"'
                     + ' id="data[participants_xpBonus][' + n + ']" />';
            },
            extraInputs: function(n) {
                return '<input class="form-control ml-1 mt-1 col-2" type="number" name="participants_xp[' + n + ']"'
                     + ' value="0" id="data[participants_xp][' + n + ']" />'
                     + '<input class="mt-1 ml-1 col-1" type="checkbox" title="Mort" name="participants_mort[' + n + ']"'
                     + ' id="data[participants_mort][' + n + ']" />';
            }
        });

        setupParticipantSection({
            data:              pnjs,
            addBtnId:          'add-participants_pnjs',
            removeBtnClass:    'remove-participants_pnjs',
            rowClass:          'participants_pnjs',
            selectNamePrefix:  'participants_pnjs',
            selectClass:       'form-control mt-1 col-10',
            extraInputs: function(n) {
                return '<input class="mt-1 ml-1 col-1" type="checkbox" name="participants_pnjs_mort[' + n + ']"'
                     + ' id="data[participants_pnjs_mort][' + n + ']" />';
            }
        });

    });
</script>
