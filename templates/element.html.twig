{% extends 'base.html.twig' %}
{% block title %}{{ entity == 'sheet' ? 'Fiche de Jeu : ' ~ nom : ENTITY_LABELS[entity]|default(entity|capitalize) ~ ' ' ~ nom }} {{parent()}} {% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{asset('css/components/element.css')}}" />
  <link rel="stylesheet" href="{{asset('css/components/picture-grid.css')}}" />
{% endblock %}

{% block body %}
  <main class="container-fluid element-page">
    <div class="container relative">

      {% set category_label = {world: 'Univers', story: 'Aventure', rules: 'Règles', characters: 'Personnages'}[category] ?? category|capitalize %}
      {% if category == 'characters' and entity == 'sheet' %}
        {% set fil = [
          { label: category_label, path: path(category) },
          { label: nom, path: path('characters_profile', {id: fiche.personnage.id}) },
          { label: 'Fiche de Jeu' },
        ] %}
      {% else %}
        {% set fil = [
          { label: category_label, path: path(category, {'_fragment': entity}) },
          { label: nom },
        ] %}
      {% endif %}
      {{ include('parts/breadcrumbs.html.twig', {items: fil}) }}

      {{ include('parts/flash-messages.html.twig') }}

      <section>

        <h1 class="heading-elementdetail relative">
          {% if category == 'characters' and entity == 'sheet' %}
            <strong>Fiche de Jeu : {{ nom }}</strong>
          {% else %}
            <strong>{{ nom }}</strong>
          {% endif %}

          {% if is_mj() %}
            {% set redirect, size, color, position = entity, 'btn-icon-medium', 'link-gm', 'topright-corner-snap' %}
            {{ include('/btns/btn-icon-edit.html.twig') }}
          {% endif %}
        </h1>
        <hr class="hr-title">

        <article class="row">
          {% block element_content %}{% endblock %}            
        </article>
      </section>
    </div>
  </main>
{% endblock %}
