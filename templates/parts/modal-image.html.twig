<div class="modal fade" id="{{ id }}" tabindex="-1" aria-labelledby="{{ id }}-titre" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content bg-clouds">
      <div class="modal-header">
        <h5 class="modal-title heading-present compact" id="{{ id }}-titre">{{ titre }}</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <img class="img-fluid d-block mx-auto" src="{{ asset(image) }}" loading="lazy" alt="{{ alt|default(titre) }}" />
      </div>
    </div>
  </div>
</div>
