{% extends 'base.html.twig' %}

{% block title %}Contactez-Nous {{ parent() }}{% endblock %}

{% block body %}

<main class="container-fluid">
    <section class="container">

        {{ include('parts/breadcrumbs.html.twig', {items: [{label: "Contactez-Nous"}]}) }}

        <h1 class="pt-3 mb-3">
            <strong>Contactez-l'Administrateur</strong>
        </h1>

        <p>Vous pouvez également nous contacter via le formulaire suivant.</p>

        {% if notif is not empty %}
            <div class="alert alert-success" role="alert">
                {{ notif }}
            </div>
        {% endif %}

        {{ form(formulaire) }}

    </section>
</main>

{% endblock %}
