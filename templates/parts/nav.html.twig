{% set compact = compact|default(false) %}
{% set with_search = not compact %}
{% set control_panel = null %}
{% if app.user and is_granted('ROLE_ADMIN') %}
  {% set control_panel = {variant: 'admin', icon: 'fa-tools', label: "Panneau d'Administration"} %}
{% elseif is_gm() %}
  {% set control_panel = {variant: 'gm', icon: 'fa-scroll', label: 'Panneau du Maître'} %}
{% endif %}

{% if control_panel and not compact %}
  <div class="control-panel-bar {{ control_panel.variant }}">
    <a href="{{ path('back_office') }}">
      <i class="fas {{ control_panel.icon }}"></i>
      &nbsp;&nbsp;
      {{ control_panel.label }}
    </a>
  </div>
{% endif %}

{% set nav_sections = [
  { label: 'ACCUEIL',      route: 'news',       active_routes: ['news'] },
  { label: 'AVENTURE',    route: 'story',       active_routes: ['story', 'story_season', 'story_episode'] },
  { label: 'PERSONNAGES', route: 'characters',  active_routes: ['characters', 'characters_profile', 'characters_sheet', 'characters_sheet_edit'] },
  { label: 'UNIVERS',      route: 'world',      active_routes: ['world', 'world_clan', 'world_archive', 'world_location', 'world_lore'] },
  { label: 'RÈGLES',      route: 'rules',       active_routes: ['rules', 'rules_rule', 'rules_library', 'rules_object', 'rules_class', 'rules_dojo'] },
  { label: 'CARTE',       route: 'map',         active_routes: ['map'] },
] %}
{% set current_route = app.request.get('_route') %}
{% set active_section = nav_sections|filter(s => current_route in s.active_routes)|first %}

<header class="container-fluid navigation-bar{% if compact %} compact{% endif %}">
  <div class="container">
    <nav class="navbar navbar-expand-lg">

      <a id="logo" class="navbar-brand hover-shine" href="{{ path('news') }}">
        <img  class="img-fluid" src="{{ asset(LOGO) }}" alt="Logo AXL-JDR" title="Retour à l'Accueil" />
      </a>

      <div class="nav-mobile-menu dropdown{{ compact ? '' : ' d-lg-none' }}">
        <button
          class="nav-link nav-mobile-toggle-full chevron-toggle{% if active_section %} active{% endif %}" type="button"
          data-toggle="dropdown" aria-expanded="false" aria-label="Ouvrir le menu des sections"
        >
          {{ active_section.label|default('MENU') }}
          <i class="fas fa-chevron-down"></i>
        </button>

        <div class="dropdown-menu dropdown-dark">
          {% for section in nav_sections %}
            <a class="dropdown-item{% if current_route in section.active_routes %} active{% endif %}" href="{{ path(section.route) }}">{{ section.label }}</a>
          {% endfor %}
        </div>
      </div>

      {% if with_search %}
        <button
          class="search-toggle d-lg-none" type="button"
          data-toggle="collapse" data-target="#search-mobile" aria-controls="search-mobile" aria-expanded="false" aria-label="Ouvrir la recherche"
        >
          <i class="fas fa-magnifying-glass"></i>
        </button>
      {% endif %}

      <div class="navbar-collapse d-lg-flex {{ compact ? 'justify-content-lg-end' : 'justify-content-lg-between' }} align-items-lg-center w-100" id="navbarNav">

        <ul class="navbar-nav d-none{{ compact ? '' : ' d-lg-flex' }}">
          {% for section in nav_sections %}
            <li class="nav-item">
              <a  href="{{ path(section.route) }}"
                  class="nav-link{% if current_route in section.active_routes %} active{% endif %}"
              >
                {{ section.label }}
              </a>
            </li>
          {% endfor %}
        </ul>

        {% if with_search %}
          {{ include('parts/search-bar.html.twig', {variant: 'd-none d-lg-flex ml-auto mr-4'}) }}
        {% endif %}

        {% if app.user %}
          {% set main_character = navigating_character() %}
          <div id="user-zone" class="connected">

            <div class="user-infos">
              <strong>{{ app.user.pseudo }}</strong>

              {% if main_character %}
                <a class="main-character" href="{{ path('characters_profile', {id: main_character.id}) }}">
                  <img class="img-24" src="{{ asset(image_small(main_character.clan ? main_character.clan.mon|default(NA_MON) : NA_MON)) }}" alt="Mon du clan" />
                  ({{ main_character.nomComplet }})
                </a>
              {% endif %}

              <a class="{% if current_route starts with 'account' %}active{% endif %}" href="{{ path('account') }}">
                <i class="fas fa-torii-gate"></i>
                &nbsp;&nbsp;
                MON COMPTE
              </a>

              <small>
                <a href="{{ path('app_logout') }}">Se Déconnecter</a>
              </small>
            </div>

            <a class="avatar-link hover-shine" href="{{ path('account') }}">
              {{ include('parts/avatar.html.twig', {user: app.user, character: true, size: compact ? 48 : 96}) }}
            </a>

          </div>
        {% else %}
          <div id="user-zone" class="disconnected">
            {% if compact %}
              <a href="#login-modal" data-toggle="modal" role="button">Se connecter</a>
            {% else %}
              <button class="btn-primary-style btn-medium" data-toggle="modal" data-target="#login-modal">Se connecter</button>
              <a class="mt-1" href="{{ path('app_register') }}">Créer un compte</a>
            {% endif %}
          </div>
        {% endif %}

        {% if control_panel and compact %}
          <a class="control-panel-bar icon {{ control_panel.variant }}" href="{{ path('back_office') }}" title="{{ control_panel.label }}" aria-label="{{ control_panel.label }}">
            <i class="fas {{ control_panel.icon }}"></i>
          </a>
        {% endif %}
      </div>
    </nav>

    {% if with_search %}
      <div id="search-mobile" class="search-collapse collapse d-lg-none">
        {{ include('parts/search-bar.html.twig', {variant: 'mobile'}) }}
      </div>
    {% endif %}
  </div>
</header>
