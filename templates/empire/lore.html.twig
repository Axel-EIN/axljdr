{% extends 'element.html.twig' %}

{% block stylesheets %}
  {{parent()}}
  <link rel="stylesheet" href="{{asset('css/components/rule-lore-part.css')}}" />
{% endblock %}

{% block element_content %}

  <div class="col-12">
    <div class="card card-page">

      <div class="relative">

        {{ include('rule-lore-library/summary.html.twig', {un_element}) }}

        {{ include('/parts/card-top-image.html.twig', {
          image: un_element.image,
          na_image: NA_LORE,
          alt: 'Image de ' ~ nom,
          pdf: un_element.pdf,
          state: element_state(un_element),
          pdf_button: un_element.hasParts,
          img_class: 'crop-169',
          titre: nom,
        }) }}
      </div>

      {{ include('rule-lore-library/parts.html.twig', {un_element, entity: 'lore'}) }}

    </div>
  </div>

  {{ include('/parts/picture-grid.html.twig', {
      title: 'Autres Lores',
      items: autresLores, route: 'empire_lore',
      na_image: NA_LORE,
  }) }}

{% endblock %}
