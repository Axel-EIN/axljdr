{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{asset('css/components/category.css')}}" />
{% endblock %}

{% block body %}

    <header class="header-bg-img header-bg-{{header_classname}}">
        <div class="container">
            <div class="header d-flex flex-column justify-content-center align-items-center">
                <div class="text-center d-flex justify-content-center">
                    <strong class="h1 text-white">
                        {{header_up}}
                    </strong>
                </div>
                <hr class="w-50">
                {% set has_long_word = false %}
                {% for mot in header_down|split(' ') %}
                    {% if mot|length > 9 %}{% set has_long_word = true %}{% endif %}
                {% endfor %}
                <h1 class="heading-category{% if has_long_word %} reduced{% endif %}">
                    {{header_down|relief|raw}}
                </h1>
            </div>
        </div>
    </header>

    <main class="container-fluid category-page">
        <div class="container">

            {# Contenu optionnel place avant le titre de la premiere section
               (filtres de la rubrique Personnages). Vide ailleurs. #}
            {% block content_top %}{% endblock %}

            {% set compteur = 1 %}
            {% for une_section in sections %}
                {% set entity, label_one = une_section['entity'], une_section['label_one'] %}

                <section id="{{une_section['entity']}}">

                    <div class="relative">
                        <h2 class="heading-categorysubsection">
                            <span class="small-word">{{une_section['titleLight']}}</span><strong>{{une_section['titleStrong']}}</strong>
                        </h2>
                        {# le filet n'a plus lieu d'etre sur mobile : les cartes
                           et images empilees separent deja les sections #}
                        <hr class="d-none d-lg-block">
                        {{ include('/parts/btn-ajouter-element.html.twig', {entity, label_one, position: 'right-corner-16'}) }}
                    </div>
                    <div class="row">

                        {{ block('section_content' ~ compteur) }}
                        
                    </div>
                </section>

                {% set compteur = compteur + 1 %}
            {% endfor %}
            
        </div>
    </main>

{% endblock %}