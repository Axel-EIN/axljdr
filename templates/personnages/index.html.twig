{% extends 'category.html.twig' %}

{% block stylesheets %}
    {{parent()}}
    <link rel="stylesheet" href="{{asset('css/components/picture-grid.css')}}" />
    <link rel="stylesheet" href="{{asset('css/pages/characters.css')}}" />
{% endblock %}
{% block title %}Personnages de l'Aventure {{ parent() }}{% endblock %}

{% block content_top %}
    {% set active_filter = selected_episode_id is not null ? 'episode'
                         : (selected_chapitre_id is not null ? 'chapitre'
                         : (selected_saison_id is not null ? 'saison' : null)) %}
    <div class="characters-filters bg-stroke-container">
        {% if active_filter is not null %}
            <a href="{{ path('personnages') }}" class="btn-reset-icon" title="Réinitialiser les filtres">
                <i class="fas fa-undo"></i>
            </a>
        {% endif %}
        {% set filtres = [
            { nom: 'saison',   label: 'Saison',   icone: STORY_SEASON_ICO,   vide: '— Toutes —', options: saisons,   selected: selected_saison_id,   inactif: false,                        reset: ['chapitre', 'episode'] },
            { nom: 'chapitre', label: 'Chapitre', icone: STORY_CHAPTER_ICO, vide: '— Tous —',   options: chapitres, selected: selected_chapitre_id, inactif: selected_saison_id is null,   reset: ['episode'] },
            { nom: 'episode',  label: 'Episode',  icone: STORY_EPISODE_ICO,  vide: '— Tous —',   options: episodes,  selected: selected_episode_id,  inactif: selected_chapitre_id is null, reset: [] },
        ] %}

        <form method="get" action="{{ path('personnages') }}" class="form-row align-items-end m-0">
            {% for filtre in filtres %}
                <div class="col-12 col-md-4 mb-2 mb-md-0 px-1 d-flex d-md-block align-items-center">
                    <label for="filtre-{{ filtre.nom }}" class="mb-0 mb-md-2 mr-3 mr-md-0 ml-md-n1 flex align-items-center">
                        <img class="img-32 mr-md-1" src="{{ asset(filtre.icone) }}" alt="" />
                        <span class="label-amerigo d-none d-md-inline">{{ filtre.label }}</span>
                    </label>
                    <select name="{{ filtre.nom }}" id="filtre-{{ filtre.nom }}"
                            class="form-control form-control-sm{% if active_filter == filtre.nom %} is-active-filter{% endif %}"
                            onchange="{% for aval in filtre.reset %}document.getElementById('filtre-{{ aval }}').value='';{% endfor %}this.form.submit();"
                            {% if filtre.inactif %}disabled{% endif %}>
                        <option value="">{{ filtre.vide }}</option>
                        {% for option in filtre.options %}
                            <option value="{{ option.id }}" {% if filtre.selected == option.id %}selected{% endif %}>
                                {{ filtre.label }} {{ option.numero }} — {{ option.titre }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            {% endfor %}
        </form>
    </div>
{% endblock %}

{% block section_aside1 %}
    <label class="voir-inactifs" for="voir-inactifs">
        <input type="checkbox" id="voir-inactifs">
        Afficher les morts et disparus
    </label>
{% endblock %}

{% block section_content1 %}
    {% set pjs = pjs|filter(p => element_listed(p)) %}
    {% for perso in element_sort(pjs) %}
        {{ include('/personnages/character-card.html.twig', {perso}) }}
    {% endfor %}
    {% if pjs is empty %}
        <div class="col-12"><p class="text-muted font-italic">Aucun personnage joueur ne correspond à ce filtre.</p></div>
    {% endif %}
{% endblock %}

{% block section_content2 %}
    {% set pnjs = pnjs|filter(p => element_listed(p)) %}
    <div class="col-12">
        {% set clans_listes = FACTIONS|map(c => c.nom) %}
        {% set groupes = FACTIONS|map(c => {titre: c.titre, faction: true, persos: pnjs|filter(p => p.clan is not empty and p.clan.nom == c.nom)})
            |merge([{titre: 'Autres', faction: false, persos: pnjs|filter(p => p.clan is empty or p.clan.nom not in clans_listes)}]) %}

        {% for groupe in groupes|filter(g => g.persos|length > 0) %}
            {% set clan_groupe = groupe.faction ? (groupe.persos|first).clan : null %}
            {% set scroller_id = 'pnj-' ~ loop.index %}
            <div class="pnj-clan-group">
                <h3 class="heading-amerigo category-section-sub-heading relative">
                    <img class="img-40 mr-2" src="{{ asset(clan_groupe ? image_small(clan_groupe.mon|default(NA_MON)) : NA_MON) }}" alt="Mon de la faction" />
                    {{ groupe.titre }}
                    <span class="scroller-dots" data-scroller="{{ scroller_id }}"{% if clan_groupe and clan_groupe.couleur %} style="--clan-color: {{ clan_groupe.couleur }}"{% endif %}></span>
                </h3>
                {% embed 'parts/picture-scroller.html.twig' with {scroller_id, scroller_class: 'desktop-only'} %}
                    {% block track %}
                        <div class="row scroller-track characters-track {{ groupe.faction ? 'compact' }}">
                            {% for perso in element_sort(groupe.persos, true) %}
                                {{ include('/personnages/character-card.html.twig', {perso, hide_clan: groupe.faction, compact: groupe.faction}) }}
                            {% endfor %}
                        </div>
                    {% endblock %}
                {% endembed %}
            </div>
        {% endfor %}

        {% if pnjs is empty %}
            <p class="text-muted font-italic">Aucun autre personnage ne correspond à ce filtre.</p>
        {% endif %}
    </div>
{% endblock %}