{% set reveal_session = reveal_session|default(false) %}
{% set reveal_hidden = reveal_hidden|default(reveal_session) %}
{% set hide_dead = hide_dead|default(false) %}
{% set items = (items ?? null) is null ? null : items|filter(item => element_listed(item, reveal_hidden) and not (hide_dead and item.dead)) %}

{% if items is not null and (items is not empty or empty_message is defined) %}

  {% set scroll = scroll|default(false) %}
  {% set items = keep_order|default(false) ? items : element_sort(items, scroll) %}
  {% set variant = variant|default('landscape') %}
  {% set shape = {landscape: '1610', rule: '43', icon: '11'}[variant]|default('1610') %}
  {% set pin = {portrait: 'pin-topleft', icon: 'pin-downcenter'}[variant]|default('') %}
  {% set show_label = variant != 'portrait' %}
  {% set label_inside = label_inside|default(false) and variant in ['landscape', 'rule'] %}
  {% set plain = reveal_session %}
  {% set badge_hover = badge_hover|default(false) %}
  {% set badge_pinned = badge_pinned|default(false) %}
  {% set catalog = catalog|default(false) %}
  {% set gm_plain = catalog and is_gm() %}
  {% set type_badges = type_badges|default([]) %}
  {% set type_icon = type_icon|default(false) %}
  {% set mark_players = mark_players|default(false) %}
  {% set label_soft = label_soft|default(false) %}
  {% set hint_block = hint_block|default(false) %}

  {% if scroll and per_row is not defined %}{% set per_row = {desktop: 6, mobile: 2} %}{% endif %}
  {% set breakpoints = {} %}
  {% if per_row is defined %}
    {% set cols = per_row is iterable ? per_row : {desktop: per_row} %}
    {% set style = '--grid-min: 0' %}
    {% for breakpoint, count in cols %}
      {% set style = style ~ '; --cols-' ~ breakpoint ~ ': ' ~ count %}
    {% endfor %}
    {% set cols_tablet = cols.tablet|default(cols.desktop|default(null)) %}
    {% set breakpoints = {desktop: cols.desktop|default(null), tablet: cols_tablet, mobile: cols.mobile|default(cols_tablet)} %}
  {% else %}
    {% set style = min_size is defined ? '--grid-min: ' ~ min_size : '' %}
  {% endif %}
  {% if max_size is defined %}{% set style = style ~ '; --image-max: ' ~ max_size %}{% endif %}
  {% if gap is defined %}{% set style = style ~ '; --gap: ' ~ gap %}{% endif %}

  {% if title is defined %}
    <div class="{{ wrapper|default('col-12') }}">
      <div class="card card-body">
        {% if btn_add is defined %}{{ include('/btns/btn-add-element.html.twig', btn_add, with_context = false) }}{% endif %}
        <h2 class="heading-cardtitle">{{ title }}</h2>
        <hr class="mb-4">
  {% endif %}

  {% set wrapper_class = title is not defined ? wrapper|default('') : '' %}

  {% set track %}
  <div class="picture-grid {{ scroll ? 'scroll scroller-track' : wrapper_class }}{{ hint_block ? ' hint-block' }}{{ label_soft ? ' label-soft' }}" style="{{ style }}">
    {% for item in limit is defined ? items|slice(0, limit) : items %}

      {% set state = element_state(item, reveal_hidden) %}
      {% set restricted = not element_readable(item) %}
      {% set locked = not plain and not gm_plain and state == 'locked' %}
      {% set edges = '' %}
      {% if restricted and not hint_block %}
        {% for breakpoint, count in breakpoints %}
          {% if count and loop.parent.loop.index0 is divisible by(count) %}{% set edges = edges ~ ' start-' ~ breakpoint %}{% endif %}
          {% if count and loop.parent.loop.index is divisible by(count) %}{% set edges = edges ~ ' edge-' ~ breakpoint %}{% endif %}
        {% endfor %}
      {% endif %}
      {% set item_class = restricted ? 'restricted locked' ~ edges ~ (catalog ? ' catalog' : '') : (plain ? 'hover-zoom' : (element_unseen(item) and not gm_plain ? 'access-hidden ' : '') ~ (locked ? 'locked ' : '') ~ (catalog ? 'catalog ' : '') ~ (locked ? '' : 'hover-zoom')) %}
      {% set name = item.nomComplet is defined ? item.nomComplet : (item.nom is defined ? item.nom : item.titre) %}
      {% set is_player = mark_players and item.estPj|default(false) %}
      {% set pdf_only = item.pdf|default(null) and item.hasParts is defined and not item.hasParts %}
      {% set image_na = pdf_only ? NA_PDF : na_image|default(NA_ICON) %}
      {% set pdf_link = pdf_only and not is_gm() and app.user %}
      {% set href = pdf_link ? pdf_url(item) : (route is defined ? path(route, {id: item.id}) : element_url(item)) %}

      {% set label %}
        <div class="label">
          {%- set clan = item.clan|default(null) -%}
          {%- set clan_color = clan and element_listed(clan) ? clan.couleur : null -%}
          {%- if type_icon and item.typeIcon|default(null) -%}
            <span class="label-icon{{ item.city|default(false) ? ' city' }}" title="{{ item.type }}"{% if clan_color %} style="--clan-color: {{ clan_color }}"{% endif %}><i class="{{ item.typeIcon }}" aria-hidden="true"></i></span>
          {%- endif -%}
          {%- if item.type|default(null) in type_badges -%}
            <span class="label-badge"{% if clan_color %} style="--clan-color: {{ clan_color }}"{% endif %}>{{ item.type }}</span>
          {%- endif -%}
          {{ name }}
        </div>
      {% endset %}

      <a class="picture-item {{ variant }} {{ item_class }}{{ label_inside ? ' label-inside' }}{{ is_player ? ' player' }}"
         {% if restricted or not href %}aria-disabled="true"{% else %}{% if show_label %}title="{{ name }}" {% endif %}{% if pdf_link %}target="_blank" rel="noopener" {% endif %}href="{{ href }}"{% endif %}>
        <div class="image-container {% if locked or restricted %}slight-fade{% endif %}">

          {% if catalog and not restricted %}
            {{ include('parts/badge-catalog.html.twig', {item: item}) }}
          {% elseif not restricted %}
            {% set pinned = badge_pinned or (badge_hover and not is_gm() and element_individual(item)) %}
            {{ include('parts/badge-access.html.twig', {
              state: pinned and state == 'common-discovered' ? 'unlocked' : state,
              variant: badge_hover and not pinned ? 'hover-only' : '',
            }) }}
          {% endif %}

          {% if locked or restricted %}
            {{ include('parts/icon-lock.html.twig', {state, classes: variant == 'icon' ? 'in-icon'}) }}
          {% endif %}

          {% if element_fresh(item, reveal_hidden) %}{{ include('parts/badge-new.html.twig', {variant: pin}) }}{% endif %}

          {% if variant == 'portrait' %}
            {% set na_gender = item.genre == 'F' ? NA_PERSO_PORTRAIT_F : (item.genre == 'M' ? NA_PERSO_PORTRAIT_M : NA_PERSO_PORTRAIT) %}
            {% set dead_shown = not restricted and item.dead|default(false) %}
            <img class="picture {{ dead_shown ? 'effect-dead' }}" src="{{ asset(item.icone|default(na_gender)) }}" loading="lazy" alt="{{ name }}" />
            {% if dead_shown %}
              <img class="character-icon-dead" src="{{ asset(MORT_ICO) }}" alt="est mort" />
            {% endif %}

          {% elseif variant == 'emblem' %}
            <span class="hover-ray">
              <img class="picture" src="{{ asset(attribute(item, field|default('mon'))|default(image_na)) }}" loading="lazy" alt="{{ name }}" />
            </span>

          {% elseif variant == 'icon' %}
            <img class="picture" src="{{ asset(item.icone|default(image_na)) }}" loading="lazy" alt="{{ name }}" />

          {% else %}
            {% if pdf_only %}<img class="badge-corner" src="{{ asset(PDF) }}" alt="Icône PDF" />{% endif %}
            <div class="frame ratio-{{ shape }}">
              {% set image = field|default(null) ? attribute(item, field)|default(null) : item.imageAffichee|default(item.image|default(null)) %}
              {% set na_icon = image ? null : element_icon(item) %}
              {% set picture = na_icon ? NA_43 : (field|default(null) ? image|default(image_na) : image_small(image|default(image_na))) %}
              <img class="ratio-cropped" src="{{ asset(picture) }}" loading="lazy" alt="{{ name }}" />
              {% if na_icon %}
                {% set ring_icon = item.ringIcon|default(null) %}
                <span class="na-icon">
                  {% if ring_icon %}
                    <img class="na-ring" src="{{ asset(ring_icon) }}" alt="" />
                  {% else %}
                    <i class="fa-solid {{ na_icon }}" aria-hidden="true"></i>
                  {% endif %}
                  <span class="na-label">{{ element_label(item) }}</span>
                </span>
              {% endif %}
              {% if not restricted and item.icone|default(null) %}
                <img class="hover-icon" src="{{ asset(item.icone) }}" alt="" />
              {% endif %}
              {% if label_inside %}{{ label }}{% endif %}
            </div>
          {% endif %}

          {% if not show_label and not restricted %}
            <span class="hover-tooltip caption{{ is_player ? ' player' }}"><span class="label">{{ name }}</span></span>
          {% endif %}
        </div>

        {% if show_label and not label_inside %}{{ label }}{% endif %}

        {% if restricted %}
          {{ include('parts/access-hint.html.twig') }}
        {% endif %}
      </a>

    {% else %}
      <span class="grid-empty text-muted font-italic">{{ empty_message|default('') }}</span>
    {% endfor %}
  </div>
  {% endset %}

  {% if scroll %}
    {% embed 'parts/picture-scroller.html.twig' with {scroller_id: scroll_id|default(null), scroller_class: wrapper_class} %}
      {% block track %}{{ track }}{% endblock %}
    {% endembed %}
  {% else %}
    {{ track }}
  {% endif %}

  {% if title is defined %}
      </div>
    </div>
  {% endif %}

{% endif %}
