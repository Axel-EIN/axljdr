{% set size = size|default(96) %}
{% set main_character = (character is defined ? character : false) ? navigating_character() : null %}

{% if main_character %}
  <span class="avatar" style="--avatar-size: {{ size }}px">
    <img src="{{ asset(main_character.icone|default(NA_PERSO_PORTRAIT)) }}"
         alt="Portrait de {{ main_character.prenom }}" title="{{ main_character.nomComplet }}" />
  </span>
{% elseif user.avatar %}
  <span class="avatar" style="--avatar-size: {{ size }}px">
    <img src="{{ asset(size <= 64 ? image_small(user.avatar) : user.avatar) }}" alt="Avatar de {{ user.pseudo }}" title="{{ user.pseudo }}" />
  </span>
{% else %}
  <span class="avatar initial" style="--avatar-size: {{ size }}px" title="{{ user.pseudo }}">{{ user.pseudo|first|upper }}</span>
{% endif %}
