{% extends 'base.html.twig' %}
{% block title %}L'épisode {{ episode.titre }} du Chapitre {{ episode.chapitreParent.titre }} {{ parent() }}{% endblock %}

{% block stylesheets %}
  {{parent()}}
  <link rel="stylesheet" href="{{asset('css/components/element.css')}}" />
  <link rel="stylesheet" href="{{asset('css/pages/episode.css')}}" />
  <link rel="stylesheet" href="{{asset('css/components/scene.css')}}" />
  <link rel="stylesheet" href="{{asset('css/components/chapter.css')}}" />
{% endblock %}

{% block body %}

{% set chapter_image = episode.chapitreParent.image|default(NA_CHAPITRE) %}
{% set chapter_srcset = image_srcset(chapter_image) %}
<div class="chapter-backdrop padded" style="--chapter-color: {{ episode.chapitreParent.couleur }}">

  <img class="chapter-backdrop-image tall{{ image_bright(chapter_image) ? ' bright' }}" src="{{ asset(chapter_image) }}"
    {% if chapter_srcset %}
      srcset="{{ chapter_srcset }}"
      sizes="100vw"
    {% endif %}
    alt="" />

  <header class="container header header-episode veiled">

    {{ include('/parts/flash-messages.html.twig') }}

    <div class="relative d-flex w-100 flex-column">
      {% set chapitres_voisins = {precedent: previous_chapter, suivant: next_chapter}|map(c => c ? c.episodes|filter(e => e.scenes|length > 0 or is_mj())|first : null) %}
      <span class="chapter-number navigable display-5">
        <a class="prev btn-quaternary-style text-white50{{ chapitres_voisins.precedent is empty ? ' invisible' }}"
           {% if chapitres_voisins.precedent is not empty %}href="{{ path('story_episode', {id: chapitres_voisins.precedent.id}) }}" title="Chapitre précédent"{% endif %}>
          <i class="fa-solid fa-chevron-left"></i>
        </a>
        CHAPITRE {{ episode.chapitreParent.numero }}
        <a class="btn-quaternary-style text-white50{{ chapitres_voisins.suivant is empty ? ' invisible' }}"
           {% if chapitres_voisins.suivant is not empty %}href="{{ path('story_episode', {id: chapitres_voisins.suivant.id}) }}" title="Chapitre suivant"{% endif %}>
          <i class="fa-solid fa-chevron-right"></i>
        </a>
      </span>
      <div><hr></div>
      <a class="btn-primary-style btn-medium hue-gray chapter-backbtn" href="{{ path('story_season', {id: episode.chapitreParent.saisonParent.id, '_fragment': 'read-head-ch-id' ~ episode.chapitreParent.id } ) }}" title="Retour à l'Aventure" aria-label="Retour à l'Aventure"><i class="fa-solid fa-reply" aria-hidden="true"></i></a>
    </div>

    <h2 id="read-head" class="heading-chapter">{{ episode.chapitreParent.titre|relief|raw }}</h2>

    <div class="chapter-intro relative">
      {{ include('story/chapter-characters.html.twig', {un_chapitre: episode.chapitreParent, episode}) }}
      <p class="quote quote-chapter">{{ episode.chapitreParent.citation|nl2br }}</p>
    </div>

  </header>

  <main class="container-fluid element-page">
   <div class="container">
    <section>
     <div class="row">

      <div class="col-12 relative">
        {{ include('story/episodes-line.html.twig', {episode}) }}
      </div>

      <div class="col-12 bg-stroke-container relative">
        {{ include('parts/badge-access.html.twig', {state: element_state(episode)}) }}
        <h1 class="heading-episodedetail mb-0 mt-3 py-3">
          {{episode.titre}}
          {% if is_mj() %}            {% set color, position, redirect, entity, un_element, size = 'text-white50', '', 'story', 'episode', episode, 'btn-icon-medium' %}
            {{ include('/btns/btn-icon-edit.html.twig') }}
          {% endif %}
        </h1>
      </div>

      <div class="col-12 offset-xl-1 col-xl-10">
        <div class="card card-page card-episode-detail bg-clouds">

          {% set numero = 0 %}
          {% for une_scene in episode.scenes %}

            {% if is_mj() %}
              <div class="text-center mb-4">&nbsp;
                  {% set color, entity, numero, parent, parentID, redirect, label = 'link-gm', 'scene', une_scene.numero, 'episode', episode.id, 'episode', 'Insérer' %}
                  {{ include('/btns/btn-line-insert.html.twig') }}
              </div>
            {% endif %}

            {{ include('/story/scene-detail.html.twig', {une_scene, lazy: not loop.first}) }}

          {% else %}
            <p class="text-center text-light py-5">Il n'y a pas encore de scènes pour cette épisode.</p>
          {% endfor %}

          {% if is_mj() %}
            <div class="text-center mt-1 mb-3">
              {% set btnStyle, btnSize, color, entity, numero, parent, parentID, redirect, label = 'btn-primary-style gm', 'btn-medium', 'text-white', 'scene', (numero + 1), 'episode', episode.id, 'episode', 'Ajouter' %}
              {{ include('/btns/btn-line-insert.html.twig') }}
            </div>
          {% endif %}

          <hr class="mt-5">

          {% if episode.issue is defined and episode.issue is not empty %}
            <div class="text-center mt-4 mb-2">
              {% if episode.issue == 'Win' %}
                <img class="img-fluid" src="{{asset('assets/ui/outcome-success.png')}}" />
              {% elseif episode.issue == 'Mitigate' %}
                <img class="img-fluid" src="{{asset('assets/ui/outcome-mitigate.png')}}" />
              {% elseif episode.issue == 'Lose' %}
                <img class="img-fluid" src="{{asset('assets/ui/outcome-fail.png')}}" />
              {% endif %}
            </div>
          {% endif %}

          {% if episode_ranking %}
            <div class="d-flex justify-content-center">
              <div class="list-group list-group-flush">
                {% set mvp = false %}
                {% if episode.issue is not empty and episode.issue == 'Win' %}
                  {% set mvp = true %}
                  {% for un_personnage in episode_ranking %}
                    {% if un_personnage != episode_ranking|first and un_personnage.xp == episode_ranking|first.xp %}
                      {% set mvp = false %}
                    {% endif %}
                  {% endfor %}
                {% endif %}

                {% set previous_xp = null %}
                {% set rank = 0 %}
                {% for un_personnage in episode_ranking %}

                  {% if previous_xp != un_personnage.xp %}
                    {% set rank = rank + 1 %}
                  {% endif %}

                  {% if episode.issue is not empty and episode.issue == 'Win' %}
                    {% set scale = 'scale-100' %}
                    {% if mvp == true and rank == 1 %}
                      {% set scale = 'scale-120' %}
                    {% endif %}
                  {% else %}
                    {% set scale = 'scale-sm-80' %}
                  {% endif %}

                  <a class="list-group-item d-flex align-items-center hover-zoom bg-transparent ranking {{scale|default('')}}" href="{{path('characters_profile',{id:un_personnage.id})}}">
                    <img class="img-96 mr-4 rounded-circle" src="{{ asset(un_personnage.icon|default(NA_PERSO_PORTRAIT)) }}" alt="Portrait du Personnage" title="Voir le profil de {{un_personnage.firstName}}"/>
                    <div class="relative inlineblock mr-4">
                      {% if mvp == true and rank == 1 %}<i class="crown fa-solid fa-crown fa-2xl text-primary mr-4"></i>{% endif %}
                      <span class="heading-present">
                        <span class="text-strong">{{un_personnage.firstName}}</span>
                      </span>
                    </div>
                    <div class="ml-auto text-right">
                      <span class="badge badge-pill text-large text-gray">{{ include('parts/xp-gain.html.twig', {xp: un_personnage.xp, total: un_personnage.xpWithBonus}) }}</span>
                      {% if un_personnage.xpWithBonus > un_personnage.xp %}
                        <div class="text-regular extrabold text-flash-green-darker mt-1">{{ include('parts/xp-gain.html.twig', {xp: un_personnage.xp, total: un_personnage.xpWithBonus, format: 'total'}) }}</div>
                      {% endif %}
                    </div>
                  </a>
                  {% set previous_xp = un_personnage.xp %}
                {% endfor %}
              </div>
            </div>
          {% endif %}

          <div class="back-next-btns">
            <div class="col text-left pl-0">
              <a class="btn-primary-style btn-medium hue-gray" href="#read-head">
                <i class="fa-solid fa-arrow-turn-up" title="revenir en haut de page"></i>&nbsp;Retour
              </a>
            </div>
            <div class="col text-center">
            </div>
            <div class="col text-right pr-0">
              {% if next_episode is not empty %}
                {% if next_episode.scenes|length > 0 or is_mj() %}
                  <a class="btn-primary-style btn-medium" href="{{ path('story_episode', {id: next_episode.id}) }}">
                    Suivant
                  </a>
                {% endif %}
              {% else %}
                {% if next_chapter_episode is not empty %}
                  <a class="btn-primary-style btn-medium hue-fuschia" href="{{ path('story_episode', {id: next_chapter_episode.id}) }}">
                    Chapitre suivant&nbsp;<i class="fa-solid fa-book-open" aria-hidden="true"></i>
                  </a>
                {% endif %}
              {% endif %}
            </div>
          </div>
        </div>
      </div>

     </div>
    </section>
   </div>
  </main>
</div>

{% endblock %}
